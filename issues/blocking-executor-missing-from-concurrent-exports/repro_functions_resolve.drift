// Probe: is the 0.33.80 blocking API reachable from user code at all,
// given BlockingExecutor & friends are `pub` but absent from std.concurrent's
// export {} list? Uses val-inference only (never names the type), owned captures.
module main;

import std.core as core;
import std.concurrent as conc;

pub fn main(argv: Array<String>) nothrow -> Int {
	var b = conc.blocking_executor_builder();
	val ex = conc.build_blocking_executor(b.build(), "export-probe");
	val x = 41;
	match conc.run_blocking_on(&ex, "probe.op", core.callback0(|| captures(copy x) => {
		return x + 1;
	})) {
		core.Result::Ok(v) => {
			if v == 42 { return 0; }
			return 2;
		},
		core.Result::Err(_) => { return 1; },
	}
}

pub fn main() nothrow -> Int {
	val a = 5;
	val p = Point(x = 7, y = a * 3, label = "pt");
	val v1 = Choice::IntVal(a);
	val v2 = Choice::PointVal(p);
	val v3 = Choice::None();
	return a + 1;
}

struct Point {
	x: Int,
	y: Int,
	label: String,
}

variant Choice {
	None,
	IntVal(value: Int),
	PointVal(p: Point),
}

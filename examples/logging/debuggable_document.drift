import std.log as log;
import std.concurrent as conc;

struct Document {
	name: String,
	size: Int,
	pages: Int,
	owner: String,
}

implement log.Debuggable for Document {
	pub fn to_debug(self: &Document) nothrow -> DiagnosticValue {
		return DiagnosticValue::Int(self.size);
	}
}

pub fn main() nothrow -> Int {
	var cfgb = log.config_builder();
	cfgb.sink(log.stderr_sink());
	cfgb.min_level(log.Level::Debug());
	cfgb.queue_capacity(1024);
	cfgb.enqueue_timeout(conc.Duration(millis = 2));
	cfgb.write_timeout(conc.Duration(millis = 25));
	val cfg = cfgb.build();
	val _ = log.init(cfg);
	val doc = Document(name = "contract.pdf", size = 1048576, pages = 42, owner = "legal");
	val _ = log.debug("document-indexed", {"doc": move doc});
	val _ = log.flush(conc.Duration(millis = 1000));
	return 0;
}

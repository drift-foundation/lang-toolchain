import std.log as log;
import std.concurrent as conc;

pub fn main() nothrow -> Int {
	var cfgb = log.config_builder();
	cfgb.sink(log.stderr_sink());
	cfgb.min_level(log.Level::Info());
	cfgb.queue_capacity(4096);
	cfgb.enqueue_timeout(conc.Duration(millis = 2));
	cfgb.write_timeout(conc.Duration(millis = 25));
	val cfg = cfgb.build();
	val logger = log.create_logger("main", cfg);
	logger.info("auth-failed", {"user": "alice", "reason": "bad-password"});
	logger.info("session-opened", {"user": "alice", "session_id": "sess-01"});
	logger.error("db-timeout", {"host": "db-main", "retryable": "true"});
	val _ = logger.flush(conc.Duration(millis = 1000));
	return 0;
}

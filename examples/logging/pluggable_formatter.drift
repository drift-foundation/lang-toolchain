import std.log as log;
import std.concurrent as conc;

// MVP formatter API uses FormatterKind.
// Default remains JSON with ISO timestamp.

pub fn main() nothrow -> Int {
	var cfgb = log.config_builder();
	cfgb.sink(log.stderr_sink());
	cfgb.min_level(log.Level::Debug());
	cfgb.queue_capacity(2048);
	cfgb.enqueue_timeout(conc.Duration(millis = 2));
	cfgb.write_timeout(conc.Duration(millis = 25));
	cfgb.formatter(log.FormatterKind::Custom("kv"));
	val cfg = cfgb.build();
	val logger = log.create_logger("main", move cfg);
	logger.info("startup", {"component": "worker"});
	logger.error("job-failed", {"job_id": "42", "retryable": "false"});
	logger.flush(conc.Duration(millis = 1000));
	return 0;
}

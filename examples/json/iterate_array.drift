module main;

import std.console as console;
import std.core as core;
import std.json as json;

fn main() nothrow -> Int {
	return try run() catch { 99 };
}

fn run() -> Int {
	var arr = json.new_array();
	arr.push(json.JsonNode::Number("1"));
	arr.push(json.JsonNode::Number("2"));
	arr.push(json.JsonNode::Number("3"));
	val node = arr.to_node();
	val items = node.expect_array("root", "items");
	for val item : items {
		val n = item.expect_int("root[]", "item");
		if n < 0 {
			return 1;
		}
	}
	val text = json.encode(&node);
	match json.parse(&text) {
		core.Result::Ok(parsed) => {
			match parsed.into_array() {
				Some(v) => {
					if v.len() != 3 {
						return 2;
					}
				},
				None => { return 3; }
			}
		},
		core.Result::Err(e) => {
			console.println(e.tag);
			return 4;
		}
	}
	return 0;
}

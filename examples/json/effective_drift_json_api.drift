module main;

import std.console as console;
import std.core as core;
import std.json as json;

pub fn main() nothrow -> Int {
	return try run() catch { 99 };
}

fn run() -> Int {
	var users = json.new_array();
	var u0 = json.new_object();
	u0.set("id", json.JsonNode::Number("42"));
	users.push(u0.to_node());
	var u1 = json.new_object();
	u1.set("id", json.JsonNode::Number("7"));
	users.push(u1.to_node());
	var root = json.new_object();
	root.set("users", users.to_node());
	val node = root.to_node();

	var cfgb = json.config_builder();
	cfgb.key_order(json.JsonKeyOrder::OrderedLexUtf8());
	val cfg = cfgb.build();
	console.println(json.encode_with_config(node, cfg));

	var users_path = ["users"];
	val users_node = node.expect_path(users_path);
	val arr = users_node.expect_array("users", "users");
	if arr.len != 2 {
		return 2;
	}
	val text = json.encode(node);
	match json.parse(text) {
		core.Result::Ok(parsed) => {
			match parsed.into_object() {
				Some(obj) => {
					if obj.len() != 1 {
						return 3;
					}
				},
				None => { return 4; }
			}
		},
		core.Result::Err(e) => {
			console.println(e.tag);
			return 5;
		}
	}
	return 0;
}

module main;

import std.cli as cli;
import std.console as console;
import std.core as core;
import std.format as format;

pub fn main(argv: Array<String>) nothrow -> Int {
	var p = cli.parser("backup-tool", "0.1.0", "Create backups for a target directory.");
	p.flag("verbose", "v", "Enable verbose output.");
	p.option_int("port", "p", "PORT", "Control plane port.", true);
	p.option_string("mode", "m", "MODE", "Backup mode: full or diff.", false);
	p.positional("target", "Target directory.", true, false);
	p.positional("paths", "Additional relative paths.", false, true);
	// parse_with_builtins owns --help / --version output: --help
	// prints the usage text, --version renders "backup-tool 0.1.0"
	// (a non-empty version string selects the simple mode; an empty
	// one renders the stamped build-info block — see
	// examples/build_info.drift), and both yield Terminal(0).
	match p.parse_with_builtins(argv) {
		cli.ParseOutcome::Args(parsed) => {
			var target = "";
			var port = 3306;
			var mode = "full";
			match parsed.positional_at(0) {
				Some(v) => { target = *v; },
				None => { return 2; }
			}
			match parsed.get_int("port", p) {
				Some(v) => { port = v; },
				None => { return 3; }
			}
			match parsed.get_string("mode", p) {
				Some(v) => { mode = *v; },
				None => { }
			}
			if parsed.has_flag("verbose", p) {
				console.println("verbose=true");
			}
			console.println("target=" + target);
			console.println("port=" + format.format_int(port));
			console.println("mode=" + mode);
			console.println("extra_paths=" + format.format_int(parsed.positional_len() - 1));
			return 0;
		},
		cli.ParseOutcome::Terminal(code) => {
			return code;
		},
		cli.ParseOutcome::Err(err) => {
			console.println("cli error: " + err.tag + " at argv[" + format.format_int(err.index) + "] " + err.message);
			return 2;
		}
	}
}

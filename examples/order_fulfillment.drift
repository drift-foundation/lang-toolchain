module main;

import std.console as console;
import std.format as fmt;

error InvalidOrder { order_id: Int, code: String }

struct Order {
	id: Int,
	sku: String,
	quantity: Int
}

fn verify(order: &Order) nothrow -> Bool {
	return order.quantity > 0 and order.sku != "";
}

fn ship(order: Order) -> Void {
	console.println("debug-start");
	console.println(fmt.format_bool(verify(&order)));
	if verify(&order) {
		val shipping_id: String = "Trk:" + order.sku;
		// `^` captures the binding as a diagnostic attribute on any
		// error thrown while it is in scope.
		val ^order_id: Int as "order.id" = order.id;
		console.println("order tracking# " + shipping_id);
	}
	else {
		throw InvalidOrder(order_id = order.id, code = "order.invalid");
	}
}

pub fn main() nothrow -> Int {
	var order: Order = Order(id = 42, sku = "DRIFT-1", quantity = 1);
	try {
		ship(move order);
	} catch InvalidOrder(e) {
		console.eprintln("rejected: " + e.code);
		return 1;
	} catch {
		return 2;
	}
	return 0;
}

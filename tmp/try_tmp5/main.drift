
module main

import std.core as core;
use trait core.Try;
use trait core.Diagnostic;

pub variant MyErr {
	Msg(m: String)
}

implement core.Diagnostic for MyErr {
	pub fn to_diag(self: MyErr) nothrow -> DiagnosticValue {
		return match self {
			Msg(m) => {
				m.to_diag()
			}
		};
	}
}

fn main() -> Int { return 1; }

module main;

import std.core as core;
import std.json as json;

// ── Throwing helpers used as the inner subjects of `try ... catch`. ──

fn pull_status(root: &json.JsonNode) -> String {
	return root.expect().field("meta").field("callback").field("status").string();
}

fn pull_count(root: &json.JsonNode) -> Int {
	return root.expect().field("meta").field("callback").field("count").int();
}

fn pull_on(root: &json.JsonNode) -> Bool {
	return root.expect().field("meta").field("callback").field("on").bool();
}

fn pull_ratio(root: &json.JsonNode) -> Float {
	return root.expect().field("meta").field("callback").field("ratio").float();
}

fn pull_missing_middle(root: &json.JsonNode) -> String {
	return root.expect().field("meta").field("nope").field("x").string();
}

fn pull_walk_through_bool(root: &json.JsonNode) -> String {
	return root.expect().field("meta").field("callback").field("on").field("x").string();
}

fn pull_int_as_string(root: &json.JsonNode) -> String {
	return root.expect().field("meta").field("callback").field("count").string();
}

fn pull_string_as_int(root: &json.JsonNode) -> Int {
	return root.expect().field("meta").field("callback").field("status").int();
}

fn pull_string_as_bool(root: &json.JsonNode) -> Bool {
	return root.expect().field("meta").field("callback").field("status").bool();
}

fn pull_string_as_float(root: &json.JsonNode) -> Float {
	return root.expect().field("meta").field("callback").field("status").float();
}

fn run() -> Int {
	val text = "{\"meta\":{\"callback\":{\"status\":\"ok\",\"count\":42,\"ratio\":1.5,\"on\":true}},\"items\":[1,2]}";
	// Slice 5 (pub-error track): `or_throw()` requires Err to be a
	// `pub error`.  `json.parse` returns `Result<_, JsonErrorData>` —
	// JsonErrorData is a `pub struct` with a manual Throw-to-JsonError
	// impl, so or_throw is rejected.  Match the Result and route the
	// parse-success branch through `_run_with_root` (the parse text is
	// well-formed, so Err is unreachable).
	match json.parse(&text) {
		Ok(root) => { return _run_with_root(move root); },
		Err(_) => { return -1; },
	}
}

fn _run_with_root(root: json.JsonNode) -> Int {

	// ── Happy paths ───────────────────────────────────────────
	if pull_status(&root) != "ok" { return 1; }
	if pull_count(&root) != 42 { return 2; }
	if !pull_on(&root) { return 3; }
	val r = pull_ratio(&root);
	if r < 1.5 { return 4; }
	if r > 1.5 { return 5; }

	// ── missing-segment ───────────────────────────────────────
	try {
		val _v = pull_missing_middle(&root);
		return 10;
	} catch json:JsonPathError(e) {
		val dv_reason = e.attrs["reason"];
		match dv_reason.as_string() {
			Some(s) => { if s != "missing-segment" { return 11; } },
			default => { return 12; }
		}
		val dv_path = e.attrs["path"];
		match dv_path.as_string() {
			Some(s) => { if s != "meta" { return 13; } },
			default => { return 14; }
		}
		val dv_seg = e.attrs["segment"];
		match dv_seg.as_string() {
			Some(s) => { if s != "nope" { return 15; } },
			default => { return 16; }
		}
		val dv_idx = e.attrs["index"];
		match dv_idx.as_int() {
			Some(v) => { if v != 1 { return 17; } },
			default => { return 18; }
		}
	}

	// ── not-object: bool intermediate ─────────────────────────
	try {
		val _v = pull_walk_through_bool(&root);
		return 20;
	} catch json:JsonPathError(e) {
		val dv_reason = e.attrs["reason"];
		match dv_reason.as_string() {
			Some(s) => { if s != "not-object" { return 21; } },
			default => { return 22; }
		}
		val dv_path = e.attrs["path"];
		match dv_path.as_string() {
			Some(s) => { if s != "meta.callback.on" { return 23; } },
			default => { return 24; }
		}
		val dv_seg = e.attrs["segment"];
		match dv_seg.as_string() {
			Some(s) => { if s != "x" { return 25; } },
			default => { return 26; }
		}
		val dv_idx = e.attrs["index"];
		match dv_idx.as_int() {
			Some(v) => { if v != 3 { return 27; } },
			default => { return 28; }
		}
	}

	// ── type-mismatch-string ──────────────────────────────────
	try {
		val _v = pull_int_as_string(&root);
		return 30;
	} catch json:JsonPathError(e) {
		val dv_reason = e.attrs["reason"];
		match dv_reason.as_string() {
			Some(s) => { if s != "type-mismatch-string" { return 31; } },
			default => { return 32; }
		}
		val dv_path = e.attrs["path"];
		match dv_path.as_string() {
			Some(s) => { if s != "meta.callback.count" { return 33; } },
			default => { return 34; }
		}
	}

	// ── type-mismatch-int ─────────────────────────────────────
	try {
		val _v = pull_string_as_int(&root);
		return 40;
	} catch json:JsonPathError(e) {
		val dv_reason = e.attrs["reason"];
		match dv_reason.as_string() {
			Some(s) => { if s != "type-mismatch-int" { return 41; } },
			default => { return 42; }
		}
	}

	// ── type-mismatch-bool ────────────────────────────────────
	try {
		val _v = pull_string_as_bool(&root);
		return 50;
	} catch json:JsonPathError(e) {
		val dv_reason = e.attrs["reason"];
		match dv_reason.as_string() {
			Some(s) => { if s != "type-mismatch-bool" { return 51; } },
			default => { return 52; }
		}
	}

	// ── type-mismatch-float ───────────────────────────────────
	try {
		val _v = pull_string_as_float(&root);
		return 60;
	} catch json:JsonPathError(e) {
		val dv_reason = e.attrs["reason"];
		match dv_reason.as_string() {
			Some(s) => { if s != "type-mismatch-float" { return 61; } },
			default => { return 62; }
		}
	}

	return 0;
}

fn main() nothrow -> Int {
	return try run() catch { 99 };
}

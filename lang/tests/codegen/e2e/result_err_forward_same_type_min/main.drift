module m;
import std.core as core;

struct E {
  tag: String,
  path: String,
  key: String
}

fn g() nothrow -> core.Result<String, E> {
  return core.Result::Err(E(tag = "bad", path = "", key = ""));
}

fn f() -> core.Result<String, E> {
  match g() {
    core.Result::Err(e) => { return core.Result::Err(e); },
    core.Result::Ok(v) => { return core.Result::Ok(v); }
  }
}

fn run() -> Int {
  match f() {
    core.Result::Err(_e) => { },
    core.Result::Ok(_) => { return 1; }
  }
  return 0;
}

fn main() nothrow -> Int { return try run() catch { 99 }; }

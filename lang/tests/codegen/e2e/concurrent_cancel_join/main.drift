module main;

import std.concurrent as conc;
import lang.thread as thread;

fn main() nothrow -> Int {
	var t = conc.spawn(| | => {
		thread.vt_park_until(50);
		return 7;
	});
	t.cancel();
	t.cancel();
	var res = t.join();
		match res {
		Err(err) => {
			if err.kind == conc.CONCURRENCY_KIND_CANCELLED { return 0; }
			return 1;
		},
		Ok(_v) => { return 2; },
		default => { return 3; },
	}
}

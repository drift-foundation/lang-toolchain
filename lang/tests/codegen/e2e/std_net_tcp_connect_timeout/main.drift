module m;

import std.concurrent as conc;
import std.net as net;

pub fn main() nothrow -> Int {
	var addr = net.socket_addr("10.255.255.1", 1);
	val t = conc.Duration(millis = 1);
	val cr = net.connect(&addr, t);
	match cr {
		Ok(s) => {
			val _ = s.close(t);
			return 0;
		},
		Err(e) => {
			if e.kind == net.NET_ERROR_KIND_WOULD_BLOCK { return 0; }
			if e.kind == net.NET_ERROR_KIND_ERRNO { return 0; }
			return 3;
		},
		default => { return 4; }
	}
}

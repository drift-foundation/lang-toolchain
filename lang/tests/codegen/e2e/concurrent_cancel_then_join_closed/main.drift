module main;

import std.concurrent as conc;

fn main() nothrow -> Int {
	var t = conc.spawn(| | => { return 1; });
	t.cancel();
	var res1 = t.join();
	var ok1 = false;
	match res1 {
		Err(err) => {
			if err.kind == conc.CONCURRENCY_KIND_CANCELLED { ok1 = true; }
		},
		Ok(_v) => {},
		default => {},
	}
	if not ok1 {
		return 2;
	}
	var res2 = t.join();
		match res2 {
		Err(err) => {
			if err.kind == conc.CONCURRENCY_KIND_CLOSED { return 0; }
			return 3;
		},
		Ok(_v) => { return 4; },
		default => { return 4; },
	}
}

module main

import std.concurrent as conc;
import std.core as core;
import std.io as io;
import std.net as net;

// ET budget-yield forward-progress regression: verify that a VT reading
// more than DRIFT_IO_BUDGET_BYTES (64KB) still completes — the budget-yield
// re-enqueues the VT and it resumes to drain remaining data.
//
// Strategy: write 128KB of data in chunks, read it all back. If budget
// enforcement or replay is broken, the reader stalls after 64KB.

const CHUNK_SIZE: Int = 4096;
const TOTAL_BYTES: Int = 131072;

pub fn main() nothrow -> Int {
	var addr = net.socket_addr("127.0.0.1", 0);
	val io_t = conc.Duration(millis = 5000);
	var lr = net.listen(&addr, io_t);
	match lr {
		Ok(l) => {
			val port = l.test_local_port();
			var writer = conc.spawn(| | captures(copy port, copy io_t) => {
				var caddr = net.socket_addr("127.0.0.1", port);
				var cr = net.connect(&caddr, io_t);
				match cr {
					Ok(s) => {
						var wbuf = io.buffer(CHUNK_SIZE);
						// Fill buffer with a pattern.
						var fi = 0;
						while fi < CHUNK_SIZE {
							io.buffer_write(&mut wbuf, fi, cast<Byte>(fi % 256));
							fi = fi + 1;
						}
						var written = 0;
						while written < TOTAL_BYTES {
							val wr = s.write(&wbuf, io_t);
							match wr {
								Ok(n) => { written = written + n; },
								Err(_) => { return 10; },
								default => { return 11; }
							}
						}
						val _ = s.close(io_t);
						return 0;
					},
					Err(_) => { return 12; },
					default => { return 13; }
				}
			});
			var ar = net.accept(&l, io_t);
			match ar {
				Ok(s2) => {
					var rbuf = io.buffer(CHUNK_SIZE);
					var total_read = 0;
					while total_read < TOTAL_BYTES {
						val rr = s2.read(&mut rbuf, io_t);
						match rr {
							Ok(n) => {
								if n <= 0 { return 20; }
								total_read = total_read + n;
							},
							Err(_) => { return 21; },
							default => { return 22; }
						}
					}
					val _ = s2.close(io_t);
					if total_read < TOTAL_BYTES { return 23; }
				},
				Err(_) => { return 30; },
				default => { return 31; }
			}
			var tr = writer.join();
			match tr {
				Ok(v) => { if v != 0 { return 100 + v; } },
				Err(_) => { return 40; },
				default => { return 41; }
			}
			return 0;
		},
		Err(_) => { return 50; },
		default => { return 51; }
	}
}

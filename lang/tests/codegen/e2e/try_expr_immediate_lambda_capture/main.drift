module m;

import std.concurrent as conc;
import std.core as core;
import std.err;


// Pins immediate-lambda + capture: the inner `try (| | ...)() catch { 0 }`
// is the real subject.  Match the outer Result rather than chain into
// or_throw so the test stays focused on capture lowering, not the
// throws/auto-try wiring.
pub fn main() nothrow -> Int {
	return try run_main() catch { 1 };
}

fn run_main() throws -> Int {
	var x: Int = 41;
	var t = conc.spawn(| | captures(move x) => {
		return try (| | captures(move x) => { return x + 1; })() catch { 0 };
	});
	match t.join() {
		Ok(v) => { return v; },
		Err(_) => { return 0; },
	}
}

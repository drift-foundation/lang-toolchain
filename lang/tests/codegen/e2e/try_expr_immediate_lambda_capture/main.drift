module m;

import std.concurrent as conc;
import std.core as core;
import std.err;


// Slice 5 (pub-error track): `or_throw()` requires Err to be `pub error`.
// `conc.spawn().join()` returns Result<T, ConcurrencyError> where
// ConcurrencyError is a `pub variant`.  Match the Result instead of
// auto-or_throw — preserves the immediate-lambda + capture exercise.
pub fn main() nothrow -> Int {
	return try run_main() catch { 1 };
}

fn run_main() throws -> Int {
	var x: Int = 41;
	var t = conc.spawn(| | captures(move x) => {
		return try (| | captures(move x) => { return x + 1; })() catch { 0 };
	});
	match t.join() {
		Ok(v) => { return v; },
		Err(_) => { return 0; },
	}
}

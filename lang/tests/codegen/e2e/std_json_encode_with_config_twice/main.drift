module m;
import std.json as json;
import std.containers as containers;
fn run() -> Int {
	var b = json.config_builder();
	b.key_order(json.JsonKeyOrder::OrderedLexUtf8());
	val cfg = b.build();
	var fields = containers.hash_map<type String, json.JsonNode>();
	fields.insert("a", json.JsonNode::Number("1"));
	val n = json.JsonNode::Object(move fields);
	val s1 = json.encode_with_config(n, cfg);
	val s2 = json.encode_with_config(n, cfg);
	if s1 != "{\"a\":1}" { return 1; }
	if s2 != "{\"a\":1}" { return 2; }
	return 0;
}
pub fn main() nothrow -> Int { return try run() catch { 99 }; }

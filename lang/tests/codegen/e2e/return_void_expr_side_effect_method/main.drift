module m

// REGRESSION: return <void-method-call> must evaluate the method for side
// effects.  Pins the HMethodCall lowering path (other variants use free fns).

struct Counter {
	n: Int,
}

implement Counter {
	fn bump(self: &mut Counter) nothrow -> Void {
		self.n = self.n + 1;
		return;
	}
}

fn do_work(c: &mut Counter) nothrow -> Void {
	return c.bump();
}

fn do_work_throws(c: &mut Counter) -> Void {
	return c.bump();
}

fn run() -> Int {
	var c = Counter(n = 0);
	do_work(&mut c);
	if c.n != 1 { return 1; }
	do_work(&mut c);
	if c.n != 2 { return 2; }
	do_work_throws(&mut c);
	if c.n != 3 { return 3; }
	return 0;
}

pub fn main() nothrow -> Int {
	return try run() catch { 99 };
}

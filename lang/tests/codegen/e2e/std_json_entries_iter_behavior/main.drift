module m;

import std.core as core;
import std.iter as iter;
import std.json as json;

use trait iter.SinglePassIterator;

fn run() -> Int {
	val t = "{\"a\":1,\"b\":2}";
	var node = json.JsonNode::Null();
	match json.parse(t) {
		core.Result::Ok(v) => { node = move v; },
		core.Result::Err(e) => { if e.tag == "x" { return 98; } return 10; }
	}
	var count = 0;
	var it = node.entries();
	while true {
		match it.next() {
			Some(item) => {
				if item.key.byte_length() <= 0 { return 97; }
				count = count + 1;
			},
			None => { break; }
		}
	}
	if count != 2 { return 11; }

	val n = json.JsonNode::Number("1");
	var itn = n.entries();
	match itn.next() {
		Some(_) => { return 20; },
		None => {}
	}

	val z = json.JsonNode::Null();
	var itz = z.entries();
	match itz.next() {
		Some(_) => { return 21; },
		None => {}
	}

	// empty object -> iterator yields nothing
	match json.parse("{}") {
		core.Result::Ok(eo) => {
			var ite = eo.entries();
			match ite.next() {
				Some(_) => { return 30; },
				None => {}
			}
		},
		core.Result::Err(_) => { return 31; }
	}

	// leak-clean EARLY iterator drop: take one entry, abandon the rest; the
	// iterator drops (in early_drop's scope) while `node` is still alive.
	if early_drop(node) != 0 { return 40; }

	return 0;
}

// Creates an entries() iterator over a borrowed object, advances once, and
// returns — dropping the iterator mid-iteration.  Memcheck pins that the early
// drop (with the still-live borrowed object) leaks nothing.
fn early_drop(node: &json.JsonNode) nothrow -> Int {
	var it = node.entries();
	match it.next() {
		Some(item) => { if item.key.byte_length() <= 0 { return 1; } return 0; },
		None => { return 2; }
	}
}

pub fn main() nothrow -> Int {
	return try run() catch { 99 };
}

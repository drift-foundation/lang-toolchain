module main;

import std.containers as containers;
import std.iter as iter;
use trait iter.SinglePassIterator;

fn run() -> Int {
	var m = containers.tree_map<type Int, Int>();
	m.insert(1, 1);
	var it = m.iter();
	m.insert(2, 2);
	val _v = it.next();
	return 0;
}

fn main() nothrow -> Int {
	return try run() catch { 99 };
}

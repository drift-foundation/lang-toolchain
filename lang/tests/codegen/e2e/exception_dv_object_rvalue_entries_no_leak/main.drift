module m;

import std.core as core;

// K28-aftermath Leak A regression.
//
// `__exc_attrs_get_dv` hands out an INDEPENDENTLY-OWNED `DiagnosticValue`
// clone; the caller must release it on scope exit.  When the cloned DV is
// a `DV::Object` with a non-empty `Array<DiagnosticEntry>` payload and the
// user calls `.entries()` on it, the payload is deep-cloned into a fresh
// `Array<DiagnosticEntry>`, and then the outer DV temp must still be
// dropped — otherwise the cloned fields-array + its inner heap keys leak.
//
// Empty-payload `DV::Object` clones don't leak because there's no heap
// payload allocated during the clone; only non-empty payloads expose
// the missing temp-drop registration.
//
// This fixture exercises BOTH receiver forms so we can differentiate:
//   (a) rvalue receiver:  e.attrs["fields"].entries()
//   (b) bound receiver:   val dv = e.attrs["fields"]; dv.entries()
// If only (a) leaks, the bug is rvalue-temp-cleanup for DV receivers.
// If both leak, it's DVEntries lowering / drift_dv_entries ownership.
//
// Heap-allocated keys are used so the leak is observable under
// DRIFT_MEMCHECK=1 (string literals carry DRIFT_STRING_FLAG_STATIC and
// their release is a no-op, masking the bug).

pub exception BadReq(tag: String, fields: DiagnosticValue)

fn heap_key() nothrow -> String {
	// Concat of two literals is forced through drift_string_concat which
	// always allocates a fresh heap buffer — i.e. a non-static String.
	return "field_" + "key";
}

fn make_obj() nothrow -> DiagnosticValue {
	return DiagnosticValue::Object([
		core.diagnostic_entry(heap_key(), DiagnosticValue::String("required"))
	]);
}

fn throw_it() throws -> Int {
	throw BadReq(tag = "validation", fields = make_obj());
}

fn consume_rvalue() nothrow -> Int {
	try {
		val _ = throw_it();
		return 99;
	} catch BadReq(e) {
		// Form (a): rvalue receiver — DV temp from e.attrs["fields"] is
		// consumed directly by .entries() without being bound.
		val entries = e.attrs["fields"].entries();
		if entries.len != 1 {
			return 1;
		}
		if entries[0].key != "field_key" {
			return 2;
		}
		return 0;
	} catch {
		return 98;
	}
}

fn consume_bound() nothrow -> Int {
	try {
		val _ = throw_it();
		return 99;
	} catch BadReq(e) {
		// Form (b): bound receiver — DV temp is bound to a local whose
		// drop should be explicit at scope exit.
		val fields_dv = e.attrs["fields"];
		val entries = fields_dv.entries();
		if entries.len != 1 {
			return 3;
		}
		if entries[0].key != "field_key" {
			return 4;
		}
		return 0;
	} catch {
		return 98;
	}
}

pub fn main() nothrow -> Int {
	// Repeat each form so any per-invocation leak accumulates.
	val a1 = consume_rvalue();
	if a1 != 0 {
		return 10 + a1;
	}
	val a2 = consume_rvalue();
	if a2 != 0 {
		return 20 + a2;
	}
	val b1 = consume_bound();
	if b1 != 0 {
		return 30 + b1;
	}
	val b2 = consume_bound();
	if b2 != 0 {
		return 40 + b2;
	}
	return 0;
}

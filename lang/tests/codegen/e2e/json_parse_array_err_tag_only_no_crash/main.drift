module m;

import std.core as core;
import std.json as json;

fn run() -> Int {
	val t = "[1,\n2,\n]";
	match json.parse(&t) {
		core.Result::Ok(_) => { return 10; },
		core.Result::Err(e) => {
			if e.tag != "invalid-syntax" { return 11; }
			return 0;
		}
	}
}

fn main() nothrow -> Int {
	return try run() catch { 99 };
}

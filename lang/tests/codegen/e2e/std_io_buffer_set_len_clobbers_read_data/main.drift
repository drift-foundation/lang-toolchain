module m;
import std.io as io;
import std.mem as mem;
import lang.thread as thread;
import std.env as env;

pub fn main() nothrow -> Int {
	val path = env.drift_tmp_path("drift_e2e_set_len_clobber.bin");
	// O_WRONLY|O_CREAT|O_TRUNC = 1|64|512 = 577
	val wfd = thread.io_open(path, 577, 420);
	if wfd < 0 { return 1; }

	// Write known bytes [0x41, 0x5B, 0xCC, 0xDD]
	var wbuf = io.buffer(4);
	io.buffer_write(wbuf, 0, cast<Byte>(65));   // 0x41
	io.buffer_write(wbuf, 1, cast<Byte>(91));   // 0x5B (the MariaDB handshake byte)
	io.buffer_write(wbuf, 2, cast<Byte>(204));  // 0xCC
	io.buffer_write(wbuf, 3, cast<Byte>(221));  // 0xDD
	val wptr = io.buffer_ptr(wbuf);
	val wn = thread.io_write(wfd, wptr, 4);
	val _ = thread.io_close(wfd);
	if wn != 4 { return 2; }

	// Re-open for read
	val rfd = thread.io_open(path, 0, 0);  // O_RDONLY = 0
	if rfd < 0 { return 3; }

	// Read into fresh buffer — simulate TcpStream.read sequence:
	//   1. io_read into raw ptr
	//   2. buffer_set_len (THIS IS THE BUG PATH)
	var rbuf = io.buffer(16);
	val rptr = io.buffer_ptr_mut(rbuf);
	val n = thread.io_read(rfd, rptr, 16);
	val _ = thread.io_close(rfd);
	if n != 4 { return 4; }
	io.buffer_commit_read(rbuf, n);  // fixed: no zero-fill over io_read data

	// Assert byte fidelity at each index
	if io.buffer_read(rbuf, 0) != cast<Byte>(65) { return 10; }   // 0x41
	if io.buffer_read(rbuf, 1) != cast<Byte>(91) { return 11; }   // 0x5B
	if io.buffer_read(rbuf, 2) != cast<Byte>(204) { return 12; }  // 0xCC
	if io.buffer_read(rbuf, 3) != cast<Byte>(221) { return 13; }  // 0xDD

	return 0;
}

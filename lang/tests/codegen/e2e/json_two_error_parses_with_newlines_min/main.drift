module m;
import std.core as core;
import std.json as json;

fn run() -> Int {
  val t1 = "{\n\"a\":}\n";
  match json.parse(&t1) {
    core.Result::Ok(_) => { return 1; },
    core.Result::Err(e) => {
      if e.tag != "invalid-syntax" { return 2; }
    }
  }
  val t2 = "[1,\n2,\n]";
  match json.parse(&t2) {
    core.Result::Ok(_) => { return 3; },
    core.Result::Err(e) => {
      if e.tag != "invalid-syntax" { return 4; }
    }
  }
  return 0;
}

fn main() nothrow -> Int { return try run() catch { 99 }; }

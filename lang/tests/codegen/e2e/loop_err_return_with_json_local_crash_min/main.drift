module m;

import std.core as core;
import std.json as json;
import std.containers as c;

fn h() nothrow -> core.Result<String, json.JsonErrorData> {
  return core.Result::Err(json.JsonErrorData(tag = "bad", offset = 1, line = -1, col = -1, path = "", key = ""));
}

fn f() -> core.Result<json.JsonNode, json.JsonErrorData> {
  var fields = c.hash_map<type String, json.JsonNode>();
  while true {
    var key = "";
    match h() {
      core.Result::Err(e) => { return core.Result::Err(e); },
      core.Result::Ok(v) => { key = v; }
    }
    fields.insert(move key, json.JsonNode::Null());
    return core.Result::Ok(json.JsonNode::Object(move fields));
  }
  return core.Result::Err(json.JsonErrorData(tag = "x", offset = 0, line = -1, col = -1, path = "", key = ""));
}

fn run() -> Int {
  val _r = f();
  return 0;
}

pub fn main() nothrow -> Int { return try run() catch { 99 }; }

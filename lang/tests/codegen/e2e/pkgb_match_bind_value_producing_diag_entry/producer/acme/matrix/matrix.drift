module acme.matrix;

import std.core as core;

export { Box, produce };

// Generic variant exported from the producer package.  Consumer uses
// a value-producing match that returns the BOUND PAYLOAD through a
// helper fn return boundary — the exact shape of the LANGUAGE_BUG
// the match-bind matrix exposed and 0.27.198 fixed (two linked
// pieces: `_lower_owning_consume` for arm result + `VariantGetField`
// owned-tracking in string_arc).  This fixture pins both fixes
// against silent regression when the variant type is imported across
// a signed package boundary.
pub variant Box<T> {
	Payload(v: T),
	@tombstone Tombstone,
}

pub fn produce() nothrow -> Box<core.DiagnosticEntry> {
	val e: core.DiagnosticEntry = core.diagnostic_entry("k" + "ey", DiagnosticValue::String("v" + "alue"));
	return Box::Payload(v = e);
}

module m;

import std.concurrent as conc;
import std.core as core;
import std.core.arc as arc;
import lang.atomic as atomic;
import lang.thread as thread;

pub struct Sigs {
	pub started: conc.AtomicBool,
	/* Two-phase gate.  Worker sets `started`, then waits for `armed`
	 * with NO deadline (main may be starved before it cancels — the
	 * worker must keep holding the cb, not complete early, else
	 * `is_complete()`-after-cancel sees a stale completion).  Main sets
	 * `armed` immediately before `cancel()`; only then does the worker
	 * arm its monotonic deadline for the short post-arm hold. */
	pub armed: conc.AtomicBool,
	pub release: conc.AtomicBool,
	/* Set by the worker iff its post-arm busy-spin hit the deadline
	 * instead of observing `release`.  Main checks it and fails with a
	 * distinct code (5) so a deadline expiry is a VISIBLE failure,
	 * never a silent false pass. */
	pub timed_out: conc.AtomicBool
}

pub fn main() nothrow -> Int {
	var b = conc.executor_policy_builder();
	b.min_threads(1);
	b.max_threads(1);
	val cb_exec = b.build_executor();

	val sigs: arc.Arc<Sigs> = arc.arc(Sigs(
		started = conc.atomic_bool(false),
		armed = conc.atomic_bool(false),
		release = conc.atomic_bool(false),
		timed_out = conc.atomic_bool(false)
	));
	val sigs_cb = sigs.clone();

	val cb: core.Callback0<Int> = core.callback0(
		| | captures(move sigs_cb) => {
			atomic.atomic_store_bool(sigs_cb.get().started, true, 2);
			/* Phase 1: wait until main arms us (about to cancel) or
			 * releases us early on a failure path.  NO deadline — main may
			 * be starved by the suite before it cancels, and the worker
			 * must keep holding the cb (not complete) until then, or the
			 * `is_complete()`-after-cancel assertion sees a stale early
			 * completion. */
			while !atomic.atomic_load_bool(sigs_cb.get().armed, 1) and !atomic.atomic_load_bool(sigs_cb.get().release, 1) {
			}
			/* Phase 2: armed — hold the cb across cancel(),
			 * cancellation-insensitive (no park/yield) but hard-capped by a
			 * monotonic deadline that starts NOW (not at spawn).  On expiry
			 * record `timed_out` so main fails with a distinct code (5)
			 * instead of a false pass / runner timeout. */
			if atomic.atomic_load_bool(sigs_cb.get().armed, 1) {
				val cb_deadline = thread.now_ms() + 20000;
				while !atomic.atomic_load_bool(sigs_cb.get().release, 1) {
					if thread.now_ms() > cb_deadline {
						atomic.atomic_store_bool(sigs_cb.get().timed_out, true, 2);
						break;
					}
				}
			}
			return 42;
		}
	);
	var res = conc.spawn_on(cb_exec, move cb);
	match res {
		Ok(v) => {
			var vt = move v;

			var spins: Int = 0;
			while !atomic.atomic_load_bool(sigs.get().started, 1) {
				val _ = conc.sleep(conc.Duration(millis = 5));
				spins = spins + 1;
				if spins > 200 {
					atomic.atomic_store_bool(sigs.get().release, true, 2);
					var _j = vt.join();
					return 82;
				}
			}

			/* Arm the worker (start its deadline) immediately before the
			 * tested cancel, so the deadline cannot expire while main is
			 * starved BEFORE the cancel. */
			atomic.atomic_store_bool(sigs.get().armed, true, 2);

			vt.cancel();

			/* cancellation request alone is not completion */
			if vt.is_complete() {
				atomic.atomic_store_bool(sigs.get().release, true, 2);
				var _j = vt.join();
				/* Distinguish a real "cancel completed it" bug (1) from a
				 * worker-deadline expiry under suite starvation (5). */
				if atomic.atomic_load_bool(sigs.get().timed_out, 1) { return 5; }
				return 1;
			}

			atomic.atomic_store_bool(sigs.get().release, true, 2);

			var spins2: Int = 0;
			while !vt.is_complete() {
				val _ = conc.sleep(conc.Duration(millis = 5));
				spins2 = spins2 + 1;
				if spins2 > 200 { return 83; }
			}

			if atomic.atomic_load_bool(sigs.get().timed_out, 1) { return 5; }

			match vt.join() {
				Err(e) => {
					if e.kind == conc.CONCURRENCY_KIND_CANCELLED { return 0; }
					return 2;
				},
				Ok(_) => { return 3; },
				default => { return 4; }
			}
		},
		Err(_) => { return 80; },
		default => { return 81; }
	}
}

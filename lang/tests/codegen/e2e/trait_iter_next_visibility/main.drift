module m;

import std.iter as iter;

use trait iter.Iterable;
use trait iter.SinglePassIterator;

fn main() nothrow -> Int {
	var arr = [10, 20, 30];
	var it = arr.iter();
	var count = 0;
	while true {
		match it.next() {
			Some(_) => { count = count + 1; },
			default => { break; }
		}
	}
	if count != 3 {
		return 1;
	}
	return 0;
}

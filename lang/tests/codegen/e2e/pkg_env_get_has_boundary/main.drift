module m;

import std.env as env;

fn main() nothrow -> Int {
	// env.get: set variable returns Some with non-empty value.
	match env.get("HOME") {
		Optional::Some(v) => {
			if v.byte_length() == 0 {
				return 1;
			}
		},
		Optional::None() => {
			return 2;
		}
	}
	// env.get: unset variable returns None.
	match env.get("DRIFT_PKG_TEST_UNSET_XYZ_99") {
		Optional::Some(_v) => {
			return 3;
		},
		Optional::None() => { }
	}
	// env.has: set variable returns true.
	if !env.has("HOME") {
		return 4;
	}
	// env.has: unset variable returns false.
	if env.has("DRIFT_PKG_TEST_UNSET_XYZ_99") {
		return 5;
	}
	return 0;
}

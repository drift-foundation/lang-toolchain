module main;

import std.core as core;

fn str_eq(a: &String, b: &String) nothrow -> Bool {
	val an = a.byte_length();
	val bn = b.byte_length();
	if an != bn { return false; }
	var i = 0;
	while i < an {
		if core.string_byte_at(a, i) != core.string_byte_at(b, i) { return false; }
		i = i + 1;
	}
	return true;
}

fn take_owned(s: String) nothrow -> Int {
	return s.byte_length();
}

fn clone_from_borrow(s: &String) nothrow -> String {
	// This is the canonical "get an owned String from &String" path.
	// It should be a cheap ARC retain, not a byte-by-byte copy.
	return s.clone();
}

pub fn main() nothrow -> Int {
	val original = "hello world";

	// Clone from borrow produces equal string
	val cloned = clone_from_borrow(original);
	if !str_eq(cloned, original) { return 1; }

	// Clone can be passed to a function that consumes ownership
	val cloned2 = original.clone();
	val len = take_owned(move cloned2);
	if len != 11 { return 2; }

	// Original is still valid after clone was consumed
	if original.byte_length() != 11 { return 3; }

	// Clone of empty string
	val empty = "";
	val cloned_empty = empty.clone();
	val e = "";
	if !str_eq(cloned_empty, e) { return 4; }

	// Multiple clones from same source
	val c1 = original.clone();
	val c2 = original.clone();
	if !str_eq(c1, original) { return 5; }
	if !str_eq(c2, original) { return 6; }

	return 0;
}

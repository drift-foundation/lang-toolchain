module m;

import std.core as core;
import std.json as json;

fn run() -> Int {
	val t1 = "{\n\"a\":}\n";
	match json.parse(&t1) {
		core.Result::Ok(_) => { return 10; },
		core.Result::Err(e) => {
			if e.tag != "invalid-syntax" { return 11; }
			if e.offset != 6 { return 12; }
			if e.line != 2 { return 13; }
			if e.col != 5 { return 14; }
		}
	}
	val t2 = "[1,\n2,\n]";
	match json.parse(&t2) {
		core.Result::Ok(_) => { return 20; },
		core.Result::Err(e) => {
			if e.tag != "invalid-syntax" { return 21; }
			if e.offset != 7 { return 22; }
			if e.line != 3 { return 23; }
			if e.col != 1 { return 24; }
		}
	}
	return 0;
}

fn main() nothrow -> Int {
	return try run() catch { 99 };
}

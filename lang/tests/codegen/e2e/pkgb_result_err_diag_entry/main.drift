// Package-boundary ownership: consume `core.Result<Int,
// core.DiagnosticEntry>` returned by a signed-producer fn and match
// its Err arm.  Targets:
//   - Result Err-side payload ownership transfer across the boundary
//   - DV-bearing DiagnosticEntry payload round-trip (copy_status /
//     is_bitcopy / needs_drop) after package linking

module main;

import acme.matrix as m;
import std.core as core;

pub fn main() nothrow -> Int {
	val r: core.Result<Int, core.DiagnosticEntry> = m.produce_err();
	match r {
		core.Result::Ok(_) => { return 3; },
		core.Result::Err(e) => {
			if e.key.byte_length() != 3 { return 1; }
		},
	}
	return 0;
}

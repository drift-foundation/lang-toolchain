module acme.matrix;

import std.core as core;

export { produce_err };

// Producer function returning `core.Result<Int, core.DiagnosticEntry>`
// — the Err variant carries a DV-bearing DiagnosticEntry.  Consumer
// matches the Err arm.  Complements `pkgb_result_ok_string_heap` by
// exercising the Err-side payload ownership transfer and a non-String
// Copy-non-bitcopy type through the boundary.
pub fn produce_err() nothrow -> core.Result<Int, core.DiagnosticEntry> {
	val e: core.DiagnosticEntry = core.diagnostic_entry("k" + "ey", DiagnosticValue::String("v" + "alue"));
	return core.Result::Err(e);
}

module m;

import std.core as core;
import std.time as time;

fn parse_or_fail(s: String) -> core.Result<time.UtcTimestamp, Int> {
	match time.parse_iso8601_utc(s) {
		core.Result::Ok(ts) => { return core.Result::Ok(move ts); },
		core.Result::Err(_) => { return core.Result::Err(1); }
	}
}

fn expect_canon(s: String, want: String) -> Int {
	match parse_or_fail(s) {
		core.Result::Ok(ts) => {
			if time.format_iso8601_utc(ts) != want {
				return 1;
			}
			return 0;
		},
		core.Result::Err(_) => { return 2; }
	}
}

fn expect_delta(a: String, b: String, want: Int) -> Int {
	match parse_or_fail(a) {
		core.Result::Ok(ta) => {
			match parse_or_fail(b) {
				core.Result::Ok(tb) => {
					if time.duration_micros_between(ta, tb) != want {
						return 1;
					}
					return 0;
				},
				core.Result::Err(_) => { return 2; }
			}
		},
		core.Result::Err(_) => { return 3; }
	}
}

fn run() -> Int {
	if expect_canon("1969-12-31T23:59:59.999000Z", "1969-12-31T23:59:59.999000Z") != 0 { return 10; }
	if expect_canon("1970-01-01T00:00:00.000000Z", "1970-01-01T00:00:00.000000Z") != 0 { return 11; }
	if expect_canon("1969-12-31T00:00:00.000000Z", "1969-12-31T00:00:00.000000Z") != 0 { return 12; }
	if expect_delta("1969-12-31T23:59:59.999999Z", "1970-01-01T00:00:00.000000Z", 1) != 0 { return 13; }
	if expect_delta("1970-01-01T00:00:00.000000Z", "1969-12-31T23:59:59.999999Z", -1) != 0 { return 14; }
	if expect_delta("1969-12-31T00:00:00.000000Z", "1970-01-01T00:00:00.000000Z", 86400000000) != 0 { return 15; }
	return 0;
}

pub fn main() nothrow -> Int {
	return try run() catch { 99 };
}

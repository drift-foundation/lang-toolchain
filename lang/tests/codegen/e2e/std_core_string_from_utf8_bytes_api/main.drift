module m;

import std.core as core;
import std.io as io;

pub fn main() nothrow -> Int {
	var b = io.buffer(5);
	io.buffer_write(&mut b, 0, cast<Byte>(100));
	io.buffer_write(&mut b, 1, cast<Byte>(114));
	io.buffer_write(&mut b, 2, cast<Byte>(105));
	io.buffer_write(&mut b, 3, cast<Byte>(102));
	io.buffer_write(&mut b, 4, cast<Byte>(116));
	val s = core.string_from_utf8_bytes(io.buffer_ptr(&b), io.buffer_len(&b));
	if s.byte_length() != 5 { return 2; }
	if core.string_byte_at(&s, 0) != cast<Byte>(100) { return 3; }
	if core.string_byte_at(&s, 4) != cast<Byte>(116) { return 4; }
	return 0;
}

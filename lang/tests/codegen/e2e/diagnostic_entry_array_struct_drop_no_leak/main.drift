module m;

import std.core as core;

// K28-aftermath Leak B regression.
//
// A plain struct owns `fields: Array<core.DiagnosticEntry>`.  Each
// `DiagnosticEntry` owns `key: String` and `value: DiagnosticValue`.  When
// the struct drops at scope exit, the drop chain must traverse:
//   RestError drop
//     → Array<DiagnosticEntry> drop
//       → for each element: DiagnosticEntry struct drop
//         → drift_string_release(entry.key)
//         → drift_dv_release(entry.value)
//
// If any link treats the array element as a bitcopy / shallow move (even
// though DiagnosticEntry is Copy in the ARC sense because String and
// DiagnosticValue are refcount-Copy), the element's inner String/DV
// ownership is silently dropped and the heap buffers leak.
//
// Heap-allocated keys are used so the leak is observable under
// DRIFT_MEMCHECK=1.  Existing regressions
// (diagnostic_entry_array_take, diagnostic_entry_array_field_read) use
// string literals which carry DRIFT_STRING_FLAG_STATIC and release to
// no-op, masking this path.

pub struct RestError {
	pub status: Int,
	pub fields: Array<core.DiagnosticEntry>,
}

fn heap_key(suffix: String) nothrow -> String {
	return "field_" + suffix;
}

fn make_error() nothrow -> RestError {
	var fields: Array<core.DiagnosticEntry> = [];
	fields.push(core.diagnostic_entry(heap_key("a"), DiagnosticValue::String("required")));
	fields.push(core.diagnostic_entry(heap_key("b"), DiagnosticValue::Int(42)));
	return RestError(status = 400, fields = move fields);
}

fn once(seed: Int) nothrow -> Int {
	val err = make_error();
	// Read a field so the push path isn't dead-code-eliminated.
	if err.fields.len != 2 {
		return 1;
	}
	if err.fields[0].key != "field_a" {
		return 2;
	}
	// Struct drops at end of scope; heap keys must be released.
	return seed;
}

// Variant: same shape but wrapped in a Result::Err, mirroring the
// downstream-facing Result<T, RestError> return shape.  If array drop is
// the only broken link, this should leak identically to `once`.  If the
// Result wrapping adds its own broken drop, the delta will show up.
fn once_in_result(seed: Int) nothrow -> Int {
	val r: core.Result<Int, RestError> = core.Result::Err(make_error());
	match r {
		Err(e) => {
			if e.fields.len != 2 {
				return 11;
			}
			if e.fields[0].key != "field_a" {
				return 12;
			}
			return seed;
		},
		default => {
			return 13;
		}
	}
}

pub fn main() nothrow -> Int {
	// Repeat each form so any per-invocation leak accumulates.
	var i = 0;
	while i < 3 {
		val r = once(0);
		if r != 0 {
			return 100 + i;
		}
		val s = once_in_result(0);
		if s != 0 {
			return 200 + i;
		}
		i = i + 1;
	}
	return 0;
}

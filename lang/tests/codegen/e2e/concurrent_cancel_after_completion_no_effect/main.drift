module main;

import std.concurrent as conc;

pub fn main() nothrow -> Int {
	var t = conc.spawn(| | => { return 7; });
	var res1 = t.join();
	match res1 {
		Ok(v) => { if v != 7 { return 1; } },
		Err(_e) => { return 2; },
		default => { return 2; },
	}
	t.cancel();
	var res2 = t.join();
		match res2 {
		Err(err) => {
			if err.kind == conc.CONCURRENCY_KIND_CLOSED { return 0; }
			return 3;
		},
		Ok(_v) => { return 4; },
		default => { return 4; },
	}
}

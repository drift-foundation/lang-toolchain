module m;

import std.core as core;

// K28 review regression — DV intrinsic method on a projected place.
//
// The DV-method-receiver heuristic (`_dv_method_recv_is_rvalue`)
// excludes `HPlaceExpr` entirely (including projected ones like
// `holder.dv.entries()`): field projection lowers to `extractvalue`
// against the owning struct, yielding a shallow alias of that struct's
// storage rather than an independently-owned DV temp.  Emitting a MIR
// `DropValue` after the DV op would release storage that the owning
// local still references and then re-release at scope drop — a
// double-free.  An earlier draft of the heuristic did treat projected
// places as rvalue, which caused SIGSEGVs in this shape; see
// `hir_to_mir.py::_DV_RVALUE_RECV_HEXPRS` for the current
// allow-list.
//
// This regression pins direct-projection-on-owned-local through three
// DV intrinsic methods:
//   - `holder.dv.entries()`
//   - `holder.dv.len()`
//   - `holder.dv.get("k_one")`
// Coverage for projection-through-reference (e.g.
// `(&holder).dv.entries()`) is deliberately out of scope for this
// fixture and can be added when Drift supports that shape in an
// exercised code path.
//
// Heap keys inside the DV::Object make any missing drop observable
// under DRIFT_MEMCHECK=1; the double-free path crashes even in
// plain mode.

pub struct Holder {
	pub dv: DiagnosticValue,
}

fn make_dv() nothrow -> DiagnosticValue {
	return DiagnosticValue::Object([
		core.diagnostic_entry("k" + "_one", DiagnosticValue::String("v1")),
		core.diagnostic_entry("k" + "_two", DiagnosticValue::Int(42))
	]);
}

fn read_via_owned_local() nothrow -> Int {
	val h = Holder(dv = make_dv());
	val entries = h.dv.entries();
	if entries.len != 2 {
		return 1;
	}
	if entries[0].key != "k_one" {
		return 2;
	}
	// h drops at scope end; if `h.dv.entries()` lowering had emitted a
	// DropValue on the projected DV value, h's drop would re-release
	// the same storage → UAF / double-free.
	return 0;
}

fn read_via_owned_local_len() nothrow -> Int {
	// Same shape with `len()` to cover a different DV intrinsic.
	val h = Holder(dv = make_dv());
	val n = h.dv.len();
	if n != 2 {
		return 11;
	}
	return 0;
}

fn read_via_owned_local_get() nothrow -> Int {
	val h = Holder(dv = make_dv());
	val v = h.dv.get("k_one");
	match v {
		Some(dv) => {
			match dv.as_string() {
				Some(s) => {
					if s != "v1" {
						return 21;
					}
				},
				None => { return 22; },
			}
		},
		None => { return 23; },
	}
	return 0;
}

pub fn main() nothrow -> Int {
	val r1 = read_via_owned_local();
	if r1 != 0 {
		return 100 + r1;
	}
	val r2 = read_via_owned_local_len();
	if r2 != 0 {
		return 200 + r2;
	}
	val r3 = read_via_owned_local_get();
	if r3 != 0 {
		return 300 + r3;
	}
	// Repeat to make per-invocation issues accumulate.
	val r4 = read_via_owned_local();
	if r4 != 0 {
		return 400 + r4;
	}
	return 0;
}

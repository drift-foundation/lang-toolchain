module m

import std.core as core;

struct E {
  tag: String,
  offset: Int,
  line: Int,
  col: Int,
  path: String,
  key: String
}

fn fail(tag: String) nothrow -> core.Result<Int, E> {
  return core.Result::Err(E(tag = tag, offset = -1, line = -1, col = -1, path = "", key = ""));
}

fn run() -> Int {
  match fail("a") {
    core.Result::Ok(_) => { return 1; },
    core.Result::Err(_e) => { }
  }
  match fail("b") {
    core.Result::Ok(_) => { return 2; },
    core.Result::Err(_e2) => { }
  }
  return 0;
}

fn main() nothrow -> Int { return try run() catch { 99 }; }

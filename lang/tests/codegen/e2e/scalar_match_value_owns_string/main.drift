// Value-position scalar (Int) match whose arms produce OWNING heap Strings,
// lowered through SwitchTerminator.  A missed cleanup/successor edge on the
// switch would leak the selected String — this is the decisive memcheck test
// for the switch lowering + the central CFG-successor migration.
module m;

pub fn label(n: Int) nothrow -> String {
	val s = match n {
		0 => { "zero" + "!" },
		1 => { "one" + "!" },
		2 => { "two" + "!" },
		default => { "many" + "!" },
	};
	return s;
}

pub fn main() nothrow -> Int {
	val a = label(0);
	val b = label(1);
	val c = label(2);
	val d = label(9);
	// "zero!"(5) + "one!"(4) + "two!"(4) + "many!"(5) = 18; 18 - 13 = 5
	return a.byte_length() + b.byte_length() + c.byte_length() + d.byte_length() - 13;
}

module m;

import std.containers as c;
import std.iter as iter;

use trait iter.Iterable;
use trait iter.SinglePassIterator;

fn main() nothrow -> Int {
	// Exercise nothrow method wrappers with generic return types across
	// the package boundary.  When the method's return TypeId goes through
	// FORWARD_NOMINAL canonicalization after FnInfo creation, the ok-type
	// in the wrapper's FnResult must match between FnInfo and TypeEnv.

	// HashMap via literal: insert returns Optional<V>
	var map: c.HashMap<String, Int> = {"a": 1, "b": 2};

	// HashMap: remove returns Optional<V> — nothrow method with generic return
	match map.remove("a") {
		Some(v) => {
			if v != 1 { return 1; }
		},
		default => { return 2; }
	}

	// Array iter: exercises wrapper for iter/next with Optional<&T> return
	var arr = [10, 20, 30];
	var it = arr.iter();
	var count = 0;
	while true {
		match it.next() {
			Some(_) => { count = count + 1; },
			default => { break; }
		}
	}
	if count != 3 { return 3; }

	// HashMap: len() — nothrow method with primitive return
	if map.len() != 1 { return 4; }

	return 0;
}

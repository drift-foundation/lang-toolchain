module main;

import std.core as core;
import std.text as text;

fn str_eq(a: &String, b: &String) nothrow -> Bool {
	val an = a.byte_length();
	val bn = b.byte_length();
	if an != bn { return false; }
	var i = 0;
	while i < an {
		if core.string_byte_at(a, i) != core.string_byte_at(b, i) { return false; }
		i = i + 1;
	}
	return true;
}


fn main() nothrow -> Int {
	val r = text.pad_end(&"hi", 5, cast<Byte>(46));
	val e = "hi...";
	if !str_eq(&r, &e) { return 1; }
	// Already wide enough
	val r2 = text.pad_end(&"hello", 3, cast<Byte>(46));
	val e2 = "hello";
	if !str_eq(&r2, &e2) { return 2; }
	// Empty string
	val r3 = text.pad_end(&"", 2, cast<Byte>(120));
	val e3 = "xx";
	if !str_eq(&r3, &e3) { return 3; }

	return 0;
}

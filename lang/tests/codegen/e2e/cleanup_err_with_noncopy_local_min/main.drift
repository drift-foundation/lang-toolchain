module m

import std.core as core;
import std.containers as c;

struct E {
  tag: String,
  path: String,
  key: String
}

fn mk_err() nothrow -> core.Result<String, E> {
  return core.Result::Err(E(tag = "bad", path = "", key = ""));
}

fn f() -> core.Result<Int, E> {
  var hm = c.hash_map<type String, E>();
  match mk_err() {
    core.Result::Err(e) => { return core.Result::Err(e); },
    core.Result::Ok(_v) => { }
  }
  if hm.len() == 999 { return core.Result::Ok(1); }
  return core.Result::Ok(0);
}

fn run() -> Int {
  match f() {
    core.Result::Ok(_) => { return 1; },
    core.Result::Err(_e) => { }
  }
  return 0;
}

fn main() nothrow -> Int { return try run() catch { 99 }; }

module m

import std.concurrent as conc;
import lang.thread as thread;

const ITERS: Int = 3000;

pub fn main() nothrow -> Int {
	var t = conc.spawn(| | => {
		var i = 0;
		while i < ITERS {
			thread.vt_park_until(1);
			i = i + 1;
		}
		return 0;
	});
	var r = t.join();
	match r {
		Ok(v) => { return v; },
		Err(_) => { return 1; },
		default => { return 2; }
	}
}

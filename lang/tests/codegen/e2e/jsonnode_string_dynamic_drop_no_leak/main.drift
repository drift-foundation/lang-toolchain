module m;

import std.core as core;
import std.format as format;
import std.json as json;

fn run() -> Int {
	var i = 0;
	while i < 1200 {
		val s = "v-" + format.format_int(i);
		val n = json.JsonNode::String(move s);
		core.drop_value<type json.JsonNode>(move n);
		i = i + 1;
	}
	return 0;
}

pub fn main() nothrow -> Int {
	return try run() catch { 99 };
}

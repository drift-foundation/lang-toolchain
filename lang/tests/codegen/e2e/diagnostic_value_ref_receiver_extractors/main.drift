module m

import std.core as core;

fn check_ref(dv: &DiagnosticValue) nothrow -> Int {
	match dv.as_bool() {
		Some(v) => {
			if not v {
				return 1;
			}
		},
		None => {
			return 2;
		}
	}
	return 0;
}

fn main() nothrow -> Int {
	val dv = DiagnosticValue::Bool(true);
	if check_ref(&dv) != 0 {
		return 3;
	}
	return 0;
}

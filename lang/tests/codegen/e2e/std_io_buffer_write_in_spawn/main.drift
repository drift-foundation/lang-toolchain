module m;

import std.concurrent as conc;
import std.core as core;
import std.io as io;

pub fn main() nothrow -> Int {
	var t = conc.spawn(| | => {
		var buf = io.buffer(1);
		io.buffer_write(&mut buf, 0, cast<Byte>(65));
		return 7;
	});
	var r = t.join();
	match r {
		Ok(v) => {
			if v == 7 {
				return 0;
			}
			return 1;
		},
		Err(_) => { return 2; },
		default => { return 3; }
	}
}

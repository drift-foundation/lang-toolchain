module m;

struct Node { text: String, children: Array<Node>, }

fn na() nothrow -> Node {
	var kids: Array<Node> = [];
	return Node(text = "a" + "", children = move kids);
}
fn nb() nothrow -> Node {
	var kids: Array<Node> = [];
	return Node(text = "b" + "", children = move kids);
}
fn peek(n: &Node) nothrow -> Int { return n.children.len(); }

pub fn main() nothrow -> Int {
	// Whole-value shared borrow of a ternary rvalue: same unsound class
	// as the field-projection form; rejected bind-first upstream.
	val cond = true;
	val c = peek(cond ? na() : nb());
	return c;
}

module m;

import std.core as core;
import std.io as io;
import std.concurrent as conc;
import std.env as env;

pub fn main() nothrow -> Int {
	var buf = io.buffer(4);
	io.buffer_write(&mut buf, 0, cast<Byte>(65));
	io.buffer_write(&mut buf, 2, cast<Byte>(66));
	if io.buffer_len(&buf) != 3 {
		return 1;
	}
	val t = conc.Duration(millis = 1000);
	var w = io.file_builder(env.drift_tmp_path("drift_std_io_buffer_len_updates.bin")).read(false).write(true).create(true).truncate(true).mode(io.FILE_MODE_DEFAULT).timeout(t).build();
	match w {
		Ok(v) => {
			val wres = v.write(&buf);
			match wres {
				Ok(_) => { },
				default => { return 2; }
			}
			val c = v.close();
			match c {
				Ok(_) => { },
				default => { return 3; }
			}
		},
		default => { return 4; }
	}
	var r = io.file_builder(env.drift_tmp_path("drift_std_io_buffer_len_updates.bin")).read(true).write(false).timeout(t).build();
	match r {
		Ok(v2) => {
			var buf2 = io.buffer(10);
			val rres = v2.read(&mut buf2);
			val n = match rres {
				Ok(v) => { v },
				default => { -1 }
			};
			if n < 0 { return 5; }
			if io.buffer_len(&buf2) != n {
				return 6;
			}
			val c2 = v2.close();
			match c2 {
				Ok(_) => { },
				default => { return 7; }
			}
			return 0;
		},
		default => { return 8; }
	}
}

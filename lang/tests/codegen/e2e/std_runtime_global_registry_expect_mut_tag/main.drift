module main;

import std.runtime as rt;

fn run() -> Int {
	val reg = rt.global_registry();
	try {
		val _ = rt.expect_mut<type Int>(reg, "missing-int-mut");
		return 1;
	} catch rt:RegistryError(e) {
		// Slice 7a: typed catch projection on synthesized field.
		if e.tag != "missing-int-mut" {
			return 2;
		}
		return 0;
	} catch {
		return 4;
	}
}

fn main() nothrow -> Int {
	return try run() catch { 99 };
}

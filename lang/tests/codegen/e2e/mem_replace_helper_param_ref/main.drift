module main;

// Regression: mem.replace must accept a function parameter of type
// &mut T as its first argument. The customer's report flagged this
// shape (factoring out the take logic into a helper) as one of the
// blocking forms.

import std.core as core;
import std.mem as mem;
import std.console as cons;

pub struct Resource { pub id: Int }
pub struct Box { pub x: Optional<Resource> }

implement core.Destructible for Resource {
	pub fn destroy(var self: Resource) nothrow -> Void { return; }
}

implement core.Destructible for Box {
	pub fn destroy(var self: Box) nothrow -> Void { return; }
}

fn _none_resource() nothrow -> Optional<Resource> {
	return Optional<Resource>::None();
}

// Helper that takes a &mut Optional<Resource> parameter. The parameter
// `slot` is a named ref — the bug rejected this even though `slot`'s
// type IS &mut Optional<Resource>.
fn take_via_helper(slot: &mut Optional<Resource>) nothrow -> Optional<Resource> {
	return mem.replace<type Optional<Resource> >(slot, _none_resource());
}

pub fn main() nothrow -> Int {
	var b = Box(x = Optional<Resource>::Some(Resource(id = 77)));

	val taken = take_via_helper(b.x);
	match taken {
		Some(r) => {
			if r.id != 77 {
				cons.eprintln("FAIL: wrong id");
				return 1;
			}
		},
		None => {
			cons.eprintln("FAIL: expected Some");
			return 2;
		}
	}

	// Slot must now be None.
	match b.x {
		Some(r) => {
			cons.eprintln("FAIL: slot should be None");
			return 3;
		},
		None => { }
	}

	// Second take through the helper must return None.
	val taken_again = take_via_helper(b.x);
	match taken_again {
		Some(r) => {
			cons.eprintln("FAIL: second take should be None");
			return 4;
		},
		None => { }
	}

	cons.println("ok");
	return 0;
}

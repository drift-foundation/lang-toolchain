module main;

import std.core as core;
import std.text as text;

fn str_eq(a: &String, b: &String) nothrow -> Bool {
	val an = a.byte_length();
	val bn = b.byte_length();
	if an != bn { return false; }
	var i = 0;
	while i < an {
		if core.string_byte_at(a, i) != core.string_byte_at(b, i) { return false; }
		i = i + 1;
	}
	return true;
}


pub fn main() nothrow -> Int {
	var sb = text.string_builder(8);
	// Builder starts empty
	if text.sb_len(&sb) != 0 { return 1; }
	// Minimum capacity is 16 even if requested less
	text.sb_append_string(&mut sb, "hello");
	if text.sb_len(&sb) != 5 { return 2; }
	val s = text.sb_build(&mut sb);
	val e = "hello";
	if !str_eq(&s, &e) { return 3; }

	return 0;
}

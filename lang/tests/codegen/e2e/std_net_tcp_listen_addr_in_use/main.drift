module m;

import std.net as net;
import std.concurrent as conc;

pub fn main() nothrow -> Int {
	var addr = net.socket_addr("127.0.0.1", 0);
	val t = conc.Duration(millis = 1000);
	val lr = net.listen(&addr, t);
	match lr {
		Ok(l) => {
			val port = l.test_local_port();
			var addr2 = net.socket_addr("127.0.0.1", port);
			val lr2 = net.listen(&addr2, t);
			match lr2 {
				Ok(_l2) => { return 2; },
				Err(e) => {
					var code = 202;
					if e.kind == net.NET_ERROR_KIND_ERRNO { code = e.code; }
					if e.kind == net.NET_ERROR_KIND_WOULD_BLOCK { code = 201; }
					if code == 98 { return 0; }
					return code;
				},
				default => { return 203; }
			}
		},
		Err(_) => { return 1; },
		default => { return 3; }
	}
}

module main;
import std.json as json;
import std.core as core;

// Ordered (UTF-8 key-sorted) encoding as a deep-equality proxy for JsonNode.
fn ord(node: &json.JsonNode) nothrow -> String {
	return json.encode_with_config(node, &json.JsonConfig(key_order = json.JsonKeyOrder::OrderedLexUtf8()));
}

// Assert parse_located(x,cfg).root encodes identically to parse_with_config(x,cfg)
// — the sidecar must never change duplicate resolution or values.
fn check(src: String, cfg: &json.JsonParseConfig) nothrow -> Bool {
	var a_ok = false; var a_enc = "";
	match json.parse_with_config(&src, cfg) {
		core.Result::Ok(a) => { a_ok = true; a_enc = ord(&a); },
		core.Result::Err(ea) => { a_enc = "ERR:" + ea.tag; }
	}
	var b_enc = "";
	match json.parse_located(&src, cfg) {
		core.Result::Ok(doc) => { b_enc = ord(doc.root()); },
		core.Result::Err(eb) => { b_enc = "ERR:" + eb.tag; }
	}
	return a_enc == b_enc;
}

pub fn main() nothrow -> Int {
	val perm = json.permissive();   // KeepLast
	val st = json.strict();          // Reject dups
	// KeepFirst cfg
	var kfb = json.parse_config_builder();
	kfb.duplicate_keys(json.DuplicateKeyPolicy::KeepFirst());
	var kf = json.permissive();
	match kfb.build() { core.Result::Ok(c) => { kf = c; }, core.Result::Err(_) => { return 1; } }

	// corpus: scalars, arrays, nesting, duplicate keys, unicode keys
	var corpus: Array<String> = [
		"42",
		"[1,2,[3,[4]]]",
		"{\"b\":1,\"a\":2,\"c\":[true,null,\"x\"]}",
		"{\"a\":1,\"a\":2,\"a\":3}",
		"{\"k\":{\"z\":9,\"a\":8},\"j\":[{\"q\":1},{\"q\":2}]}",
		"{\"é\":1,\"a\":2}",
		"{\"dup\":1,\"x\":5,\"dup\":2}"
	];
	var i = 0;
	while i < corpus.len {
		val x = corpus[i];
		if not check(x, &perm) { return 10 + i; }
		if not check(x, &kf) { return 30 + i; }
		if not check(x, &st) { return 50 + i; }
		i = i + 1;
	}
	return 0;
}

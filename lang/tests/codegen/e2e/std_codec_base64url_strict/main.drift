module m;

import std.core as core;
import std.codec as codec;

fn _require_err(s: String, tag: String, off: Int, code: Int) nothrow -> Int {
	val result = codec.base64url_decode(s);
	match result {
		core.Result::Ok(vals) => { return code; },
		core.Result::Err(e) => {
			if e.tag != tag { return code + 1; }
			if e.offset != off { return code + 2; }
		}
	}
	return 0;
}

fn _require_roundtrip(src: &Array<Byte>, code: Int) nothrow -> Int {
	val encoded = codec.base64url_encode(src);
	val result = codec.base64url_decode(encoded);
	match result {
		core.Result::Err(e) => { return code; },
		core.Result::Ok(vals) => {
			if vals.len != src.len { return code + 1; }
			val a = codec.hex_encode(vals);
			val b = codec.hex_encode(src);
			if a != b { return code + 2; }
		}
	}
	return 0;
}

pub fn main() nothrow -> Int {
	var empty: Array<Byte> = [];
	val enc0 = codec.base64url_encode(empty);
	if enc0 != "" {
		return 1;
	}

	var one: Array<Byte> = [];
	one.push(cast<Byte>(0));
	val enc1 = codec.base64url_encode(one);
	if enc1 != "AA" {
		return 2;
	}

	var two: Array<Byte> = [];
	two.push(cast<Byte>(0));
	two.push(cast<Byte>(0));
	val enc2 = codec.base64url_encode(two);
	if enc2 != "AAA" {
		return 3;
	}

	var three: Array<Byte> = [];
	three.push(cast<Byte>(0));
	three.push(cast<Byte>(0));
	three.push(cast<Byte>(0));
	val enc3 = codec.base64url_encode(three);
	if enc3 != "AAAA" {
		return 4;
	}

	var src: Array<Byte> = [];
	src.push(cast<Byte>(251));
	src.push(cast<Byte>(239));
	src.push(cast<Byte>(190));
	val enc_url = codec.base64url_encode(src);
	if enc_url != "----" {
		return 5;
	}

	var r = _require_roundtrip(src, 6);
	if r != 0 { return r; }

	r = _require_roundtrip(one, 10);
	if r != 0 { return r; }

	r = _require_roundtrip(two, 14);
	if r != 0 { return r; }

	r = _require_roundtrip(three, 18);
	if r != 0 { return r; }

	val res_empty = codec.base64url_decode("");
	match res_empty {
		core.Result::Err(e) => { return 22; },
		core.Result::Ok(vals) => {
			if vals.len != 0 { return 23; }
		}
	}

	r = _require_err("A", "base64url-invalid-length", 1, 30);
	if r != 0 { return r; }

	r = _require_err("AAAAA", "base64url-invalid-length", 5, 40);
	if r != 0 { return r; }

	r = _require_err("AA==", "base64url-padding-rejected", 2, 50);
	if r != 0 { return r; }

	r = _require_err("AA=", "base64url-padding-rejected", 2, 60);
	if r != 0 { return r; }

	r = _require_err("A=AA", "base64url-padding-rejected", 1, 65);
	if r != 0 { return r; }

	r = _require_err("A!AA", "base64url-invalid-char", 1, 70);
	if r != 0 { return r; }

	r = _require_err("AA+A", "base64url-invalid-char", 2, 80);
	if r != 0 { return r; }

	r = _require_err("AA/A", "base64url-invalid-char", 2, 90);
	if r != 0 { return r; }

	r = _require_err("AB", "base64url-non-canonical", 1, 100);
	if r != 0 { return r; }

	r = _require_err("AAB", "base64url-non-canonical", 2, 110);
	if r != 0 { return r; }

	var big: Array<Byte> = [];
	var bi = 0;
	while bi < 256 {
		big.push(cast<Byte>(bi));
		bi = bi + 1;
	}
	r = _require_roundtrip(big, 120);
	if r != 0 { return r; }

	return 0;
}

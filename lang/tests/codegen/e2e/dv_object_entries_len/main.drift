module m;

import std.core as core;

fn run() -> Int {
	val obj = DiagnosticValue::Object([
		core.diagnostic_entry("email", DiagnosticValue::String("invalid-format")),
		core.diagnostic_entry("age", DiagnosticValue::Int(42)),
		core.diagnostic_entry("email", DiagnosticValue::String("updated"))
	]);

	// len: duplicate "email" is deduplicated, so 2 unique entries
	if obj.len() != 2 {
		return 1;
	}

	// entries: returns Array<DiagnosticEntry>
	val entries = obj.entries();

	// Array.len is field access in Drift (no parens)
	if entries.len != 2 {
		return 2;
	}

	// After dedup, surviving entries in order:
	// Input: [email(invalid-format), age(42), email(updated)]
	// Dedup: email at 0 is shadowed by email at 2 -> remove 0
	// Survivors: [age(42), email(updated)]
	val e0 = entries[0];
	if e0.key != "age" {
		return 3;
	}
	match e0.value.as_int() {
		Some(v) => {
			if v != 42 {
				return 4;
			}
		},
		None => {
			return 5;
		},
	}

	val e1 = entries[1];
	if e1.key != "email" {
		return 6;
	}
	match e1.value.as_string() {
		Some(v) => {
			if v != "updated" {
				return 7;
			}
		},
		None => {
			return 8;
		},
	}

	// get() agrees with entries — last-write-wins
	match obj.get("email") {
		Some(dv) => {
			match dv.as_string() {
				Some(v) => {
					if v != "updated" {
						return 9;
					}
				},
				None => {
					return 10;
				},
			}
		},
		None => {
			return 11;
		},
	}

	// entries on non-Object returns empty array
	val int_dv = DiagnosticValue::Int(99);
	if int_dv.len() != 0 {
		return 12;
	}
	val empty_entries = int_dv.entries();
	if empty_entries.len != 0 {
		return 13;
	}

	return 0;
}

pub fn main() nothrow -> Int {
	return try run() catch { 99 };
}

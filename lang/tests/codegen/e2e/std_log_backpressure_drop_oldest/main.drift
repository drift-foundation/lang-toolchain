module m

import std.log as log;

fn run() -> Int {
	var b = log.config_builder();
	b.queue_capacity(1);
	b.backpressure_policy(log.BackpressurePolicy::DropOldest());
	val cfg = b.build();
	if not log.init(cfg) {
		return 1;
	}
	if not log.info("ev-1", {"x": 1}) {
		return 2;
	}
	if not log.info("ev-2", {"x": 2}) {
		return 3;
	}
	return 0;
}

fn main() nothrow -> Int {
	return try run() catch { 99 };
}

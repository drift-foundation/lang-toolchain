module main;

struct Blob {
	xs: Array<Int>
}

interface Take {
	fn take(self: &Self, v: Blob) nothrow -> Int;
}

struct Impl {}

implement Take for Impl {
	fn take(self: &Impl, v: Blob) nothrow -> Int {
		return 8;
	}
}

fn main() nothrow -> Int {
	var x = Impl();
	var t: Take = x;
	val b = Blob(xs = [1]);
	return t.take(b);
}

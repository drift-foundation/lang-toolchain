module m;

import std.concurrent as conc;
import std.containers as containers;
import std.core as core;
import std.io as io;
import std.net as net;

type VtInt = conc.VirtualThread<Int>;

const N: Int = 500;

// NetError is a `pub error` (0.31.67) — the `throws`-function entry
// (run_main) uses auto-try over `net.listen(...)` and the top-level
// dispatcher catches `net:NetError(e)` as a typed pub-error catch arm.
// That is the contract this fixture pins.  Per-syscall failures inside
// the spawned worker VTs use explicit `match` to tolerate transient
// kernel conditions under N=500 concurrent connections, so the
// fixture's exit code distinguishes "auto-try / typed catch failed to
// compile or routed wrong" (catch-all → 1) from "kernel transient,
// retried elsewhere" (typed → distinct code).
fn handle_client(var s: net.TcpStream, timeout: conc.Duration) nothrow -> Int {
	var buf = io.buffer(1024);
	match s.read(&mut buf, timeout) {
		Ok(_) => {},
		Err(_) => { return -1; },
	}
	match s.write(&buf, timeout) {
		Ok(_) => {},
		Err(_) => { return -2; },
	}
	match s.close(timeout) {
		Ok(_) => {},
		Err(_) => { return -3; },
	}
	return 0;
}

fn server_loop(listener: net.TcpListener, timeout: conc.Duration) nothrow -> Int {
	var i = 0;
	while i < N {
		match net.accept(&listener, timeout) {
			Ok(s) => {
				val r = handle_client(move s, timeout);
				if r < 0 { return r; }
			},
			Err(_) => { return -10; },
		}
		i = i + 1;
	}
	return 0;
}

fn _client_after_connect(s: net.TcpStream, size: Int, timeout: conc.Duration) nothrow -> Int {
	val byte = cast<Byte>(65);
	var wbuf = io.buffer(size);
	var i = 0;
	while i < size {
		io.buffer_write(&mut wbuf, i, byte);
		i = i + 1;
	}
	var wn: Int = 0;
	match s.write(&wbuf, timeout) {
		Ok(v) => { wn = v; },
		Err(_) => { return -30; },
	}
	if wn != size { return -33; }
	var rbuf = io.buffer(size);
	var rn: Int = 0;
	match s.read(&mut rbuf, timeout) {
		Ok(v) => { rn = v; },
		Err(_) => { return -35; },
	}
	if rn != size { return -36; }
	match s.close(timeout) {
		Ok(_) => {},
		Err(_) => { return -37; },
	}
	return size * 65;
}

fn client_once(port: Int, size: Int, timeout: conc.Duration) nothrow -> Int {
	var addr = net.socket_addr("127.0.0.1", port);
	match net.connect(&addr, timeout) {
		Ok(s) => { return _client_after_connect(move s, size, timeout); },
		Err(_) => { return -20; },
	}
}

pub fn main() nothrow -> Int {
	return try run_main() catch net:NetError(_e) {
		// Listen / accept threw before the worker VTs took over.  Auto-try
		// over the boundary call routed through this typed pub-error arm,
		// which is the migration's load-bearing contract.
		50
	} catch {
		1
	};
}

fn run_main() throws -> Int {
	val io_t = conc.Duration(millis = 5000);
	var addr = net.socket_addr("127.0.0.1", 0);
	val listener = net.listen(&addr, io_t);
	return _run_with_listener(move listener, io_t);
}

fn _run_with_listener(listener: net.TcpListener, io_t: conc.Duration) throws -> Int {
	val port = listener.local_port();
	// Start the server in its own VT.
	var server = conc.spawn(| | captures(move listener, copy port, copy io_t) => {
		return try server_loop(move listener, io_t) catch { -70 };
	});
	var dq = containers.deque<type VtInt>();
	// Expected sum is the total bytes written across all clients.
	var expected = 0;
	var k = 0;
	var actual = 0;
	while k < N {
		// Size cycles 1/64/1024 to stress small/medium/large payloads.
		val size = (k % 3 == 0) ? 1 : ((k % 3 == 1) ? 64 : 1024);
		expected = expected + (size * 65);
		// Spawn the client VT.
		val t = conc.spawn(| | captures(copy port, copy size, copy io_t) => {
			return try client_once(port, size, io_t) catch { -80 };
		});
		dq.push_back(move t);
		k = k + 1;
	}
	// Join all client VTs and accumulate actual sum.
	while dq.len() > 0 {
		val opt = dq.pop_front();
		match opt {
			Some(vt) => {
				var t = move vt;
				match t.join() {
					Ok(code) => {
						if code < 0 { return code; }
						actual = actual + code;
					},
					Err(_) => { return -90; },
				}
			},
			None => { return 60; },
			default => { return 63; }
		}
	}
	// Join server and verify total math.
	match server.join() {
		Ok(v) => {
			if v != 0 { return 70; }
		},
		Err(_) => { return -91; },
	}
	if actual != expected { return 71; }
	return 0;
}

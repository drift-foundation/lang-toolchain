module main;

import std.runtime as rt;

fn _with_inner(st: &mut rt.ScopedStack<Int>) nothrow -> Int {
	val g2 = st.push(20);
	if st.depth() != 2 {
		return 10;
	}
	match st.peek() {
		Some(v4) => {
			if *v4 != 20 {
				return 11;
			}
		},
		None => { return 12; }
	}
	return 0;
}

fn _with_outer(st: &mut rt.ScopedStack<Int>) nothrow -> Int {
	val g1 = st.push(10);
	if st.depth() != 1 {
		return 4;
	}
	match st.peek() {
		Some(v) => {
			if *v != 10 {
				return 5;
			}
		},
		None => { return 6; }
	}
	match st.peek_mut() {
		Some(v2) => {
			*v2 = *v2 + 1;
		},
		None => { return 7; }
	}
	match st.peek() {
		Some(v3) => {
			if *v3 != 11 {
				return 8;
			}
		},
		None => { return 9; }
	}
	val inner_rc = _with_inner(st);
	if inner_rc != 0 {
		return inner_rc;
	}
	if st.depth() != 1 {
		return 13;
	}
	match st.peek() {
		Some(v5) => {
			if *v5 != 11 {
				return 14;
			}
		},
		None => { return 15; }
	}
	match st.pop() {
		Some(v6) => {
			if v6 != 11 {
				return 16;
			}
		},
		None => { return 17; }
	}
	if not st.is_empty() {
		return 18;
	}
	return 0;
}

fn _push_one(st: &mut rt.ScopedStack<Int>) nothrow -> Int {
	val g3 = st.push(30);
	return 0;
}

fn run() nothrow -> Int {
	var st = rt.scoped_stack<type Int>();
	if not st.is_empty() {
		return 1;
	}
	if st.depth() != 0 {
		return 2;
	}
	match st.peek() {
		Some(_v) => { return 3; },
		None => {}
	}
	val outer_rc = _with_outer(st);
	if outer_rc != 0 {
		return outer_rc;
	}
	if not st.is_empty() {
		return 19;
	}
	val one_rc = _push_one(st);
	if one_rc != 0 {
		return one_rc;
	}
	if not st.is_empty() {
		return 20;
	}
	return 0;
}

pub fn main() nothrow -> Int {
	return run();
}

module main

struct MathOp {
	apply: Fn(Int, Int) -> Int
}

fn add(a: Int, b: Int) nothrow -> Int { return a + b; }
fn mul(a: Int, b: Int) nothrow -> Int { return a * b; }

fn main() nothrow -> Int {
	val op_add = MathOp(apply = add);
	val op_mul = MathOp(apply = mul);
	val r1 = op_add.apply(3, 4);
	val r2 = op_mul.apply(3, 4);
	if r1 != 7 { return 1; }
	if r2 != 12 { return 2; }
	return 0;
}

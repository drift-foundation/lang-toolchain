module main;

struct MathOp {
	apply: Fn(Int, Int) nothrow -> Int
}

fn add(a: Int, b: Int) nothrow -> Int { return a + b; }
fn mul(a: Int, b: Int) nothrow -> Int { return a * b; }

pub fn main() nothrow -> Int {
	val op_add = MathOp(apply = add);
	val op_mul = MathOp(apply = mul);
	val f1 = op_add.apply;
	val f2 = op_mul.apply;
	val r1 = f1(3, 4);
	val r2 = f2(3, 4);
	if r1 != 7 { return 1; }
	if r2 != 12 { return 2; }
	return 0;
}

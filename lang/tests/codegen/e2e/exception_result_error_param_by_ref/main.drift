module m;

import std.core as core;
import std.err as err;

fn fail() -> Int {
	throw err:ResultError(diag_json = core.diagnostic_json_int(7));
}

pub fn main() nothrow -> Int {
	// Slice 7a: ResultError carries `diag_json: String`.
	val v = try fail() catch err:ResultError(e) {
		(e.diag_json == "7") ? 7 : -1
	} catch {
		99
	};
	return v;
}

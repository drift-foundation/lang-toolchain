module main;

import std.core as core;
import std.text as text;

fn str_eq(a: &String, b: &String) nothrow -> Bool {
	val an = a.byte_length();
	val bn = b.byte_length();
	if an != bn { return false; }
	var i = 0;
	while i < an {
		if core.string_byte_at(a, i) != core.string_byte_at(b, i) { return false; }
		i = i + 1;
	}
	return true;
}


fn main() nothrow -> Int {
	match text.char_at("hello", 0) {
		core.Result::Ok(v) => {
			val e = "h";
			if !str_eq(&v, &e) { return 1; }
		},
		core.Result::Err(_) => { return 2; }
	}
	match text.char_at("hello", 4) {
		core.Result::Ok(v) => {
			val e = "o";
			if !str_eq(&v, &e) { return 3; }
		},
		core.Result::Err(_) => { return 4; }
	}
	// Out of bounds
	match text.char_at("hello", 5) {
		core.Result::Ok(_) => { return 5; },
		core.Result::Err(_) => { }
	}
	// Negative
	match text.char_at("hello", 0 - 1) {
		core.Result::Ok(_) => { return 6; },
		core.Result::Err(_) => { }
	}

	return 0;
}

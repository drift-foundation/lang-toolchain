module m;

import std.json as json;
import std.containers as containers;

fn run() -> Int {
	var fields = containers.hash_map<type String, json.JsonNode>();
	fields.insert("a", json.JsonNode::Number("1"));
	val root = json.JsonNode::Object(move fields);
	match root.as_object() {
		Some(obj) => {
			if obj.len() != 1 {
				return 1;
			}
		},
		None => {
			return 2;
		}
	}
	val k = "a";
	val path = [k];
	val node = root.expect_path(&path);
	if node.expect_int("", "a") != 1 {
		return 4;
	}
	val s = json.JsonNode::String("a\"b");
	if json.encode(&s) != "\"a\\\"b\"" {
		return 5;
	}
	if json.encode_compact(&root) != "{\"a\":1}" {
		return 6;
	}
	return 0;
}

pub fn main() nothrow -> Int {
	return try run() catch { 99 };
}

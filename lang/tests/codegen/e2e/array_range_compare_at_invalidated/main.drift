module main;

import std.err;
import std.iter as iter;

fn main() nothrow -> Int {
	var arr = [1, 2];
	var r = arr.range();
	arr.push(3);
	val out = try iter.RandomAccessReadable::compare_at(&r, 0, 0) catch std.err:IteratorInvalidated(e) {
		// Slice 7a: typed catch projection on container_id; op_id is a
		// variant whose throw-side projection has a known double-quoting
		// bug (out-of-scope for 7a — see array_range_len_invalidated).
		(e.container_id != "std.containers:Array") ? 10 : 0
	} catch {
		99
	};
	return out;
}

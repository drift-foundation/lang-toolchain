module main;

import std.core as core;
import std.json as json;
import std.format as fmt;

// Reproducer: val in outer match arm, not moved on one path of a
// nested match.  The val should be dropped when the outer arm exits.

fn make_json() nothrow -> core.Result<json.JsonNode, String> {
	match json.parse(&"{\"a\": 1}") {
		core.Result::Ok(node) => {
			return core.Result::Ok(move node);
		},
		core.Result::Err(_) => {
			return core.Result::Err("parse failed");
		}
	}
}

fn test_nested_match_drop() nothrow -> Int {
	match make_json() {
		core.Result::Ok(node) => {
			// deep is allocated here, in the Ok arm scope.
			val deep = node.clone_deep();
			// Nested match that does NOT move deep on the happy path.
			match node.into_object() {
				Some(obj) => {
					// deep is NOT used/moved here.
					// It should be dropped when the Ok arm exits.
					val count = obj.len();
					return count;
				},
				None => {
					// deep IS moved here.
					val s = json.encode(&deep);
					return s.byte_length();
				}
			}
		},
		core.Result::Err(_) => {
			return 0;
		}
	}
}

pub fn main() nothrow -> Int {
	// Run twice to confirm leak scales with call count.
	val r1 = test_nested_match_drop();
	val r2 = test_nested_match_drop();
	if r1 != r2 { return 1; }
	return 0;
}

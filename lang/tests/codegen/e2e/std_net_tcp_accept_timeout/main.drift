module m;

import std.concurrent as conc;
import std.net as net;

pub fn main() nothrow -> Int {
	var addr = net.socket_addr("127.0.0.1", 0);
	val io_t = conc.Duration(millis = 1000);
	val lr = net.listen(&addr, io_t);
	match lr {
		Ok(l) => {
			val t = conc.Duration(millis = 1);
			val ar = net.accept(&l, t);
			match ar {
				Ok(s) => {
					val _ = s.close(io_t);
					return 2;
				},
				Err(e) => {
					match e {
						WouldBlock => { return 0; },
						Errno(_) => { return 3; },
						default => { return 4; }
					}
				},
				default => { return 5; }
			}
		},
		Err(_) => { return 9; },
		default => { return 10; }
	}
}

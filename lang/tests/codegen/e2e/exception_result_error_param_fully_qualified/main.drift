module m;

import std.core as core;

fn fail() -> Int {
	throw std.err:ResultError(diag_json = core.diagnostic_json_int(7));
}

pub fn main() nothrow -> Int {
	// Slice 7a: ResultError carries `diag_json: String`.  Pins the
	// round-trip via typed catch projection on the synthesized field;
	// marker payload is the canonical JSON-text form of integer 7.
	val v = try fail() catch std.err:ResultError(e) {
		(e.diag_json == "7") ? 7 : -1
	} catch {
		99
	};
	return v;
}

module m

import std.core as core;
import std.containers as containers;
import std.format as format;

fn run() -> Int {
	var i = 0;
	while i < 800 {
		var m = containers.hash_map<type String, String>();
		var j = 0;
		while j < 12 {
			val k = "k-" + format.format_int(j);
			val v = "v-" + format.format_int(j);
			m.insert(move k, move v);
			j = j + 1;
		}
		var j2 = 0;
		while j2 < 12 {
			val k2 = "k-" + format.format_int(j2);
			match m.remove(&k2) {
				Optional::Some(v) => { core.drop_value<type String>(move v); },
				Optional::None() => { return 3; }
			}
			j2 = j2 + 1;
		}
		i = i + 1;
	}
	return 0;
}

fn main() nothrow -> Int {
	return try run() catch { 99 };
}

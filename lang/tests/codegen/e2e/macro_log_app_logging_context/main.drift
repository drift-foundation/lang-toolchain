module m;

import app.logging as applog;
import std.log as log;
import std.meta as meta;
import std.runtime as rt;

fn _with_ctx() -> Int {
	val g = applog.push_auth("alice", "r-1");
	val st = rt.expect<type applog.AppLoggerState>(rt.global_registry(), "missing-logger-state");
	match applog.current_context() {
		Some(ctx) => {
			log.info!(&st.security, "auth-start", ctx);
			log.info!(&st.security, "auth-failed", ctx, {"req": DiagnosticValue::String("r-2"), "code": DiagnosticValue::Int(401)});
		},
		None => {
			return 5;
		}
	}
	return 0;
}

fn run() -> Int {
	if not applog.install() {
		return 1;
	}
	val st = rt.expect<type applog.AppLoggerState>(rt.global_registry(), "missing-logger-state");
	log.info!(&st.security, "startup");
	val rc = _with_ctx();
	if rc != 0 {
		return rc;
	}
	log.info!(&st.security, "after-scope");
	return 0;
}

fn main() nothrow -> Int {
	return try run() catch { 99 };
}

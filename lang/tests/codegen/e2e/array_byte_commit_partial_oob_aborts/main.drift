module main

import lang.thread as thread;
import std.mem as mem;

fn main() nothrow -> Int {
	// Alloc cap 8, write 3 bytes, commit len 3.
	var buf = unsafe { thread.array_byte_alloc_uninit(8) };
	val ptr = unsafe { thread.array_byte_as_mut_ptr(&mut buf) };
	mem.ptr_write<type Byte>(ptr, cast<Byte>(10));
	mem.ptr_write<type Byte>(mem.ptr_offset<type Byte>(ptr, 1), cast<Byte>(20));
	mem.ptr_write<type Byte>(mem.ptr_offset<type Byte>(ptr, 2), cast<Byte>(30));
	unsafe { thread.array_byte_commit_init_len(&mut buf, 3); }

	// Index 3 is past committed length — must be out of bounds.
	val _ = buf[3];
	return 0;
}

module m;

import std.log as log;

fn run() -> Int {
	var b = log.config_builder();
	b.min_level(log.Level::Error());
	val lg = log.create_logger("main", b.build());
	// Info should be filtered out by the Error min_level; the
	// stderr_jsonl assertion is what actually verifies that.
	lg.info("info", {"x": 1});
	lg.error("err", {"x": 2});
	return 0;
}

pub fn main() nothrow -> Int {
	return try run() catch { 99 };
}

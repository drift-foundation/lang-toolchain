module m;

import std.sync as sync;
import std.concurrent as conc;
import std.core as core;
import std.containers as containers;

fn worker_fetch(per_worker: Int) nothrow -> Int {
	var local = sync.atomic_int(0);
	var j = 0;
	while j < per_worker {
		val _ = local.fetch_add(1, sync.MemoryOrder::AcqRel());
		j = j + 1;
	}
	val old = local.fetch_sub(1, sync.MemoryOrder::Relaxed());
	val now = local.load(sync.MemoryOrder::SeqCst());
	if old != per_worker {
		return -1;
	}
	return now;
}

fn run() -> Int {
	val workers = 24;
	val per_worker = 300;
	var tasks = containers.deque<type conc.VirtualThread<Int>>();
	var i = 0;
	while i < workers {
		var t = conc.spawn_cb(core.callback0(| | captures(copy per_worker) => { return worker_fetch(per_worker); }));
		tasks.push_back(move t);
		i = i + 1;
	}

	var sum = 0;
	while tasks.len() > 0 {
		var opt = tasks.pop_front();
		match opt {
			Some(var vt) => {
				var r = vt.join();
				match r {
					Ok(v) => {
						if v < 0 {
							return 1;
						}
						sum = sum + v;
					},
					default => { return 2; }
				}
			},
			default => { return 3; }
		}
	}
	if sum == workers * (per_worker - 1) {
		return 0;
	}
	return 4;
}

fn main() nothrow -> Int {
	return try run() catch { 99 };
}

module main;

pub struct Box {
	v: Int
}

implement Box {
	// Overload by parameter type — `pick(&String)` returns v + 100.
	pub fn pick(self: &Box, k: &String) nothrow -> Int {
		return self.v + 100;
	}

	// Overload by parameter type — `pick(&Array<String>)` returns v + 200 + array length.
	pub fn pick(self: &Box, k: &Array<String>) nothrow -> Int {
		return self.v + 200 + k.len;
	}
}

pub fn main() nothrow -> Int {
	val b = Box(v = 10);

	// String overload — auto-borrow (the only call spelling).
	val by_str = b.pick("world");
	if by_str != 110 { return 2; }

	// Array<String> overload — auto-borrow on a local.
	val segs: Array<String> = ["a", "b", "c"];
	val by_arr = b.pick(segs);
	if by_arr != 213 { return 4; }

	return 0;
}

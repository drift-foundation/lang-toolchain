module m;

import std.sync as sync;

pub fn main() nothrow -> Int {
	var ai = sync.atomic_int(7);
	val o1 = ai.compare_exchange_observed(7, 9, sync.MemoryOrder::SeqCst(), sync.MemoryOrder::Acquire());
	if o1 != 7 { return 1; }
	if ai.load(sync.MemoryOrder::Acquire()) != 9 { return 2; }
	val o2 = ai.compare_exchange_observed(7, 11, sync.MemoryOrder::SeqCst(), sync.MemoryOrder::Acquire());
	if o2 != 9 { return 3; }
	if ai.load(sync.MemoryOrder::Acquire()) != 9 { return 4; }
	val o3 = ai.compare_exchange_observed(9, 10, sync.MemoryOrder::Relaxed(), sync.MemoryOrder::Release());
	if o3 != 9 { return 5; }
	if ai.load(sync.MemoryOrder::Acquire()) != 9 { return 6; }

	var ab = sync.atomic_bool(true);
	val b1 = ab.compare_exchange_observed(true, false, sync.MemoryOrder::SeqCst(), sync.MemoryOrder::Acquire());
	if not b1 { return 7; }
	if ab.load(sync.MemoryOrder::Acquire()) { return 8; }
	val b2 = ab.compare_exchange_observed(true, false, sync.MemoryOrder::SeqCst(), sync.MemoryOrder::Acquire());
	if b2 { return 9; }
	if ab.load(sync.MemoryOrder::Acquire()) { return 10; }

	return 0;
}

module main;

import std.core as core;
import std.format as fmt;
import std.log as log;

pub fn main() nothrow -> Int {
	var cfgb = log.config_builder();
	cfgb.sink(log.stderr_sink());
	cfgb.min_level(log.Level::Error());
	val logger = log.create_logger("test", cfgb.build());

	// This path triggers the double-free: DiagnosticValue::String wrapping
	// a heap string in a map literal passed to logger.info().
	// _attrs_json calls Debuggable::to_debug(&dv) which does *self —
	// a raw LoadRef without clone.  Two owners, one string, double-free.
	val _ = logger.info("ev", {
		"port": DiagnosticValue::String(fmt.format_int(8080))
	});
	val _ = logger.info("ev", {
		"port": DiagnosticValue::String(fmt.format_int(8081))
	});
	val _ = logger.info("ev", {
		"port": DiagnosticValue::String(fmt.format_int(8082))
	});
	return 0;
}

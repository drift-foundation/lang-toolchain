module m;
import std.core as core;
import std.json as json;
fn run() -> Int {
  val a = "{";
  match json.parse(&a) { core.Result::Ok(_) => { return 1; }, core.Result::Err(_e) => { } }
  val b = "{";
  match json.parse(&b) { core.Result::Ok(_) => { return 2; }, core.Result::Err(_e2) => { } }
  return 0;
}
fn main() nothrow -> Int { return try run() catch { 99 }; }

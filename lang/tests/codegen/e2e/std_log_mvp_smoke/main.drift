module m;

import std.log as log;
import std.concurrent as conc;

fn run() -> Int {
	var cfg_builder = log.config_builder();
	cfg_builder.min_level(log.Level::Debug());
	cfg_builder.queue_capacity(128);
	cfg_builder.backpressure_policy(log.BackpressurePolicy::BlockWithTimeout());
	cfg_builder.sink(log.stderr_sink());
	val cfg = cfg_builder.build();
	val main_logger = log.create_logger("main", move cfg);

	main_logger.info("auth-failed", {"attempts": 3, "status": 401});

	val lib_logger = main_logger.with_min_level(log.Level::Debug()).derive("auth").build();
	lib_logger.debug("token-parse", {"attempts": 3, "status": 401});

	if not main_logger.flush(conc.Duration(millis = 10)) {
		return 4;
	}
	return 0;
}

fn main() nothrow -> Int {
	return try run() catch { 99 };
}

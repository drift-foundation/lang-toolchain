module m;

fn bump(counter: &mut Int) nothrow -> Bool {
  *counter = *counter + 1;
  return true;
}

fn run() -> Int {
  var counter = 0;

  if false and bump(counter) {
    return 1;
  }

  if true or bump(counter) {
  } else {
    return 2;
  }

  if counter != 0 {
    return 3;
  }

  return 0;
}

pub fn main() nothrow -> Int {
  return try run() catch { 99 };
}

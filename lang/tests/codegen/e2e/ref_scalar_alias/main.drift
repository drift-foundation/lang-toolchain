module m;

fn bump(x: &mut Int) nothrow -> Void {
	*x = *x + 1;
}

fn bump_if(cond: Bool, x: &mut Int) nothrow -> Void {
	if cond {
		*x = *x + 1;
	}
}

pub fn main() nothrow -> Int{
	var c = 0;

	// Unconditional bumps should both be visible through the same slot.
	bump(c);
	bump(c);

	// Only the true branch mutates.
	bump_if(true, c);
	bump_if(false, c);

	// Loop-based mutation through the same reference.
	var i = 0;
	while i < 3 {
		bump(c);
		i = i + 1;
	}

	return c; // expect 6
}

module main;

import std.core as core;

exception AppError(status: String, tag: String, field: String, reason: String)

fn might_fail() -> Int {
	throw AppError(status = "FAILED", tag = "test", field = "x", reason = "bad");
}

fn main() nothrow -> Int {
	var result_state = "OK";
	var err_tag = "";
	var err_field = "";
	var err_reason = "";

	val result = try might_fail() catch AppError(e) {
		match e.attrs["status"].as_string() {
			Some(s) => { result_state = s; },
			None => { result_state = "FAILED"; }
		}
		match e.attrs["tag"].as_string() {
			Some(t) => { err_tag = t; },
			None => {}
		}
		match e.attrs["field"].as_string() {
			Some(f) => { err_field = f; },
			None => {}
		}
		match e.attrs["reason"].as_string() {
			Some(r) => { err_reason = r; },
			None => {}
		}
		0
	} catch { 3 };
	return result;
}

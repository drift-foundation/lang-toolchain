module main;

import std.core as core;

pub error AppError { status: String, tag: String, field: String, reason: String }
fn might_fail() -> Int {
	throw AppError(status = "FAILED", tag = "test", field = "x", reason = "bad");
}

fn main() nothrow -> Int {
	var result_state = "OK";
	var err_tag = "";
	var err_field = "";
	var err_reason = "";

	val result = try might_fail() catch AppError(e) {
		// Slice 7a: typed catch projection on synthesized fields.
		result_state = e.status;
		err_tag = e.tag;
		err_field = e.field;
		err_reason = e.reason;
		0
	} catch { 3 };
	return result;
}

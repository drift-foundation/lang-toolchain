module main;

import std.containers as containers;
import std.err;

fn main() nothrow -> Int {
var dq = containers.deque<type Int>();
	dq.push_back(1);
	try {
		val _ = dq.at(3);
		return 10;
	} catch std.err:IndexError(e) {
		// Slice 7a: typed catch projection on synthesized fields.
		if not (e.container_id == "std.containers:Deque") {
			return 20;
		}
		if e.index != 3 {
			return 22;
		}
		return 0;
	} catch {
		return 98;
	}
}

module main

import std.containers as containers;
import std.iter as iter;
use trait iter.SinglePassIterator;

fn run() -> Int {
	var s = containers.hash_set<type Int>();
	s.insert(1);
	s.insert(2);
	s.insert(3);
	var it = s.iter();
	var count = 0;
	var done = false;
	while not done {
		val nxt = it.next();
		match nxt {
			None => { done = true; },
			Some(_) => {
				count = count + 1;
			}
		}
	}
	if count != 3 { return 1; }
	return 0;
}

fn main() nothrow -> Int {
	return try run() catch { 99 };
}

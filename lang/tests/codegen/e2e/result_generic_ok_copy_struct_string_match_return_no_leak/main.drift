module main;

import std.core as core;

struct Payload {
	msg: String
}

fn wrap<T>(v: T) nothrow -> core.Result<T, Int> {
	return core.Result::Ok(move v);
}

pub fn main() nothrow -> Int {
	match wrap<type Payload>(Payload(msg = "generic")) {
		core.Result::Ok(v) => {
			if v.msg == "generic" {
				return 0;
			}
			return 1;
		},
		core.Result::Err(_) => {
			return 2;
		}
	}
}

module m
import std.containers as c;
import std.json as json;

fn f() -> Int {
  var m = c.hash_map<type String, json.JsonNode>();
  if m.len() != 0 { return 1; }
  return 0;
}

fn run() -> Int {
  if f() != 0 { return 1; }
  if f() != 0 { return 2; }
  return 0;
}

fn main() nothrow -> Int { return try run() catch { 99 }; }

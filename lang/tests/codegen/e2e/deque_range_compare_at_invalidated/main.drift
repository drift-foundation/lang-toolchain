module main;

import std.err;
import std.iter as iter;
import std.containers as containers;

fn main() nothrow -> Int {
var dq = containers.deque<type Int>();
	dq.push_back(1);
	dq.push_back(2);
	var r = dq.range();
	dq.push_back(3);
	val out = try iter.RandomAccessReadable::compare_at(&r, 0, 0) catch std.err:IteratorInvalidated(e) {
		// Slice 7b: op_id projects as bare integer (CompareAt → 3).
		val cid_bad = (not (e.container_id == "std.containers:Deque"));
		val op = match e.params.get("op_id").as_int() {
			Some(v) => { v },
			None => { -1 }
		};
		val op_bad = (op != 3);
		(cid_bad ? 10 : 0) + (op_bad ? 20 : 0)
	} catch {
		99
	};
	return out;
}

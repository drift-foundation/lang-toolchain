module main;

import std.err;
import std.iter as iter;
import std.containers as containers;

fn main() nothrow -> Int {
var dq = containers.deque<type Int>();
	dq.push_back(1);
	dq.push_back(2);
	var r = dq.range();
	dq.push_back(3);
	val out = try iter.RandomAccessReadable::compare_at(&r, 0, 0) catch std.err:IteratorInvalidated(e) {
		// Slice 7a: typed catch projection on container_id; op_id variant
		// projection bug deferred (see array_range_len_invalidated).
		(not (e.container_id == "std.containers:Deque")) ? 10 : 0
	} catch {
		99
	};
	return out;
}

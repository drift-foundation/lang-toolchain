module m;

import std.core as core;
import lang.thread as thread;

pub fn main() nothrow -> Int {
	// Raw intrinsic ABI pin: exec_create(min_threads, max_threads,
	// queue_limit, timeout_ms, saturation, stack_bytes) with
	// saturation = 1 = ReturnBusy (0 = Block).  This fixture asserts
	// RETURN-BUSY queue-limit enforcement at the intrinsic level: a
	// submit to a full executor fails IMMEDIATELY with code 1.  The
	// Block(timeout) admission path (saturation = 0, real since
	// 0.33.80) is covered by lang/tests/driver/
	// test_exec_block_admission.py via the stdlib builder.
	val exec = thread.exec_create(1, 1, 1, 0, 1, 262144);
	if exec == 0 {
		return 10;
	}
	val cb1: core.Callback0<Void> = core.callback0(| | => {
		val deadline = thread.now_ms() + 20;
		while thread.now_ms() < deadline {
		}
		return;
	});
	val h1 = thread.vt_spawn(move cb1, exec);
	val s1 = thread.exec_submit(exec, h1);
	if s1 != 0 {
		return 11;
	}
	thread.vt_park_until(1);
	val cb2: core.Callback0<Void> = core.callback0(| | => { return; });
	val h2 = thread.vt_spawn(move cb2, exec);
	val s2 = thread.exec_submit(exec, h2);
	if s2 == 1 {
		return 0;
	}
	if s2 == 0 {
		return 1;
	}
	return 12;
}

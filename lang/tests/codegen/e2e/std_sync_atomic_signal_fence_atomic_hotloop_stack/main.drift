module m;

import std.sync as sync;

pub fn main() nothrow -> Int {
	var x = sync.atomic_int(0);
	var i = 0;
	while i < 200000 {
		x.store(i, sync.MemoryOrder::Relaxed());
		sync.signal_fence(sync.MemoryOrder::SeqCst());
		val v = x.load(sync.MemoryOrder::Relaxed());
		if v != i { return 1; }
		i = i + 1;
	}
	return 0;
}

module main

import std.core as core;
import std.regex as regex;

fn str_eq(a: &String, b: &String) nothrow -> Bool {
	val an = a.byte_length();
	val bn = b.byte_length();
	if an != bn { return false; }
	var i = 0;
	while i < an {
		if core.string_byte_at(a, i) != core.string_byte_at(b, i) { return false; }
		i = i + 1;
	}
	return true;
}

fn check_compiles_and_matches(pattern: &String, input: &String, expected: Bool, fail_code: Int) nothrow -> Int {
	match regex.compile(pattern) {
		core.Result::Ok(re) => {
			if regex.is_match(&re, input) != expected { return fail_code; }
			return 0;
		},
		core.Result::Err(_) => { return fail_code + 1; }
	}
}

fn check_match(pattern: &String, input: &String, exp_start: Int, exp_end: Int, fail_code: Int) nothrow -> Int {
	match regex.compile(pattern) {
		core.Result::Ok(re) => {
			match regex.find_first(&re, input) {
				Optional::Some(m) => {
					if m.start != exp_start { return fail_code; }
					if m.end != exp_end { return fail_code + 1; }
					return 0;
				},
				Optional::None() => { return fail_code + 2; }
			}
		},
		core.Result::Err(_) => { return fail_code + 3; }
	}
}

fn main() nothrow -> Int {
	var rc = 0;

	// =================================================================
	// §1 — Large alternation chain (50 branches)
	//
	// Build pattern: "aa|ab|ac|...|az|ba|bb|...|bx" (50 two-char branches).
	// This stresses the parser (deep alternation array) and NFA compiler
	// (Split chains grow as 2*(n-1) instructions).
	// =================================================================

	var alt50 = "";
	var i = 0;
	while i < 26 {
		val ch = core.byte_to_string(cast<Byte>(97 + i));
		if i > 0 { alt50 = alt50 + "|"; }
		alt50 = alt50 + "a" + ch;
		i = i + 1;
	}
	// Add 24 more branches: ba through bx.
	i = 0;
	while i < 24 {
		val ch = core.byte_to_string(cast<Byte>(97 + i));
		alt50 = alt50 + "|b" + ch;
		i = i + 1;
	}
	// alt50 now has 50 branches.

	// Should compile successfully.
	rc = check_compiles_and_matches(&alt50, &"az", true, 10);
	if rc != 0 { return rc; }
	rc = check_compiles_and_matches(&alt50, &"bx", true, 12);
	if rc != 0 { return rc; }
	rc = check_compiles_and_matches(&alt50, &"cx", false, 14);
	if rc != 0 { return rc; }

	// Find first: "xbhx" → matches "bh" at 1..3.
	rc = check_match(&alt50, &"xbhx", 1, 3, 16);
	if rc != 0 { return rc; }

	// =================================================================
	// §2 — Large alternation chain (100 single-char branches)
	//
	// Build pattern with 100 branches: alternating literal bytes.
	// This is a|b|c|...|z|A|B|...|Z|0|1|...|9 + fill to 100.
	// =================================================================

	var alt100 = "";
	// a-z (26)
	i = 0;
	while i < 26 {
		if i > 0 { alt100 = alt100 + "|"; }
		alt100 = alt100 + core.byte_to_string(cast<Byte>(97 + i));
		i = i + 1;
	}
	// A-Z (26)
	i = 0;
	while i < 26 {
		alt100 = alt100 + "|" + core.byte_to_string(cast<Byte>(65 + i));
		i = i + 1;
	}
	// 0-9 (10)
	i = 0;
	while i < 10 {
		alt100 = alt100 + "|" + core.byte_to_string(cast<Byte>(48 + i));
		i = i + 1;
	}
	// Pad with literal strings to reach ~100: "aa" through "al" (38 more → total 100).
	i = 0;
	while i < 38 {
		val ch = core.byte_to_string(cast<Byte>(97 + (i % 26)));
		alt100 = alt100 + "|a" + ch;
		i = i + 1;
	}

	// Should compile and match.
	rc = check_compiles_and_matches(&alt100, &"Z", true, 20);
	if rc != 0 { return rc; }
	rc = check_compiles_and_matches(&alt100, &"5", true, 22);
	if rc != 0 { return rc; }
	rc = check_compiles_and_matches(&alt100, &"!", false, 24);
	if rc != 0 { return rc; }

	// =================================================================
	// §3 — Long concatenation pattern (100 literal bytes)
	//
	// Build "abcabc..." (100 chars) and match against itself.
	// =================================================================

	var long_pat = "";
	var long_inp = "";
	i = 0;
	while i < 100 {
		val ch = core.byte_to_string(cast<Byte>(97 + (i % 3)));
		long_pat = long_pat + ch;
		long_inp = long_inp + ch;
		i = i + 1;
	}

	rc = check_compiles_and_matches(&long_pat, &long_inp, true, 30);
	if rc != 0 { return rc; }

	// Off-by-one: input one byte short → no match.
	var short_inp = "";
	i = 0;
	while i < 99 {
		val ch = core.byte_to_string(cast<Byte>(97 + (i % 3)));
		short_inp = short_inp + ch;
		i = i + 1;
	}
	rc = check_compiles_and_matches(&long_pat, &short_inp, false, 32);
	if rc != 0 { return rc; }

	// =================================================================
	// §4 — Long concatenation with quantifiers
	//
	// "a.b.c.d.e.f.g.h.i.j" (19 nodes: 10 literals + 9 dots).
	// =================================================================

	rc = check_compiles_and_matches(&"a.b.c.d.e.f.g.h.i.j", &"aXbXcXdXeXfXgXhXiXj", true, 40);
	if rc != 0 { return rc; }
	rc = check_compiles_and_matches(&"a.b.c.d.e.f.g.h.i.j", &"aXbXcXdXeXfXgXhXiYj", true, 42);
	if rc != 0 { return rc; }
	rc = check_compiles_and_matches(&"a.b.c.d.e.f.g.h.i.j", &"aXbXcXdXeXfXgXhXi", false, 44);
	if rc != 0 { return rc; }

	// =================================================================
	// §5 — Nested groups stress
	//
	// ((((a)))) should compile and match 'a'.
	// Deep nesting tests parser recursion depth.
	// =================================================================

	rc = check_compiles_and_matches(&"((((a))))", &"a", true, 50);
	if rc != 0 { return rc; }
	rc = check_compiles_and_matches(&"((((a))))", &"b", false, 52);
	if rc != 0 { return rc; }

	// 10 levels deep: ((((((((((a))))))))))
	rc = check_compiles_and_matches(&"((((((((((a))))))))))", &"a", true, 54);
	if rc != 0 { return rc; }

	// Nested group with alternation + quantifier.
	// ((a|b)+) on "ababba" → should match.
	rc = check_match(&"((a|b)+)", &"ababba", 0, 6, 56);
	if rc != 0 { return rc; }

	// =================================================================
	// §6 — Deterministic output: same pattern+input always same result
	// =================================================================

	// Run the same match 3 times and verify identical output.
	match regex.compile(&"[a-z]+") {
		core.Result::Ok(re) => {
			match regex.find_first(&re, &"123abc456") {
				Optional::Some(m1) => {
					match regex.find_first(&re, &"123abc456") {
						Optional::Some(m2) => {
							match regex.find_first(&re, &"123abc456") {
								Optional::Some(m3) => {
									if m1.start != m2.start or m2.start != m3.start { return 60; }
									if m1.end != m2.end or m2.end != m3.end { return 61; }
									if m1.start != 3 or m1.end != 6 { return 62; }
								},
								Optional::None() => { return 63; }
							}
						},
						Optional::None() => { return 64; }
					}
				},
				Optional::None() => { return 65; }
			}
		},
		core.Result::Err(_) => { return 66; }
	}

	return 0;
}

module main;

import std.concurrent as conc;

fn main() nothrow -> Int {
	var f = conc.spawn_future(| | => { return 4; });
	var res1 = f.join();
	match res1 {
		Ok(v) => { if v != 4 { return 1; } },
		Err(_e) => { return 2; },
		default => { return 2; },
	}
	f.cancel();
	var res2 = f.join();
		match res2 {
		Err(err) => {
			if err.kind == conc.CONCURRENCY_KIND_CLOSED { return 0; }
			return 3;
		},
		Ok(_v) => { return 4; },
		default => { return 4; },
	}
}

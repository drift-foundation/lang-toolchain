module main;
import std.json as json;
import std.core as core;

// helper: get object field "a"'s Number raw lexeme, or "" 
fn field_a_raw(node: &json.JsonNode) nothrow -> String {
	match node {
		json.JsonNode::Object(fields) => {
			match fields.get("a") {
				Some(v) => {
					match v {
						json.JsonNode::Number(raw) => { return *raw; },
						default => { return "?"; }
					}
				},
				None => { return "<none>"; }
			}
		},
		default => { return "<notobj>"; }
	}
}

fn err_tag(text: String, cfg: &json.JsonParseConfig) nothrow -> String {
	match json.parse_with_config(text, cfg) {
		core.Result::Ok(_) => { return "<ok>"; },
		core.Result::Err(e) => { return e.tag; }
	}
}

fn ok_a(text: String, cfg: &json.JsonParseConfig) nothrow -> String {
	match json.parse_with_config(text, cfg) {
		core.Result::Ok(v) => { return field_a_raw(v); },
		core.Result::Err(e) => { return "ERR:" + e.tag; }
	}
}

pub fn main() nothrow -> Int {
	val perm = json.permissive();
	val st = json.strict();
	val si = json.signed_ir();

	// 1. 0.33.93 clean break: parse() IS the strict entry point —
	// leading zeros and duplicate keys REJECT there.
	match json.parse("{\"a\":0123}") {
		core.Result::Ok(_) => { return 1; },
		core.Result::Err(e) => { if e.tag != "number-leading-zero" { return 2; } }
	}
	match json.parse("{\"a\":1,\"a\":2}") {
		core.Result::Ok(_) => { return 3; },
		core.Result::Err(e) => { if e.tag != "duplicate-key" { return 4; } }
	}

	// 2. dup-key policies
	// permissive (KeepLast)
	if ok_a("{\"a\":1,\"a\":2}", perm) != "2" { return 10; }
	// strict (Reject)
	if err_tag("{\"a\":1,\"a\":2}", st) != "duplicate-key" { return 11; }
	// KeepFirst via builder
	var kf = json.parse_config_builder();
	kf.duplicate_keys(json.DuplicateKeyPolicy::KeepFirst());
	match kf.build() {
		core.Result::Ok(c) => { if ok_a("{\"a\":1,\"a\":2}", c) != "1" { return 12; } },
		core.Result::Err(_) => { return 13; }
	}

	// 3. leading zeros: rejected by EVERY policy (strict, permissive, signed_ir — and parse() itself, pinned in §1)
	if err_tag("{\"a\":0123}", st) != "number-leading-zero" { return 20; }
	if err_tag("0123", perm) != "number-leading-zero" { return 21; }  // permissive rejects too

	// 4. numeric subset (signed_ir)
	if err_tag("1.5", si) != "number-fraction" { return 30; }
	if err_tag("1e3", si) != "number-exponent" { return 31; }
	if err_tag("-0", si) != "number-negative-zero" { return 32; }
	if err_tag("42", si) != "<ok>" { return 33; }
	if err_tag("-0", st) != "<ok>" { return 34; }   // strict allows -0

	// 5. top-level
	var oo = json.parse_config_builder();
	oo.top_level(json.TopLevelPolicy::ObjectOnly());
	match oo.build() {
		core.Result::Ok(c) => {
			if err_tag("[1,2]", c) != "top-level-not-object" { return 40; }
			if err_tag("{\"a\":1}", c) != "<ok>" { return 41; }
		},
		core.Result::Err(_) => { return 42; }
	}

	// 6. limits: max_depth=1 rejects nested
	var dl = json.parse_config_builder();
	dl.limits(json.JsonLimits(
		max_document_bytes = Optional<Int>::None(), max_depth = Optional::Some(1),
		max_string_bytes = Optional<Int>::None(), max_number_bytes = Optional<Int>::None(),
		max_array_items = Optional<Int>::None(), max_object_fields = Optional<Int>::None()));
	match dl.build() {
		core.Result::Ok(c) => {
			if err_tag("[1,2]", c) != "<ok>" { return 50; }        // depth1 ok
			if err_tag("[[1]]", c) != "limit-depth" { return 51; }  // depth2 rejected
		},
		core.Result::Err(_) => { return 52; }
	}

	// 7. invalid-config (negative limit) via parse_with_config directly
	val badcfg = json.JsonParseConfig(
		duplicate_keys = json.DuplicateKeyPolicy::KeepLast(),
		top_level = json.TopLevelPolicy::AnyValue(),
		numbers = json.JsonNumberPolicy(allow_fractions=true, allow_exponents=true, allow_negative_zero=true),
		limits = json.JsonLimits(
			max_document_bytes = Optional<Int>::None(), max_depth = Optional::Some(-5),
			max_string_bytes = Optional<Int>::None(), max_number_bytes = Optional<Int>::None(),
			max_array_items = Optional<Int>::None(), max_object_fields = Optional<Int>::None()));
	if err_tag("1", badcfg) != "invalid-config" { return 60; }

	return 0;
}

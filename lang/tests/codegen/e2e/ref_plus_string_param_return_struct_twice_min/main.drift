module m;

import std.core as core;

struct E {
  pub tag: String,
  pub line: Int,
}

fn mk(text: &String, tag: String, offset: Int) nothrow -> E {
  var line = 1;
  if offset > text.byte_length() {
    line = 2;
  }
  return E(tag = tag, line = line);
}

fn run() -> Int {
  val s = "{\n\"a\":}\n";
  val a = mk(&s, "invalid-syntax", 6);
  if a.line != 1 { return 1; }
  if a.tag != "invalid-syntax" { return 2; }
  val b = mk(&s, "invalid-syntax", 7);
  if b.line != 1 { return 3; }
  if b.tag != "invalid-syntax" { return 4; }
  return 0;
}

pub fn main() nothrow -> Int { return try run() catch { 99 }; }

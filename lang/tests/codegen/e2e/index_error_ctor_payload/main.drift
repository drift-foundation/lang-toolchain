module main;

import std.err;

// Constructor-only test: does not exercise bounds-check plumbing.
pub fn main() nothrow -> Int {
	try {
		throw std.err:IndexError(container_id = "std.containers:Array", index = 7);
	} catch std.err:IndexError(e) {
		// Slice 7a: typed catch projection on synthesized fields.
		if e.container_id != "std.containers:Array" {
			return 20;
		}
		if e.index != 7 {
			return 22;
		}
		return 0;
	}
	return 1;
}

module m

import std.concurrent as conc;
import std.console as console;
import std.core as core;
import std.format as format;
import std.io as io;
import std.net as net;
import std.time as time;
import std.err;

const WARMUP: Int = 20;
const ITERS: Int = 1000;

fn code_from_error(e: std.err.ResultError) nothrow -> Int {
	val dv = e.attrs["dv"];
	val opt = dv.as_int();
	match opt {
		Some(v) => { return v; },
		None => { return 90; }
	}
}

fn server_handler(listener: net.TcpListener, n: Int, timeout: conc.Duration) -> Int {
	val s = net.accept(&listener, timeout).on_error(|_e| => { throw std.err:ResultError(dv = -10); });
	var buf = io.buffer(64);
	var i = 0;
	while i < n {
		s.read(&mut buf, timeout).on_error(|_e| => { throw std.err:ResultError(dv = -11); });
		s.write(&buf, timeout).on_error(|_e| => { throw std.err:ResultError(dv = -12); });
		i = i + 1;
	}
	val _ = s.close(timeout);
	return 0;
}

fn run_bench() -> Int {
	val io_t = conc.Duration(millis = 10000);
	val total = WARMUP + ITERS;
	var addr = net.socket_addr("127.0.0.1", 0);
	val listener = net.listen(&addr, io_t).on_error(|_e| => { throw std.err:ResultError(dv = 101); });
	val port = listener.local_port();
	// Server VT: accept one connection, echo total request/response pairs.
	var server = conc.spawn(| | captures(move listener, copy total, copy io_t) => {
		return try server_handler(move listener, total, io_t) catch std.err:ResultError(e) {
			code_from_error(e)
		} catch { 92 };
	});
	// Client: connect once, run warmup + measured iterations on same connection.
	var caddr = net.socket_addr("127.0.0.1", port);
	val cs = net.connect(&caddr, io_t).on_error(|_e| => { throw std.err:ResultError(dv = -20); });
	val byte = cast<Byte>(65);
	var wbuf = io.buffer(64);
	var j = 0;
	while j < 64 {
		io.buffer_write(&mut wbuf, j, byte);
		j = j + 1;
	}
	var rbuf = io.buffer(64);
	// Warmup.
	var wi = 0;
	while wi < WARMUP {
		cs.write(&wbuf, io_t).on_error(|_e| => { throw std.err:ResultError(dv = -21); });
		cs.read(&mut rbuf, io_t).on_error(|_e| => { throw std.err:ResultError(dv = -22); });
		wi = wi + 1;
	}
	// Measured.
	val t0 = time.now_monotonic();
	var mi = 0;
	while mi < ITERS {
		cs.write(&wbuf, io_t).on_error(|_e| => { throw std.err:ResultError(dv = -31); });
		cs.read(&mut rbuf, io_t).on_error(|_e| => { throw std.err:ResultError(dv = -32); });
		mi = mi + 1;
	}
	val elapsed = time.elapsed_ms(&t0);
	console.eprintln("[bench] vt_loopback " + format.format_int(ITERS) + " iters " + format.format_int(elapsed) + " ms");
	val _ = cs.close(io_t);
	val sr = server.join().on_error(|_e| => { throw std.err:ResultError(dv = 51); });
	if sr != 0 { return sr; }
	return 0;
}

pub fn main() nothrow -> Int {
	return try run_bench() catch std.err:ResultError(e) {
		1000 + code_from_error(e)
	} catch {
		-777
	};
}

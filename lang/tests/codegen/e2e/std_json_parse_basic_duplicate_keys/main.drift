module m;

import std.json as json;
import std.core as core;

fn run() -> Int {
	val text = "{\"a\":1,\"a\":2,\"b\":true,\"c\":null}";
	var root = json.JsonNode::Null();
	match json.parse(&text) {
		core.Result::Ok(v) => {
			root = move v;
		},
		core.Result::Err(_) => {
			return 1;
		}
	}
	val ka = "a";
	val kb = "b";
	val kc = "c";
	val patha = [ka];
	val na = root.expect_path(&patha);
	if na.expect_int("", "a") != 2 {
		return 2;
	}
	val pathb = [kb];
	val nb = root.expect_path(&pathb);
	if not nb.expect_bool("", "b") {
		return 4;
	}
	val pathc = [kc];
	val nc = root.expect_path(&pathc);
	if not nc.is_null() {
		return 6;
	}
	return 0;
}

pub fn main() nothrow -> Int {
	return try run() catch { 99 };
}

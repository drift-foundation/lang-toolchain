module main;

import std.concurrent as conc;
import std.core as core;
import std.core.arc as arc;
import lang.atomic as atomic;
import lang.thread as thread;

pub struct Sigs {
	pub blocker_started: conc.AtomicBool,
	pub release_blocker: conc.AtomicBool,
	pub blocker_timed_out: conc.AtomicBool,
	pub dropped_task_ran: conc.AtomicBool
}

pub fn main() nothrow -> Int {
	var b = conc.executor_policy_builder();
	b.min_threads(1);
	b.max_threads(1);
	b.queue_limit(8);
	val exec = b.build_executor();

	val sigs: arc.Arc<Sigs> = arc.arc(Sigs(
		blocker_started = conc.atomic_bool(false),
		release_blocker = conc.atomic_bool(false),
		blocker_timed_out = conc.atomic_bool(false),
		dropped_task_ran = conc.atomic_bool(false)
	));

	val blocker_sigs = sigs.clone();
	match conc.spawn_on<type Int>(
		exec,
		core.callback0(
			| | captures(move blocker_sigs) nothrow => {
				atomic.atomic_store_bool(&blocker_sigs.get().blocker_started, true, 2);
				val deadline = thread.now_ms() + 20000;
				while !atomic.atomic_load_bool(&blocker_sigs.get().release_blocker, 1) {
					if thread.now_ms() > deadline {
						atomic.atomic_store_bool(&blocker_sigs.get().blocker_timed_out, true, 2);
						break;
					}
				}
				return 0;
			}
		)
	) {
		Ok(v) => {
			var blocker = move v;
			var spins: Int = 0;
			while !atomic.atomic_load_bool(&sigs.get().blocker_started, 1) {
				val _ = conc.sleep(conc.Duration(millis = 2));
				spins = spins + 1;
				if spins > 1000 {
					atomic.atomic_store_bool(&sigs.get().release_blocker, true, 2);
					var _j = blocker.join();
					return 80;
				}
			}

			val dropped_sigs = sigs.clone();
			match conc.spawn_on<type Int>(
				exec,
				core.callback0(
					| | captures(move dropped_sigs) nothrow => {
						atomic.atomic_store_bool(&dropped_sigs.get().dropped_task_ran, true, 2);
						return 0;
					}
				)
			) {
				Ok(v2) => {
					{ var dropped = move v2; }
				},
				Err(_) => {
					atomic.atomic_store_bool(&sigs.get().release_blocker, true, 2);
					var _j2 = blocker.join();
					return 81;
				},
				default => {
					atomic.atomic_store_bool(&sigs.get().release_blocker, true, 2);
					var _j3 = blocker.join();
					return 82;
				}
			}

			atomic.atomic_store_bool(&sigs.get().release_blocker, true, 2);
			var _ = blocker.join();
			if atomic.atomic_load_bool(&sigs.get().blocker_timed_out, 1) {
				return 83;
			}
			var wait_spins: Int = 0;
			while !atomic.atomic_load_bool(&sigs.get().dropped_task_ran, 1) {
				val _sleep = conc.sleep(conc.Duration(millis = 2));
				wait_spins = wait_spins + 1;
				if wait_spins > 1000 {
					return 1;
				}
			}
			return 0;
		},
		Err(_) => { return 84; },
		default => { return 85; }
	}
}

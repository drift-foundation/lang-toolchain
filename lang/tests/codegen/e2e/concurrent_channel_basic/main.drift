module m;

import std.concurrent as conc;
import std.core as core;

pub fn main() nothrow -> Int {
	var halves = conc.channel<type Int>();
	var sender = halves.take_sender();
	var receiver = halves.take_receiver();
	val _ = sender.send(7);
	val _ = sender.send(35);
	var sum: Int = 0;
	match receiver.recv() {
		Ok(v) => { sum = sum + v; },
		Err(_) => { return 1; },
		default => { return 2; }
	}
	match receiver.recv() {
		Ok(v) => { sum = sum + v; },
		Err(_) => { return 3; },
		default => { return 4; }
	}
	return sum;
}

module main;

import std.core as core;
import std.concurrent as conc;

struct Counter {
	v: Int
}

implement Counter {
	pub fn inc(self: &mut Counter) nothrow -> Int {
		self.v = self.v + 1;
		return self.v;
	}
}

struct Holder {
	cb: core.Callback0<Int>
}

fn noop() nothrow -> Int {
	return -1;
}

implement Holder {
	pub fn call(self: &Holder) nothrow -> Int {
		return self.cb.call();
	}

	pub fn replace(self: &mut Holder, var cb: core.Callback0<Int>) nothrow -> Void {
		self.cb = move cb;
	}
}

pub fn main() nothrow -> Int {
	var root = conc.arc(conc.mutex(Counter(v = 0)));
	var captured = root.clone();
	var cb: core.Callback0<Int> = core.callback0(| | captures(move captured) => {
		var g = conc.lock(captured);
		return g.get_mut().inc();
	});
	var h = Holder(cb = move cb);
	val a = h.call();
	val b = h.call();
	if a != 1 or b != 2 {
		return 10;
	}
	h.replace(core.callback0(noop));
	var rg = conc.lock(root);
	if rg.get_mut().v != 2 {
		return 11;
	}
	return 0;
}

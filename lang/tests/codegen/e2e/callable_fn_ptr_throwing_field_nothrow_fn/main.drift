module main;

struct MathOp {
	apply: Fn(Int, Int) -> Int
}

fn add(a: Int, b: Int) nothrow -> Int { return a + b; }

fn run() -> Int {
	val op = MathOp(apply = add);
	val f = op.apply;
	val result = f(3, 4);
	if result != 7 {
		return 10;
	}
	return 0;
}

fn main() nothrow -> Int {
	return try run() catch { 99 };
}

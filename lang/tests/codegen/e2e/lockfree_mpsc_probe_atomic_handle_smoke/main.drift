module m;

import std.sync as sync;

const INDEX_BITS_U: Uint = 16;

struct Node {
	v: Int
}

fn pack_handle(tag: Uint, idx: Uint) nothrow -> sync.Handle<Node> {
	val raw = (tag << INDEX_BITS_U) | (idx & cast<Uint>(65535));
	return sync.handle<type Node>(raw);
}

fn unpack_tag(h: sync.Handle<Node>) nothrow -> Uint {
	return h.to_uint() >> INDEX_BITS_U;
}

fn unpack_idx(h: sync.Handle<Node>) nothrow -> Uint {
	return h.to_uint() & cast<Uint>(65535);
}

struct MpscTagged {
	head: sync.AtomicHandle<Node>,
	tail: sync.AtomicHandle<Node>
}

fn producer_try_advance_tail(q: &MpscTagged, expected: sync.Handle<Node>, next: sync.Handle<Node>) nothrow -> sync.Handle<Node> {
	return q.tail.compare_exchange_observed(expected, next, sync.MemoryOrder::AcqRel(), sync.MemoryOrder::Acquire());
}

pub fn main() nothrow -> Int {
	var q = MpscTagged(
		head = sync.atomic_handle(pack_handle(cast<Uint>(0), cast<Uint>(0))),
		tail = sync.atomic_handle(pack_handle(cast<Uint>(0), cast<Uint>(0)))
	);

	val old0 = producer_try_advance_tail(q, pack_handle(cast<Uint>(0), cast<Uint>(0)), pack_handle(cast<Uint>(1), cast<Uint>(9)));
	if old0.to_uint() != pack_handle(cast<Uint>(0), cast<Uint>(0)).to_uint() { return 1; }

	val old1 = producer_try_advance_tail(q, pack_handle(cast<Uint>(0), cast<Uint>(0)), pack_handle(cast<Uint>(2), cast<Uint>(10)));
	if old1.to_uint() != pack_handle(cast<Uint>(1), cast<Uint>(9)).to_uint() { return 2; }

	val cur = q.tail.load(sync.MemoryOrder::Acquire());
	if unpack_tag(cur) != cast<Uint>(1) { return 3; }
	if unpack_idx(cur) != cast<Uint>(9) { return 4; }

	val h0 = q.head.compare_exchange_observed(pack_handle(cast<Uint>(0), cast<Uint>(0)), pack_handle(cast<Uint>(1), cast<Uint>(9)), sync.MemoryOrder::AcqRel(), sync.MemoryOrder::Acquire());
	if h0.to_uint() != pack_handle(cast<Uint>(0), cast<Uint>(0)).to_uint() { return 5; }
	val hcur = q.head.load(sync.MemoryOrder::Acquire());
	if hcur.to_uint() != pack_handle(cast<Uint>(1), cast<Uint>(9)).to_uint() { return 6; }

	return 0;
}

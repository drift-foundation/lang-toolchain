module main;

import std.concurrent as conc;
import std.core as core;
import lang.thread as thread;

pub fn main() nothrow -> Int {
	var exec = conc.default_executor();

	thread.exec_submit_test_override(1);
	val res_busy = conc.spawn_on(exec, | | => { return 1; });
	var ok_busy = false;
	match res_busy {
		Err(err) => {
			if err.kind == conc.CONCURRENCY_KIND_BUSY { ok_busy = true; }
		},
		Ok(_t) => {},
		default => {},
	}

	thread.exec_submit_test_override(2);
	val res_timeout = conc.spawn_on(exec, | | => { return 1; });
	var ok_timeout = false;
	match res_timeout {
		Err(err) => {
			if err.kind == conc.CONCURRENCY_KIND_TIMEOUT { ok_timeout = true; }
		},
		Ok(_t) => {},
		default => {},
	}

	thread.exec_submit_test_override(-1);

	if ok_busy {
		if ok_timeout {
			return 0;
		}
	}
	return 1;
}

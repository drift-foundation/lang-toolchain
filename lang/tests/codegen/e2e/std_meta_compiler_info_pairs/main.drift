module main;

import std.core as core;
import std.meta as meta;

fn str_eq(a: &String, b: &String) nothrow -> Bool {
	val an = a.byte_length();
	val bn = b.byte_length();
	if an != bn {
		return false;
	}
	var i = 0;
	while i < an {
		if core.string_byte_at(a, i) != core.string_byte_at(b, i) {
			return false;
		}
		i = i + 1;
	}
	return true;
}

pub fn main() nothrow -> Int {
	val pairs = meta.compiler_info_pairs();

	// Must have at least 4 tags.
	if pairs.len < 4 {
		return 1;
	}

	// First key must be "driftc".
	val k0 = "driftc";
	if !str_eq(pairs[0].key(), k0) {
		return 2;
	}

	// Second key must be "abi".
	val k1 = "abi";
	if !str_eq(pairs[1].key(), k1) {
		return 3;
	}

	// Third key must be "word".
	val k2 = "word";
	if !str_eq(pairs[2].key(), k2) {
		return 4;
	}

	// "build_utc" key must exist somewhere.
	val k_build = "build_utc";
	var found_build = false;
	var i = 0;
	while i < pairs.len {
		if str_eq(pairs[i].key(), k_build) {
			found_build = true;
		}
		i = i + 1;
	}
	if !found_build {
		return 5;
	}

	// All keys and values must be non-empty.
	var j = 0;
	while j < pairs.len {
		val kj = pairs[j].key();
		if kj.byte_length() == 0 {
			return 6;
		}
		val vj = pairs[j].value();
		if vj.byte_length() == 0 {
			return 7;
		}
		j = j + 1;
	}

	return 0;
}

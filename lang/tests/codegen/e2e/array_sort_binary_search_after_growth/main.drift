module main;

import std.algo as algo;
import std.containers as containers;
import std.core.cmp as cmp;
import std.iter as iter;
use trait algo.BinarySearchable;
use trait cmp.Comparable;
use trait iter.RandomAccessPermutable;

pub fn main() nothrow -> Int {
	var arr = [3, 1];
	arr.reserve(4);
	arr.push(2);
	arr.push(5);
	var r = arr.range_mut();
	try {
		algo.sort_in_place<type containers.ArrayRangeMut<Int>, Int>(r);
	} catch _ {
		return 10;
	}
	var r2 = arr.range();
	var found_idx = -1;
	try {
		val f = algo.binary_search<type containers.ArrayRange<Int>, Int>(r2, 2);
		match f {
			Some(i) => { found_idx = i; },
			None => {}
		}
	} catch _ {
		return 11;
	}
	if found_idx < 0 {
		return 21;
	}
	if found_idx != 1 {
		return 20;
	}
	return arr[0] * 1000 + arr[1] * 100 + arr[2] * 10 + arr[3];
}

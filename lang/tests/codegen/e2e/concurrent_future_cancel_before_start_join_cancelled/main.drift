module main;

import std.concurrent as conc;

fn main() nothrow -> Int {
	var f = conc.spawn_future(| | => { return 1; });
	f.cancel();
	var res = f.join();
		match res {
		Err(err) => {
			if err.kind == conc.CONCURRENCY_KIND_CANCELLED { return 0; }
			return 1;
		},
		Ok(_v) => { return 2; },
		default => { return 2; },
	}
}

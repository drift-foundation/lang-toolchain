module main;

import std.core as core;
import std.format as fmt;

fn do_work(code: Int) nothrow -> Int {
	// Case 2: local binding from creator, then DV wrapping.
	// s is a local that string_arc manages via scope-exit.
	// The DV wrapping must retain (drift_dv_string), not steal ownership.
	val s = fmt.format_int(code);
	val dv = DiagnosticValue::String(s);
	return code;
}

pub fn main() nothrow -> Int {
	val r1 = do_work(200);
	val r2 = do_work(200);
	val r3 = do_work(200);
	return r1 + r2 + r3 - 600;
}

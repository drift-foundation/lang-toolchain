module m;

import std.concurrent as conc;
import std.core as core;
import std.net as net;

pub fn main() nothrow -> Int {
	val io_t = conc.Duration(millis = 2000);

	// Listen on 127.0.0.1 with ephemeral port.
	var bind_addr = net.socket_addr("127.0.0.1", 0);
	var lr = net.listen(bind_addr, io_t);
	match lr {
		Ok(l) => {
			val port = l.test_local_port();

			// Connect via IP literal — should succeed (baseline).
			var t_ip = conc.spawn(| | captures(copy port, copy io_t) => {
				var a = net.socket_addr("127.0.0.1", port);
				var cr = net.connect(a, io_t);
				match cr {
					Ok(s) => { val _ = s.close(io_t); return 0; },
					Err(_) => { return 1; },
					default => { return 2; }
				}
			});
			var ar1 = net.accept(l, io_t);
			match ar1 {
				Ok(s2) => { val _ = s2.close(io_t); },
				Err(_) => { return 10; },
				default => { return 11; }
			}
			var tr1 = t_ip.join();
			match tr1 {
				Ok(v) => { if v != 0 { return 20 + v; } },
				Err(_) => { return 30; },
				default => { return 31; }
			}

			// Connect via hostname "localhost" — the regression target.
			var t_host = conc.spawn(| | captures(copy port, copy io_t) => {
				var a = net.socket_addr("localhost", port);
				var cr = net.connect(a, io_t);
				match cr {
					Ok(s) => { val _ = s.close(io_t); return 0; },
					Err(_) => { return 1; },
					default => { return 2; }
				}
			});
			var ar2 = net.accept(l, io_t);
			match ar2 {
				Ok(s2) => { val _ = s2.close(io_t); },
				Err(_) => { return 40; },
				default => { return 41; }
			}
			var tr2 = t_host.join();
			match tr2 {
				Ok(v) => { if v != 0 { return 50 + v; } },
				Err(_) => { return 60; },
				default => { return 61; }
			}

			return 0;
		},
		Err(_) => { return 90; },
		default => { return 91; }
	}
}

module m;

import std.sync as sync;

fn run() -> Int {
	val iters = 300000;
	var a = sync.atomic_int(0);
	var i = 0;
	while i < iters {
		val _ = a.fetch_add(1, sync.MemoryOrder::Relaxed());
		i = i + 1;
	}
	if a.load(sync.MemoryOrder::Relaxed()) != iters {
		return 1;
	}
	return 0;
}

pub fn main() nothrow -> Int {
	return try run() catch { 99 };
}

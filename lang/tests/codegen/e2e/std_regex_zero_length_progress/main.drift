module main;

import std.core as core;
import std.regex as regex;

fn check_match(pattern: &String, input: &String, exp_start: Int, exp_end: Int, fail_code: Int) nothrow -> Int {
	match regex.compile(pattern) {
		core.Result::Ok(re) => {
			match regex.find_first(&re, input) {
				Optional::Some(m) => {
					if m.start != exp_start { return fail_code; }
					if m.end != exp_end { return fail_code + 1; }
					return 0;
				},
				Optional::None() => { return fail_code + 2; }
			}
		},
		core.Result::Err(_) => { return fail_code + 3; }
	}
}

fn check_is_match(pattern: &String, input: &String, expected: Bool, fail_code: Int) nothrow -> Int {
	match regex.compile(pattern) {
		core.Result::Ok(re) => {
			val got = regex.is_match(&re, input);
			if got != expected { return fail_code; }
			return 0;
		},
		core.Result::Err(_) => { return fail_code + 1; }
	}
}

fn main() nothrow -> Int {
	var rc = 0;

	// --- §7: empty pattern match on empty input ---
	rc = check_match(&"", &"", 0, 0, 1);
	if rc != 0 { return rc; }

	// --- §7: empty pattern match on non-empty input → zero-length at 0 ---
	rc = check_match(&"", &"abc", 0, 0, 5);
	if rc != 0 { return rc; }

	// --- §7: a* on empty input → zero-length match at 0 ---
	rc = check_match(&"a*", &"", 0, 0, 9);
	if rc != 0 { return rc; }

	// --- §7: a* on non-matching input → zero-length at 0 ---
	rc = check_match(&"a*", &"bbb", 0, 0, 13);
	if rc != 0 { return rc; }

	// --- §7: a* on matching input → greedy, longest at start ---
	rc = check_match(&"a*", &"aaab", 0, 3, 17);
	if rc != 0 { return rc; }

	// --- §7: a? on empty → zero-length at 0 ---
	rc = check_match(&"a?", &"", 0, 0, 21);
	if rc != 0 { return rc; }

	// --- §7: a? on "b" → zero-length at 0 ---
	rc = check_match(&"a?", &"b", 0, 0, 25);
	if rc != 0 { return rc; }

	// --- §7: a? on "a" → length-1 at 0 ---
	rc = check_match(&"a?", &"a", 0, 1, 29);
	if rc != 0 { return rc; }

	// --- §8: forward progress — simulated find_all loop.
	// Pattern "" matches empty at every position.
	// A manual loop calling find_first with advancing start must terminate.
	// We simulate by checking matches at positions 0, 1, 2, 3 on "abc".
	val p_empty = "";
	match regex.compile(&p_empty) {
		core.Result::Ok(re) => {
			// Simulated find_all with forward-progress guard:
			// After a zero-length match at position P, next search starts at P+1.
			val input = "abc";
			val input_len = input.byte_length();
			var pos = 0;
			var match_count = 0;
			while pos <= input_len {
				match regex.find_first(&re, &input) {
					Optional::Some(m) => {
						match_count = match_count + 1;
						// Guarantee forward progress.
						if m.end == m.start {
							pos = pos + 1;
						} else {
							pos = m.end;
						}
					},
					Optional::None() => {
						pos = pos + 1;
					}
				}
				// Safety: must terminate within input_len + 1 iterations.
				if match_count > input_len + 1 {
					return 40;
				}
			}
			// We should have gotten at least one match.
			if match_count == 0 { return 41; }
		},
		core.Result::Err(_) => { return 42; }
	}

	// --- anchored empty: ^$ matches only empty ---
	rc = check_is_match(&"^$", &"", true, 50);
	if rc != 0 { return rc; }

	rc = check_is_match(&"^$", &"a", false, 52);
	if rc != 0 { return rc; }

	// --- ^a* on "bbb" should still match (zero-length at start) ---
	rc = check_is_match(&"^a*", &"bbb", true, 54);
	if rc != 0 { return rc; }

	rc = check_match(&"^a*", &"bbb", 0, 0, 56);
	if rc != 0 { return rc; }

	return 0;
}

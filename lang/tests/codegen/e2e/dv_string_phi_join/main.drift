module main;

import std.core as core;
import std.format as fmt;

fn make_flag() nothrow -> Optional<Int> {
	return Optional::Some(42);
}

fn do_work(code: Int) nothrow -> Int {
	// Case 5: control-flow join / PHI-shaped string producer.
	// The string comes from different match arms, joined at the match exit.
	val s = match make_flag() {
		Some(v) => { fmt.format_int(v) },
		None => { fmt.format_int(0) }
	};
	val dv = DiagnosticValue::String(s);
	return code;
}

pub fn main() nothrow -> Int {
	val r1 = do_work(200);
	val r2 = do_work(200);
	val r3 = do_work(200);
	return r1 + r2 + r3 - 600;
}

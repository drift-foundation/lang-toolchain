module main

import std.core as core;

struct Payload {
	name: String
	count: Int
}

fn main() nothrow -> Int {
	val p = Payload(name = "job-1", count = 9);
	var cb: core.Callback0<Int> = core.callback0(| | captures(move p) => {
		val q = move p;
		return q.count;
	});
	val a = cb.call();
	val b = cb.call();
	if a != 9 { return 30; }
	if b != 0 { return 31; }
	return 0;
}

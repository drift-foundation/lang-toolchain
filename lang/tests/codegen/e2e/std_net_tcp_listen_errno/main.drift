module m;

import std.net as net;
import std.concurrent as conc;

pub fn main() nothrow -> Int {
	var addr = net.socket_addr("127.0.0.1", 0);
	val t = conc.Duration(millis = 1000);
	var lr = net.listen(addr, t);
	match lr {
		Ok(_l) => { return 0; },
		Err(e) => {
			var code = 202;
			if e.kind == net.NET_ERROR_KIND_ERRNO { code = e.code; }
			if e.kind == net.NET_ERROR_KIND_WOULD_BLOCK { code = 201; }
			return code;
		},
		default => { return 203; }
	}
}

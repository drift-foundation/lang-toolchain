module main;

import std.core as core;
import std.format as fmt;
import std.containers as containers;

// Minimal reproducer: HashMap<String, String> map literal.
// The strings inside the map should be freed when the map goes out of scope.

fn consume_map(m: containers.HashMap<String, String>) nothrow -> Int {
	return m.len();
}

pub fn main() nothrow -> Int {
	// Map literal with format_int values — exact bookkeeper pattern
	val n = consume_map({"port": fmt.format_int(42)});
	val m = consume_map({"a": fmt.format_int(1), "b": fmt.format_int(2)});
	return n + m;
}

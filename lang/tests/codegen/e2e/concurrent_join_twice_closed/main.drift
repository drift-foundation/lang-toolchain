module m;

import std.concurrent as conc;
import std.core as core;

pub fn main() nothrow -> Int {
	var t = conc.spawn_cb(core.callback0(| | nothrow => { return 7; }));
	var r1 = t.join();
	var acc = 0;
	match r1 {
		Ok(v) => { acc = acc + v; },
		Err(_) => { return 1; },
		default => { return 2; }
	}
	var r2 = t.join();
	match r2 {
		Err(e) => {
			if e.kind == conc.CONCURRENCY_KIND_CLOSED { return acc; }
			return 3;
		},
		Ok(_) => { return 4; },
		default => { return 5; }
	}
}

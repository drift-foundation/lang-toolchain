module main;

import std.core as core;
import std.format as fmt;
import std.log as log;

pub fn main() nothrow -> Int {
	var cfgb = log.config_builder();
	cfgb.sink(log.stderr_sink());
	cfgb.min_level(log.Level::Error());
	val logger = log.create_logger("test", cfgb.build());

	// This is the exact pattern that caused a use-after-free in 0.27.146:
	// DiagnosticValue::String wrapping a heap string in a map literal
	// passed to logger.info().  The HashMap cleanup tried to release
	// the string after drift_dv_release_impl already freed it.
	val _ = logger.info("event", {
		"port": DiagnosticValue::String(fmt.format_int(8080))
	});
	val _ = logger.info("event", {
		"port": DiagnosticValue::String(fmt.format_int(8081))
	});
	val _ = logger.info("event", {
		"port": DiagnosticValue::String(fmt.format_int(8082))
	});
	return 0;
}

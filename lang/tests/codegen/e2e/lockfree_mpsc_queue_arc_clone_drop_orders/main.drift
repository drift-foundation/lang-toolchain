module m;

import std.sync as sync;
import std.concurrent as conc;

struct Node { v: Int }

fn push_from_clone(var root: conc.Arc<sync.MpscQueue<Node>>, v: Uint) nothrow -> Bool {
	var c = root.clone();
	val queue_ref = c.get();
	return queue_ref.push(sync.handle<type Node>(v));
}

fn push_from_nested_clone(var root: conc.Arc<sync.MpscQueue<Node>>, v: Uint) nothrow -> Bool {
	var a = root.clone();
	var b = root.clone();
	val queue_ref_b = b.get();
	if not queue_ref_b.push(sync.handle<type Node>(v)) { return false; }
	val queue_ref_a = a.get();
	if not queue_ref_a.push(sync.handle<type Node>(v + cast<Uint>(11))) { return false; }
	return true;
}

fn main() nothrow -> Int {
	var root = conc.arc(sync.mpsc_queue<type Node>(8));
	var root1 = root.clone();
	if not push_from_nested_clone(move root1, cast<Uint>(11)) { return 1; }
	var root2 = root.clone();
	if not push_from_clone(move root2, cast<Uint>(33)) { return 2; }

	val queue_ref = root.get();
	match queue_ref.pop() {
		Some(v) => { if v.to_uint() != cast<Uint>(11) { return 3; } },
		default => { return 4; }
	}
	match queue_ref.pop() {
		Some(v) => { if v.to_uint() != cast<Uint>(22) { return 5; } },
		default => { return 6; }
	}
	match queue_ref.pop() {
		Some(v) => { if v.to_uint() != cast<Uint>(33) { return 7; } },
		default => { return 8; }
	}
	match queue_ref.pop() {
		Some(_) => { return 9; },
		default => {}
	}

	return 0;
}

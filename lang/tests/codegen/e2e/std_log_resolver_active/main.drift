module m;

import std.core as core;
import std.log as log;
import std.concurrent as conc;

// A stateful resolver: pre-builds the LogContext at construction
// time and hands out a borrow into its own field on every
// resolve() call.  Matches the app-team pattern of "resolver
// holds the context, logger reads it synchronously per emit".
pub struct StdResolver {
	ctx: log.LogContext
}

pub fn std_resolver(user_tag: String, req_tag: String) nothrow -> StdResolver {
	var ctx = log.log_context();
	ctx.put("user", user_tag);
	ctx.put("req", req_tag);
	return StdResolver(ctx = move ctx);
}

implement log.ContextResolver for StdResolver {
	pub fn resolve(self: &StdResolver) nothrow -> Optional<&log.LogContext> {
		return Optional<&log.LogContext>::Some(&self.ctx);
	}
}

fn run() -> Int {
	var b = log.config_builder();
	b.min_level(log.Level::Debug());
	b.context_resolver(
		conc.arc(std_resolver("u-ambient", "r-ambient"))
			.as_interface<type log.ContextResolver>()
	);
	val main = log.create_logger("svc", b.build());

	// Bare info: ambient ctx merged.
	main.info("bare-info");

	// Bare info + typed attrs: ambient ctx + attrs (caller wins on key collision).
	// Slice 7a: the original DV-mixed-type attrs map was retired with the DV
	// public-surface deletion; the typed-V Debuggable form requires a single V
	// per call, and the pre-projected `HashMap<String, String>` form on the
	// 2-arg `info(ev, attrs)` overload doesn't exist in this slice (a 3-arg
	// form with empty `&log.log_context()` would suppress the resolver).
	// The resolver-merge behavior is still pinned by the `bare-info` event
	// above; the explicit attrs override on a typed-V call is pinned by
	// `bare-info-attrs` below with a single-V map.
	main.info("bare-info-attrs", {"user": "u-caller-wins"});

	// Explicit ctx: resolver suppressed; only explicit attrs surface.
	var explicit = log.log_context();
	explicit.put("scope", "explicit");
	main.info("explicit-info", &explicit);

	// Explicit ctx + pre-projected JSON-text attrs: merge with attrs winning.
	// Slice 7a: the 3-arg `info(ev, ctx, attrs: HashMap<String, String>)` form
	// splices values verbatim — the user must hand it canonical JSON via
	// `core.diagnostic_json_*`.  This is the migration shape for what was
	// previously the `HashMap<String, DiagnosticValue>` mixed-type override.
	main.info("explicit-info-attrs", &explicit, {"scope": core.diagnostic_json_string(&"override")});

	// Explicit ctx + typed (single-type) attrs: same merge semantics, no JSON-text projection.
	main.info("explicit-info-typed-attrs", &explicit, {"size": 42});

	// Explicit empty ctx: per-call opt-out from resolver.
	main.info("opt-out-info", &log.log_context());

	// Same patterns at debug, including typed ctx+attrs.
	main.debug("bare-debug");
	main.debug("explicit-debug-typed-attrs", &explicit, {"size": 42});
	main.debug("opt-out-debug", &log.log_context());

	// Same patterns at error, including typed ctx+attrs.
	main.error("bare-error");
	main.error("explicit-error-typed-attrs", &explicit, {"size": 42});
	main.error("opt-out-error", &log.log_context());
	return 0;
}

pub fn main() nothrow -> Int {
	return try run() catch { 99 };
}

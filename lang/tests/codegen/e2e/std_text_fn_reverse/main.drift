module main;

import std.core as core;
import std.text as text;

fn str_eq(a: &String, b: &String) nothrow -> Bool {
	val an = a.byte_length();
	val bn = b.byte_length();
	if an != bn { return false; }
	var i = 0;
	while i < an {
		if core.string_byte_at(a, i) != core.string_byte_at(b, i) { return false; }
		i = i + 1;
	}
	return true;
}


fn main() nothrow -> Int {
	val r = text.reverse(&"hello");
	val e = "olleh";
	if !str_eq(&r, &e) { return 1; }
	// Single char
	val r2 = text.reverse(&"a");
	val e2 = "a";
	if !str_eq(&r2, &e2) { return 2; }
	// Empty
	val r3 = text.reverse(&"");
	val e3 = "";
	if !str_eq(&r3, &e3) { return 3; }
	// Palindrome
	val r4 = text.reverse(&"aba");
	val e4 = "aba";
	if !str_eq(&r4, &e4) { return 4; }

	return 0;
}

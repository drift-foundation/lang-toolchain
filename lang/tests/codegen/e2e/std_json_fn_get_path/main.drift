module main;

import std.core as core;
import std.json as json;

pub fn main() nothrow -> Int {
	// Object-only path through nested objects.
	val text = "{\"meta\":{\"callback\":{\"status\":\"ok\",\"code\":42},\"flag\":true},\"items\":[1,2,3]}";

	match json.parse(&text) {
		core.Result::Err(_) => { return 100; },
		core.Result::Ok(root) => {

			// 1) Happy path: three-segment dotted traversal to a leaf String.
			match root.get_path("meta.callback.status") {
				Optional::Some(node) => {
					match node.as_string() {
						Optional::Some(s) => {
							val want = "ok";
							if s.byte_length() != 2 { return 1; }
							if core.string_byte_at(&s, 0) != cast<Byte>(111) { return 2; }  // 'o'
							if core.string_byte_at(&s, 1) != cast<Byte>(107) { return 3; }  // 'k'
						},
						Optional::None() => { return 4; }
					}
				},
				Optional::None() => { return 5; }
			}

			// 2) Happy path: leaf Number.
			match root.get_path("meta.callback.code") {
				Optional::Some(node) => {
					match node.as_int() {
						Optional::Some(v) => { if v != 42 { return 10; } },
						Optional::None() => { return 11; }
					}
				},
				Optional::None() => { return 12; }
			}

			// 3) Single-segment path (one key).
			match root.get_path("meta") {
				Optional::Some(_) => { },
				Optional::None() => { return 20; }
			}

			// 4) Empty path returns Some(self).  Verified by traversing one more
			//    step from the returned node.
			match root.get_path("") {
				Optional::Some(node) => {
					match node.get_path("meta.flag") {
						Optional::Some(_) => { },
						Optional::None() => { return 30; }
					}
				},
				Optional::None() => { return 31; }
			}

			// 5) Missing leaf segment → None.
			match root.get_path("meta.callback.nope") {
				Optional::Some(_) => { return 40; },
				Optional::None() => { }
			}

			// 6) Missing intermediate segment → None.
			match root.get_path("meta.nope.status") {
				Optional::Some(_) => { return 50; },
				Optional::None() => { }
			}

			// 7) Missing top-level segment → None.
			match root.get_path("nope") {
				Optional::Some(_) => { return 60; },
				Optional::None() => { }
			}

			// 8) Path walks through a non-object (Bool) intermediate → None.
			match root.get_path("meta.flag.anything") {
				Optional::Some(_) => { return 70; },
				Optional::None() => { }
			}

			// 9) Array traversal is not supported in v1 → None.
			match root.get_path("items.0") {
				Optional::Some(_) => { return 80; },
				Optional::None() => { }
			}

			// 10) Leaf is an array — get_path returns the array node itself, not
			//     an element.  Narrowing via as_array() is the user's job.
			match root.get_path("items") {
				Optional::Some(node) => {
					match node.as_array() {
						Optional::Some(_) => { },
						Optional::None() => { return 90; }
					}
				},
				Optional::None() => { return 91; }
			}
		}
	}

	return 0;
}

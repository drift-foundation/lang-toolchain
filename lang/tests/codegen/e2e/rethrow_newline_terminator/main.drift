module main;

import std.console as console;

error E {}
fn run() -> Int {
    try {
        try {
            throw E();
        } catch err {
            console.print("inner");
            rethrow;
        }
        console.print("UNREACHABLE");
    } catch err {
        console.print("outer");
    }
    return 0;
}

pub fn main() nothrow -> Int{
    try run() catch { return 0; }
    return 0;
}

module m;

import std.core as core;
import std.json as json;

fn run() -> Int {
	val text = "12345";
	var i = 0;
	while i < 2000 {
		match json.parse(&text) {
			core.Result::Ok(node) => {
				core.drop_value<type json.JsonNode>(move node);
			},
			core.Result::Err(_e) => { return 3; }
		}
		i = i + 1;
	}
	return 0;
}

fn main() nothrow -> Int {
	return try run() catch { 99 };
}

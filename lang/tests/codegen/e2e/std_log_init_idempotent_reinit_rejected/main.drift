module m

import std.log as log;

fn run() -> Int {
	var b1 = log.config_builder();
	b1.min_level(log.Level::Info());
	b1.queue_capacity(2);
	val l1 = log.create_logger("one", b1.build());
	var b2 = log.config_builder();
	b2.min_level(log.Level::Error());
	b2.queue_capacity(2);
	val l2 = log.create_logger("two", b2.build());
	if l1.info("i1", {"x": 1}) == false {
		return 1;
	}
	if l2.info("i2", {"x": 2}) {
		return 2;
	}
	if not l2.error("e2", {"x": 3}) {
		return 3;
	}
	return 0;
}

fn main() nothrow -> Int {
	return try run() catch { 99 };
}

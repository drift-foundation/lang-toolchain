module main;

import std.containers as containers;

pub fn main() nothrow -> Int {
var dq = containers.deque<type Int>();
	dq.push_back(1);
	dq.push_back(2);
	dq.push_back(3);
	dq.push_back(4);
	dq.push_back(5);
	val _a = dq.pop_front();
	val _b = dq.pop_front();
	dq.push_back(6);
	dq.push_back(7);
	var i = 0;
	var acc = 0;
	var threw = false;
	while i < dq.len() {
		try {
			acc = acc * 10 + *dq.at(i);
		} catch std.err:IndexError(_) {
			threw = true;
		} catch {
			threw = true;
		}
		i = i + 1;
	}
	return threw ? -1 : acc;
}

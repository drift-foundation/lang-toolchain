module main;

import std.core as core;
import std.text as text;

fn str_eq(a: &String, b: &String) nothrow -> Bool {
	val an = a.byte_length();
	val bn = b.byte_length();
	if an != bn {
		return false;
	}
	var i = 0;
	while i < an {
		if core.string_byte_at(a, i) != core.string_byte_at(b, i) {
			return false;
		}
		i = i + 1;
	}
	return true;
}

pub fn main() nothrow -> Int {
	val s = "hello world";

	// Middle slice: "lo wo"
	match text.substring(&s, 3, 5) {
		core.Result::Ok(v) => {
			val expect = "lo wo";
			if !str_eq(&v, &expect) {
				return 1;
			}
		},
		core.Result::Err(_) => { return 2; }
	}

	// Prefix: "hello"
	match text.substring(&s, 0, 5) {
		core.Result::Ok(v) => {
			val expect = "hello";
			if !str_eq(&v, &expect) {
				return 3;
			}
		},
		core.Result::Err(_) => { return 4; }
	}

	// Suffix: "world"
	match text.substring(&s, 6, 5) {
		core.Result::Ok(v) => {
			val expect = "world";
			if !str_eq(&v, &expect) {
				return 5;
			}
		},
		core.Result::Err(_) => { return 6; }
	}

	// Full string
	match text.substring(&s, 0, 11) {
		core.Result::Ok(v) => {
			val expect = "hello world";
			if !str_eq(&v, &expect) {
				return 7;
			}
		},
		core.Result::Err(_) => { return 8; }
	}

	// Empty len=0
	match text.substring(&s, 3, 0) {
		core.Result::Ok(v) => {
			val expect = "";
			if !str_eq(&v, &expect) {
				return 9;
			}
		},
		core.Result::Err(_) => { return 10; }
	}

	// Out-of-bounds: start + len > byte_length
	match text.substring(&s, 8, 5) {
		core.Result::Ok(_) => { return 11; },
		core.Result::Err(e) => {
			val tag_expect = "out-of-bounds";
			if !str_eq(&e.tag, &tag_expect) {
				return 12;
			}
		}
	}

	// Negative start
	match text.substring(&s, 0 - 1, 3) {
		core.Result::Ok(_) => { return 13; },
		core.Result::Err(_) => { }
	}

	// Negative len
	match text.substring(&s, 0, 0 - 1) {
		core.Result::Ok(_) => { return 14; },
		core.Result::Err(_) => { }
	}

	return 0;
}

module repro;

struct Entry {
	pub name: String,
	pub value: String
}

struct Nested {
	pub label: String,
	pub data: Array<Byte>
}

// Positive: Copy field (String) projected from non-Copy element.
fn find_by_name(entries: &Array<Entry>, target: String) nothrow -> Int {
	var i = 0;
	while i < entries.len {
		if entries[i].name == target { return i; }
		i = i + 1;
	}
	return -1;
}

// Positive: non-Copy field (Array<Byte>) projected from non-Copy element.
// The field itself is non-Copy, so the MIR path should NOT emit CopyValue
// but should still produce a valid read via LoadRef.
fn first_data_len(items: &Array<Nested>) nothrow -> Int {
	if items.len == 0 { return -1; }
	return items[0].data.len;
}

pub fn main() nothrow -> Int {
	// Test 1: find_by_name — Copy field from non-Copy element
	var entries: Array<Entry> = [];
	entries.push(Entry(name = "alice", value = "one"));
	entries.push(Entry(name = "bob", value = "two"));
	val idx = find_by_name(entries, "bob");
	if idx != 1 { return 1; }

	// Test 2: non-Copy field projection (data.len reads through borrow)
	var items: Array<Nested> = [];
	var d: Array<Byte> = [cast<Byte>(10), cast<Byte>(20), cast<Byte>(30)];
	items.push(Nested(label = "first", data = move d));
	val dlen = first_data_len(items);
	if dlen != 3 { return 2; }

	return 0;
}

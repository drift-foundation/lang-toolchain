module main
import std.core as core;
import std.regex as regex;

fn expect_ok(pattern: &String, fail_code: Int) nothrow -> Int {
	match regex.compile(pattern) {
		core.Result::Ok(_) => { return 0; },
		core.Result::Err(_) => { return fail_code; }
	}
}

fn main() nothrow -> Int {
	var rc = 0;
	rc = expect_ok(&"abc", 1);   if rc != 0 { return rc; }
	rc = expect_ok(&"x", 2);     if rc != 0 { return rc; }
	rc = expect_ok(&"a.b", 3);   if rc != 0 { return rc; }
	rc = expect_ok(&"...", 4);   if rc != 0 { return rc; }
	rc = expect_ok(&"^abc$", 5); if rc != 0 { return rc; }
	rc = expect_ok(&"^$", 6);    if rc != 0 { return rc; }
	rc = expect_ok(&"a*", 10);   if rc != 0 { return rc; }
	rc = expect_ok(&"a+", 11);   if rc != 0 { return rc; }
	rc = expect_ok(&"a?", 12);   if rc != 0 { return rc; }
	return 0;
}

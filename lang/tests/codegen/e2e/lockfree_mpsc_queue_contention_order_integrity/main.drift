module m;

import std.sync as sync;
import std.concurrent as conc;
import std.containers as containers;
import std.core as core;
import lang.thread as thread;

struct Node { v: Int }

fn encode(prod: Int, seq: Int) nothrow -> Uint {
	return cast<Uint>(prod * 100000 + seq);
}

fn decode_prod(raw: Uint) nothrow -> Int {
	return cast<Int>(raw) / 100000;
}

fn decode_seq(raw: Uint) nothrow -> Int {
	return cast<Int>(raw) % 100000;
}

fn producer(q: conc.Arc<sync.MpscQueue<Node>>, pid: Int, n: Int) nothrow -> Int {
	var i = 0;
	while i < n {
		val payload = encode(pid, i);
		val queue_ref = q.get();
		while not queue_ref.push(sync.handle<type Node>(payload)) {
			thread.vt_yield();
		}
		i = i + 1;
	}
	return n;
}

fn run() -> Int {
	val producers = 4;
	val per = 96;
	val total = producers * per;
	var q = conc.arc(sync.mpsc_queue<type Node>(128));
	var tasks = containers.deque<type conc.VirtualThread<Int>>();

	var p = 0;
	while p < producers {
		var qq = q.clone();
		var t = conc.spawn_cb(core.callback0(| | captures(move qq, copy p, copy per) => { return producer(move qq, p, per); }));
		tasks.push_back(move t);
		p = p + 1;
	}

	var last: Array<Int> = [];
	var seen_by_prod: Array<Int> = [];
	var i = 0;
	while i < producers {
		last.push(-1);
		seen_by_prod.push(0);
		i = i + 1;
	}

	var seen = 0;
	while seen < total {
		val queue_ref = q.get();
		match queue_ref.pop() {
			Some(v) => {
				val raw = v.to_uint();
				val pid = decode_prod(raw);
				if pid < 0 or pid >= producers { return 1; }
				val seq = decode_seq(raw);
				if seq < 0 or seq >= per { return 2; }
				val prev = last[pid];
				if seq <= prev { return 3; }
				if seq != prev + 1 { return 4; }
				last[pid] = seq;
				seen_by_prod[pid] = seen_by_prod[pid] + 1;
				seen = seen + 1;
			},
			default => { thread.vt_yield(); }
		}
	}

	while true {
		match tasks.pop_front() {
			Some(var t) => {
				match t.join() {
					Ok(_) => { },
					default => { return 5; }
				}
			},
			default => { break; }
		}
	}

	i = 0;
	while i < producers {
		if seen_by_prod[i] != per { return 6; }
		if last[i] != per - 1 { return 7; }
		i = i + 1;
	}

	return 0;
}

pub fn main() nothrow -> Int {
	return try run() catch { 99 };
}

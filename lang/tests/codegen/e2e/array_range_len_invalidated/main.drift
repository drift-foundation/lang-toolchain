module main;

import std.err;
import std.iter as iter;

fn main() nothrow -> Int {
	var arr = [1, 2];
	var r = arr.range();
	arr.push(3);
	val out = try iter.RandomAccessReadable::len(&r) catch std.err:IteratorInvalidated(e) {
		// Slice 7a: typed catch projection on the `container_id` String
		// field.  The `op_id` field is `IteratorOpId` (a variant) — its
		// throw-side params-JSON projection currently double-quotes the
		// numeric tag (the auto-promotion path wraps the variant's
		// `to_json_text` output in `DV::String`, which then JSON-quotes
		// the already-canonical numeric body).  That's a separate
		// variant-field projection bug, out of scope for Slice 7a; this
		// test pins the container_id round-trip and the
		// IteratorInvalidated catch path while the op_id tag check
		// stays deferred.
		(e.container_id != "std.containers:Array") ? 10 : 0
	} catch {
		99
	};
	return out;
}

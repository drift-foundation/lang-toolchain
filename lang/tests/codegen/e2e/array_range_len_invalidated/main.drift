module main;

import std.err;
import std.iter as iter;

fn main() nothrow -> Int {
	var arr = [1, 2];
	var r = arr.range();
	arr.push(3);
	val out = try iter.RandomAccessReadable::len(&r) catch std.err:IteratorInvalidated(e) {
		// Slice 7b: variant-field projection through params JSON now
		// splices the canonical numeric tag verbatim (no DV-wrap re-
		// encoding), so `op_id` reads back as a bare integer.  Len → 2
		// per IteratorOpId's manual `Diagnostic` impl in std.err.
		// container_id is a synthesized String field (typed catch
		// scalar projection); op_id is a variant, accessed via the
		// params cursor.
		val cid_bad = (e.container_id != "std.containers:Array");
		val op = match e.params.get("op_id").as_int() {
			Some(v) => { v },
			None => { -1 }
		};
		val op_bad = (op != 2);
		(cid_bad ? 10 : 0) + (op_bad ? 20 : 0)
	} catch {
		99
	};
	return out;
}

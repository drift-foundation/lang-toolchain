module m
import std.core as core;
import std.json as json;
fn run() -> Int {
  val a = "{";
  match json.parse(&a) {
    core.Result::Ok(_) => { return 1; },
    core.Result::Err(e) => { if e.tag == "" { return 2; } }
  }
  val b = "[";
  match json.parse(&b) {
    core.Result::Ok(_) => { return 3; },
    core.Result::Err(e2) => { if e2.tag == "" { return 4; } }
  }
  return 0;
}
fn main() nothrow -> Int { return try run() catch { 99 }; }

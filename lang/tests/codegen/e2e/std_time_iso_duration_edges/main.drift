module m;

import std.core as core;
import std.time as time;

fn must_parse(s: String) -> core.Result<time.UtcTimestamp, Int> {
	match time.parse_iso8601_utc(s) {
		core.Result::Ok(ts) => { return core.Result::Ok(move ts); },
		core.Result::Err(_) => { return core.Result::Err(1); }
	}
}

fn expect_delta(a: String, b: String, want_us: Int) -> Int {
	val pa = must_parse(a);
	val pb = must_parse(b);
	match pa {
		core.Result::Ok(ta) => {
			match pb {
				core.Result::Ok(tb) => {
					val got = time.duration_micros_between(ta, tb);
					if got != want_us {
						return 2;
					}
					return 0;
				},
				core.Result::Err(_) => { return 3; }
			}
		},
		core.Result::Err(_) => { return 4; }
	}
}

fn run() -> Int {
	if expect_delta("1970-01-01T00:00:00.000000Z", "1970-01-01T00:00:01.000000Z", 1000000) != 0 { return 10; }
	if expect_delta("1970-01-01T00:00:00.000000Z", "1970-01-01T00:01:00.000000Z", 60000000) != 0 { return 11; }
	if expect_delta("1970-01-01T00:00:00.000000Z", "1970-01-02T00:00:00.000000Z", 86400000000) != 0 { return 12; }
	if expect_delta("1969-12-31T23:59:59.000000Z", "1970-01-01T00:00:00.000000Z", 1000000) != 0 { return 13; }
	if expect_delta("2024-02-28T23:59:59.000000Z", "2024-02-29T00:00:00.000000Z", 1000000) != 0 { return 14; }
	if expect_delta("2024-02-29T23:59:59.000000Z", "2024-03-01T00:00:00.000000Z", 1000000) != 0 { return 15; }
	if expect_delta("2024-03-01T00:00:00.000000Z", "2024-02-29T23:59:59.000000Z", -1000000) != 0 { return 16; }
	if expect_delta("2000-02-28T00:00:00.000000Z", "2000-03-01T00:00:00.000000Z", 172800000000) != 0 { return 17; }
	if expect_delta("1900-02-28T00:00:00.000000Z", "1900-03-01T00:00:00.000000Z", 86400000000) != 0 { return 18; }
	if expect_delta("2000-01-01T00:00:00.000000Z", "2001-01-01T00:00:00.000000Z", 31622400000000) != 0 { return 19; }
	if expect_delta("2001-01-01T00:00:00.000000Z", "2002-01-01T00:00:00.000000Z", 31536000000000) != 0 { return 20; }
	return 0;
}

pub fn main() nothrow -> Int {
	return try run() catch { 99 };
}

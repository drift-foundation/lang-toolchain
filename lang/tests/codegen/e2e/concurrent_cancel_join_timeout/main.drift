module main;

import std.concurrent as conc;
import lang.thread as thread;

fn main() nothrow -> Int {
	var t = conc.spawn(| | => {
		thread.vt_park_until(10);
		return 5;
	});
	t.cancel();
	var res = t.join_timeout(conc.Duration(millis = 200));
		match res {
		Err(err) => {
			if err.kind == conc.CONCURRENCY_KIND_CANCELLED { return 0; }
			if err.kind == conc.CONCURRENCY_KIND_TIMEOUT { return 1; }
			return 2;
		},
		Ok(_v) => { return 3; },
		default => { return 4; },
	}
}

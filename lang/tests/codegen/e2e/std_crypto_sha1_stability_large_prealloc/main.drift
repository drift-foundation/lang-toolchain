module main

import std.crypto as crypto;

fn _eq_bytes(a: &Array<Byte>, b: &Array<Byte>) nothrow -> Bool {
	if a.len != b.len {
		return false;
	}
	var i = 0;
	while i < a.len {
		if a[i] != b[i] {
			return false;
		}
		i = i + 1;
	}
	return true;
}

fn main() nothrow -> Int {
	var payload = Array<type Byte>::with_capacity(200000);
	var i = 0;
	while i < 200000 {
		payload.push(cast<Byte>(i % 251));
		i = i + 1;
	}
	val baseline = crypto.sha1(&payload);
	if baseline.len != 20 {
		return 1;
	}
	var run = 0;
	while run < 64 {
		val cur = crypto.sha1(&payload);
		if not _eq_bytes(&baseline, &cur) {
			return 2;
		}
		run = run + 1;
	}
	return 0;
}

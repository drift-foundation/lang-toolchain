module main;

	import std.concurrent as conc;
	import std.core as core;

	pub fn main() nothrow -> Int {
		var counter = core.cell(0);
		var t = conc.spawn(| | => { return; });
		counter.set(0);
		t.cancel();
		var res = t.join();
		var v = counter.get();
		match res {
		Err(err) => {
			if err.kind == conc.CONCURRENCY_KIND_CANCELLED {
	var out = 2;
						if v == 0 {
							out = 0;
						}
				return out;
			}
			return 3;
		},
		Ok(_v) => { return 4; },
		default => { return 4; },
	}
}

module m

import std.sync as sync;
import std.concurrent as conc;
import std.core as core;
import std.containers as containers;

fn worker(dref: conc.Arc<sync.EpochDomain>, loops: Int) nothrow -> Int {
	var p = sync.epoch_participant();
	var i = 0;
	while i < loops {
		sync.epoch_enter(dref.get(), &mut p);
		sync.epoch_retire(dref.get(), &p);
		sync.epoch_leave(dref.get(), &mut p);
		i = i + 1;
	}
	return 0;
}

fn run() -> Int {
	val workers = 8;
	val loops = 200;
	val expected = workers * loops;
	var dom = conc.arc(sync.epoch_domain());
	var tasks = containers.deque<type conc.VirtualThread<Int>>();
	var i = 0;
	while i < workers {
		var d = dom.clone();
		var t = conc.spawn_cb(core.callback0(| | captures(move d, copy loops) => { return worker(move d, loops); }));
		tasks.push_back(move t);
		i = i + 1;
	}
	while tasks.len() > 0 {
		match tasks.pop_front() {
			Some(var t) => {
				match t.join() {
					Ok(v) => { if v != 0 { return 1; } },
					default => { return 2; }
				}
			},
			default => { return 3; }
		}
	}
	val reclaimed = sync.epoch_try_advance(dom.get());
	if reclaimed != expected { return 4; }
	if sync.epoch_pending(dom.get()) != cast<Uint>(0) { return 5; }
	if sync.epoch_reclaimed(dom.get()) != cast<Uint>(expected) { return 6; }
	return 0;
}

fn main() nothrow -> Int {
	return try run() catch { 99 };
}

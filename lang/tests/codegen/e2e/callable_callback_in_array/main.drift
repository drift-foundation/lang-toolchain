module main;

import std.core as core;

fn double(x: Int) nothrow -> Int { return x * 2; }
fn triple(x: Int) nothrow -> Int { return x * 3; }
fn add10(x: Int) nothrow -> Int { return x + 10; }

fn main() nothrow -> Int {
	var arr: Array<core.Callback1<Int, Int>> = [];
	var cb1 = core.callback1(double);
	var cb2 = core.callback1(triple);
	var cb3 = core.callback1(add10);
	arr.push(move cb1);
	arr.push(move cb2);
	arr.push(move cb3);
	if arr.len != 3 { return 1; }
	return 0;
}

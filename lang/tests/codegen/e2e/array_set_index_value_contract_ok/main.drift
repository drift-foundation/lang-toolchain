module m;

// Positive contract test for `arr.set(index, value)`.
//
// The public API is `arr.set(index: Int, value: T)`.  This matches:
//   - the existing MIR lowering (idx=args[0], val=args[1]),
//   - `insert(index, value)` at the same arity / order,
//   - the principle of least surprise across array APIs.
//
// Pre-fix the checker shared `push`'s validator with `set`, which
// rejected `arr.set(0, name)` with "Array element type mismatch
// (have Int, expected String)" because it compared the literal `0`
// against the element type instead of the index type.

pub fn main() nothrow -> Int {
	var arr: Array<String> = [];
	arr.push("seed");

	// arr.set(index, value)
	arr.set(0, "replaced");

	if arr.len != 1 { return 1; }
	if arr[0].byte_length() != 8 { return 2; }   // "replaced"

	// Heap-backed value to also exercise the ownership-transfer path.
	val v: String = "x" + "AAAA";
	arr.set(0, v);
	if arr[0].byte_length() != 5 { return 3; }   // "xAAAA"

	return 0;
}

module m;

import std.concurrent as conc;
import std.core as core;
import lang.thread as thread;

pub fn main() nothrow -> Int {
	thread.exec_submit_test_override(1);
	var vt = conc.spawn(| | => { return 42; });
	/* submit_error != 0 → is_complete is true immediately
	 * (terminal: the deferred error will surface on join). */
	if vt.is_complete() {
		thread.exec_submit_test_override(0);
		return 0;
	}
	thread.exec_submit_test_override(0);
	return 1;
}

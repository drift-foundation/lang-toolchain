// Regression: match binder rename must descend into while-loop bodies
// (HLoop) and cast expressions (HCast) inside match arm bodies.

import std.core as core;

variant Shape {
	Circle(radius: Int),
	Rect(w: Int, h: Int),
	@tombstone Tombstone
}

implement core.Copy for Shape {
}

fn area(s: Shape) nothrow -> Int {
	return match s {
		Shape::Circle(r) => {
			// Exercises HLoop rename path: binder 'r' used inside while loop.
			var sum = 0;
			var i = 0;
			while i < r {
				sum = sum + 1;
				i = i + 1;
			}
			sum
		},
		Shape::Rect(w, h) => { w * h },
		default => { 0 - 1 }
	};
}

variant Tagged {
	Val(tag: Byte),
	@tombstone Tombstone
}

implement core.Copy for Tagged {
}

fn tag_as_int(t: Tagged) nothrow -> Int {
	// Exercises HCast rename path: binder 'tag' used inside cast<Int>().
	return match t {
		Tagged::Val(tag) => { cast<Int>(tag) },
		default => { 0 - 1 }
	};
}

fn main() nothrow -> Int {
	val c = Shape::Circle(radius = 7);
	val r = Shape::Rect(w = 3, h = 4);

	val a1 = area(c);
	val a2 = area(r);

	// Circle: loop 7 times → sum=7
	if a1 != 7 { return 1; }
	// Rect: 3*4 = 12
	if a2 != 12 { return 2; }

	val t = Tagged::Val(tag = cast<Byte>(42));
	if tag_as_int(t) != 42 { return 3; }

	return 0;
}

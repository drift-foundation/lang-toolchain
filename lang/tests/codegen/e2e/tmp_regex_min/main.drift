module main
import std.core as core;
import std.regex as regex;

fn str_eq(a: &String, b: &String) nothrow -> Bool {
	val an = a.byte_length();
	val bn = b.byte_length();
	if an != bn { return false; }
	var i = 0;
	while i < an {
		if core.string_byte_at(a, i) != core.string_byte_at(b, i) { return false; }
		i = i + 1;
	}
	return true;
}

fn main() nothrow -> Int {
	// Empty pattern replace_all on "ab" should produce "XaXbX"
	match regex.compile(&"") {
		core.Result::Ok(re) => {
			val r = regex.replace_all(&re, &"ab", &"X");
			if !str_eq(&r, &"XaXbX") { return 2; }
			return 0;
		},
		core.Result::Err(_) => { return 1; }
	}
}

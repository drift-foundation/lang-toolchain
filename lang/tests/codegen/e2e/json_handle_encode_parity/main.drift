module main;

import std.json as json;
import std.core as core;

fn main() nothrow -> Int {
	// Use an array to avoid object key ordering non-determinism.
	val text = "[1,true,\"hello\",null]";
	match json.parse(&text) {
		core.Result::Ok(node) => {
			val node_enc = json.encode_compact(&node);
			val handle = json.share(move node);
			val handle_enc = handle.encode_compact();
			if node_enc != handle_enc { return 1; }
			if handle_enc != "[1,true,\"hello\",null]" { return 2; }
			return 0;
		},
		core.Result::Err(_) => { return 3; }
	}
}

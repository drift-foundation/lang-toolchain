module main

import std.algo as algo;
import std.containers as containers;
import std.core.cmp as cmp;
import std.iter as iter;
import std.err;
use trait algo.BinarySearchable;
use trait cmp.Comparable;
use trait iter.RandomAccessPermutable;
use trait iter.RandomAccessReadable;

fn run() -> Int {
var dq = containers.deque<type Int>();
	dq.push_back(4);
	dq.push_back(5);
	dq.push_back(6);
	val _p1 = dq.pop_front();
	val _p2 = dq.pop_front();
	dq.push_back(3);
	dq.push_back(2);
	dq.push_back(1);
	var rm = dq.range_mut();
	algo.sort_in_place<type containers.DequeRangeMut<Int>, Int>(&mut rm);
	var r = dq.range();
	val idx = algo.binary_search<type containers.DequeRange<Int>, Int>(&r, &3);
	var found_idx = -1;
	match idx {
		Some(i) => { found_idx = i; },
		None => {}
	}
	if found_idx < 0 {
		return 2;
	}
	var got = -1;
	try {
		got = *dq.at(found_idx);
	} catch std.err:IndexError(_) {
		got = -1;
	} catch {
		got = -1;
	}
	return (got == 3) ? 0 : 1;
}

fn main() nothrow -> Int { return try run() catch { 99 }; }

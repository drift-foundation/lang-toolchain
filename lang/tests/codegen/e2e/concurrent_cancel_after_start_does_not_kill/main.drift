module main;

import std.concurrent as conc;
import lang.thread as thread;

pub fn main() nothrow -> Int {
	var t = conc.spawn(| | => { thread.vt_park_until(5); return 9; });
	thread.vt_park_until(1);
	t.cancel();
	var res = t.join();
		match res {
		Ok(v) => {
	var out = 1;
				if v == 9 {
					out = 0;
				}
			return out;
		},
		Err(err) => {
			if err.kind == conc.CONCURRENCY_KIND_CANCELLED { return 0; }
			return 2;
		},
		default => { return 2; },
	}
}

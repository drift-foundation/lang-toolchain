module repro;

import std.core as core;
import std.io as io;

error Info { msg: String, detail: String }
fn _heap_string(bytes: &Array<Byte>) nothrow -> String {
	val n = bytes.len;
	var buf = io.buffer(n);
	var i = 0;
	while i < n { io.buffer_write(&mut buf, i, bytes[i]); i = i + 1; }
	return core.string_from_utf8_bytes(io.buffer_ptr(&buf), n);
}

// The original string goes out of scope when this function returns via throw.
// Slice 7c-1 (ABI 14): the throw-side String fields are projected through
// `core.Diagnostic.to_json_text` into the params JSON.  The Path-A struct
// constructed at the throw site consumes the Strings exactly once, and
// `_emit_diagnostic_owning_throw`'s explicit DropValue (Slice 7b leak fix)
// frees them after the to_json_text call.  Pre-Slice 7b this code path
// went through `drift_dv_string` retain — that path is gone.
fn throw_one_heap(label: String) -> Int {
	var b: Array<Byte> = [cast<Byte>(104), cast<Byte>(101), cast<Byte>(108), cast<Byte>(108), cast<Byte>(111)];
	val s = _heap_string(&b);
	throw Info(s, label);
}

// Both fields are heap-backed.
fn throw_two_heap() -> Int {
	var b1: Array<Byte> = [cast<Byte>(97), cast<Byte>(108), cast<Byte>(112), cast<Byte>(104), cast<Byte>(97)];
	var b2: Array<Byte> = [cast<Byte>(98), cast<Byte>(101), cast<Byte>(116), cast<Byte>(97)];
	val s1 = _heap_string(&b1);
	val s2 = _heap_string(&b2);
	throw Info(s1, s2);
}

pub fn main() nothrow -> Int {
	// One heap field, one literal — exercises the mixed retain path.
	val r1 = try throw_one_heap("static-detail") catch { 1 };
	if r1 != 1 { return 1; }

	// Both heap fields — exercises retain on every DV string.
	val r2 = try throw_two_heap() catch { 2 };
	if r2 != 2 { return 2; }

	// Repeat to stress double-lifecycle (ensure no leak accumulates).
	val r3 = try throw_one_heap("again") catch { 3 };
	if r3 != 3 { return 3; }

	return 0;
}

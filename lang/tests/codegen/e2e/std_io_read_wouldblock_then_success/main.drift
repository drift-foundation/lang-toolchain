module m

import std.io as io;
import std.concurrent as conc;
import lang.thread as thread;

pub fn main() nothrow -> Int {
	val fd = thread.test_eventfd_create();
	if fd <= 0 { return 9; }
	val f = io.file_from_fd(fd);
	var buf = io.buffer(8);
	val short_t = conc.Duration(millis = 1);
	val short_c = io.configure_file(&f, short_t);

	var i = 0;
	while i < 3 {
		val r = short_c.read(&mut buf);
		match r {
			Ok(_) => { return 2; },
			Err(e) => {
				if not io.is_would_block_error(e) {
					return 3;
				}
			},
			default => { return 4; }
		}
		i += 1;
	}

	thread.test_eventfd_write(fd, 1);
	val long_t = conc.Duration(millis = 1000);
	val long_c = io.configure_file(&f, long_t);
	val r2 = long_c.read(&mut buf);
	match r2 {
		Ok(n) => {
			if n <= 0 { return 5; }
			return 0;
		},
		Err(e) => {
			if io.is_would_block_error(e) { return 6; }
			return 7;
		},
		default => { return 8; }
	}
}

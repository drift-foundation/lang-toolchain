module main;

import std.err;
import std.containers;
import std.iter as iter;
use trait iter.RandomAccessReadable;

fn main() nothrow -> Int {
	var arr = [1, 2];
	var r = arr.range();
	// Reserve that should be a no-op (cap already 2).
	arr.reserve(2);
	var len1 = 0;
	try {
		len1 = r.len();
	} catch std.err:IteratorInvalidated(_) {
		return 10;
	} catch {
		return 11;
	}
	if len1 != 2 {
		return 12;
	}
	// Reserve that forces growth should invalidate.
	arr.reserve(10);
	var out = 0;
	try {
		val len2 = r.len();
		out = len2;
	} catch std.err:IteratorInvalidated(e) {
		val dv_c = e.attrs["container_id"];
		val dv_o = e.attrs["op_id"];
		val c = dv_c.as_string();
		val o = dv_o.as_int();
		val c_code = match c {
			Some(s) => {
				(s != "std.containers:Array") ? 20 : 0
			},
			None => {
				21
			},
		};
		val o_code = match o {
			Some(v) => {
				(v != 2) ? 22 : 0
			},
			None => {
				23
			},
		};
		out = (c_code != 0) ? c_code : ((o_code != 0) ? o_code : 0);
	} catch {
		out = 99;
	}
	return out;
}

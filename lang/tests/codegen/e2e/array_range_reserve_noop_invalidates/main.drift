module main;

import std.err;
import std.containers;
import std.iter as iter;
use trait iter.RandomAccessReadable;

fn main() nothrow -> Int {
	var arr = [1, 2];
	var r = arr.range();
	// Reserve that should be a no-op (cap already 2).
	arr.reserve(2);
	var len1 = 0;
	try {
		len1 = r.len();
	} catch std.err:IteratorInvalidated(_) {
		return 10;
	} catch {
		return 11;
	}
	if len1 != 2 {
		return 12;
	}
	// Reserve that forces growth should invalidate.
	arr.reserve(10);
	var out = 0;
	try {
		val len2 = r.len();
		out = len2;
	} catch std.err:IteratorInvalidated(e) {
		// Slice 7a: typed catch projection on container_id; op_id variant
		// projection bug deferred (see array_range_len_invalidated).
		out = (e.container_id != "std.containers:Array") ? 20 : 0;
	} catch {
		out = 99;
	}
	return out;
}

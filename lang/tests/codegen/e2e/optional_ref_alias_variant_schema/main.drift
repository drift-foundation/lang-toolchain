module m;

variant Opt<T> {
	None,
	Some(value: T),
	@tombstone Tombstone
}

struct Pair(a: Int, b: Int);
type PairAlias = Pair;

variant Holder {
	Item(value: PairAlias),
	@tombstone Tombstone
}

implement Holder {
	fn as_item(self: &Holder) nothrow -> Opt<&PairAlias> {
		return match self {
			Item(v) => { Opt::Some(v) },
			default => { Opt<&PairAlias>::None() }
		};
	}
}

fn main() nothrow -> Int {
	val h = Holder::Item(Pair(a = 1, b = 2));
	match h.as_item() {
		Opt::Some(v) => {
			if v.a == 1 and v.b == 2 {
				return 0;
			}
			return 2;
		},
		Opt::None => { return 1; }
	}
}

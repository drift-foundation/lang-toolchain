module main;

import std.console as console;

exception E()

fn run() -> Int {
    try {
        try {
            throw E();
        } catch {
            rethrow;
        }
    } catch {
        console.print("handled");
    }
    return 0;
}

fn main() nothrow -> Int{
    try run() catch { return 0; }
    return 0;
}

module main;

import std.console as console;

exception E()

fn run() -> Int {
    try {
        try {
            throw E();
        } catch {
            console.print("inner");
            rethrow;
        }
        console.print("UNREACHABLE");
    } catch {
        console.print("outer");
    }
    return 0;
}

fn main() nothrow -> Int{
    try run() catch { return 0; }
    return 0;
}

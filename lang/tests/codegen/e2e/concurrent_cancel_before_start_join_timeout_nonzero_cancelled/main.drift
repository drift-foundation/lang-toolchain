module main;

import std.concurrent as conc;

pub fn main() nothrow -> Int {
	var t = conc.spawn(| | => { return 1; });
	t.cancel();
	var res = t.join_timeout(conc.Duration(millis = 10));
		match res {
		Err(err) => {
			if err.kind == conc.CONCURRENCY_KIND_CANCELLED { return 0; }
			return 1;
		},
		Ok(_v) => { return 2; },
		default => { return 2; },
	}
}

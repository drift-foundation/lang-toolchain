module main;

import std.err;
import std.containers;
import std.iter as iter;
use trait iter.RandomAccessPermutable;

pub fn main() nothrow -> Int {
	var arr = [1, 2];
	var r = arr.range_mut();
	var out = 0;
	try {
		r.__test_invalidate();
		r.swap(0, 0);
	} catch std.err:IteratorInvalidated(e) {
		// Slice 7b: op_id projects as bare integer (Swap → 4).
		val cid_bad = (e.container_id != "std.containers:Array");
		val op = match e.params.get("op_id").as_int() {
			Some(v) => { v },
			None => { -1 }
		};
		val op_bad = (op != 4);
		out = (cid_bad ? 10 : 0) + (op_bad ? 20 : 0);
	} catch {
		out = 99;
	}
	return out;
}

module main;

import std.err;
import std.containers;
import std.iter as iter;
use trait iter.RandomAccessPermutable;

fn main() nothrow -> Int {
	var arr = [1, 2];
	var r = arr.range_mut();
	var out = 0;
	try {
		r.__test_invalidate();
		r.swap(0, 0);
	} catch std.err:IteratorInvalidated(e) {
		// Slice 7a: typed catch projection on container_id; op_id variant
		// projection bug deferred (see array_range_len_invalidated).
		out = (e.container_id != "std.containers:Array") ? 10 : 0;
	} catch {
		out = 99;
	}
	return out;
}

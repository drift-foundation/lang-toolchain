module m;

import std.concurrent as conc;
import std.core as core;

pub fn main() nothrow -> Int {
	var halves = conc.channel<type Int>();
	var sender = halves.take_sender();
	var receiver = halves.take_receiver();
	/* Empty channel; recv_timeout(20ms) should TIMEOUT. */
	match receiver.recv_timeout(conc.Duration(millis = 20)) {
		Err(e) => {
			if e.kind == conc.CONCURRENCY_KIND_TIMEOUT { return 0; }
			return 11;
		},
		Ok(_) => { return 12; },
		default => { return 13; }
	}
}

module m;

import std.concurrent as conc;
import std.core as core;
import std.core.arc as arc;
import lang.atomic as atomic;

pub struct Payload
	require Self is core.Destructible
{
	pub id: Int,
	pub counter: arc.Arc<conc.AtomicInt>
}

implement core.Destructible for Payload {
	pub fn destroy(var self: Payload) nothrow -> Void {
		val _ = atomic.atomic_fetch_add_int(self.counter.get(), 1, 2);
	}
}

pub fn main() nothrow -> Int {
	val counter: arc.Arc<conc.AtomicInt> = arc.arc(conc.atomic_int(0));
	{
		var halves = conc.channel<type Payload>();
		var sender = halves.take_sender();
		var receiver = halves.take_receiver();

		val _ = sender.send(Payload(id = 1, counter = counter.clone()));
		val _ = sender.send(Payload(id = 2, counter = counter.clone()));
		val _ = sender.send(Payload(id = 3, counter = counter.clone()));

		/* Consume one — its arm-bound `p` drops at arm end → +1 */
		match receiver.recv() {
			Ok(p) => { if p.id != 1 { return 20; } },
			Err(_) => { return 21; },
			default => { return 22; }
		}

		/* Drop sender first; then receiver-drop drains remaining 2 */
		{ val _ = move sender; }
		{ val _ = move receiver; }
	}
	val n = atomic.atomic_load_int(counter.get(), 1);
	/* Expected: 3 destructions (1 received + 2 drained on receiver-drop) */
	if n != 3 { return 30 + n; }
	return 0;
}

module main;

import std.concurrent as conc;
import std.core as core;
import std.io as io;
import std.net as net;

// ET per-direction wake regression: verify that read and write on the same
// fd use independent waiter slots and do not interfere.
//
// Strategy: spawn a reader VT and a writer VT on the same accepted socket.
// The writer sends data, then the reader reads it. Under a broken
// per-direction model, an EPOLLOUT event could spuriously wake the reader
// or vice versa, causing hangs or incorrect results.

pub fn main() nothrow -> Int {
	var addr = net.socket_addr("127.0.0.1", 0);
	val io_t = conc.Duration(millis = 3000);
	var lr = net.listen(&addr, io_t);
	match lr {
		Ok(l) => {
			val port = l.test_local_port();
			// Client: connect, write a payload, then read the echo.
			var client = conc.spawn(| | captures(copy port, copy io_t) => {
				var caddr = net.socket_addr("127.0.0.1", port);
				var cr = net.connect(&caddr, io_t);
				match cr {
					Ok(s) => {
						var wbuf = io.buffer(16);
						io.buffer_write(&mut wbuf, 0, cast<Byte>(42));
						val wr = s.write(&wbuf, io_t);
						match wr {
							Ok(_) => { },
							Err(_) => { return 10; },
							default => { return 11; }
						}
						// Read echo back.
						var rbuf = io.buffer(16);
						val rr = s.read(&mut rbuf, io_t);
						match rr {
							Ok(n) => {
								if n <= 0 { return 12; }
							},
							Err(_) => { return 14; },
							default => { return 15; }
						}
						val _ = s.close(io_t);
						return 0;
					},
					Err(_) => { return 16; },
					default => { return 17; }
				}
			});
			// Server: accept, read, then write the same data back (echo).
			var ar = net.accept(&l, io_t);
			match ar {
				Ok(s2) => {
					var rbuf = io.buffer(16);
					val rr = s2.read(&mut rbuf, io_t);
					match rr {
						Ok(n) => {
							if n <= 0 { return 20; }
						},
						Err(_) => { return 21; },
						default => { return 22; }
					}
					// Echo back what we read.
					val wr = s2.write(&rbuf, io_t);
					match wr {
						Ok(_) => { },
						Err(_) => { return 23; },
						default => { return 24; }
					}
					val _ = s2.close(io_t);
				},
				Err(_) => { return 30; },
				default => { return 31; }
			}
			var tr = client.join();
			match tr {
				Ok(v) => { if v != 0 { return 100 + v; } },
				Err(_) => { return 40; },
				default => { return 41; }
			}
			return 0;
		},
		Err(_) => { return 50; },
		default => { return 51; }
	}
}

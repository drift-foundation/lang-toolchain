module main;

import std.console as console;

error A {}
error B {}
fn run() -> Int {
    try {
        try {
            throw A();
        } catch A(a) {
            console.print("inner");
            throw B();
        }
        console.print("UNREACHABLE");
    } catch B(b) {
        console.print("outer");
    }
    return 0;
}

pub fn main() nothrow -> Int{
    try run() catch { return 0; }
    return 0;
}

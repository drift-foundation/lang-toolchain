module main;

import std.core as core;
import std.text as text;

fn str_eq(a: &String, b: &String) nothrow -> Bool {
	val an = a.byte_length();
	val bn = b.byte_length();
	if an != bn { return false; }
	var i = 0;
	while i < an {
		if core.string_byte_at(a, i) != core.string_byte_at(b, i) { return false; }
		i = i + 1;
	}
	return true;
}


fn main() nothrow -> Int {
	if !text.ends_with("hello world", "world") { return 1; }
	if text.ends_with("hello", "world") { return 2; }
	if !text.ends_with("hello", "") { return 3; }
	if !text.ends_with("", "") { return 4; }
	if text.ends_with("", "x") { return 5; }
	if !text.ends_with("abc", "abc") { return 6; }
	if text.ends_with("bc", "abc") { return 7; }

	return 0;
}

module main;

import std.core as core;
import std.text as text;

fn str_eq(a: &String, b: &String) nothrow -> Bool {
	val an = a.byte_length();
	val bn = b.byte_length();
	if an != bn { return false; }
	var i = 0;
	while i < an {
		if core.string_byte_at(a, i) != core.string_byte_at(b, i) { return false; }
		i = i + 1;
	}
	return true;
}


pub fn main() nothrow -> Int {
	var parts: Array<String> = [];
	parts.push("a");
	parts.push("b");
	parts.push("c");
	val r = text.join(&parts, ", ");
	val e = "a, b, c";
	if !str_eq(&r, &e) { return 1; }
	// Single element
	var one: Array<String> = [];
	one.push("only");
	val r2 = text.join(&one, ",");
	val e2 = "only";
	if !str_eq(&r2, &e2) { return 2; }
	// Empty array
	var none: Array<String> = [];
	val r3 = text.join(&none, ",");
	val e3 = "";
	if !str_eq(&r3, &e3) { return 3; }
	// Empty separator
	val r4 = text.join(&parts, "");
	val e4 = "abc";
	if !str_eq(&r4, &e4) { return 4; }

	return 0;
}

module m;

import std.json as json;
import std.core as core;

fn run() -> Int {
	val text = "{\"a\":1,\"a\":2,\"b\":true,\"c\":null}";
	var root = json.JsonNode::Null();
	val perm = json.permissive();
	match json.parse_with_config(text, perm) {
		core.Result::Ok(v) => {
			root = move v;
		},
		core.Result::Err(_) => {
			return 1;
		}
	}
	val ka = "a";
	match root.get(ka) {
		Some(_v) => {
		},
		None => {
			return 2;
		}
	}
	return 0;
}

pub fn main() nothrow -> Int {
	return try run() catch { 99 };
}

module m;

import std.core as core;

// This test verifies that the PRIOR workaround pattern (manually dropping
// owned fields inside destroy()) is no longer necessary. After the codegen
// fix, the compiler drops non-Destructible owned fields automatically
// after destroy() returns.
//
// The correct destroy() pattern: do NOT manually drop fields. Just handle
// custom cleanup logic (flushing, logging, etc.). Field drops are automatic.

struct Drainer {
	data: Array<Int>,
	label: Array<Int>,
	counter: Int,
}

implement core.Destructible for Drainer {
	pub fn destroy(var self: Drainer) nothrow -> Void {
		// Custom cleanup logic only — no manual field drops needed.
		// The compiler drops data and label after this returns.
		self.counter = 0;
		return;
	}
}

pub fn main() nothrow -> Int {
	var d: Array<Int> = [1, 2, 3];
	var l: Array<Int> = [4, 5];
	val s = Drainer(data = move d, label = move l, counter = 99);
	return 0;
}

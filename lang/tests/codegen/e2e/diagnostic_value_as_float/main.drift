module main;

error E { v: Float }
fn run() -> Int {
	try {
		throw E(v = 1.5);
	} catch E(e) {
		val dv = e.attrs["v"];
		match dv.as_float() {
			Some(f) => {
				if f < 1.49 or f > 1.51 {
					return 1;
				}
			},
			None => {
				return 2;
			},
		}
		match e.attrs["missing"].as_float() {
			Some(_) => {
				return 3;
			},
			None => {
			},
		}
		return 0;
	} catch {
		return 4;
	}
}

fn main() nothrow -> Int {
	return try run() catch { 99 };
}


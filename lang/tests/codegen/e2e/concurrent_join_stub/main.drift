module main;

import std.concurrent as conc;
import std.core as core;

pub fn main() nothrow -> Int {
	var t = conc.spawn(| | => { return 1; });
	var res = t.join();
		match res {
		Err(err) => {
			if err.kind == conc.CONCURRENCY_KIND_FAILED { return 2; }
			if err.kind == conc.CONCURRENCY_KIND_BUSY { return 1; }
			if err.kind == conc.CONCURRENCY_KIND_CANCELLED { return 1; }
			if err.kind == conc.CONCURRENCY_KIND_CLOSED { return 1; }
			if err.kind == conc.CONCURRENCY_KIND_TIMEOUT { return 1; }
			return 1;
		},
		Ok(v) => { return v; },
		default => { return 1; },
	}
}

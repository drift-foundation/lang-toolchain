module m;

import std.concurrent as conc;
import std.io as io;
import lang.thread as thread;

pub fn main() nothrow -> Int {
	val fd = thread.test_eventfd_create();
	if fd <= 0 { return 9; }
	val f = io.file_from_fd(fd);
	val c = io.configure_file(&f, conc.Duration(millis = 0));
	var buf = io.buffer(8);
	val r = c.read(&mut buf);
	match r {
		Ok(_) => { return 2; },
		Err(e) => {
			if e.kind == io.IO_ERROR_KIND_ERRNO {
				if io.io_is_would_block(e.code) { return 0; }
				return 3;
			}
			return 4;
		},
		default => { return 5; }
	}
}

module m;
import std.core as core;
import std.json as json;
fn run() -> Int {
  val _r = core.Result<json.JsonNode, json.JsonErrorData>::Err(json.JsonErrorData(tag = "bad", offset = 1, line = -1, col = -1, path = "", key = ""));
  return 0;
}
pub fn main() nothrow -> Int { return try run() catch { 99 }; }

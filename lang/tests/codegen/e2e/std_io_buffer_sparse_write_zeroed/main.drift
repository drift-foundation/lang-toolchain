module m;

import std.io as io;

pub fn main() nothrow -> Int {
	var buf = io.buffer(8);
	io.buffer_write(buf, 0, cast<Byte>(65));
	io.buffer_write(buf, 4, cast<Byte>(66));
	if io.buffer_len(buf) != 5 {
		return 1;
	}
	if io.buffer_read(buf, 0) != cast<Byte>(65) {
		return 2;
	}
	if io.buffer_read(buf, 1) != cast<Byte>(0) {
		return 3;
	}
	if io.buffer_read(buf, 2) != cast<Byte>(0) {
		return 4;
	}
	if io.buffer_read(buf, 3) != cast<Byte>(0) {
		return 5;
	}
	if io.buffer_read(buf, 4) != cast<Byte>(66) {
		return 6;
	}
	return 0;
}

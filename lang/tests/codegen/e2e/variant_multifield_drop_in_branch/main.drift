module main;

variant Packet {
	Full(id: Int, msg: String, data: Array<Byte>),
	None
}

fn make_packet(id: Int) nothrow -> Packet {
	var data: Array<Byte> = [];
	data.push(cast<Byte>(id % 251));
	data.push(cast<Byte>((id + 1) % 251));
	return Packet::Full(id = id, msg = "pkt", data = move data);
}

fn main() nothrow -> Int {
	var i = 0;
	while i < 200 {
		if (i % 2) == 0 {
			var p = make_packet(i);
			match p {
				Packet::Full(id, _msg, data) => {
					if id < 0 {
						return 10;
					}
					if data.len != 2 {
						return 11;
					}
				},
				Packet::None() => { return 12; }
			}
		} else {
			var p = make_packet(i + 1);
			match p {
				Packet::Full(id, _msg, data) => {
					if id < 0 {
						return 20;
					}
					if data.len != 2 {
						return 21;
					}
				},
				Packet::None() => { return 22; }
			}
		}
		i = i + 1;
	}
	return 0;
}

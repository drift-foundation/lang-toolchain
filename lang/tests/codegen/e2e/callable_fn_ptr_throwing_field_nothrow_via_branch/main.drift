module main;

struct MathOp {
	apply: Fn(Int, Int) -> Int
}

fn add(a: Int, b: Int) nothrow -> Int { return a + b; }
fn sub(a: Int, b: Int) nothrow -> Int { return a - b; }

fn pick(use_sub: Bool) nothrow -> Fn(Int, Int) nothrow -> Int {
	if use_sub {
		return sub;
	}
	return add;
}

fn run() -> Int {
	val f = pick(true);
	val op = MathOp(apply = f);
	val g = op.apply;
	val result = g(10, 3);
	if result != 7 {
		return 10;
	}
	return 0;
}

fn main() nothrow -> Int {
	return try run() catch { 99 };
}

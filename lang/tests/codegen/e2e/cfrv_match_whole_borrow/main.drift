module m;
struct Node { text: String, }
fn make_a() nothrow -> Node { return Node(text = "a" + ""); }
fn make_b() nothrow -> Node { return Node(text = "b" + ""); }
fn inspect(n: &Node) nothrow -> Int { return n.text.byte_length(); }
pub fn main() nothrow -> Int { return inspect(match true { true => { make_a() }, false => { make_b() } }) - 1; }

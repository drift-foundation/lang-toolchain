module m;

import std.containers as containers;
import std.core as core;
import std.format as format;
import std.json as json;

fn run() -> Int {
	var outer = 0;
	while outer < 200 {
		var m = containers.hash_map<type String, json.JsonNode>();
		var i = 0;
		while i < 24 {
			val k = "k-" + format.format_int(i);
			val v = "v-" + format.format_int(i);
			m.insert(move k, json.JsonNode::String(move v));
			i = i + 1;
		}
		core.drop_value<type containers.HashMap<String, json.JsonNode>>(move m);
		outer = outer + 1;
	}
	return 0;
}

pub fn main() nothrow -> Int {
	return try run() catch { 99 };
}

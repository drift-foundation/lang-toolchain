module main;

extern "C" fn add_i32(a: Int32, b: Int32) nothrow -> Int32;
extern "C" fn mul_u32(x: Uint32, factor: Uint32) nothrow -> Uint32;
extern "C" fn negate_i32(x: Int32) nothrow -> Int32;

pub fn main() nothrow -> Int {
    val sum: Int32 = unsafe { add_i32(cast<Int32>(10), cast<Int32>(3)) };
    if cast<Int>(sum) != 13 { return 97; }

    val prod: Uint32 = unsafe { mul_u32(cast<Uint32>(7), cast<Uint32>(6)) };
    if cast<Int>(prod) != 42 { return 98; }

    val neg: Int32 = unsafe { negate_i32(cast<Int32>(99)) };
    if cast<Int>(neg) != -99 { return 96; }

    return 3;
}

module main;

import std.core as core;
import std.concurrent as conc;

// Pins escape/borrow scope acceptance — the surrounding try/match
// shape is incidental.  Match the Result inside a catch-all `try {}`
// so the conservative may-throw analysis on the stubbed Fn1::call
// lambda dispatch is satisfied.
pub fn main() nothrow -> Int {
	try {
		val r: core.Result<Void, conc.ConcurrencyError> = conc.scope(|_s: std.concurrent.Scope| nothrow => { return; });
		match r {
			Ok(_) => { return 0; },
			Err(_) => { return 2; },
		}
	} catch _ { return 99; }
}

module m

import std.core as core;
import std.iter as iter;
import std.json as json;

use trait iter.Iterable;
use trait iter.SinglePassIterator;

fn run() -> Int {
	val text = "{\"users\":[{\"id\":1},{\"id\":2}]}";
	var root = json.JsonNode::Null();
	match json.parse(&text) {
		core.Result::Ok(v) => { root = move v; },
		core.Result::Err(_) => { return 100; }
	}

	var users_path = ["users"];
	val users_node = root.expect_path(&users_path);
	val users = users_node.expect_array("users", "users");

	var it = users.iter();
	var seen = 0;
	while true {
		match it.next() {
			Some(_entry) => { seen += 1; },
			default => { break; }
		}
	}
	if seen != 2 {
		return 1;
	}
	return 0;
}

fn main() nothrow -> Int {
	return try run() catch { 99 };
}

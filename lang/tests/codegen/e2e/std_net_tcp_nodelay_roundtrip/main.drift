module m

import std.concurrent as conc;
import std.io as io;
import std.net as net;

pub fn main() nothrow -> Int {
	var addr = net.socket_addr("127.0.0.1", 0);
	val io_t = conc.Duration(millis = 1000);
	var lr = net.listen(&addr, io_t);
	match lr {
		Ok(l) => {
			val port = l.test_local_port();
			var t = conc.spawn(| | captures(copy port, copy io_t) => {
				var caddr = net.socket_addr("127.0.0.1", port);
				var cr = net.connect(&caddr, io_t);
				match cr {
					Ok(s) => {
						var sr = s.set_nodelay(true);
						match sr {
							Ok(_) => { },
							Err(_) => { return 2; },
							default => { return 3; }
						}
						var buf = io.buffer(1024);
						val b = cast<Byte>(97);
						io.buffer_write(&mut buf, 0, b);
						var wr = s.write(&buf, io_t);
						match wr {
							Ok(_) => { },
							Err(_) => { return 4; },
							default => { return 5; }
						}
						val _ = s.close(io_t);
						return 1;
					},
					Err(_) => { return 6; },
					default => { return 7; }
				}
			});
			var ar = net.accept(&l, io_t);
			match ar {
				Ok(s2) => {
					var sr2 = s2.set_nodelay(true);
					match sr2 {
						Ok(_) => { },
						Err(_) => { return 8; },
						default => { return 9; }
					}
					var nr2 = s2.nodelay();
					match nr2 {
						Ok(v) => {
							if !v { return 18; }
						},
						Err(_) => { return 19; },
						default => { return 20; }
					}
					var buf = io.buffer(1024);
					var rr = s2.read(&mut buf, io_t);
					match rr {
						Ok(_) => { },
						Err(_) => { return 10; },
						default => { return 11; }
					}
					val _ = s2.close(io_t);
				},
				Err(_) => { return 12; },
				default => { return 13; }
			}
			var tr = t.join();
			match tr {
				Ok(_) => { },
				Err(_) => { return 14; },
				default => { return 15; }
			}
			return 0;
		},
		Err(_) => { return 16; },
		default => { return 17; }
	}
}

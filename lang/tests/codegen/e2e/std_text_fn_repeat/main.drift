module main;

import std.core as core;
import std.text as text;

fn str_eq(a: &String, b: &String) nothrow -> Bool {
	val an = a.byte_length();
	val bn = b.byte_length();
	if an != bn { return false; }
	var i = 0;
	while i < an {
		if core.string_byte_at(a, i) != core.string_byte_at(b, i) { return false; }
		i = i + 1;
	}
	return true;
}


pub fn main() nothrow -> Int {
	val r = text.repeat("ab", 3);
	val e = "ababab";
	if !str_eq(r, e) { return 1; }
	// n=0 → empty
	val r2 = text.repeat("x", 0);
	val e2 = "";
	if !str_eq(r2, e2) { return 2; }
	// n=1 → same
	val r3 = text.repeat("a", 1);
	val e3 = "a";
	if !str_eq(r3, e3) { return 3; }
	// empty source
	val r4 = text.repeat("", 5);
	val e4 = "";
	if !str_eq(r4, e4) { return 4; }
	// negative → empty
	val r5 = text.repeat("x", 0 - 1);
	val e5 = "";
	if !str_eq(r5, e5) { return 5; }

	return 0;
}

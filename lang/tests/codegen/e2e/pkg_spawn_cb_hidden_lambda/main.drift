module m;

import std.core as core;
import std.concurrent as conc;

// Simulate the web.rest pattern: a library function that internally
// calls conc.spawn_cb with a callback.  When this function is compiled
// as part of a package and consumed, the hidden lambda inside spawn_cb
// must still be resolved.
fn start_worker() nothrow -> conc.VirtualThread<Int> {
	val cb = core.callback0(|| nothrow => { return 42; });
	return conc.spawn_cb(move cb);
}

fn main() nothrow -> Int {
	val vt = start_worker();
	return 0;
}

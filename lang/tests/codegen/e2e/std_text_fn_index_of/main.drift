module main;

import std.core as core;
import std.text as text;

fn str_eq(a: &String, b: &String) nothrow -> Bool {
	val an = a.byte_length();
	val bn = b.byte_length();
	if an != bn { return false; }
	var i = 0;
	while i < an {
		if core.string_byte_at(a, i) != core.string_byte_at(b, i) { return false; }
		i = i + 1;
	}
	return true;
}


pub fn main() nothrow -> Int {
	if text.index_of("hello world", "world") != 6 { return 1; }
	if text.index_of("hello", "hello") != 0 { return 2; }
	if text.index_of("hello", "xyz") != 0 - 1 { return 3; }
	// Empty needle → 0
	if text.index_of("hello", "") != 0 { return 4; }
	if text.index_of("", "x") != 0 - 1 { return 5; }
	// Finds first occurrence
	if text.index_of("abcabc", "abc") != 0 { return 6; }

	return 0;
}

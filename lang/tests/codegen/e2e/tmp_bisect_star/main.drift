module main
import std.core as core;
import std.regex as regex;

fn expect_ok(pattern: &String, fail_code: Int) nothrow -> Int {
	match regex.compile(pattern) {
		core.Result::Ok(_) => { return 0; },
		core.Result::Err(_) => { return fail_code; }
	}
}

fn main() nothrow -> Int {
	var rc = 0;
	rc = expect_ok(&"a*", 1);   if rc != 0 { return rc; }
	return 0;
}

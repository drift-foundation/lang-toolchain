module main;

import std.err;
import std.iter as iter;
import std.containers as containers;
use trait iter.RandomAccessPermutable;

fn main() nothrow -> Int {
var dq = containers.deque<type Int>();
	dq.push_back(1);
	dq.push_back(2);
	var r = dq.range_mut();
	var out = 0;
	try {
		r.__test_invalidate();
		r.swap(0, 0);
	} catch std.err:IteratorInvalidated(e) {
		// Slice 7a: typed catch projection on synthesized fields.
		val c_code = (not (e.container_id == "std.containers:Deque")) ? 10 : 0;
		out = c_code;
	} catch {
		out = 99;
	}
	return out;
}

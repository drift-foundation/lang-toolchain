module main;

import std.err;
import std.iter as iter;
import std.containers as containers;
use trait iter.RandomAccessPermutable;

fn main() nothrow -> Int {
var dq = containers.deque<type Int>();
	dq.push_back(1);
	dq.push_back(2);
	var r = dq.range_mut();
	var out = 0;
	try {
		r.__test_invalidate();
		r.swap(0, 0);
	} catch std.err:IteratorInvalidated(e) {
		val dv_c = e.attrs["container_id"];
		val dv_o = e.attrs["op_id"];
		val c = dv_c.as_string();
		val o = dv_o.as_int();
		val c_code = match c {
			Some(s) => {
				(not (s == "std.containers:Deque")) ? 10 : 0
			},
			None => {
				11
			},
		};
		val o_code = match o {
			Some(v) => {
				(v != 4) ? 12 : 0
			},
			None => {
				13
			},
		};
		out = (c_code != 0) ? c_code : ((o_code != 0) ? o_code : 0);
	} catch {
		out = 99;
	}
	return out;
}

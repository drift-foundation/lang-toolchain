module main;

import std.concurrent as conc;
import std.core as core;
import lang.thread as thread;

fn main() nothrow -> Int {
	thread.exec_submit_test_override(1);
	var t = conc.spawn(| | => { return 7; });
	var res = t.join();
		match res {
		Err(err) => {
			if err.kind == conc.CONCURRENCY_KIND_FAILED { return 0; }
			return 1;
		},
		Ok(_v) => { return 2; },
		default => { return 2; },
	}
}

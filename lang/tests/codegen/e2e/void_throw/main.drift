module m;

import std.console as console;

error Boom {}
fn maybe_fail(flag: Int) -> Void {
	if flag == 0 {
		return;
	}
	throw Boom();
}

fn main() nothrow -> Int{
	// Success path.
	try {
		maybe_fail(0);
	} catch err {
		console.println("unexpected");
		return 2;
	}
	console.println("ok");

	// Error path.
	try {
		maybe_fail(1);
	} catch err {
		console.println("err");
		return 1;
	}

	console.println("should-not-reach");
	return 0;
}

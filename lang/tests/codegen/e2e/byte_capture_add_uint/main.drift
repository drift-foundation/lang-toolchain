module m;

import std.concurrent as conc;

pub fn main() nothrow -> Int {
	val b = cast<Byte>(65);
	var t = conc.spawn(| | captures(copy b) => {
		val u = cast<Uint>(b);
		val one = cast<Uint>(1);
		val s = u + one;
		return cast<Int>(s);
	});
	val r = t.join();
	match r {
		Ok(v) => {
			if v == 66 { return 0; }
			return 1;
		},
		Err(_) => { return 2; },
		default => { return 3; }
	}
}

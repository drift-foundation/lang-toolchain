module main;

import std.runtime as rt;

struct AppCfg {
	name: String,
}

fn run() -> Int {
	val reg = rt.global_registry();
	val cfg = AppCfg(name = "main");
	if not reg.set(move cfg) {
		return 1;
	}
	val got = rt.expect<type AppCfg>(reg, "missing-appcfg");
	if got.name != "main" {
		return 2;
	}
	try {
		val _ = rt.expect<type Int>(reg, "missing-int");
		return 3;
	} catch rt:RegistryError(e) {
		// Slice 7a: typed catch projection on synthesized field.
		if e.tag != "missing-int" {
			return 4;
		}
		return 0;
	} catch {
		return 5;
	}
}

fn main() nothrow -> Int {
	return try run() catch { 99 };
}

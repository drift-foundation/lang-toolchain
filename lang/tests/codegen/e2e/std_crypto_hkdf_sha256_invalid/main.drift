module m;

import std.core as core;
import std.crypto as crypto;

pub fn main() nothrow -> Int {
	var prk: Array<Byte> = [];
	var i = 0;
	while i < 32 {
		prk.push(cast<Byte>(i));
		i = i + 1;
	}
	var info: Array<Byte> = [];

	// 1. Negative output length -> Err
	val r1 = crypto.hkdf_expand_sha256(&prk, &info, -1);
	match r1 {
		core.Result::Ok(_) => { return 1; },
		core.Result::Err(e) => {
			if e.tag != "invalid-output-length" { return 2; }
		}
	}

	// 2. Output length > 255*32 = 8160 -> Err
	val r2 = crypto.hkdf_expand_sha256(&prk, &info, 8161);
	match r2 {
		core.Result::Ok(_) => { return 3; },
		core.Result::Err(e) => {
			if e.tag != "invalid-output-length" { return 4; }
		}
	}

	// 3. Exactly 8160 should succeed (boundary)
	val r3 = crypto.hkdf_expand_sha256(&prk, &info, 8160);
	match r3 {
		core.Result::Ok(okm) => {
			if okm.len != 8160 { return 5; }
		},
		core.Result::Err(_) => { return 6; }
	}

	// 4. Full hkdf_sha256 with negative length -> Err
	var salt: Array<Byte> = [];
	var ikm: Array<Byte> = [];
	val r4 = crypto.hkdf_sha256(&salt, &ikm, &info, -1);
	match r4 {
		core.Result::Ok(_) => { return 7; },
		core.Result::Err(e) => {
			if e.tag != "invalid-output-length" { return 8; }
		}
	}

	return 0;
}

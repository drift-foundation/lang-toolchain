module m

exception E(code: Int)

fn fail(x: Int) -> Int {
	val ^input: Int = x;
	val ^note: String as "pipeline.note" = "captured";
	throw E(code = x);
}

fn inspect(e: E) nothrow -> Int {
	val dv_i = e.captures["m::fail"]["input"];
	val oi = dv_i.as_int();
	match oi {
		Some(v) => { if v != 7 { return 1; } },
		None => { return 2; },
		default => { return 3; }
	}

	val dv_n = e.captures["m::fail"]["pipeline.note"];
	val on = dv_n.as_string();
	match on {
		Some(s) => { if s != "captured" { return 4; } },
		None => { return 5; },
		default => { return 6; }
	}

	val miss = e.captures["m::fail"]["missing"];
	val om = miss.as_int();
	match om {
		Some(_x) => { return 7; },
		None => { return 0; },
		default => { return 8; }
	}
}

fn main() nothrow -> Int {
	return try fail(7) catch E(e) { inspect(e) } catch { 9 };
}

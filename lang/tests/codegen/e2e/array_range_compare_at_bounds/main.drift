module main;

import std.err;
import std.iter as iter;

fn check_bounds<R>(r: &R, i: Int, j: Int, expect: Int) nothrow -> Int require R is iter.RandomAccessReadable<Int> {
	val out = try iter.RandomAccessReadable::compare_at(r, i, j) catch std.err:IndexError(e) {
		// Slice 7a: typed catch projection on synthesized fields.
		val c_code = (e.container_id != "std.containers:Array") ? 10 : 0;
		val i_code = (e.index != expect) ? 12 : 0;
		(c_code != 0) ? c_code : i_code
	} catch {
		90
	};
	return out;
}

pub fn main() nothrow -> Int {
	var arr = [1, 2];
	var r = arr.range();
	val neg = check_bounds(&r, -1, 0, -1);
	if neg != 0 {
		return neg;
	}
	val hi = check_bounds(&r, 2, 0, 2);
	return hi;
}

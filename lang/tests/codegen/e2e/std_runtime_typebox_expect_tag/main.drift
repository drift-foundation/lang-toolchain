module main;

import std.runtime as rt;

fn run() -> Int {
	val b = rt.type_box(7);
	val _ = rt.expect_downcast<type Int>(b, "x");
	try {
		val _ = rt.expect_downcast<type String>(b, "invalid-datatype");
		return 1;
	} catch rt:TypeBoxError(_e) {
		return 0;
	} catch {
		return 2;
	}
}

pub fn main() nothrow -> Int {
	return try run() catch { 3 };
}

module acme.matrix;

export { Msg };

// Generic variant with a `@tombstone` ctor.  Consumer constructs
// `Msg::Payload` across the boundary and matches it.  Targets variant
// tombstone metadata reconstruction after package linking — the
// 0.27.197 generic-variant-re-finalization fix must survive the
// signed-package boundary round-trip.
pub variant Msg<T> {
	Payload(v: T),
	@tombstone Tombstone,
}

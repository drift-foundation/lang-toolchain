module acme.matrix;

import std.core as core;

export { AcmeError, Widget, make_widget, configure, run_widget };

// Migrated 2026-05-06 from `pub variant AcmeError` + hand-rolled
// `core.Throw` / `core.Diagnostic` impls to canonical `pub error`.
// Slice 5's strict `or_throw()` gate (E_OR_THROW_NOT_ERROR_TYPE)
// requires the `Err` type of `Result<T, E>` to be a `pub error`
// type; auto-try desugars through `or_throw`, so the same gate
// applies to the consumer's auto-try use of this type.  The
// `Throw` and `Diagnostic` impls are now compiler-synthesized
// from the `pub error` decl — no hand-rolled impls needed.
pub error AcmeError { code: Int }

pub struct Widget {
	pub v: Int,
}

// Returns Result<Widget, AcmeError>.
pub fn make_widget(n: Int) -> core.Result<Widget, AcmeError> {
	return core.Result::Ok(Widget(v = n));
}

// Takes &mut Widget — if auto-try didn't unwrap the binding,
// this overload resolution fails.
pub fn configure(w: &mut Widget, extra: Int) -> core.Result<Int, AcmeError> {
	w.v = w.v + extra;
	return core.Result::Ok(w.v);
}

// Takes Widget by move.
pub fn run_widget(w: Widget) -> core.Result<Int, AcmeError> {
	return core.Result::Ok(w.v);
}

module main

struct Foo {
	val x: Int
}

// Negative regression: taking &mut of a field through a shared reference
// must remain rejected. The call-site reborrow (&mut T → &T) does NOT
// imply that shared references can be upgraded to mutable sub-borrows.
fn bad(f: &Foo) nothrow -> Int {
	val p = &mut (*f).x;
	*p = 99;
	return *p;
}

fn main() nothrow -> Int {
	var f = Foo(x = 10);
	return bad(&f);
}

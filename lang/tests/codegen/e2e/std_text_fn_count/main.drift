module main;

import std.core as core;
import std.text as text;

fn str_eq(a: &String, b: &String) nothrow -> Bool {
	val an = a.byte_length();
	val bn = b.byte_length();
	if an != bn { return false; }
	var i = 0;
	while i < an {
		if core.string_byte_at(a, i) != core.string_byte_at(b, i) { return false; }
		i = i + 1;
	}
	return true;
}


fn main() nothrow -> Int {
	if text.count("aabaaab", "aa") != 2 { return 1; }
	if text.count("hello", "l") != 2 { return 2; }
	if text.count("hello", "xyz") != 0 { return 3; }
	// Empty needle → 0
	if text.count("hello", "") != 0 { return 4; }
	// Empty haystack → 0
	if text.count("", "x") != 0 { return 5; }
	// Full string match → 1
	if text.count("abc", "abc") != 1 { return 6; }

	return 0;
}

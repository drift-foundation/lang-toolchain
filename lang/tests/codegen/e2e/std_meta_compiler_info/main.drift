module main;

import std.core as core;
import std.meta as meta;

fn contains(haystack: &String, needle: &String) nothrow -> Bool {
	val hn = haystack.byte_length();
	val nn = needle.byte_length();
	if nn == 0 {
		return true;
	}
	if hn < nn {
		return false;
	}
	var i = 0;
	while i <= hn - nn {
		var j = 0;
		var ok = true;
		while j < nn {
			val a = core.string_byte_at(haystack, i + j);
			val b = core.string_byte_at(needle, j);
			if a != b {
				ok = false;
				j = nn;
			} else {
				j = j + 1;
			}
		}
		if ok {
			return true;
		}
		i = i + 1;
	}
	return false;
}

fn main() nothrow -> Int {
	val info = meta.compiler_info();
	val k_driftc = "driftc";
	if !contains(&info, &k_driftc) {
		return 1;
	}
	val k_abi = "abi";
	if !contains(&info, &k_abi) {
		return 2;
	}
	val k_word = "word";
	if !contains(&info, &k_word) {
		return 3;
	}
	val k_build_utc = "build_utc";
	if !contains(&info, &k_build_utc) {
		return 4;
	}
	// `profile` is the app-visible build-profile tag.  The normal
	// compiler lane stamps "optimized" (DRIFT_DEBUG => "debug";
	// sanitizer modes => "asan"/"ubsan"/"asan_ubsan").  We only
	// assert presence here so this test stays lane-agnostic.
	val k_profile = "profile";
	if !contains(&info, &k_profile) {
		return 5;
	}
	// `vendor` and `license` are constants of this toolchain build
	// (DRIFTC_VENDOR / DRIFTC_LICENSE in lang/versions.py).  Pinning
	// the literal values here -- a fork that rebuilt under a
	// different vendor/license should change these constants; this
	// test will surface that as a fail, which is what we want for the
	// canonical Drift Foundation build.
	val k_vendor = "vendor The Drift Language Foundation";
	if !contains(&info, &k_vendor) {
		return 6;
	}
	val k_license = "license GPL-3.0";
	if !contains(&info, &k_license) {
		return 7;
	}
	return 0;
}

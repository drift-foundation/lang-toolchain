module main;

import std.core as core;
import std.text as text;

fn str_eq(a: &String, b: &String) nothrow -> Bool {
	val an = a.byte_length();
	val bn = b.byte_length();
	if an != bn { return false; }
	var i = 0;
	while i < an {
		if core.string_byte_at(a, i) != core.string_byte_at(b, i) { return false; }
		i = i + 1;
	}
	return true;
}


pub fn main() nothrow -> Int {
	var p = text.split_limit("a,b,c,d", ",", 2);
	if p.len != 3 { return 1; }
	val ea = "a"; val eb = "b"; val ecd = "c,d";
	if !str_eq(&p[0], &ea) { return 2; }
	if !str_eq(&p[1], &eb) { return 3; }
	if !str_eq(&p[2], &ecd) { return 4; }
	// max=0 → no splits
	var p2 = text.split_limit("a,b", ",", 0);
	if p2.len != 1 { return 5; }
	// max=1 → split once
	var p3 = text.split_limit("a,b,c", ",", 1);
	if p3.len != 2 { return 6; }
	val ebc = "b,c";
	if !str_eq(&p3[1], &ebc) { return 7; }

	return 0;
}

module main;

import std.err;

pub fn main() nothrow -> Int {
	val xs = [1, 2, 3];
	try {
		val _ = xs[3];
		return 10;
	} catch std.err:IndexError(e) {
		// Slice 7a: typed catch projection on the synthesized
		// pub error fields.  Replaces the retired
		// `e.attrs[k]` DV-typed view.
		if e.container_id != "std.containers:Array" {
			return 20;
		}
		if e.index != 3 {
			return 22;
		}
		return 0;
	}
}

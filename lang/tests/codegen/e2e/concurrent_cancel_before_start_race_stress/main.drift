module main;

import std.concurrent as conc;

fn one() -> Int {
	var t = conc.spawn(| | => {
		conc.sleep(conc.Duration(millis = 1));
		return 1;
	});
	t.cancel();
	var res = t.join_timeout(conc.Duration(millis = 0));
		match res {
		Err(err) => {
			if err.kind == conc.CONCURRENCY_KIND_CANCELLED { return 0; }
			if err.kind == conc.CONCURRENCY_KIND_TIMEOUT { return 0; }
			if err.kind == conc.CONCURRENCY_KIND_CLOSED { return 12; }
			if err.kind == conc.CONCURRENCY_KIND_BUSY { return 13; }
			if err.kind == conc.CONCURRENCY_KIND_FAILED { return 14; }
			return 15;
		},
		Ok(_v) => { return 0; },
		default => { return 16; },
	}
}

fn run() -> Int {
	var i = 0;
	while i < 3000 {
		val rc = one();
		if rc != 0 {
			return rc;
		}
		i = i + 1;
	}
	return 0;
}

fn main() nothrow -> Int {
	return try run() catch { 99 };
}

module main

import std.concurrent as conc;

fn one() -> Int {
	var t = conc.spawn(| | => {
		conc.sleep(conc.Duration(millis = 1));
		return 1;
	});
	t.cancel();
	var res = t.join_timeout(conc.Duration(millis = 0));
	return match res {
		Err(err) => {
			yield match err {
				Cancelled => { 0 },
				Timeout => { 0 },
				Closed => { 1 },
				Busy => { 1 },
				Failed(_) => { 1 },
				default => { 1 },
			}
		},
		Ok(_v) => { 0 },
		default => { 1 },
	};
}

fn run() -> Int {
	var i = 0;
	while i < 3000 {
		if one() != 0 {
			return 1;
		}
		i = i + 1;
	}
	return 0;
}

fn main() nothrow -> Int {
	return try run() catch { 99 };
}

module m

import std.sync as sync;

fn main() nothrow -> Int {
	val x = sync.atomic_uint(cast<Uint>(0));
	x.store(cast<Uint>(1), sync.MemoryOrder::Relaxed());
	sync.thread_fence(sync.MemoryOrder::Release());
	val y = x.load(sync.MemoryOrder::Acquire());
	sync.signal_fence(sync.MemoryOrder::SeqCst());
	if y == cast<Uint>(1) {
		return 0;
	}
	return 1;
}

module main;

import std.core as core;
import std.log as log;

pub fn main() nothrow -> Int {
	var cfgb = log.config_builder();
	cfgb.sink(log.stderr_sink());
	cfgb.min_level(log.Level::Debug());
	val logger = log.create_logger("test", cfgb.build());

	// No-attrs overloads (the new API)
	logger.debug("debug-event");
	logger.info("info-event");
	logger.error("error-event");

	// Attrs overloads (must still work)
	logger.info("with-attrs", {"k": "v"});

	return 0;
}

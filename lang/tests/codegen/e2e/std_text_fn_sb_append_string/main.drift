module main;

import std.core as core;
import std.text as text;

fn str_eq(a: &String, b: &String) nothrow -> Bool {
	val an = a.byte_length();
	val bn = b.byte_length();
	if an != bn { return false; }
	var i = 0;
	while i < an {
		if core.string_byte_at(a, i) != core.string_byte_at(b, i) { return false; }
		i = i + 1;
	}
	return true;
}


pub fn main() nothrow -> Int {
	var sb = text.string_builder(16);
	text.sb_append_string(sb, "hello");
	text.sb_append_string(sb, " ");
	text.sb_append_string(sb, "world");
	val s = text.sb_build(sb);
	val e = "hello world";
	if !str_eq(s, e) { return 1; }
	// Append empty string is no-op
	text.sb_append_string(sb, "");
	if text.sb_len(sb) != 11 { return 2; }

	return 0;
}

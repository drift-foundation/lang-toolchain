module m;

import std.io as io;
import std.log as log;
import std.runtime as runtime;
import std.concurrent as conc;

pub fn main() nothrow -> Int {
	val reg = runtime.global_registry();
	if not runtime.contains<type io.ProcessStderrCapability>(reg) {
		return 1;
	}
	var b = log.config_builder();
	val lg = log.create_logger("main", b.build());
	lg.info("preamble-sink", {"ok": 1});
	val _ = lg.flush(conc.Duration(millis = 10));
	return 0;
}

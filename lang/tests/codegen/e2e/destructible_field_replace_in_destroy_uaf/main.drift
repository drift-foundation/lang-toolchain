module m;

import std.core as core;

// REGRESSION: two bugs fixed simultaneously:
//
// 1. UAF: post-destroy caller-side field drops used stale SSA snapshot,
//    reading freed pointers when destroy() replaced owned fields.
//
// 2. LEAK: replacement Array<String> created inside destroy's call chain
//    was never freed because Destructible fields were skipped in the
//    post-destroy field-drop epilogue.
//
// The fix: self participates in scope drops inside destroy(). The codegen
// inside-destroy guard detects the recursive drop and emits per-field
// drops (calling destroy() on Destructible fields) using the LIVE
// post-mutation self value at scope exit.

struct Holder {
	items: Array<String>,
	tag: Int,
}

fn replace_items(h: &mut Holder) nothrow -> Void {
	// This drops old h.items (freeing backing), stores a new array.
	h.items = ["x", "y"];
	return;
}

implement core.Destructible for Holder {
	pub fn destroy(var self: Holder) nothrow -> Void {
		// Calls through &mut self, replacing the owned Array<String> field.
		replace_items(self);
		return;
	}
}

pub fn main() nothrow -> Int {
	val h = Holder(items = ["a", "b", "c"], tag = 42);
	// h goes out of scope here.
	// destroy() replaces items with ["x","y"]; the replacement must be
	// freed by the epilogue field drops (no UAF, no leak).
	return 0;
}

module m

import std.concurrent as conc;
import std.net as net;

pub fn main() nothrow -> Int {
	var addr = net.socket_addr("127.0.0.1", 0);
	var lr = net.listen(&addr);
	match lr {
		Ok(l) => {
			val port = l.test_local_port();
			var t = conc.spawn(| | captures(copy port) => {
				var caddr = net.socket_addr("127.0.0.1", port);
				var cr = net.connect(&caddr);
				match cr {
					Ok(s) => {
						val _ = s.close();
						return 1;
					},
					Err(_) => { return 2; },
					default => { return 3; }
				}
			});
			var ar = net.accept(&l);
			match ar {
				Ok(s2) => { val _ = s2.close(); },
				Err(_) => { return 4; },
				default => { return 5; }
			}
			var tr = t.join();
			match tr {
				Ok(_) => { },
				Err(_) => { return 7; },
				default => { return 8; }
			}
			return 0;
		},
		Err(_) => { return 9; },
		default => { return 10; }
	}
}

module m

import std.concurrent as conc;
import std.containers as containers;
import std.core as core;
import std.io as io;
import std.net as net;
use trait core.Try;

type VtInt = conc.VirtualThread<Int>;

const N: Int = 500;

fn handle_client(var s: net.TcpStream) throws -> Int {
	// Server-side handler for one client:
	// - read a fixed-size buffer
	// - echo it back
	// - close the socket
	var buf = io.buffer(1024);
	s.read(&mut buf);
	s.write(&buf);
	s.close();
	return 0;
}

fn server_loop(listener: net.TcpListener) throws -> Int {
	// Accept exactly N connections and handle them sequentially.
	var i = 0;
	while i < N {
		val s = net.accept(&listener);
		val r = handle_client(move s);
		if r < 0 { return r; }
		i = i + 1;
	}
	return 0;
}

fn client_once(port: Int, size: Int) throws -> Int {
	// One client:
	// - connect to 127.0.0.1:port
	// - write size bytes (all 65)
	// - read size bytes back
	// - close socket
	var addr = net.socket_addr("127.0.0.1", port);
	val s = net.connect(&addr);
	// Prepare write buffer.
	val byte = cast<Byte>(65);
	var wbuf = io.buffer(size);
	var i = 0;
	while i < size {
		io.buffer_write(&mut wbuf, i, byte);
		i = i + 1;
	}
	val n = s.write(&wbuf);
	if n != size { return -33; }
	// Read echoed bytes into a fresh buffer.
	var rbuf = io.buffer(size);
	val r = s.read(&mut rbuf);
	if r != size { return -36; }
	s.close();
	return size * 65;
}

pub fn main() nothrow -> Int {
	return try run_main() catch { 1 };
}

fn run_main() throws -> Int {
	// Spin up a TCP listener on an ephemeral port.
	var addr = net.socket_addr("127.0.0.1", 0);
	val listener = net.listen(&addr);
	val port = listener.local_port();
	// Start the server in its own VT.
	var server = conc.spawn(| | captures(move listener, copy port) => {
		return try server_loop(move listener) catch { -70 };
	});
	var dq = containers.deque<type VtInt>();
	// Expected sum is the total bytes written across all clients.
	var expected = 0;
	var k = 0;
	var actual = 0;
	while k < N {
		// Size cycles 1/64/1024 to stress small/medium/large payloads.
		val size = (k % 3 == 0) ? 1 : ((k % 3 == 1) ? 64 : 1024);
		expected = expected + (size * 65);
		// Spawn the client VT.
		val t = conc.spawn(| | captures(copy port, copy size) => {
			return try client_once(port, size) catch { -80 };
		});
		dq.push_back(move t);
		k = k + 1;
	}
	// Join all client VTs and accumulate actual sum.
	while dq.len() > 0 {
		val opt = dq.pop_front();
		match opt {
			Some(vt) => {
				var t = move vt;
				val code = t.join();
				if code < 0 { return code; }
				actual = actual + code;
			},
			None => { return 60; },
			default => { return 63; }
		}
	}
	// Join server and verify total math.
	val v = server.join();
	if v != 0 { return 70; }
	if actual != expected { return 71; }
	return 0;
}

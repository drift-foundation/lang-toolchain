module m

import std.err as err;

fn code_from_error(e: err.ResultError) nothrow -> Int {
	val dv = e.attrs["dv"];
	val opt = dv.as_int();
	match opt {
		Some(v) => { return v; },
		None => { return -1; },
		default => { return -2; }
	}
}

fn fail() -> Int {
	throw err:ResultError(dv = 7);
}

	pub fn main() nothrow -> Int {
		val v = try fail() catch err:ResultError(e) {
			code_from_error(e)
		} catch {
			99
		};
		return v;
	}

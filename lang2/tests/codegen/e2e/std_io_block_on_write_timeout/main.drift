module m

import std.concurrent as conc;
import std.io as io;
import lang.thread as thread;

pub fn main() nothrow -> Int {
	val fd = thread.test_eventfd_create();
	if fd <= 0 { return 9; }
	thread.test_eventfd_write(fd, 9223372036854775806);
	val f = io.file_from_fd(fd);
	var buf = io.buffer(1);
	io.buffer_write(&mut buf, 0, cast<Byte>(1));
	val t = conc.Duration(millis = 1);
	val r = io.write(&f, &buf, t);
	match r {
		Ok(_) => { return 2; },
		Err(e) => {
			match e {
				WouldBlock => { return 0; },
				Errno(_) => { return 0; },
				default => { return 4; }
			}
		},
		default => { return 5; }
	}
}

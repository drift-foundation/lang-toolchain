	Literal(byte_val: Byte),
	Dot,
	Anchor(kind: LgAnchorKind),
	Class(cls: LgCharClass),
	Group(children: Array<LgRegexNode>),
	Alternation(branches: Array<LgRegexNode>),
	Repeat(child: Array<LgRegexNode>, quant: LgQuantifier),

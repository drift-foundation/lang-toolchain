// ---------------------------------------------------------------------------
// LgParser — single-pass recursive descent over pattern bytes
// ---------------------------------------------------------------------------

struct LgParser {
	src: String,
	len: Int,
	pos: Int
}

fn Lg_new_parser(pattern: &String) nothrow -> LgParser {
	return LgParser(src = *pattern, len = pattern.byte_length(), pos = 0);
}

fn Lg_peek(p: &mut LgParser) nothrow -> Int {
	if p.pos >= p.len {
		return 0 - 1;
	}
	return cast<Int>(core.string_byte_at(&p.src, p.pos));
}

fn Lg_advance(p: &mut LgParser) nothrow -> Byte {
	val b = core.string_byte_at(&p.src, p.pos);
	p.pos = p.pos + 1;
	return b;
}

fn Lg_at_end(p: &mut LgParser) nothrow -> Bool {
	return p.pos >= p.len;
}

fn Lg_err(tag: &String, offset: Int) nothrow -> core.Result<LgRegexNode, LgRegexError> {
	return core.Result::Err(LgRegexError(tag = *tag, offset = offset));
}

// ---------------------------------------------------------------------------
// Top-level entry: parse alternation
// ---------------------------------------------------------------------------

/// Parses `pattern` and compiles it to a matchable `LgRegex`.
///
/// Supported syntax: literal bytes, `.` dot, `^` / `$` anchors,
/// `[...]` character classes (with negation `[^...]` and ranges
/// `a-z`), `*` / `+` / `?` quantifiers, alternation `a|b`,
/// grouping `(...)`, and the standard escapes `\d` `\D` `\w` `\W`
/// `\s` `\S` `\t` `\n` `\r`.  Backreferences and named groups are
/// not supported.
///
/// **Returns:** `Ok(LgRegex)` on success.  `Err(LgRegexError)` carrying
/// a stable failure tag and the byte offset where parsing failed.
///
/// **See also:** `LgRegex`, `LgRegexError`, `Lgis_match`, `Lgfind_first`.
pub fn Lgcompile(pattern: &String) nothrow -> core.Result<LgRegex, LgRegexError> {
	var p = Lg_new_parser(pattern);
	match Lg_parse_alternation(&mut p) {
		core.Result::Ok(node) => {
			if not Lg_at_end(&mut p) {
				val tag = "unexpected-char";
				return core.Result::Err(LgRegexError(tag = tag, offset = p.pos));
			}
			val nfa = Lg_nfa_compile(&node);
			return core.Result::Ok(LgRegex(root = move node, nfa = move nfa));
		},
		core.Result::Err(e) => {
			return core.Result::Err(move e);
		}
	}
}

// alternation = sequence ('|' sequence)*
fn Lg_parse_alternation(p: &mut LgParser) nothrow -> core.Result<LgRegexNode, LgRegexError> {
	match Lg_parse_sequence(p) {
		core.Result::Err(e) => { return core.Result::Err(move e); },
		core.Result::Ok(first) => {
			if Lg_peek(p) != 124 {
				return core.Result::Ok(move first);
			}
			var branches = Array<type LgRegexNode>::with_capacity(4);
			branches.push(first);
			while Lg_peek(p) == 124 {
				p.pos = p.pos + 1;
				match Lg_parse_sequence(p) {
					core.Result::Err(e) => { return core.Result::Err(move e); },
					core.Result::Ok(branch) => {
						branches.push(branch);
					}
				}
			}
			return core.Result::Ok(LgRegexNode::Alternation(branches = move branches));
		}
	}
}

// sequence = quantified*
fn Lg_parse_sequence(p: &mut LgParser) nothrow -> core.Result<LgRegexNode, LgRegexError> {
	var children = Array<type LgRegexNode>::with_capacity(8);
	while not Lg_at_end(p) {
		val ch = Lg_peek(p);
		// Stop at alternation pipe or closing paren.
		if ch == 124 or ch == 41 {
			break;
		}
		match Lg_parse_quantified(p) {
			core.Result::Err(e) => { return core.Result::Err(move e); },
			core.Result::Ok(node) => {
				children.push(node);
			}
		}
	}
	if children.len == 1 {
		// Unwrap single-element group to keep AST lean.
		match children.pop() {
			Optional::Some(only) => { return core.Result::Ok(move only); },
			Optional::None() => { }
		}
	}
	return core.Result::Ok(LgRegexNode::Group(children = move children));
}

// quantified = atom ('*' | '+' | '?')?
fn Lg_parse_quantified(p: &mut LgParser) nothrow -> core.Result<LgRegexNode, LgRegexError> {
	match Lg_parse_atom(p) {
		core.Result::Err(e) => { return core.Result::Err(move e); },
		core.Result::Ok(atom) => {
			if Lg_at_end(p) {
				return core.Result::Ok(move atom);
			}
			val ch = Lg_peek(p);
			if ch == 42 {
				p.pos = p.pos + 1;
				var wrap = Array<type LgRegexNode>::with_capacity(1);
				wrap.push(atom);
				return core.Result::Ok(LgRegexNode::Repeat(child = move wrap, quant = LgQuantifier::Star()));
			}
			if ch == 43 {
				p.pos = p.pos + 1;
				var wrap = Array<type LgRegexNode>::with_capacity(1);
				wrap.push(atom);
				return core.Result::Ok(LgRegexNode::Repeat(child = move wrap, quant = LgQuantifier::Plus()));
			}
			if ch == 63 {
				p.pos = p.pos + 1;
				var wrap = Array<type LgRegexNode>::with_capacity(1);
				wrap.push(atom);
				return core.Result::Ok(LgRegexNode::Repeat(child = move wrap, quant = LgQuantifier::Question()));
			}
			return core.Result::Ok(move atom);
		}
	}
}

// atom = '.' | '^' | '$' | '(' alternation ')' | '[' charclass ']' | '\\' escape | literal
fn Lg_parse_atom(p: &mut LgParser) nothrow -> core.Result<LgRegexNode, LgRegexError> {
	val ch = Lg_peek(p);

	// Dot: any character.
	if ch == 46 {
		p.pos = p.pos + 1;
		return core.Result::Ok(LgRegexNode::Dot());
	}

	// Caret: start anchor.
	if ch == 94 {
		p.pos = p.pos + 1;
		return core.Result::Ok(LgRegexNode::Anchor(kind = LgAnchorKind::Start()));
	}

	// Dollar: end anchor.
	if ch == 36 {
		p.pos = p.pos + 1;
		return core.Result::Ok(LgRegexNode::Anchor(kind = LgAnchorKind::End()));
	}

	// Open paren: grouped sub-expression.
	if ch == 40 {
		p.pos = p.pos + 1;
		match Lg_parse_alternation(p) {
			core.Result::Err(e) => { return core.Result::Err(move e); },
			core.Result::Ok(inner) => {
				if Lg_at_end(p) or Lg_peek(p) != 41 {
					val tag = "unclosed-group";
					return Lg_err(&tag, p.pos);
				}
				p.pos = p.pos + 1;
				return core.Result::Ok(move inner);
			}
		}
	}

	// Open bracket: character class.
	if ch == 91 {
		return Lg_parse_char_class(p);
	}

	// Backslash: escape sequence.
	if ch == 92 {
		return Lg_parse_escape(p);
	}

	// Bare closing paren without matching open.
	if ch == 41 {
		val tag = "unexpected-paren";
		return Lg_err(&tag, p.pos);
	}

	// Bare quantifier with no preceding atom.
	if ch == 42 or ch == 43 or ch == 63 {
		val tag = "dangling-quantifier";
		return Lg_err(&tag, p.pos);
	}

	// Literal byte.
	val b = Lg_advance(p);
	return core.Result::Ok(LgRegexNode::Literal(byte_val = b));
}

// ---------------------------------------------------------------------------
// Escape sequences: \d \D \w \W \s \S and metachar literals
// ---------------------------------------------------------------------------

fn Lg_parse_escape(p: &mut LgParser) nothrow -> core.Result<LgRegexNode, LgRegexError> {
	val start = p.pos;
	p.pos = p.pos + 1;
	if Lg_at_end(p) {
		val tag = "trailing-backslash";
		return Lg_err(&tag, start);
	}
	val ch = cast<Int>(Lg_advance(p));

	// \d  → [0-9]
	if ch == 100 {
		return core.Result::Ok(Lg_class_digit(false));
	}
	// \D  → [^0-9]
	if ch == 68 {
		return core.Result::Ok(Lg_class_digit(true));
	}
	// \w  → [A-Za-z0-9_]
	if ch == 119 {
		return core.Result::Ok(Lg_class_word(false));
	}
	// \W  → [^A-Za-z0-9_]
	if ch == 87 {
		return core.Result::Ok(Lg_class_word(true));
	}
	// \s  → [ \t\n\r]
	if ch == 115 {
		return core.Result::Ok(Lg_class_space(false));
	}
	// \S  → [^ \t\n\r]
	if ch == 83 {
		return core.Result::Ok(Lg_class_space(true));
	}

	// \t
	if ch == 116 {
		return core.Result::Ok(LgRegexNode::Literal(byte_val = cast<Byte>(9)));
	}
	// \n
	if ch == 110 {
		return core.Result::Ok(LgRegexNode::Literal(byte_val = cast<Byte>(10)));
	}
	// \r
	if ch == 114 {
		return core.Result::Ok(LgRegexNode::Literal(byte_val = cast<Byte>(13)));
	}

	// Metacharacter literal escapes: \. \^ \$ \( \) \[ \] \| \* \+ \? \\
	if ch == 46 or ch == 94 or ch == 36 or ch == 40 or ch == 41 or ch == 91 or ch == 93 or ch == 124 or ch == 42 or ch == 43 or ch == 63 or ch == 92 {
		return core.Result::Ok(LgRegexNode::Literal(byte_val = cast<Byte>(ch)));
	}

	val tag = "invalid-escape";
	return Lg_err(&tag, start);
}

// ---------------------------------------------------------------------------
// Built-in character class constructors
// ---------------------------------------------------------------------------

fn Lg_class_digit(neg: Bool) nothrow -> LgRegexNode {
	var ranges = Array<type LgCharRange>::with_capacity(1);
	ranges.push(LgCharRange(lo = cast<Byte>(48), hi = cast<Byte>(57)));
	return LgRegexNode::Class(cls = LgCharClass(negated = neg, ranges = move ranges));
}

fn Lg_class_word(neg: Bool) nothrow -> LgRegexNode {
	var ranges = Array<type LgCharRange>::with_capacity(4);
	ranges.push(LgCharRange(lo = cast<Byte>(65), hi = cast<Byte>(90)));
	ranges.push(LgCharRange(lo = cast<Byte>(97), hi = cast<Byte>(122)));
	ranges.push(LgCharRange(lo = cast<Byte>(48), hi = cast<Byte>(57)));
	ranges.push(LgCharRange(lo = cast<Byte>(95), hi = cast<Byte>(95)));
	return LgRegexNode::Class(cls = LgCharClass(negated = neg, ranges = move ranges));
}

fn Lg_class_space(neg: Bool) nothrow -> LgRegexNode {
	var ranges = Array<type LgCharRange>::with_capacity(4);
	ranges.push(LgCharRange(lo = cast<Byte>(32), hi = cast<Byte>(32)));
	ranges.push(LgCharRange(lo = cast<Byte>(9), hi = cast<Byte>(9)));
	ranges.push(LgCharRange(lo = cast<Byte>(10), hi = cast<Byte>(10)));
	ranges.push(LgCharRange(lo = cast<Byte>(13), hi = cast<Byte>(13)));
	return LgRegexNode::Class(cls = LgCharClass(negated = neg, ranges = move ranges));
}

// ---------------------------------------------------------------------------
// Character class parsing: [abc], [a-z], [^...], [\d], etc.
// ---------------------------------------------------------------------------

fn Lg_parse_char_class(p: &mut LgParser) nothrow -> core.Result<LgRegexNode, LgRegexError> {
	val start = p.pos;
	p.pos = p.pos + 1;

	var negated = false;
	if not Lg_at_end(p) and Lg_peek(p) == 94 {
		negated = true;
		p.pos = p.pos + 1;
	}

	var ranges = Array<type LgCharRange>::with_capacity(4);
	var first = true;

	while not Lg_at_end(p) and (Lg_peek(p) != 93 or first) {
		first = false;
		val ch = Lg_peek(p);

		// Escape inside class.
		if ch == 92 {
			p.pos = p.pos + 1;
			if Lg_at_end(p) {
				val tag = "trailing-backslash-in-class";
				return Lg_err(&tag, p.pos - 1);
			}
			val esc = cast<Int>(Lg_advance(p));
			// Shorthand classes inside []: \d \w \s and their negations.
			if esc == 100 {
				ranges.push(LgCharRange(lo = cast<Byte>(48), hi = cast<Byte>(57)));
				continue;
			}
			if esc == 119 {
				ranges.push(LgCharRange(lo = cast<Byte>(65), hi = cast<Byte>(90)));
				ranges.push(LgCharRange(lo = cast<Byte>(97), hi = cast<Byte>(122)));
				ranges.push(LgCharRange(lo = cast<Byte>(48), hi = cast<Byte>(57)));
				ranges.push(LgCharRange(lo = cast<Byte>(95), hi = cast<Byte>(95)));
				continue;
			}
			if esc == 115 {
				ranges.push(LgCharRange(lo = cast<Byte>(32), hi = cast<Byte>(32)));
				ranges.push(LgCharRange(lo = cast<Byte>(9), hi = cast<Byte>(9)));
				ranges.push(LgCharRange(lo = cast<Byte>(10), hi = cast<Byte>(10)));
				ranges.push(LgCharRange(lo = cast<Byte>(13), hi = cast<Byte>(13)));
				continue;
			}
			// \t \n \r inside class.
			if esc == 116 {
				match Lg_maybe_range(p, cast<Byte>(9), &mut ranges) {
					core.Result::Err(e) => { return core.Result::Err(move e); },
					core.Result::Ok(_) => { continue; }
				}
			}
			if esc == 110 {
				match Lg_maybe_range(p, cast<Byte>(10), &mut ranges) {
					core.Result::Err(e) => { return core.Result::Err(move e); },
					core.Result::Ok(_) => { continue; }
				}
			}
			if esc == 114 {
				match Lg_maybe_range(p, cast<Byte>(13), &mut ranges) {
					core.Result::Err(e) => { return core.Result::Err(move e); },
					core.Result::Ok(_) => { continue; }
				}
			}
			// Metachar escapes inside class: \] \\ \^ \-
			if esc == 93 or esc == 92 or esc == 94 or esc == 45 {
				match Lg_maybe_range(p, cast<Byte>(esc), &mut ranges) {
					core.Result::Err(e) => { return core.Result::Err(move e); },
					core.Result::Ok(_) => { continue; }
				}
			}
			val tag = "invalid-escape-in-class";
			return Lg_err(&tag, p.pos - 2);
		}

		// Regular byte — might be start of a range (a-z).
		val lo = Lg_advance(p);
		match Lg_maybe_range(p, lo, &mut ranges) {
			core.Result::Err(e) => { return core.Result::Err(move e); },
			core.Result::Ok(_) => { }
		}
	}

	if Lg_at_end(p) {
		val tag = "unclosed-class";
		return Lg_err(&tag, start);
	}
	p.pos = p.pos + 1;

	if ranges.len == 0 {
		val tag = "empty-class";
		return Lg_err(&tag, start);
	}

	return core.Result::Ok(LgRegexNode::Class(cls = LgCharClass(negated = negated, ranges = move ranges)));
}

// Check for '-' after a byte to form a range; otherwise push as singleton.
fn Lg_maybe_range(p: &mut LgParser, lo: Byte, ranges: &mut Array<LgCharRange>) nothrow -> core.Result<Void, LgRegexError> {
	if not Lg_at_end(p) and Lg_peek(p) == 45 {
		// Peek ahead: if next-next is ']' or end, treat '-' as literal.
		if p.pos + 1 < p.len and cast<Int>(core.string_byte_at(&p.src, p.pos + 1)) != 93 {
			p.pos = p.pos + 1;
			if Lg_at_end(p) {
				val tag = "incomplete-range";
				return core.Result::Err(LgRegexError(tag = tag, offset = p.pos));
			}
			val hi_ch = Lg_peek(p);
			var hi = cast<Byte>(0);
			// Handle escape on the high end of a range.
			if hi_ch == 92 {
				p.pos = p.pos + 1;
				if Lg_at_end(p) {
					val tag = "trailing-backslash-in-class";
					return core.Result::Err(LgRegexError(tag = tag, offset = p.pos - 1));
				}
				val esc = cast<Int>(Lg_advance(p));
				if esc == 116 { hi = cast<Byte>(9); }
				else { if esc == 110 { hi = cast<Byte>(10); }
				else { if esc == 114 { hi = cast<Byte>(13); }
				else { if esc == 93 or esc == 92 or esc == 94 or esc == 45 { hi = cast<Byte>(esc); }
				else {
					val tag = "invalid-escape-in-class";
					return core.Result::Err(LgRegexError(tag = tag, offset = p.pos - 2));
				} } } }
			} else {
				hi = Lg_advance(p);
			}
			if cast<Int>(lo) > cast<Int>(hi) {
				val tag = "reversed-range";
				return core.Result::Err(LgRegexError(tag = tag, offset = p.pos - 1));
			}
			ranges.push(LgCharRange(lo = lo, hi = hi));
			return core.Result::Ok(core.void_value());
		}
	}
	ranges.push(LgCharRange(lo = lo, hi = lo));
	return core.Result::Ok(core.void_value());
}

// ---------------------------------------------------------------------------
// NFA instruction set (private)
// ---------------------------------------------------------------------------

/// Internal NFA opcode.  Implementation detail of the regex engine —
/// not user-facing API.
pub variant Lg_NfaOp {
	ByteMatch(b: Byte),
	AnyByte,
	Ranges(range_start: Int, range_count: Int, negated: Bool),
	Split(a: Int, b: Int),
	Jump(target: Int),
	AssertStart,
	AssertEnd,
	Accept,
	@tombstone Tombstone
}

implement core.Copy for Lg_NfaOp {
}

// NFA program: instruction array + side table of ranges for Ranges ops.
/// Internal NFA program.  Implementation detail of the regex engine
/// — not user-facing API.
pub struct Lg_NfaProg {
	ops: Array<Lg_NfaOp>,
	ranges: Array<LgCharRange>
}

// ---------------------------------------------------------------------------
// NFA compiler: LgRegexNode AST → Lg_NfaOp instruction array
//
// Uses pre-computed instruction sizes to emit absolute jump targets
// without backpatching.
// ---------------------------------------------------------------------------

/// Internal: NFA-program size estimator.
pub fn Lg_node_size(node: &LgRegexNode) nothrow -> Int {
	match node {
		Literal(_) => { return 1; },
		Dot => { return 1; },
		LgRegexNode::Anchor(_) => { return 1; },
		LgRegexNode::Class(_) => { return 1; },
		LgRegexNode::Group(children) => {
			var total = 0;
			var i = 0;
			while i < children.len {
				total = total + Lg_node_size(&children[i]);
				i = i + 1;
			}
			return total;
		},
		LgRegexNode::Alternation(branches) => {
			if branches.len == 0 { return 0; }
			var total = 0;
			var i = 0;
			while i < branches.len {
				total = total + Lg_node_size(&branches[i]);
				i = i + 1;
			}
			if branches.len > 1 {
				total = total + 2 * (branches.len - 1);
			}
			return total;
		},
		LgRegexNode::Repeat(child, quant) => {
			val cs = Lg_node_size(&child[0]);
			match quant {
				LgQuantifier::Star => { return cs + 2; },
				LgQuantifier::Plus => { return cs + 1; },
				LgQuantifier::Question => { return cs + 1; },
				default => { return 0; }
			}
			return 0;
		},
		default => { return 0; }
	}
	return 0;
}

/// Internal: emits NFA opcodes for a single AST node.
pub fn Lg_emit_node(node: &LgRegexNode, nfa: &mut Lg_NfaProg) nothrow -> Void {
	match node {
		Literal(byte_val) => {
			nfa.ops.push(Lg_NfaOp::ByteMatch(b = byte_val));
		},
		Dot => {
			nfa.ops.push(Lg_NfaOp::AnyByte());
		},
		LgRegexNode::Anchor(kind) => {
			match kind {
				LgAnchorKind::Start => { nfa.ops.push(Lg_NfaOp::AssertStart()); },
				LgAnchorKind::End => { nfa.ops.push(Lg_NfaOp::AssertEnd()); },
				default => { }
			}
		},
		LgRegexNode::Class(cls) => {
			val rs = nfa.ranges.len;
			var ri = 0;
			while ri < cls.ranges.len {
				nfa.ranges.push(cls.ranges[ri]);
				ri = ri + 1;
			}
			nfa.ops.push(Lg_NfaOp::Ranges(range_start = rs, range_count = cls.ranges.len, negated = cls.negated));
		},
		LgRegexNode::Group(children) => {
			var i = 0;
			while i < children.len {
				Lg_emit_node(&children[i], nfa);
				i = i + 1;
			}
		},
		LgRegexNode::Alternation(branches) => {
			val n = branches.len;
			if n == 0 {
				// empty alternation — nothing to emit
			} else { if n == 1 {
				Lg_emit_node(&branches[0], nfa);
			} else {
				// Pre-compute branch sizes for absolute target calculation.
				var sizes = Array<type Int>::with_capacity(n);
				var si = 0;
				while si < n {
					sizes.push(Lg_node_size(&branches[si]));
					si = si + 1;
				}
				// end_pos = current_pos + sum(sizes) + 2*(n-1)
				var total = 0;
				si = 0;
				while si < n { total = total + sizes[si]; si = si + 1; }
				total = total + 2 * (n - 1);
				val end_pos = nfa.ops.len + total;
				// Emit branches 0..n-2, each wrapped in Split + Jump.
				var bi = 0;
				while bi < n - 1 {
					val body_start = nfa.ops.len + 1;
					val after_jump = body_start + sizes[bi] + 1;
					nfa.ops.push(Lg_NfaOp::Split(a = body_start, b = after_jump));
					Lg_emit_node(&branches[bi], nfa);
					nfa.ops.push(Lg_NfaOp::Jump(target = end_pos));
					bi = bi + 1;
				}
				// Last branch — no wrapper.
				Lg_emit_node(&branches[n - 1], nfa);
			} }
		},
		LgRegexNode::Repeat(child, quant) => {
			val child_size = Lg_node_size(&child[0]);
			match quant {
				LgQuantifier::Star => {
					// Split(body, after) | body | Jump(split)
					val split_pos = nfa.ops.len;
					val body_start = split_pos + 1;
					val after = body_start + child_size + 1;
					nfa.ops.push(Lg_NfaOp::Split(a = body_start, b = after));
					Lg_emit_node(&child[0], nfa);
					nfa.ops.push(Lg_NfaOp::Jump(target = split_pos));
				},
				LgQuantifier::Plus => {
					// body | Split(body, after)
					val body_start = nfa.ops.len;
					Lg_emit_node(&child[0], nfa);
					val after = nfa.ops.len + 1;
					nfa.ops.push(Lg_NfaOp::Split(a = body_start, b = after));
				},
				LgQuantifier::Question => {
					// Split(body, after) | body
					val body_start = nfa.ops.len + 1;
					val after = body_start + child_size;
					nfa.ops.push(Lg_NfaOp::Split(a = body_start, b = after));
					Lg_emit_node(&child[0], nfa);
				},
				default => { }
			}
		},
		default => { }
	}
}

/// Internal: compiles a parsed AST into an NFA program.
pub fn Lg_nfa_compile(root: &LgRegexNode) nothrow -> Lg_NfaProg {
	var nfa = Lg_NfaProg(
		ops = Array<type Lg_NfaOp>::with_capacity(Lg_node_size(root) + 1),
		ranges = Array<type LgCharRange>::with_capacity(16)
	);
	Lg_emit_node(root, &mut nfa);
	nfa.ops.push(Lg_NfaOp::Accept());
	return move nfa;
}

// ---------------------------------------------------------------------------
// NFA executor — Thompson simulation
//
// Epsilon closure via recursive Lg_add_state; byte matching per step.
// Lg_try_match_at returns the longest match end from a fixed start, or -1.
// ---------------------------------------------------------------------------

/// Internal: NFA-state-tracking bitmap allocator.
pub fn Lg_make_bitmap(n: Int) nothrow -> Array<Bool> {
	var a = Array<type Bool>::with_capacity(n);
	var i = 0;
	while i < n { a.push(false); i = i + 1; }
	return move a;
}

/// Internal: bitmap reset between NFA iterations.
pub fn Lg_clear_bitmap(a: &mut Array<Bool>, n: Int) nothrow -> Void {
	var i = 0;
	while i < n { a[i] = false; i = i + 1; }
}

// Recursively follow epsilon transitions (Split, Jump, assertions) and
// collect consuming instructions into clist.
/// Internal: NFA state-set push (with epsilon-closure expansion).
pub fn Lg_add_state(nfa: &Lg_NfaProg, bitmap: &mut Array<Bool>, clist: &mut Array<Int>, pc: Int, pos: Int, input_len: Int) nothrow -> Void {
	if pc >= 0 and pc < nfa.ops.len and not bitmap[pc] {
		bitmap[pc] = true;
		val op = nfa.ops[pc];
		match op {
			Lg_NfaOp::Split(a, b) => {
				Lg_add_state(nfa, bitmap, clist, a, pos, input_len);
				Lg_add_state(nfa, bitmap, clist, b, pos, input_len);
			},
			Lg_NfaOp::Jump(target) => {
				Lg_add_state(nfa, bitmap, clist, target, pos, input_len);
			},
			Lg_NfaOp::AssertStart => {
				if pos == 0 {
					Lg_add_state(nfa, bitmap, clist, pc + 1, pos, input_len);
				}
			},
			Lg_NfaOp::AssertEnd => {
				if pos == input_len {
					Lg_add_state(nfa, bitmap, clist, pc + 1, pos, input_len);
				}
			},
			Lg_NfaOp::ByteMatch(_) => { clist.push(pc); },
			Lg_NfaOp::AnyByte => { clist.push(pc); },
			Lg_NfaOp::Ranges(_, _, _) => { clist.push(pc); },
			Lg_NfaOp::Accept => { clist.push(pc); },
			default => { }
		}
	}
}

/// Internal: byte-class match test for a given NFA opcode.
pub fn Lg_byte_matches(nfa: &Lg_NfaProg, pc: Int, b: Byte) nothrow -> Bool {
	val op = nfa.ops[pc];
	match op {
		Lg_NfaOp::ByteMatch(expected) => {
			return b == expected;
		},
		Lg_NfaOp::AnyByte => {
			return true;
		},
		Lg_NfaOp::Ranges(range_start, range_count, negated) => {
			var found = false;
			var i = 0;
			while i < range_count {
				val r = nfa.ranges[range_start + i];
				if b >= r.lo and b <= r.hi {
					found = true;
					break;
				}
				i = i + 1;
			}
			if negated { return not found; }
			return found;
		},
		Lg_NfaOp::Split(_, _) => { return false; },
		Lg_NfaOp::Jump(_) => { return false; },
		Lg_NfaOp::AssertStart => { return false; },
		Lg_NfaOp::AssertEnd => { return false; },
		Lg_NfaOp::Accept => { return false; },
		default => { return false; }
	}
}

// Run NFA from a fixed start position; return longest match end or -1.
/// Internal: attempts a single anchored match starting at `start`,
/// returning the matched byte-length or `-1` on no match.
pub fn Lg_try_match_at(nfa: &Lg_NfaProg, input: &String, start: Int) nothrow -> Int {
	val src = text._byte_source_all(input);
	return Lg_try_match_at_range(nfa, &src, start);
}

// THE matcher authority: every entry point (String or view) funnels
// here.  The subject is a borrowed `text._StringByteSource` window:
// positions (`start`, returned end, anchor semantics) are
// WINDOW-RELATIVE — `^` asserts position 0 OF THE WINDOW, `$` asserts
// its size — and reads go through the source's range-guarded `read`.
// String entries build `_byte_source_all` (borrow, zero retains), view
// entries `_byte_source`; String-form behavior is bit-identical to the
// pre-source implementation, and the source's private fields mean a
// narrow view's window can never read the rest of its backing.
fn Lg_try_match_at_range(nfa: &Lg_NfaProg, src: &text._StringByteSource, start: Int) nothrow -> Int {
	val input_len = src.size();
	val prog_len = nfa.ops.len;
	val accept_pc = prog_len - 1;

	var bitmap = Lg_make_bitmap(prog_len);
	var clist = Array<type Int>::with_capacity(prog_len);
	Lg_add_state(nfa, &mut bitmap, &mut clist, 0, start, input_len);

	var best_end = 0 - 1;
	if bitmap[accept_pc] {
		best_end = start;
	}

	var pos = start;
	while pos < input_len and clist.len > 0 {
		val b = src.read(pos);

		// Step: advance each consuming state that matches this byte.
		var seeds = Array<type Int>::with_capacity(clist.len);
		var ci = 0;
		while ci < clist.len {
			if Lg_byte_matches(nfa, clist[ci], b) {
				seeds.push(clist[ci] + 1);
			}
			ci = ci + 1;
		}

		// Rebuild state set from seeds.
		Lg_clear_bitmap(&mut bitmap, prog_len);
		clist = Array<type Int>::with_capacity(prog_len);
		var si = 0;
		while si < seeds.len {
			Lg_add_state(nfa, &mut bitmap, &mut clist, seeds[si], pos + 1, input_len);
			si = si + 1;
		}

		if bitmap[accept_pc] {
			best_end = pos + 1;
		}
		pos = pos + 1;
	}

	return best_end;
}

// ---------------------------------------------------------------------------
// Public match API — search semantics
//
// Lgis_match: returns true if pattern matches anywhere in input.
// Lgfind_first: returns leftmost match (greedy — longest at that start).
// ---------------------------------------------------------------------------

/// Returns `true` if `re` matches anywhere in the VIEW's bytes.
///
/// The view IS the subject string: `^`/`$` anchor at the view's
/// boundaries.  Reads through the borrowed view — never retains,
/// never materializes the subject.
pub fn Lgis_match_view(re: &LgRegex, v: &text.StringByteView) nothrow -> Bool {
	match Lgfind_first_view(re, v) {
		Optional::Some(_) => { return true; },
		Optional::None() => { return false; }
	}
}

/// Returns the leftmost match of `re` in the VIEW's bytes (greedy —
/// longest at that start), or `None`.
///
/// Match offsets are VIEW-RELATIVE (compose directly with
/// `Lgmatch_subview`); `^`/`$` anchor at the view's boundaries.  Never
/// retains, never materializes the subject.
pub fn Lgfind_first_view(re: &LgRegex, v: &text.StringByteView) nothrow -> Optional<LgRegexMatch> {
	val src = text._byte_source(v);
	return Lg_find_from_range(&re.nfa, &src, 0);
}

/// Checked, OPT-IN conversion: a `LgRegexMatch` over `s` into a
/// retained view of `s`.
///
/// `LgRegexMatch` is a cheap `Copy` span with public fields and NO
/// source identity, so this is bounds-CHECKED against the `s` it is
/// GIVEN and carries no provenance claim beyond that: malformed
/// (`start < 0`, `end < start`) and out-of-range spans return
/// `Err(text.TextError(tag = "out-of-bounds", offset = m.start))`.
/// The FULL validation happens BEFORE any arithmetic, so fabricated
/// extreme spans (e.g. `start = INT_MIN, end = INT_MAX`) cannot
/// overflow the length subtraction.  On success: exactly one retain,
/// no byte copies.
pub fn Lgmatch_view(m: LgRegexMatch, s: &String) nothrow -> core.Result<text.StringByteView, text.TextError> {
	if m.start < 0 or m.end < m.start or m.end > s.byte_length() {
		return core.Result::Err(text.TextError(tag = "out-of-bounds", offset = m.start));
	}
	// 0 <= start <= end <= len: the subtraction cannot overflow.
	return text.byte_view(s, m.start, m.end - m.start);
}

/// Checked conversion: a VIEW-RELATIVE `LgRegexMatch` (as returned by
/// `Lgfind_first_view`) over `v` into a subview of `v`.
///
/// Same checked, provenance-free contract as `Lgmatch_view`; offsets
/// compose onto `v`'s backing.  Exactly one retain on success.
pub fn Lgmatch_subview(m: LgRegexMatch, v: &text.StringByteView) nothrow -> core.Result<text.StringByteView, text.TextError> {
	if m.start < 0 or m.end < m.start or m.end > v.byte_length() {
		return core.Result::Err(text.TextError(tag = "out-of-bounds", offset = m.start));
	}
	// 0 <= start <= end <= view len: the subtraction cannot overflow.
	return v.subview(m.start, m.end - m.start);
}

/// Returns `true` if `re` matches anywhere in `input`.
///
/// Equivalent to `Lgfind_first(re, input).is_some()` but skips
/// allocating the `LgRegexMatch` value.
///
/// **See also:** `Lgfind_first`, `Lgis_match_view`.
pub fn Lgis_match(re: &LgRegex, input: &String) nothrow -> Bool {
	val input_len = input.byte_length();
	var start = 0;
	while start <= input_len {
		if Lg_try_match_at(&re.nfa, input, start) >= 0 {
			return true;
		}
		start = start + 1;
	}
	return false;
}

/// Returns the leftmost match of `re` in `input`, or `None` if no
/// match exists.
///
/// **See also:** `Lgis_match`, `Lgreplace_first`, `LgRegexMatch`.
pub fn Lgfind_first(re: &LgRegex, input: &String) nothrow -> Optional<LgRegexMatch> {
	return Lg_find_from(re, input, 0);
}

// Search for the first match starting at byte offset `from`.
/// Internal: like `Lgfind_first` but starting search from `from`
/// (used by `Lgreplace_all` to advance past previous matches).
pub fn Lg_find_from(re: &LgRegex, input: &String, from: Int) nothrow -> Optional<LgRegexMatch> {
	val src = text._byte_source_all(input);
	return Lg_find_from_range(&re.nfa, &src, from);
}

// Windowed search loop (see Lg_try_match_at_range).  Returned match
// offsets are WINDOW-RELATIVE.
fn Lg_find_from_range(nfa: &Lg_NfaProg, src: &text._StringByteSource, from: Int) nothrow -> Optional<LgRegexMatch> {
	val sublen = src.size();
	var start = from;
	while start <= sublen {
		val end = Lg_try_match_at_range(nfa, src, start);
		if end >= 0 {
			return Optional::Some(LgRegexMatch(start = start, end = end));
		}
		start = start + 1;
	}
	return Optional::None();
}

// ---------------------------------------------------------------------------
// Substring helper (nothrow, no Result) — caller must ensure valid bounds.
// Returns "" when len == 0.  Uses io.buffer for byte-level copy.
// ---------------------------------------------------------------------------

/// Internal: byte-range substring helper used by replace operations.
pub fn Lg_substr(s: &String, start: Int, len: Int) nothrow -> String {
	if len == 0 {
		return "";
	}
	var b = io.buffer(len);
	var i = 0;
	while i < len {
		io.buffer_write(&mut b, i, core.string_byte_at(s, start + i));
		i = i + 1;
	}
	return core.string_from_utf8_bytes(io.buffer_ptr(&b), len);
}

// ---------------------------------------------------------------------------
// Replacement API — literal replacement, non-overlapping, left-to-right
//
// Semantics (frozen):
//   - Literal replacement only (no backrefs/capture interpolation).
//   - Non-overlapping, left-to-right scan.
//   - Zero-length matches advance cursor by 1 byte (forward-progress rule).
//   - Empty pattern: Lgreplace_all inserts `repl` before every byte and after
//     the last byte (N+1 insertions for N-byte input).
//   - Empty replacement: equivalent to deleting matched text.
//   - Empty input + empty pattern: Lgreplace_all returns `repl` (one match).
// ---------------------------------------------------------------------------

/// Returns a new string with the leftmost match of `re` in `input`
/// replaced by `repl`.
///
/// `repl` is a literal replacement — backreferences (`$1`, `\1`)
/// are NOT interpreted.
///
/// **See also:** `Lgreplace_all`, `Lgfind_first`.
pub fn Lgreplace_first(re: &LgRegex, input: &String, repl: &String) nothrow -> String {
	match Lg_find_from(re, input, 0) {
		Optional::Some(m) => {
			val input_len = input.byte_length();
			val prefix = Lg_substr(input, 0, m.start);
			val suffix = Lg_substr(input, m.end, input_len - m.end);
			return prefix + *repl + suffix;
		},
		Optional::None() => {
			return *input;
		}
	}
}

/// Returns a new string with every non-overlapping match of `re` in
/// `input` replaced by `repl`.
///
/// `repl` is a literal replacement.  Empty matches are advanced
/// past one byte at a time to avoid an infinite loop.
///
/// **See also:** `Lgreplace_first`.
pub fn Lgreplace_all(re: &LgRegex, input: &String, repl: &String) nothrow -> String {
	val input_len = input.byte_length();
	var result = "";
	var cursor = 0;
	while cursor <= input_len {
		match Lg_find_from(re, input, cursor) {
			Optional::Some(m) => {
				// Append text between previous cursor and match start.
				if m.start > cursor {
					result = result + Lg_substr(input, cursor, m.start - cursor);
				}
				// Append replacement.
				result = result + *repl;
				// Forward-progress rule: if the match is zero-length,
				// advance cursor by 1 byte to avoid infinite loop.
				if m.end == m.start {
					// Copy the byte at the current position (if any)
					// before advancing past it.
					if cursor < input_len {
						result = result + Lg_substr(input, cursor, 1);
					}
					cursor = cursor + 1;
				} else {
					cursor = m.end;
				}
			},
			Optional::None() => {
				// No more matches — append the remaining input.
				if cursor < input_len {
					result = result + Lg_substr(input, cursor, input_len - cursor);
				}
				break;
			}
		}
	}
	return result;
}

// ==================== end legacy engine ===========================

// one case: compare legacy vs current std.regex on every entry point
fn diff_case(mm: &mut Int, cid: Int, pat: &String, inp: &String) nothrow -> Void {
	match Lgcompile(pat) {
		Ok(lre) => {
			match regex.compile(pat) {
				Ok(nre) => {
					var lst = 0 - 1;
					var len2 = 0 - 1;
					match Lgfind_first(&lre, inp) {
						Some(lm) => { lst = lm.start; len2 = lm.end; },
						None() => { }
					}
					var nst = 0 - 1;
					var nen = 0 - 1;
					match regex.find_first(&nre, inp) {
						Some(nm) => { nst = nm.start; nen = nm.end; },
						None() => { }
					}
					if lst != nst or len2 != nen {
						*mm = *mm + 1;
						cons.println("DIFF find case=" + fmt.format_int(cid)
							+ " legacy=" + fmt.format_int(lst) + ":" + fmt.format_int(len2)
							+ " new=" + fmt.format_int(nst) + ":" + fmt.format_int(nen));
					}
					val lim = Lgis_match(&lre, inp);
					val nim = regex.is_match(&nre, inp);
					if lim != nim {
						*mm = *mm + 1;
						cons.println("DIFF is_match case=" + fmt.format_int(cid));
					}
					val v = text.byte_view_all(inp);
					var vst = 0 - 1;
					var ven = 0 - 1;
					match regex.find_first_view(&nre, &v) {
						Some(vm) => { vst = vm.start; ven = vm.end; },
						None() => { }
					}
					if vst != nst or ven != nen {
						*mm = *mm + 1;
						cons.println("DIFF view case=" + fmt.format_int(cid)
							+ " view=" + fmt.format_int(vst) + ":" + fmt.format_int(ven)
							+ " string=" + fmt.format_int(nst) + ":" + fmt.format_int(nen));
					}
				},
				Err(ne) => {
					*mm = *mm + 1;
					cons.println("DIFF compile-flip(new-rejects) case=" + fmt.format_int(cid));
				}
			}
		},
		Err(le) => {
			match regex.compile(pat) {
				Ok(nre2) => {
					*mm = *mm + 1;
					cons.println("DIFF compile-flip(new-accepts) case=" + fmt.format_int(cid));
				},
				Err(ne2) => {
					if le.tag != ne2.tag or le.offset != ne2.offset {
						*mm = *mm + 1;
						cons.println("DIFF compile-error case=" + fmt.format_int(cid)
							+ " legacy=" + le.tag + "@" + fmt.format_int(le.offset)
							+ " new=" + ne2.tag + "@" + fmt.format_int(ne2.offset));
					}
				}
			}
		}
	}
}

fn case_block_0(mm: &mut Int) nothrow -> Void {
	diff_case(mm, 0, &"^c2?c", &"cacc\td\t b");
	diff_case(mm, 1, &"^c2?c", &"xbce ,cd1aa x 3e20 \taaee");
	diff_case(mm, 2, &"^c2?c", &"a a1ab\t,ad3x2,222 0\t");
	diff_case(mm, 3, &"^c2?c", &"2d1bb 313bae3\t01xc0 2ed\t2cx1xdx\te b\t03 xd");

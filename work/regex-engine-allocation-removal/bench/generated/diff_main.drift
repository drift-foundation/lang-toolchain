	case_block_14(&mut mm);
	case_block_15(&mut mm);
	case_block_16(&mut mm);
	case_block_17(&mut mm);
	case_block_18(&mut mm);
	case_block_19(&mut mm);
	cons.println("DIFF-TOTAL " + fmt.format_int(mm) + " mismatches / 1000 cases");
	if mm != 0 { return 1; }
	return 0;
}

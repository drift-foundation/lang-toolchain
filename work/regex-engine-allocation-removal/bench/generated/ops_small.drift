		val r = cm_anchor_loop(&pa, &s_fill_256, 7812);
		line_cm_anchored_256 = line_cm_anchored_256 + fmt.format_int(time.elapsed_micros(&t0)) + ",";
		if r != 7812 { return 107; }
		k = k + 1;
	}
	cons.println(line_cm_anchored_256);
	var line_cm_alt_256 = "RESULT cm_alt_256 us=";
	k = 0;
	while k < iters {
		val t0 = time.now_monotonic();
		val r = cm_find_loop(&palt, &s_alt_256, 7812);
		line_cm_alt_256 = line_cm_alt_256 + fmt.format_int(time.elapsed_micros(&t0)) + ",";
		if r != 39060 { return 108; }
		k = k + 1;
	}
	cons.println(line_cm_alt_256);

	return 0;
}

pub fn main() nothrow -> Int {
	match regex.compile(&"[a-z]+[0-9]+") {
		Err(e) => { return 30; },
		Ok(re1) => {
			match regex.compile(&"^[a-z,x]+$") {
				Err(e) => { return 31; },
				Ok(rea) => {
					match regex.compile(&"(get|post|put|delete|head|patch)") {
						Err(e) => { return 32; },
						Ok(ralt) => {
							return run_all(&re1, &rea, &ralt);
						}
					}
				}
			}
		}
	}
}

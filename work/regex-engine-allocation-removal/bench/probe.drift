// regex-engine-allocation-removal: allocator-call CALIBRATION probe.
// Pins how many drift_alloc_array / drift_free_array CALLS each Array
// construct emits at the wrap layer (header+storage model, tombstone
// null-frees), so the engine allocation model reconciles call-exactly.
// Each op loops x100: per-construct counts show as exact hundreds.
module main;

import std.core as core;

fn mk7() nothrow -> Array<Int> {
	var x = Array<type Int>::with_capacity(7);
	x.push(1);
	return move x;
}

// with_capacity + push + scope drop
pub fn op_wc(dummy: Int) nothrow -> Int {
	var acc = 0;
	var k = 0;
	while k < 100 {
		var a = Array<type Int>::with_capacity(7);
		a.push(1);
		acc = acc + a.len;
		k = k + 1;
	}
	return acc;
}

// Bool array filled to capacity (the _make_bitmap shape, minus move)
pub fn op_wc_bool(dummy: Int) nothrow -> Int {
	var acc = 0;
	var k = 0;
	while k < 100 {
		var a = Array<type Bool>::with_capacity(8);
		var i = 0;
		while i < 8 { a.push(false); i = i + 1; }
		acc = acc + a.len;
		k = k + 1;
	}
	return acc;
}

// construct in a helper, return move (the _make_bitmap call shape)
pub fn op_moveout(dummy: Int) nothrow -> Int {
	var acc = 0;
	var k = 0;
	while k < 100 {
		val a = mk7();
		acc = acc + a.len;
		k = k + 1;
	}
	return acc;
}

// reassignment: old value dropped at replace (the clist swap shape)
pub fn op_reassign(dummy: Int) nothrow -> Int {
	var acc = 0;
	var k = 0;
	while k < 100 {
		var a = Array<type Int>::with_capacity(3);
		a = Array<type Int>::with_capacity(4);
		acc = acc + a.len;
		k = k + 1;
	}
	return acc;
}

// the engine's inner-loop microcosm: bitmap + clist, then per "byte":
// seeds (block-scoped) + clist replacement.  3 inner iterations.
pub fn op_engine_shape(dummy: Int) nothrow -> Int {
	var acc = 0;
	var k = 0;
	while k < 100 {
		var bitmap = Array<type Bool>::with_capacity(4);
		var bi = 0;
		while bi < 4 { bitmap.push(false); bi = bi + 1; }
		var clist = Array<type Int>::with_capacity(4);
		clist.push(0);
		var pos = 0;
		while pos < 3 {
			var seeds = Array<type Int>::with_capacity(clist.len);
			var ci = 0;
			while ci < clist.len {
				seeds.push(clist[ci] + 1);
				ci = ci + 1;
			}
			clist = Array<type Int>::with_capacity(4);
			var si = 0;
			while si < seeds.len {
				clist.push(seeds[si]);
				si = si + 1;
			}
			pos = pos + 1;
		}
		acc = acc + clist.len + bitmap.len;
		k = k + 1;
	}
	return acc;
}

pub fn main() nothrow -> Int {
	if op_wc(0) != 100 { return 1; }
	if op_wc_bool(0) != 800 { return 2; }
	if op_moveout(0) != 100 { return 3; }
	if op_reassign(0) != 0 { return 4; }
	if op_engine_shape(0) != 500 { return 5; }
	if op_scratch_four(0) != 1100 { return 6; }
	if op_scratch_packed(0) != 400 { return 7; }
	return 0;
}

// ---- blocker 3: scratch-shape comparison (P = 8 program slots) ----

// four separately allocated Arrays (marks filled, three empty-capacity)
pub fn op_scratch_four(dummy: Int) nothrow -> Int {
	var acc = 0;
	var k = 0;
	while k < 100 {
		var marks = Array<type Int>::with_capacity(8);
		var i = 0;
		while i < 8 { marks.push(0); i = i + 1; }
		var clist = Array<type Int>::with_capacity(8);
		var nlist = Array<type Int>::with_capacity(8);
		var stack = Array<type Int>::with_capacity(8);
		clist.push(1);
		nlist.push(2);
		stack.push(3);
		acc = acc + marks.len + clist.len + nlist.len + stack.len;
		k = k + 1;
	}
	return acc;
}

// ONE packed Array<Int> partitioned into marks/current/next/worklist
// regions (explicit lengths carried as scalars in the real design)
pub fn op_scratch_packed(dummy: Int) nothrow -> Int {
	var acc = 0;
	var k = 0;
	while k < 100 {
		var ws = Array<type Int>::with_capacity(32);
		var i = 0;
		while i < 32 { ws.push(0); i = i + 1; }
		ws[8] = 1;
		ws[16] = 2;
		ws[24] = 3;
		acc = acc + ws.len - 28;
		k = k + 1;
	}
	return acc;
}

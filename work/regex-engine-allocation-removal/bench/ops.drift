// regex-engine-allocation-removal: TIMING protocol (report-only
// checkpoint evidence).  tier_bench-style RESULT lines; per-iteration
// microseconds, medians computed by run_bench.py across launches.
// CHECK lines pin match results for cross-validation against the
// Python model replica.  Bench-local (work/), never part of any gate.
module main;

import std.core as core;
import std.text as text;
import std.regex as regex;
import std.time as time;
import std.console as cons;
import std.format as fmt;

// ---- inputs (identical recipes in counts.drift and model.py) ----

fn build_from_chunk(chunk: &String, target_bytes: Int) nothrow -> String {
	var sb = text.string_builder(target_bytes + 64);
	var total = 0;
	val n = chunk.byte_length();
	while total < target_bytes {
		text.sb_append_string(&mut sb, chunk);
		total = total + n;
	}
	return text.sb_build(&mut sb);
}

fn build_carrier(target_bytes: Int) nothrow -> String {
	return build_from_chunk(&"alpha,bravo12,charlie345,dd,echo_echo_echo,f,", target_bytes);
}

fn build_nomatch(target_bytes: Int) nothrow -> String {
	return build_from_chunk(&"alpha,bravo,charlie,dd,echo_echo_echo,f,", target_bytes);
}

// ---- workloads ----

// Scan-all: advance-past-match _find_from loop (the prior phase's
// "stock engine" 171,325 us workload shape).
fn scan_all(re: &regex.Regex, s: &String) nothrow -> Int {
	var count = 0;
	var last_end = 0;
	var cursor = 0;
	val n = s.byte_length();
	while cursor <= n {
		match regex._find_from(re, s, cursor) {
			Some(m) => {
				count = count + 1;
				last_end = m.end;
				if m.end == m.start {
					cursor = m.start + 1;
				} else {
					cursor = m.end;
				}
			},
			None() => { break; }
		}
	}
	return count * 10000000 + last_end;
}

fn find_nomatch(re: &regex.Regex, s: &String) nothrow -> Int {
	match regex.find_first(re, s) {
		Some(m) => { return 0 - 1; },
		None() => { return 1; }
	}
}

fn find_nomatch_view(re: &regex.Regex, v: &text.StringByteView) nothrow -> Int {
	match regex.find_first_view(re, v) {
		Some(m) => { return 0 - 1; },
		None() => { return 1; }
	}
}

fn zw_loop(re: &regex.Regex, s: &String, reps: Int) nothrow -> Int {
	var acc = 0;
	var k = 0;
	while k < reps {
		match regex.find_first(re, s) {
			Some(m) => {
				if m.start == 0 and m.end == 0 { acc = acc + 1; }
			},
			None() => { return 0 - 1; }
		}
		k = k + 1;
	}
	return acc;
}

fn short_loop(re: &regex.Regex, s: &String, reps: Int) nothrow -> Int {
	var acc = 0;
	var k = 0;
	while k < reps {
		match regex.find_first(re, s) {
			Some(m) => { acc = acc + m.end - m.start; },
			None() => { acc = acc + 0; }
		}
		k = k + 1;
	}
	return acc;
}

fn anchor_loop(re: &regex.Regex, s: &String, reps: Int) nothrow -> Int {
	var acc = 0;
	var k = 0;
	while k < reps {
		if regex.is_match(re, s) { acc = acc + 1; }
		k = k + 1;
	}
	return acc;
}

fn compile_loop(pat: &String, reps: Int) nothrow -> Int {
	var acc = 0;
	var k = 0;
	while k < reps {
		match regex.compile(pat) {
			Ok(re) => { acc = acc + 1; },
			Err(e) => { return 0 - 1; }
		}
		k = k + 1;
	}
	return acc;
}

// blocker 3: scratch-shape construction cost (short-search fixed
// overhead proxy; P = 8 program slots)
fn scratch_four_loop(reps: Int) nothrow -> Int {
	var acc = 0;
	var k = 0;
	while k < reps {
		var marks = Array<type Int>::with_capacity(8);
		var i = 0;
		while i < 8 { marks.push(0); i = i + 1; }
		var clist = Array<type Int>::with_capacity(8);
		var nlist = Array<type Int>::with_capacity(8);
		var stack = Array<type Int>::with_capacity(8);
		clist.push(1);
		nlist.push(2);
		stack.push(3);
		acc = acc + marks.len + clist.len + nlist.len + stack.len;
		k = k + 1;
	}
	return acc;
}

fn scratch_packed_loop(reps: Int) nothrow -> Int {
	var acc = 0;
	var k = 0;
	while k < reps {
		var ws = Array<type Int>::with_capacity(32);
		var i = 0;
		while i < 32 { ws.push(0); i = i + 1; }
		ws[8] = 1;
		ws[16] = 2;
		ws[24] = 3;
		acc = acc + ws.len - 28;
		k = k + 1;
	}
	return acc;
}

fn run_all(re1: &regex.Regex, realt: &regex.Regex, rezw: &regex.Regex, reanch: &regex.Regex) nothrow -> Int {
	val carrier = build_carrier(2 * 1024 * 1024);
	val nomatch = build_nomatch(2 * 1024 * 1024);
	val altin = build_nomatch(512 * 1024);
	val zwin = text.repeat(&"z", 1024);
	val short_hit = "user42";
	val short_miss = "userxyz";
	val anchor_in = "alphabravo";
	val p1 = "[a-z]+[0-9]+";
	val palt = "(ab|ac|ad|ae|af|ag|ah|ai|aj|ak|al|am|an|ao|ap|aq)z";

	cons.println("INPUT carrier=" + fmt.format_int(carrier.byte_length())
		+ " nomatch=" + fmt.format_int(nomatch.byte_length())
		+ " altin=" + fmt.format_int(altin.byte_length()));

	// checksums (once) + CHECK lines for the model replica
	val c_scan = scan_all(re1, &carrier);
	cons.println("CHECK scan_all=" + fmt.format_int(c_scan));
	val c_nm = find_nomatch(re1, &nomatch);
	if c_nm != 1 { return 40; }
	val nmview = text.byte_view_all(&nomatch);
	val c_nmv = find_nomatch_view(re1, &nmview);
	if c_nmv != 1 { return 41; }
	val c_alt = find_nomatch(realt, &altin);
	if c_alt != 1 { return 42; }
	val c_zw = zw_loop(rezw, &zwin, 1);
	if c_zw != 1 { return 43; }
	val c_sh = short_loop(re1, &short_hit, 1);
	cons.println("CHECK short_hit=" + fmt.format_int(c_sh));
	val c_sm = short_loop(re1, &short_miss, 1);
	if c_sm != 0 { return 44; }
	val c_an = anchor_loop(reanch, &anchor_in, 1);
	if c_an != 1 { return 45; }

	val iters = 5;

	var line1 = "RESULT scan_all_carrier_2m us=";
	var k = 0;
	while k < iters {
		val t0 = time.now_monotonic();
		val r = scan_all(re1, &carrier);
		line1 = line1 + fmt.format_int(time.elapsed_micros(&t0)) + ",";
		if r != c_scan { return 50; }
		k = k + 1;
	}
	cons.println(line1);

	var line2 = "RESULT find_nomatch_2m us=";
	k = 0;
	while k < iters {
		val t0 = time.now_monotonic();
		val r = find_nomatch(re1, &nomatch);
		line2 = line2 + fmt.format_int(time.elapsed_micros(&t0)) + ",";
		if r != 1 { return 51; }
		k = k + 1;
	}
	cons.println(line2);

	var line3 = "RESULT find_nomatch_view_2m us=";
	k = 0;
	while k < iters {
		val t0 = time.now_monotonic();
		val r = find_nomatch_view(re1, &nmview);
		line3 = line3 + fmt.format_int(time.elapsed_micros(&t0)) + ",";
		if r != 1 { return 52; }
		k = k + 1;
	}
	cons.println(line3);

	var line4 = "RESULT alt_nomatch_512k us=";
	k = 0;
	while k < iters {
		val t0 = time.now_monotonic();
		val r = find_nomatch(realt, &altin);
		line4 = line4 + fmt.format_int(time.elapsed_micros(&t0)) + ",";
		if r != 1 { return 53; }
		k = k + 1;
	}
	cons.println(line4);

	var line5 = "RESULT zw_1k_x20000 us=";
	k = 0;
	while k < iters {
		val t0 = time.now_monotonic();
		val r = zw_loop(rezw, &zwin, 20000);
		line5 = line5 + fmt.format_int(time.elapsed_micros(&t0)) + ",";
		if r != 20000 { return 54; }
		k = k + 1;
	}
	cons.println(line5);

	var line6 = "RESULT short_hit_x20000 us=";
	k = 0;
	while k < iters {
		val t0 = time.now_monotonic();
		val r = short_loop(re1, &short_hit, 20000);
		line6 = line6 + fmt.format_int(time.elapsed_micros(&t0)) + ",";
		if r != c_sh * 20000 { return 55; }
		k = k + 1;
	}
	cons.println(line6);

	var line7 = "RESULT short_miss_x20000 us=";
	k = 0;
	while k < iters {
		val t0 = time.now_monotonic();
		val r = short_loop(re1, &short_miss, 20000);
		line7 = line7 + fmt.format_int(time.elapsed_micros(&t0)) + ",";
		if r != 0 { return 56; }
		k = k + 1;
	}
	cons.println(line7);

	var line8 = "RESULT anchor_x20000 us=";
	k = 0;
	while k < iters {
		val t0 = time.now_monotonic();
		val r = anchor_loop(reanch, &anchor_in, 20000);
		line8 = line8 + fmt.format_int(time.elapsed_micros(&t0)) + ",";
		if r != 20000 { return 57; }
		k = k + 1;
	}
	cons.println(line8);

	var line9 = "RESULT compile_p1_x2000 us=";
	k = 0;
	while k < iters {
		val t0 = time.now_monotonic();
		val r = compile_loop(&p1, 2000);
		line9 = line9 + fmt.format_int(time.elapsed_micros(&t0)) + ",";
		if r != 2000 { return 58; }
		k = k + 1;
	}
	cons.println(line9);

	var line10 = "RESULT compile_alt_x2000 us=";
	k = 0;
	while k < iters {
		val t0 = time.now_monotonic();
		val r = compile_loop(&palt, 2000);
		line10 = line10 + fmt.format_int(time.elapsed_micros(&t0)) + ",";
		if r != 2000 { return 59; }
		k = k + 1;
	}
	cons.println(line10);

	var line11 = "RESULT scratch_four_x200000 us=";
	k = 0;
	while k < iters {
		val t0 = time.now_monotonic();
		val r = scratch_four_loop(200000);
		line11 = line11 + fmt.format_int(time.elapsed_micros(&t0)) + ",";
		if r != 2200000 { return 60; }
		k = k + 1;
	}
	cons.println(line11);

	var line12 = "RESULT scratch_packed_x200000 us=";
	k = 0;
	while k < iters {
		val t0 = time.now_monotonic();
		val r = scratch_packed_loop(200000);
		line12 = line12 + fmt.format_int(time.elapsed_micros(&t0)) + ",";
		if r != 800000 { return 61; }
		k = k + 1;
	}
	cons.println(line12);

	return 0;
}

pub fn main() nothrow -> Int {
	match regex.compile(&"[a-z]+[0-9]+") {
		Err(e) => { return 30; },
		Ok(re1) => {
			match regex.compile(&"(ab|ac|ad|ae|af|ag|ah|ai|aj|ak|al|am|an|ao|ap|aq)z") {
				Err(e) => { return 31; },
				Ok(realt) => {
					match regex.compile(&"a*") {
						Err(e) => { return 32; },
						Ok(rezw) => {
							match regex.compile(&"^[a-z]*$") {
								Err(e) => { return 33; },
								Ok(reanch) => {
									return run_all(&re1, &realt, &rezw, &reanch);
								}
							}
						}
					}
				}
			}
		}
	}
}

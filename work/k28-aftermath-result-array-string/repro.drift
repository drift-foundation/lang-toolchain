module m;

import std.core as core;

// Single-file repro of drift-net-tls bug:
// heap-use-after-free on Array<String> struct field when containing struct
// is wrapped in core.Result::Ok(...) and the array came from a callee's
// return value.

pub struct Session {
	pub names: Array<String>,
}

fn make_name(seed: Int) nothrow -> String {
	// Heap String via concat (drift_string_from_utf8_bytes path gives us
	// a non-static String with a refcounted buffer, same as the reporter).
	return "x" + "AAAA";
}

fn collect_names() nothrow -> Array<String> {
	var names: Array<String> = [];
	var i = 0;
	while i < 3 {
		var name = make_name(i);
		if name.byte_length() > 0 {
			names.push(name);
		}
		i = i + 1;
	}
	return move names;
}

fn build_session() nothrow -> core.Result<Session, Int> {
	val names = collect_names();
	return core.Result::Ok(Session(names = names));
}

pub fn main() nothrow -> Int {
	match build_session() {
		core.Result::Err(_) => { return 1; },
		core.Result::Ok(session) => {
			val names = session.names;
			if names.len == 0 { return 2; }
			val first = &names[0];
			return first.byte_length();
		},
	}
}

module probe_std_json_legacy_primary;

import std.json as json;

fn removed_associated_helpers() -> Void {
	val _arr = json.JsonNode::new_array();
	val _obj = json.JsonNode::new_object();
	return;
}

fn removed_methods_on_valid_receivers() -> Void {
	var arr = json.new_array();
	arr.array_push(json.JsonNode::Number("1"));
	var obj = json.new_object();
	obj.object_set("k", json.JsonNode::Null());
	return;
}

pub fn main() -> Int {
	removed_associated_helpers();
	removed_methods_on_valid_receivers();
	return 0;
}

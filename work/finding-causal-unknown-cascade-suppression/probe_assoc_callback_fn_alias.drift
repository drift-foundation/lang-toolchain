module probe_assoc_callback_fn_alias;

import std.core as core;

fn add1(x: Int) nothrow -> Int { return x + 1; }

struct S {}

implement S {
	pub fn take_cb(cb: core.Callback1<Int, Int>) nothrow -> Int {
		return cb.call(6);
	}
}

pub fn main() nothrow -> Int {
	val f = add1;
	return S::take_cb(f) - 7;
}

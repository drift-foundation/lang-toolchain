module repro;

pub error ExcA { kind: Int }
pub error ExcB { kind: Int }

pub fn main() nothrow -> Int {
    val f = |n: Int| -> Int => { if n > 0 { throw ExcA(kind = 1); } else { throw ExcB(kind = 2); } };
    val a = try f(1) catch { 10 };
    val b = try f(-1) catch { 20 };
    val n = 3;
    val c = try (|| -> Int => { if n > 2 { throw ExcA(kind = 3); } else { throw ExcB(kind = 4); } })() catch { 30 };
    val g = |k: Int| -> Int => {
        match k {
            0 => { throw ExcA(kind = 5); },
            default => { throw ExcB(kind = 6); }
        }
    };
    val d = try g(0) catch { 40 };
    val e = try g(9) catch { 50 };
    val h = || -> Int => { { throw ExcA(kind = 7); } };
    val i = try h() catch { 60 };
    return a + b + c + d + e + i - 210;
}

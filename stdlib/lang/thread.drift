/// **Internal stdlib infrastructure.**
///
/// `lang.thread` exposes the raw OS / runtime primitives that
/// `std.io`, `std.net`, `std.concurrent`, `std.runtime`, and
/// `std.env` wrap into safe, ergonomic APIs.  Application code
/// should call the `std.*` wrappers — direct use of `lang.thread`
/// bypasses the safety, timeout, and error-mapping contracts the
/// wrappers enforce.
///
/// Opaque handle for a virtual-thread instance.
pub type VtHandle = Int;

/// Opaque handle for a thread-pool executor.  Internal — see
/// `std.concurrent.Executor`.
pub type ExecutorHandle = Int;

/// Opaque handle for the I/O reactor.  Internal infrastructure.
pub type ReactorHandle = Int;

@intrinsic pub fn vt_spawn(entry: core.Callback0<Void>, exec: ExecutorHandle) nothrow -> VtHandle;
@intrinsic pub fn vt_join(vt: VtHandle) nothrow -> Void;
@intrinsic pub fn vt_join_timeout(vt: VtHandle, timeout_ms: Int) nothrow -> Int;
@intrinsic pub fn vt_is_completed(vt: VtHandle) nothrow -> Int;
@intrinsic pub fn vt_cancel(vt: VtHandle) nothrow -> Int;
@intrinsic pub fn vt_drop(vt: VtHandle) nothrow -> Void;
@intrinsic pub fn vt_current() nothrow -> VtHandle;

/// Returns `1` if the current VT has been cancelled (via
/// `VirtualThread.cancel` / `vt_cancel` from another VT), `0`
/// otherwise.  Returns `0` when called outside a VT context.
///
/// **Intended use: compute-loop cooperative cancellation.**  A
/// long-running CPU-bound loop voluntarily polls this flag at
/// safe-point granularity and exits early when it observes
/// cancellation:
///
/// ```
/// while not thread.vt_is_cancelled() and not done(work) {
///     work = step(work);
/// }
/// ```
///
/// **Not useful from parking primitives.**  The runtime's
/// scheduler kills parked VTs at worker-dispatch time when their
/// `cancelled` flag is set
/// (`lang/language_runtime/posix/thread_runtime.c:858-872`).  A
/// VT parked inside `vt_park` / `vt_park_until` that gets
/// cancelled by another thread is reaped at re-dispatch BEFORE
/// any post-park user code runs — so `Condvar.wait` and similar
/// primitives have no opportunity to read this flag and surface
/// a `CANCELLED` error.  Future runtime work to let cancelled
/// VTs run a cleanup epilogue may change this; until then,
/// parking primitives surface CLOSED / TIMEOUT instead.
///
/// Backed by the runtime's per-VT `cancelled` atomic which the
/// cancel path (`vt_cancel`) sets.
@intrinsic pub fn vt_is_cancelled() nothrow -> Int;
@intrinsic pub fn vt_park(reason: Int) nothrow -> Void;
@intrinsic pub fn vt_park_until(deadline_ms: Int) nothrow -> Void;
/// Liveness annotation: record what the current VT is about to wait on, so the
/// runtime liveness interrogator (`kill -USR2 <pid>`) can report it.  Call
/// immediately before a `vt_park`/`vt_park_until` in a blocking primitive.
/// `kind` is a `DriftWaitKind` value (see `std.concurrent`); `id` is an opaque
/// wait-object id (0 if none).  No-op off a VT; cleared automatically on
/// resume.  Best-effort: never affects scheduling or correctness.
@intrinsic pub fn vt_set_wait(kind: Int, id: Int) nothrow -> Void;
@intrinsic pub fn vt_unpark(vt: VtHandle) nothrow -> Void;
@intrinsic pub fn vt_yield() nothrow -> Void;
/// Monotonic scheduler clock in milliseconds.  Internal deadline APIs use
/// this unit deliberately; wall-clock and measurement APIs use microseconds.
@intrinsic pub fn now_ms() nothrow -> Int;
/// Monotonic clock in microseconds for `std.time.Instant`.
@intrinsic pub fn now_us() nothrow -> Int;
/// UTC Unix-epoch clock in microseconds for `std.time.UtcTimestamp`.
@intrinsic pub fn now_utc_us() nothrow -> Int;

@intrinsic pub fn exec_default_get() nothrow -> ExecutorHandle;
@intrinsic pub fn exec_default_set(exec: ExecutorHandle) nothrow -> Void;
@intrinsic pub fn exec_create(min_threads: Int, max_threads: Int, queue_limit: Int, timeout_ms: Int, saturation: Int, stack_bytes: Int) nothrow -> ExecutorHandle;
@intrinsic pub fn exec_submit(exec: ExecutorHandle, vt: VtHandle) nothrow -> Int;
@intrinsic pub fn exec_submit_test_override(code: Int) nothrow -> Void;
@intrinsic pub fn exec_get_running(exec: ExecutorHandle) nothrow -> Int;

@intrinsic pub fn reactor_default_get() nothrow -> ReactorHandle;
@intrinsic pub fn reactor_default_set(reactor: ReactorHandle) nothrow -> Void;
@intrinsic pub fn reactor_register_io(fd: Int, interest: Int, vt: VtHandle, deadline_ms: Int) nothrow -> Void;
@intrinsic pub fn reactor_register_timer(deadline_ms: Int, vt: VtHandle) nothrow -> Void;
@intrinsic pub fn reactor_check_pending(fd: Int, direction: Int) nothrow -> Int;
@intrinsic pub fn reactor_io_charge(fd: Int, direction: Int, bytes: Int) nothrow -> Int;

/// F3 wait-set primitives (back `std.io.poll_many` / `_wait_set`).
/// `vt_wait_epoch_begin` snapshots the VT's wait epoch to stamp the next
/// wait-set's registrations.  `reactor_wait_register` registers one
/// `(fd, interest)` under that epoch, returning 0 or an errno (rolling back its
/// own partial state on failure).  `reactor_wait_clear` ends the episode (bump
/// epoch, clear slots/timer, free the per-VT list).
/// `reactor_wait_collect_pending` returns a readiness mask
/// (1=read 2=write 4=hangup 8=error 16=closed).  Read/write bits are CONSUMED
/// (cleared on read); hangup/error are STICKY/non-consuming — they are terminal
/// fd-level conditions that must remain visible to a second waiter on the same fd
/// (do not reintroduce consuming HUP/ERR).  `reactor_wait_park` parks until
/// ready/timeout/cancel with NO generic park token (0=woken 1=timeout
/// 2=cancelled).  The `reactor_*` counters are deterministic test probes.
@intrinsic pub fn vt_wait_epoch_begin(vt: VtHandle) nothrow -> Int;
@intrinsic pub fn reactor_wait_register(fd: Int, interest: Int, vt: VtHandle, epoch: Int) nothrow -> Int;
@intrinsic pub fn reactor_wait_clear(vt: VtHandle) nothrow -> Void;
@intrinsic pub fn reactor_wait_collect_pending(vt: VtHandle, fd: Int, interest: Int) nothrow -> Int;
@intrinsic pub fn reactor_wait_park(vt: VtHandle, deadline_ms: Int) nothrow -> Int;
@intrinsic pub fn reactor_stale_epoch_drops() nothrow -> Int;
@intrinsic pub fn reactor_close_unparks() nothrow -> Int;
@intrinsic pub fn reactor_park_blocks() nothrow -> Int;
@intrinsic pub fn test_eventfd_create() nothrow -> Int;
@intrinsic pub fn test_eventfd_write(fd: Int, value: Int) nothrow -> Void;
@intrinsic pub fn test_timerfd_create() nothrow -> Int;
@intrinsic pub fn test_timerfd_set(fd: Int, delay_ms: Int) nothrow -> Void;
@intrinsic pub fn io_open(path: String, flags: Int, mode: Int) nothrow -> Int;
@intrinsic pub fn io_close(fd: Int) nothrow -> Int;
@intrinsic pub fn io_read(fd: Int, buf: mem.Ptr<Byte>, len: Int) nothrow -> Int;
@intrinsic pub fn io_write(fd: Int, buf: mem.Ptr<Byte>, len: Int) nothrow -> Int;
@intrinsic pub fn io_errno() nothrow -> Int;
@intrinsic pub fn io_set_nonblocking(fd: Int) nothrow -> Int;
/// Non-consuming readability confirmation (recv MSG_PEEK): 1 = data available,
/// 0 = EOF/peer shutdown, -1 = WOULD_BLOCK (stale/replayed read hint), -2 = not a
/// peekable connected socket (listener/pipe) or error — caller must trust the hint.
/// Used by io.poll_many to suppress stale readable without breaking accept().
@intrinsic pub fn net_peek_readable(fd: Int) nothrow -> Int;
// std.fs.read_dir, offloaded to the shared blocking-syscall pool so the
// directory walk never blocks a VT carrier.  `fs_read_dir` submits one job and
// parks the VT; `deadline_ms` is an ABSOLUTE monotonic-ms deadline (0 = none).
// It returns a result handle >= 1, or a negative sentinel: -1 ENOMEM, -2
// saturation (backpressure), -4 timed-out, -5 cancelled.  The `fs_result_*`
// accessors are pure in-memory reads of the materialized snapshot
// (carrier-safe).  See lang/language_runtime/posix/fs_runtime.h.
@intrinsic pub fn fs_read_dir(path: String, deadline_ms: Int) nothrow -> Int;
@intrinsic pub fn fs_result_status(handle: Int) nothrow -> Int;
@intrinsic pub fn fs_result_errno(handle: Int) nothrow -> Int;
@intrinsic pub fn fs_result_count(handle: Int) nothrow -> Int;
@intrinsic pub fn fs_result_name(handle: Int, idx: Int) nothrow -> String;
@intrinsic pub fn fs_result_kind(handle: Int, idx: Int) nothrow -> Int;
@intrinsic pub fn fs_result_free(handle: Int) nothrow -> Int;
// Test-only: count of directory walks that have entered a pool worker (a
// worker-entry barrier for the saturation regression).
@intrinsic pub fn fs_test_walk_entries() nothrow -> Int;
// Test-only: count of reactor DIRECT-resume claims won (PARKED→READY taken by
// the poller, not a competing unpark/cancel).  Lets a race test wait until the
// reactor has actually won the claim before cancelling into the READY→RUNNING
// window.
@intrinsic pub fn vt_test_direct_resume_claims() nothrow -> Int;
@intrinsic pub fn console_write(text: String) nothrow -> Void;
@intrinsic pub fn console_writeln(text: String) nothrow -> Void;
@intrinsic pub fn console_eprint(text: String) nothrow -> Void;
@intrinsic pub fn console_eprintln(text: String) nothrow -> Void;
@intrinsic pub fn net_listen(ip: &String, port: Int) nothrow -> Int;
@intrinsic pub fn net_accept(fd: Int) nothrow -> Int;
@intrinsic pub fn net_connect(ip: &String, port: Int, deadline_ms: Int) nothrow -> Int;
@intrinsic pub fn net_listener_port(fd: Int) nothrow -> Int;
@intrinsic pub fn net_set_nodelay(fd: Int, enabled: Int) nothrow -> Int;
@intrinsic pub fn net_get_nodelay(fd: Int) nothrow -> Int;
@intrinsic pub fn net_udp_local_port(fd: Int) nothrow -> Int;
@intrinsic pub fn net_udp_bind(ip: &String, port: Int) nothrow -> Int;
@intrinsic pub fn net_udp_bind_v6(ip: &String, port: Int) nothrow -> Int;
@intrinsic pub fn net_udp_send_to(fd: Int, ip: &String, port: Int, buf: mem.Ptr<Byte>, len: Int) nothrow -> Int;
@intrinsic pub fn net_udp_send_to_v6(fd: Int, ip: &String, port: Int, buf: mem.Ptr<Byte>, len: Int) nothrow -> Int;
@intrinsic pub fn net_udp_recv_from(fd: Int, buf: mem.Ptr<Byte>, len: Int, out_ip: &mut String, out_port: &mut Int) nothrow -> Int;
@intrinsic pub fn net_udp_recv_from_v6(fd: Int, buf: mem.Ptr<Byte>, len: Int, out_ip: &mut String, out_port: &mut Int) nothrow -> Int;
@intrinsic pub fn runtime_global_registry_ptr() nothrow -> mem.Ptr<Byte>;
@intrinsic pub fn runtime_thread_registry_ptr() nothrow -> mem.Ptr<Byte>;
@intrinsic pub fn runtime_registry_set(type_tag: Uint64, ptr: mem.Ptr<Byte>, dropper: core.Callback1<mem.Ptr<Byte>, Void>) nothrow -> Int;
@intrinsic pub fn runtime_registry_contains(type_tag: Uint64) nothrow -> Int;
@intrinsic pub fn runtime_registry_get(type_tag: Uint64) nothrow -> mem.Ptr<Byte>;
@intrinsic pub fn runtime_thread_registry_set(type_tag: Uint64, ptr: mem.Ptr<Byte>, dropper: core.Callback1<mem.Ptr<Byte>, Void>) nothrow -> Int;
@intrinsic pub fn runtime_thread_registry_contains(type_tag: Uint64) nothrow -> Int;
@intrinsic pub fn runtime_thread_registry_get(type_tag: Uint64) nothrow -> mem.Ptr<Byte>;
@intrinsic pub unsafe fn array_byte_alloc_uninit(n: Int) nothrow -> Array<Byte>;
@intrinsic pub unsafe fn array_byte_as_mut_ptr(a: &mut Array<Byte>) nothrow -> mem.Ptr<Byte>;
@intrinsic pub unsafe fn array_byte_commit_init_len(a: &mut Array<Byte>, len: Int) nothrow -> Void;
@intrinsic pub unsafe fn random_fill(buf: mem.Ptr<Byte>, len: Int) nothrow -> Int;
@intrinsic pub fn env_get_raw(name: String) nothrow -> String;
@intrinsic pub fn env_has_raw(name: String) nothrow -> Int;
@intrinsic pub fn signal_await() nothrow -> Int;
@intrinsic pub fn vt_id() nothrow -> Int;
/// OS kernel thread id (`gettid()`) of the calling carrier thread — the same
/// value the liveness interrogator reports as `carrier_tid`, and the id used by
/// `top`/`ps`/`/proc`/`perf`/`strace`.  `std.log` emits this as `tid`.
@intrinsic pub fn kernel_thread_id() nothrow -> Int;

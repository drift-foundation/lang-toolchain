module lang.thread;

import std.core as core;
import std.mem as mem;

export {
	VtHandle,
	ExecutorHandle,
	ReactorHandle,
	vt_spawn,
	vt_join,
	vt_join_timeout,
	vt_is_completed,
	vt_cancel,
	vt_drop,
	vt_current,
	vt_park,
	vt_park_until,
	vt_unpark,
	vt_yield,
	now_ms,
	now_utc_ms,
	exec_default_get,
	exec_default_set,
	exec_create,
	exec_submit,
	exec_submit_test_override,
	exec_get_running,
	reactor_default_get,
	reactor_default_set,
	reactor_register_io,
	reactor_register_timer,
	reactor_check_pending,
	reactor_io_charge,
	test_eventfd_create,
	test_eventfd_write,
	test_timerfd_create,
	test_timerfd_set,
	io_open,
	io_close,
	io_read,
	io_write,
	io_errno,
	io_set_nonblocking,
	console_write,
	console_writeln,
	console_eprint,
	console_eprintln,
	net_listen,
	net_accept,
	net_connect,
	net_listener_port,
	net_udp_local_port,
	net_udp_bind,
	net_udp_bind_v6,
	net_udp_send_to,
	net_udp_send_to_v6,
	net_udp_recv_from,
	net_udp_recv_from_v6,
	net_set_nodelay,
	net_get_nodelay,
	runtime_global_registry_ptr,
	runtime_thread_registry_ptr,
	runtime_registry_set,
	runtime_registry_contains,
	runtime_registry_get,
	runtime_thread_registry_set,
	runtime_thread_registry_contains,
	runtime_thread_registry_get,
	array_byte_alloc_uninit,
	array_byte_as_mut_ptr,
	array_byte_commit_init_len,
	random_fill,
	env_get_raw,
	env_has_raw
};

pub type VtHandle = Int;
pub type ExecutorHandle = Int;
pub type ReactorHandle = Int;

@intrinsic pub fn vt_spawn(entry: core.Callback0<Void>, exec: ExecutorHandle) nothrow -> VtHandle;
@intrinsic pub fn vt_join(vt: VtHandle) nothrow -> Void;
@intrinsic pub fn vt_join_timeout(vt: VtHandle, timeout_ms: Int) nothrow -> Int;
@intrinsic pub fn vt_is_completed(vt: VtHandle) nothrow -> Int;
@intrinsic pub fn vt_cancel(vt: VtHandle) nothrow -> Int;
@intrinsic pub fn vt_drop(vt: VtHandle) nothrow -> Void;
@intrinsic pub fn vt_current() nothrow -> VtHandle;
@intrinsic pub fn vt_park(reason: Int) nothrow -> Void;
@intrinsic pub fn vt_park_until(deadline_ms: Int) nothrow -> Void;
@intrinsic pub fn vt_unpark(vt: VtHandle) nothrow -> Void;
@intrinsic pub fn vt_yield() nothrow -> Void;
@intrinsic pub fn now_ms() nothrow -> Int;
@intrinsic pub fn now_utc_ms() nothrow -> Int;

@intrinsic pub fn exec_default_get() nothrow -> ExecutorHandle;
@intrinsic pub fn exec_default_set(exec: ExecutorHandle) nothrow -> Void;
@intrinsic pub fn exec_create(min_threads: Int, max_threads: Int, queue_limit: Int, timeout_ms: Int, saturation: Int, stack_bytes: Int) nothrow -> ExecutorHandle;
@intrinsic pub fn exec_submit(exec: ExecutorHandle, vt: VtHandle) nothrow -> Int;
@intrinsic pub fn exec_submit_test_override(code: Int) nothrow -> Void;
@intrinsic pub fn exec_get_running(exec: ExecutorHandle) nothrow -> Int;

@intrinsic pub fn reactor_default_get() nothrow -> ReactorHandle;
@intrinsic pub fn reactor_default_set(reactor: ReactorHandle) nothrow -> Void;
@intrinsic pub fn reactor_register_io(fd: Int, interest: Int, vt: VtHandle, deadline_ms: Int) nothrow -> Void;
@intrinsic pub fn reactor_register_timer(deadline_ms: Int, vt: VtHandle) nothrow -> Void;
@intrinsic pub fn reactor_check_pending(fd: Int, direction: Int) nothrow -> Int;
@intrinsic pub fn reactor_io_charge(fd: Int, direction: Int, bytes: Int) nothrow -> Int;
@intrinsic pub fn test_eventfd_create() nothrow -> Int;
@intrinsic pub fn test_eventfd_write(fd: Int, value: Int) nothrow -> Void;
@intrinsic pub fn test_timerfd_create() nothrow -> Int;
@intrinsic pub fn test_timerfd_set(fd: Int, delay_ms: Int) nothrow -> Void;
@intrinsic pub fn io_open(path: String, flags: Int, mode: Int) nothrow -> Int;
@intrinsic pub fn io_close(fd: Int) nothrow -> Int;
@intrinsic pub fn io_read(fd: Int, buf: mem.Ptr<Byte>, len: Int) nothrow -> Int;
@intrinsic pub fn io_write(fd: Int, buf: mem.Ptr<Byte>, len: Int) nothrow -> Int;
@intrinsic pub fn io_errno() nothrow -> Int;
@intrinsic pub fn io_set_nonblocking(fd: Int) nothrow -> Int;
@intrinsic pub fn console_write(text: String) nothrow -> Void;
@intrinsic pub fn console_writeln(text: String) nothrow -> Void;
@intrinsic pub fn console_eprint(text: String) nothrow -> Void;
@intrinsic pub fn console_eprintln(text: String) nothrow -> Void;
@intrinsic pub fn net_listen(ip: &String, port: Int) nothrow -> Int;
@intrinsic pub fn net_accept(fd: Int) nothrow -> Int;
@intrinsic pub fn net_connect(ip: &String, port: Int, deadline_ms: Int) nothrow -> Int;
@intrinsic pub fn net_listener_port(fd: Int) nothrow -> Int;
@intrinsic pub fn net_set_nodelay(fd: Int, enabled: Int) nothrow -> Int;
@intrinsic pub fn net_get_nodelay(fd: Int) nothrow -> Int;
@intrinsic pub fn net_udp_local_port(fd: Int) nothrow -> Int;
@intrinsic pub fn net_udp_bind(ip: &String, port: Int) nothrow -> Int;
@intrinsic pub fn net_udp_bind_v6(ip: &String, port: Int) nothrow -> Int;
@intrinsic pub fn net_udp_send_to(fd: Int, ip: &String, port: Int, buf: mem.Ptr<Byte>, len: Int) nothrow -> Int;
@intrinsic pub fn net_udp_send_to_v6(fd: Int, ip: &String, port: Int, buf: mem.Ptr<Byte>, len: Int) nothrow -> Int;
@intrinsic pub fn net_udp_recv_from(fd: Int, buf: mem.Ptr<Byte>, len: Int, out_ip: &mut String, out_port: &mut Int) nothrow -> Int;
@intrinsic pub fn net_udp_recv_from_v6(fd: Int, buf: mem.Ptr<Byte>, len: Int, out_ip: &mut String, out_port: &mut Int) nothrow -> Int;
@intrinsic pub fn runtime_global_registry_ptr() nothrow -> mem.Ptr<Byte>;
@intrinsic pub fn runtime_thread_registry_ptr() nothrow -> mem.Ptr<Byte>;
@intrinsic pub fn runtime_registry_set(type_tag: Uint64, ptr: mem.Ptr<Byte>, dropper: core.Callback1<mem.Ptr<Byte>, Void>) nothrow -> Int;
@intrinsic pub fn runtime_registry_contains(type_tag: Uint64) nothrow -> Int;
@intrinsic pub fn runtime_registry_get(type_tag: Uint64) nothrow -> mem.Ptr<Byte>;
@intrinsic pub fn runtime_thread_registry_set(type_tag: Uint64, ptr: mem.Ptr<Byte>, dropper: core.Callback1<mem.Ptr<Byte>, Void>) nothrow -> Int;
@intrinsic pub fn runtime_thread_registry_contains(type_tag: Uint64) nothrow -> Int;
@intrinsic pub fn runtime_thread_registry_get(type_tag: Uint64) nothrow -> mem.Ptr<Byte>;
@intrinsic pub unsafe fn array_byte_alloc_uninit(n: Int) nothrow -> Array<Byte>;
@intrinsic pub unsafe fn array_byte_as_mut_ptr(a: &mut Array<Byte>) nothrow -> mem.Ptr<Byte>;
@intrinsic pub unsafe fn array_byte_commit_init_len(a: &mut Array<Byte>, len: Int) nothrow -> Void;
@intrinsic pub unsafe fn random_fill(buf: mem.Ptr<Byte>, len: Int) nothrow -> Int;
@intrinsic pub fn env_get_raw(name: String) nothrow -> String;
@intrinsic pub fn env_has_raw(name: String) nothrow -> Int;
@intrinsic pub fn signal_await() nothrow -> Int;

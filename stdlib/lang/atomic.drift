module lang.atomic;

// `lang.atomic` does NOT import `std.core` — that would close a cycle
// once `std.core.arc` imports `lang.atomic` for refcount storage.
// The `implement Copy for MemoryOrder { }` impl that previously
// lived here moved to `std.core/core.drift` (next to the other
// stdlib Copy impls) so the dependency goes one way:
// `std.core` → `lang.atomic` (and not the other way around).

export {
	MemoryOrder,
	AtomicBool,
	AtomicInt,
	AtomicUint,
	AtomicUint64,
	atomic_bool,
	atomic_int,
	atomic_uint,
	atomic_uint64,
	atomic_load_bool,
	atomic_store_bool,
	atomic_exchange_bool,
	atomic_compare_exchange_bool,
	atomic_compare_exchange_observed_bool,
	atomic_load_int,
	atomic_store_int,
	atomic_exchange_int,
	atomic_compare_exchange_int,
	atomic_compare_exchange_observed_int,
	atomic_fetch_add_int,
	atomic_fetch_sub_int,
	atomic_load_uint,
	atomic_store_uint,
	atomic_exchange_uint,
	atomic_compare_exchange_uint,
	atomic_compare_exchange_observed_uint,
	atomic_fetch_add_uint,
	atomic_fetch_sub_uint,
	atomic_load_uint64,
	atomic_store_uint64,
	atomic_exchange_uint64,
	atomic_compare_exchange_uint64,
	atomic_compare_exchange_observed_uint64,
	atomic_fetch_add_uint64,
	atomic_fetch_sub_uint64,
	thread_fence,
	signal_fence
};

/// **Internal stdlib infrastructure.**
///
/// `lang.atomic` exposes raw atomic load/store/RMW primitives that
/// `std.sync` and `std.concurrent` wrap into the user-facing
/// `AtomicBool` / `AtomicInt` / `AtomicUint` / `AtomicUint64`
/// methods.  Application code should call `std.sync.*` — direct
/// use of `lang.atomic` is reserved for stdlib implementation.
///
/// Memory-ordering tag passed to atomic load/store/RMW operations.
/// Standard C11/C++11 ordering set.
pub variant MemoryOrder {
	Relaxed,
	Acquire,
	Release,
	AcqRel,
	SeqCst,
}

pub struct AtomicBool {
	value: Bool
}

pub struct AtomicInt {
	value: Int
}

pub struct AtomicUint {
	value: Uint
}

pub struct AtomicUint64 {
	value: Uint64
}

pub fn atomic_bool(v: Bool) nothrow -> AtomicBool {
	return AtomicBool(v);
}

pub fn atomic_int(v: Int) nothrow -> AtomicInt {
	return AtomicInt(v);
}

pub fn atomic_uint(v: Uint) nothrow -> AtomicUint {
	return AtomicUint(v);
}

pub fn atomic_uint64(v: Uint64) nothrow -> AtomicUint64 {
	return AtomicUint64(v);
}

pub fn _order_code(order: MemoryOrder) nothrow -> Int {
	match order {
		Relaxed => { return 0; },
		Acquire => { return 1; },
		Release => { return 2; },
		AcqRel => { return 3; },
		SeqCst => { return 4; },
		default => { return 0; }
	}
}

fn _cas_orders_valid(success: MemoryOrder, failure: MemoryOrder) nothrow -> Bool {
	match failure {
		Release => { return false; },
		AcqRel => { return false; },
		default => {}
	}
	match success {
		Relaxed => {
			match failure {
				Relaxed => { return true; },
				default => { return false; }
			}
		},
		Acquire => {
			match failure {
				Relaxed => { return true; },
				Acquire => { return true; },
				default => { return false; }
			}
		},
		Release => {
			match failure {
				Relaxed => { return true; },
				default => { return false; }
			}
		},
		AcqRel => {
			match failure {
				Relaxed => { return true; },
				Acquire => { return true; },
				default => { return false; }
			}
		},
		SeqCst => {
			match failure {
				Relaxed => { return true; },
				Acquire => { return true; },
				SeqCst => { return true; },
				default => { return false; }
			}
		},
		default => { return false; }
	}
}

implement AtomicBool {
	pub fn load(self: &AtomicBool, order: MemoryOrder) nothrow -> Bool {
		return atomic_load_bool(self, _order_code(order));
	}

	pub fn store(self: &AtomicBool, v: Bool, order: MemoryOrder) nothrow -> Void {
		atomic_store_bool(self, v, _order_code(order));
		return;
	}

	pub fn exchange(self: &AtomicBool, v: Bool, order: MemoryOrder) nothrow -> Bool {
		return atomic_exchange_bool(self, v, _order_code(order));
	}

	pub fn compare_exchange(self: &AtomicBool, expected: Bool, desired: Bool, success_order: MemoryOrder, failure_order: MemoryOrder) nothrow -> Bool {
		if not _cas_orders_valid(success_order, failure_order) {
			return false;
		}
		return atomic_compare_exchange_bool(self, expected, desired, _order_code(success_order), _order_code(failure_order));
	}

	pub fn compare_exchange_observed(self: &AtomicBool, expected: Bool, desired: Bool, success_order: MemoryOrder, failure_order: MemoryOrder) nothrow -> Bool {
		if not _cas_orders_valid(success_order, failure_order) {
			return expected;
		}
		return atomic_compare_exchange_observed_bool(self, expected, desired, _order_code(success_order), _order_code(failure_order));
	}
}

implement AtomicInt {
	pub fn load(self: &AtomicInt, order: MemoryOrder) nothrow -> Int {
		return atomic_load_int(self, _order_code(order));
	}

	pub fn store(self: &AtomicInt, v: Int, order: MemoryOrder) nothrow -> Void {
		atomic_store_int(self, v, _order_code(order));
		return;
	}

	pub fn fetch_add(self: &AtomicInt, v: Int, order: MemoryOrder) nothrow -> Int {
		return atomic_fetch_add_int(self, v, _order_code(order));
	}

	pub fn fetch_sub(self: &AtomicInt, v: Int, order: MemoryOrder) nothrow -> Int {
		return atomic_fetch_sub_int(self, v, _order_code(order));
	}

	pub fn exchange(self: &AtomicInt, v: Int, order: MemoryOrder) nothrow -> Int {
		return atomic_exchange_int(self, v, _order_code(order));
	}

	pub fn compare_exchange(self: &AtomicInt, expected: Int, desired: Int, success_order: MemoryOrder, failure_order: MemoryOrder) nothrow -> Bool {
		if not _cas_orders_valid(success_order, failure_order) {
			return false;
		}
		return atomic_compare_exchange_int(self, expected, desired, _order_code(success_order), _order_code(failure_order));
	}

	pub fn compare_exchange_observed(self: &AtomicInt, expected: Int, desired: Int, success_order: MemoryOrder, failure_order: MemoryOrder) nothrow -> Int {
		if not _cas_orders_valid(success_order, failure_order) {
			return expected;
		}
		return atomic_compare_exchange_observed_int(self, expected, desired, _order_code(success_order), _order_code(failure_order));
	}
}


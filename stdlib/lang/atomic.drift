implement AtomicUint64 {
	pub fn load(self: &AtomicUint64, order: MemoryOrder) nothrow -> Uint64 {
		return atomic_load_uint64(self, _order_code(order));
	}

	pub fn store(self: &AtomicUint64, v: Uint64, order: MemoryOrder) nothrow -> Void {
		atomic_store_uint64(self, v, _order_code(order));
		return;
	}

	pub fn fetch_add(self: &AtomicUint64, v: Uint64, order: MemoryOrder) nothrow -> Uint64 {
		return atomic_fetch_add_uint64(self, v, _order_code(order));
	}

	pub fn fetch_sub(self: &AtomicUint64, v: Uint64, order: MemoryOrder) nothrow -> Uint64 {
		return atomic_fetch_sub_uint64(self, v, _order_code(order));
	}

	pub fn exchange(self: &AtomicUint64, v: Uint64, order: MemoryOrder) nothrow -> Uint64 {
		return atomic_exchange_uint64(self, v, _order_code(order));
	}

	pub fn compare_exchange(self: &AtomicUint64, expected: Uint64, desired: Uint64, success_order: MemoryOrder, failure_order: MemoryOrder) nothrow -> Bool {
		if not _cas_orders_valid(success_order, failure_order) {
			return false;
		}
		return atomic_compare_exchange_uint64(self, expected, desired, _order_code(success_order), _order_code(failure_order));
	}

	pub fn compare_exchange_observed(self: &AtomicUint64, expected: Uint64, desired: Uint64, success_order: MemoryOrder, failure_order: MemoryOrder) nothrow -> Uint64 {
		if not _cas_orders_valid(success_order, failure_order) {
			return expected;
		}
		return atomic_compare_exchange_observed_uint64(self, expected, desired, _order_code(success_order), _order_code(failure_order));
	}
}

pub fn thread_fence(order: MemoryOrder) nothrow -> Void {
	atomic_thread_fence(_order_code(order));
	return;
}

pub fn signal_fence(order: MemoryOrder) nothrow -> Void {
	atomic_signal_fence(_order_code(order));
	return;
}

@intrinsic pub fn atomic_load_bool(p: &AtomicBool, order: Int) nothrow -> Bool;
@intrinsic pub fn atomic_store_bool(p: &AtomicBool, v: Bool, order: Int) nothrow -> Void;
@intrinsic pub fn atomic_exchange_bool(p: &AtomicBool, v: Bool, order: Int) nothrow -> Bool;
@intrinsic pub fn atomic_compare_exchange_bool(p: &AtomicBool, expected: Bool, desired: Bool, success_order: Int, failure_order: Int) nothrow -> Bool;
@intrinsic pub fn atomic_compare_exchange_observed_bool(p: &AtomicBool, expected: Bool, desired: Bool, success_order: Int, failure_order: Int) nothrow -> Bool;

@intrinsic pub fn atomic_load_int(p: &AtomicInt, order: Int) nothrow -> Int;
@intrinsic pub fn atomic_store_int(p: &AtomicInt, v: Int, order: Int) nothrow -> Void;
@intrinsic pub fn atomic_exchange_int(p: &AtomicInt, v: Int, order: Int) nothrow -> Int;
@intrinsic pub fn atomic_compare_exchange_int(p: &AtomicInt, expected: Int, desired: Int, success_order: Int, failure_order: Int) nothrow -> Bool;
@intrinsic pub fn atomic_compare_exchange_observed_int(p: &AtomicInt, expected: Int, desired: Int, success_order: Int, failure_order: Int) nothrow -> Int;
@intrinsic pub fn atomic_fetch_add_int(p: &AtomicInt, v: Int, order: Int) nothrow -> Int;
@intrinsic pub fn atomic_fetch_sub_int(p: &AtomicInt, v: Int, order: Int) nothrow -> Int;

@intrinsic pub fn atomic_load_uint(p: &AtomicUint, order: Int) nothrow -> Uint;
@intrinsic pub fn atomic_store_uint(p: &AtomicUint, v: Uint, order: Int) nothrow -> Void;
@intrinsic pub fn atomic_exchange_uint(p: &AtomicUint, v: Uint, order: Int) nothrow -> Uint;
@intrinsic pub fn atomic_compare_exchange_uint(p: &AtomicUint, expected: Uint, desired: Uint, success_order: Int, failure_order: Int) nothrow -> Bool;
@intrinsic pub fn atomic_compare_exchange_observed_uint(p: &AtomicUint, expected: Uint, desired: Uint, success_order: Int, failure_order: Int) nothrow -> Uint;
@intrinsic pub fn atomic_fetch_add_uint(p: &AtomicUint, v: Uint, order: Int) nothrow -> Uint;
@intrinsic pub fn atomic_fetch_sub_uint(p: &AtomicUint, v: Uint, order: Int) nothrow -> Uint;

@intrinsic pub fn atomic_load_uint64(p: &AtomicUint64, order: Int) nothrow -> Uint64;
@intrinsic pub fn atomic_store_uint64(p: &AtomicUint64, v: Uint64, order: Int) nothrow -> Void;
@intrinsic pub fn atomic_exchange_uint64(p: &AtomicUint64, v: Uint64, order: Int) nothrow -> Uint64;
@intrinsic pub fn atomic_compare_exchange_uint64(p: &AtomicUint64, expected: Uint64, desired: Uint64, success_order: Int, failure_order: Int) nothrow -> Bool;
@intrinsic pub fn atomic_compare_exchange_observed_uint64(p: &AtomicUint64, expected: Uint64, desired: Uint64, success_order: Int, failure_order: Int) nothrow -> Uint64;
@intrinsic pub fn atomic_fetch_add_uint64(p: &AtomicUint64, v: Uint64, order: Int) nothrow -> Uint64;
@intrinsic pub fn atomic_fetch_sub_uint64(p: &AtomicUint64, v: Uint64, order: Int) nothrow -> Uint64;
@intrinsic pub fn atomic_thread_fence(order: Int) nothrow -> Void;
@intrinsic pub fn atomic_signal_fence(order: Int) nothrow -> Void;

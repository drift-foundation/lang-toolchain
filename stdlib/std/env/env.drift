module std.env;

import lang.thread as thread;

export {
	get,
	has,
	drift_tmp_path
};

/// Reads the value of the named environment variable.
///
/// Distinguishes "unset" from "set to empty string": an explicitly
/// empty value returns `Some("")`, while an unset variable returns
/// `None`.
///
/// **See also:** `has`.
pub fn get(name: String) nothrow -> Optional<String> {
	if thread.env_has_raw(name) == 0 {
		return Optional::None();
	}
	return Optional::Some(thread.env_get_raw(name));
}

/// Returns `true` if the named environment variable is set (even to
/// an empty string), `false` otherwise.
///
/// **See also:** `get`.
pub fn has(name: String) nothrow -> Bool {
	return thread.env_has_raw(name) != 0;
}

/// Returns a path under the session scratch root for a file named
/// `name`.
///
/// Resolves to `$DRIFT_TMP_ROOT/<name>` when the env var is set (the
/// normal case under pytest / the e2e runner / any process launched
/// via the drift tooling); falls back to `/tmp/<name>` for direct
/// manual invocation outside a Drift session.
///
/// Drift code that needs scratch storage MUST use this helper (or a
/// caller-supplied path) instead of hard-coding `/tmp/<name>` — the
/// `/tmp/drift-$USER/session-*` namespace is the only thing a janitor
/// can safely sweep after an OOM/SIGKILL, and the conftest /
/// PYTEST_DEBUG_TEMPROOT relocation does NOT cross the compiled-Drift
/// boundary.  See `docs/conventions/tmp-root.md`.
///
/// **Example:**
///
/// ```
/// val path = env.drift_tmp_path("my_test_output.bin");
/// val w = io.file_builder(path)...
/// ```
pub fn drift_tmp_path(name: String) nothrow -> String {
	match get("DRIFT_TMP_ROOT") {
		Optional::Some(root) => { return root + "/" + name; },
		default => { return "/tmp/" + name; }
	}
}

module std.env;

import lang.thread as thread;
import std.text as text;

export {
	get,
	has,
	drift_tmp_path
};

/// Reads the value of the named environment variable.
///
/// Distinguishes "unset" from "set to empty string": an explicitly
/// empty value returns `Some("")`, while an unset variable returns
/// `None`.
///
/// **See also:** `has`.
pub fn get(name: String) nothrow -> Optional<String> {
	if thread.env_has_raw(name) == 0 {
		return Optional::None();
	}
	return Optional::Some(thread.env_get_raw(name));
}

/// Returns `true` if the named environment variable is set (even to
/// an empty string), `false` otherwise.
///
/// **See also:** `get`.
pub fn has(name: String) nothrow -> Bool {
	return thread.env_has_raw(name) != 0;
}

/// Returns a path under the session scratch root for a file named
/// `name`.
///
/// Resolves to `$DRIFT_TMP_ROOT/<name>` when the env var is set (the
/// normal case under pytest / the e2e runner / any process launched
/// via the drift tooling); falls back to `/tmp/<name>` for direct  // drift-tmp-root-audit: allow docstring
/// manual invocation outside a Drift session.
///
/// Drift code that needs scratch storage MUST use this helper (or a
/// caller-supplied path) instead of hard-coding `/tmp/<name>` — the  // drift-tmp-root-audit: allow docstring
/// `/tmp/drift-$USER/session-*` namespace is the only thing a janitor  // drift-tmp-root-audit: allow docstring
/// can safely sweep after an OOM/SIGKILL, and the conftest /
/// PYTEST_DEBUG_TEMPROOT relocation does NOT cross the compiled-Drift
/// boundary.  See `doc/conventions/tmp-root.md`.
///
/// **Contract.**  `name` must be a single filename component — no
/// path separators (`/`, `\`), no parent-directory traversal (`..`).
/// Without this, a caller could accidentally escape `$DRIFT_TMP_ROOT`
/// (e.g. `drift_tmp_path("../etc/passwd")` would resolve outside the
/// session root once the kernel normalized the path).  Defensive:
/// any forbidden substring is replaced with `_` before the join, so
/// misuse produces a mangled-but-contained path rather than a
/// silent escape.  Callers MUST pass clean filenames; the
/// replacement is defense-in-depth, not a license to pass arbitrary
/// strings.
///
/// **Example:**
///
/// ```
/// val path = env.drift_tmp_path("my_test_output.bin");
/// val w = io.file_builder(path)...
/// ```
pub fn drift_tmp_path(name: String) nothrow -> String {
	// Defensive sanitization: replace path separators and parent-dir
	// traversal with `_` so a caller who accidentally builds the name
	// from untrusted input cannot escape the session root.  Order
	// matters: replace `..` before `/`, so the result of `..` -> `__`
	// does not interact with a subsequent `/` pass.
	val sep = "/";
	val dotdot = "..";
	val bs = "\\";
	val under = "_";
	val s1 = text.replace(&name, &dotdot, &under);
	val s2 = text.replace(&s1, &sep, &under);
	val safe = text.replace(&s2, &bs, &under);
	match get("DRIFT_TMP_ROOT") {
		Optional::Some(root) => { return root + "/" + safe; },
		default => { return "/tmp/" + safe; }  // drift-tmp-root-audit: allow fallback for direct manual invocation outside a Drift session
	}
}

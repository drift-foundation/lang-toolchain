module std.env;

import lang.thread as thread;

export {
	get,
	has
};

/// Reads the value of the named environment variable.
///
/// Distinguishes "unset" from "set to empty string": an explicitly
/// empty value returns `Some("")`, while an unset variable returns
/// `None`.
///
/// **See also:** `has`.
pub fn get(name: String) nothrow -> Optional<String> {
	if thread.env_has_raw(name) == 0 {
		return Optional::None();
	}
	return Optional::Some(thread.env_get_raw(name));
}

/// Returns `true` if the named environment variable is set (even to
/// an empty string), `false` otherwise.
///
/// **See also:** `get`.
pub fn has(name: String) nothrow -> Bool {
	return thread.env_has_raw(name) != 0;
}

module std.env

import lang.thread as thread;

export {
	get,
	has
};

// Read-only process environment access.
//
// Returns the value of the named environment variable, or None if unset.
// An environment variable set to an empty string returns Some("").
pub fn get(name: String) nothrow -> Optional<String> {
	if thread.env_has_raw(name) == 0 {
		return Optional::None();
	}
	return Optional::Some(thread.env_get_raw(name));
}

// Returns true if the named environment variable is set, false otherwise.
pub fn has(name: String) nothrow -> Bool {
	return thread.env_has_raw(name) != 0;
}

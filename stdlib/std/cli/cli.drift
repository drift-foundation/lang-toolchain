module std.cli;

import std.core as core;
import std.parse as parse_std;
import std.text as text;

export {
	CliError,
	ParsedArgs,
	ArgParser,
	parser
};

/// Error returned by `ArgParser.parse` when argv is malformed.
///
/// `tag` is a stable machine-readable code (`"unknown-option"`,
/// `"missing-value"`, `"invalid-int"`, `"missing-required"`,
/// `"too-many-positional"`, `"cli-help-requested"`).  `arg` is the
/// offending argv entry; `message` is a human-readable summary;
/// `index` is the zero-based argv position where the parser gave
/// up.
///
/// Note: the special tag `"cli-help-requested"` is returned when
/// `--help` is encountered; callers typically treat it as "exit 0",
/// not as an error.
pub struct CliError {
	pub tag: String,
	pub arg: String,
	pub message: String,
	pub index: Int
}

/// Result of a successful `ArgParser.parse`.
///
/// Carries a compact representation of which flags/options were
/// observed and what values they held.  Query via the accessor
/// methods (`has_flag`, `get_string`, `get_int`, `positional_at`,
/// `positional_len`) — never inspect the internal arrays directly.
pub struct ParsedArgs {
	flag_option_indices: Array<Int>,
	option_value_indices: Array<Int>,
	option_values: Array<String>,
	positionals: Array<String>
}

/// CLI argument-parser builder.
///
/// Construct via `parser(app, version, about)` and register
/// flags/options/positionals before calling `.parse(&argv)`.  The
/// parser supports `--long` and `-s` short forms, `--help` /
/// `-h`, and the `--name=value` syntax for options.
///
/// **See also:** `parser`, `ArgParser.parse`, `ParsedArgs`.
pub struct ArgParser {
	app: String,
	version: String,
	about: String,
	option_longs: Array<String>,
	option_shorts: Array<String>,
	option_value_names: Array<String>,
	option_helps: Array<String>,
	option_required: Array<Bool>,
	option_kinds: Array<Int>,
	pos_names: Array<String>,
	pos_helps: Array<String>,
	pos_required: Array<Bool>,
	pos_multiple: Array<Bool>
}

const OPTION_KIND_FLAG: Int = 0;
const OPTION_KIND_STRING: Int = 1;
const OPTION_KIND_INT: Int = 2;

/// Constructs an empty `ArgParser` with the given app metadata.
///
/// **Parameters:**
/// - `app` — application name (shown in `--help` output).
/// - `version` — version string.
/// - `about` — one-line description.
///
/// **See also:** `ArgParser`, `ArgParser.flag`,
/// `ArgParser.option_string`, `ArgParser.parse`.
///
/// **Example:** `examples/cli/main.drift`.
pub fn parser(app: String, version: String, about: String) nothrow -> ArgParser {
	var option_longs: Array<String> = [];
	var option_shorts: Array<String> = [];
	var option_value_names: Array<String> = [];
	var option_helps: Array<String> = [];
	var option_required: Array<Bool> = [];
	var option_kinds: Array<Int> = [];
	var pos_names: Array<String> = [];
	var pos_helps: Array<String> = [];
	var pos_required: Array<Bool> = [];
	var pos_multiple: Array<Bool> = [];
	return ArgParser(app = app, version = version, about = about, option_longs = move option_longs, option_shorts = move option_shorts, option_value_names = move option_value_names, option_helps = move option_helps, option_required = move option_required, option_kinds = move option_kinds, pos_names = move pos_names, pos_helps = move pos_helps, pos_required = move pos_required, pos_multiple = move pos_multiple);
}

fn _err(tag: String, arg: String, message: String, index: Int) nothrow -> core.Result<ParsedArgs, CliError> {
	return core.Result::Err(CliError(tag = tag, arg = arg, message = message, index = index));
}

fn _eq_byte(s: &String, i: Int, b: Byte) nothrow -> Bool {
	return core.string_byte_at(s, i) == b;
}

fn _starts_with_dash_dash(s: &String) nothrow -> Bool {
	return s.byte_length() >= 2 and _eq_byte(s, 0, cast<Byte>(45)) and _eq_byte(s, 1, cast<Byte>(45));
}

fn _starts_with_dash(s: &String) nothrow -> Bool {
	return s.byte_length() >= 1 and _eq_byte(s, 0, cast<Byte>(45));
}

fn _find_byte(s: &String, want: Byte) nothrow -> Int {
	var i = 0;
	while i < s.byte_length() {
		if core.string_byte_at(s, i) == want {
			return i;
		}
		i = i + 1;
	}
	return -1;
}

fn _slice_string(s: &String, start: Int, end: Int) nothrow -> String {
	if end <= start {
		return "";
	}
	var out: Array<Byte> = [];
	var i = start;
	while i < end {
		out.push(core.string_byte_at(s, i));
		i = i + 1;
	}
	match text.utf8_from_bytes(&out) {
		core.Result::Ok(v) => { return v; },
		core.Result::Err(_) => { return ""; }
	}
}

fn _dup_string(s: &String) nothrow -> String {
	return _slice_string(s, 0, s.byte_length());
}

fn _string_eq_ref(a: &String, b: &String) nothrow -> Bool {
	if a.byte_length() != b.byte_length() {
		return false;
	}
	var i = 0;
	while i < a.byte_length() {
		if core.string_byte_at(a, i) != core.string_byte_at(b, i) {
			return false;
		}
		i = i + 1;
	}
	return true;
}

fn _string_eq_value(a: &String, b: String) nothrow -> Bool {
	return _string_eq_ref(a, &b);
}

fn _contains_int(xs: &Array<Int>, value: Int) nothrow -> Bool {
	var i = 0;
	while i < xs.len {
		if xs[i] == value {
			return true;
		}
		i = i + 1;
	}
	return false;
}

fn _contains_value_idx(indices: &Array<Int>, option_index: Int) nothrow -> Bool {
	return _contains_int(indices, option_index);
}

fn _is_seen(flag_option_indices: &Array<Int>, option_value_indices: &Array<Int>, option_index: Int) nothrow -> Bool {
	return _contains_int(flag_option_indices, option_index) or _contains_value_idx(option_value_indices, option_index);
}

fn _find_option_by_long(option_longs: &Array<String>, long: &String) nothrow -> Int {
	var i = 0;
	while i < option_longs.len {
		if _string_eq_ref(&option_longs[i], long) {
			return i;
		}
		i = i + 1;
	}
	return -1;
}

fn _find_option_by_short(option_shorts: &Array<String>, short: &String) nothrow -> Int {
	var i = 0;
	while i < option_shorts.len {
		if _string_eq_ref(&option_shorts[i], short) {
			return i;
		}
		i = i + 1;
	}
	return -1;
}

fn _validate_schema(p: &ArgParser) nothrow -> Optional<CliError> {
	var i = 0;
	while i < p.option_longs.len {
		if _string_eq_value(&p.option_longs[i], "help") or _string_eq_value(&p.option_longs[i], "version") {
			return Optional::Some(CliError(tag = "cli-invalid-schema", arg = "", message = "reserved long option", index = i));
		}
		if _string_eq_value(&p.option_shorts[i], "h") or _string_eq_value(&p.option_shorts[i], "V") {
			return Optional::Some(CliError(tag = "cli-invalid-schema", arg = "", message = "reserved short option", index = i));
		}
		var j = i + 1;
		while j < p.option_longs.len {
			if _string_eq_ref(&p.option_longs[i], &p.option_longs[j]) {
				return Optional::Some(CliError(tag = "cli-invalid-schema", arg = "", message = "duplicate long option", index = j));
			}
			if not _string_eq_value(&p.option_shorts[i], "") and _string_eq_ref(&p.option_shorts[i], &p.option_shorts[j]) {
				return Optional::Some(CliError(tag = "cli-invalid-schema", arg = "", message = "duplicate short option", index = j));
			}
			j = j + 1;
		}
		i = i + 1;
	}
	var k = 0;
	while k < p.pos_names.len {
		if p.pos_multiple[k] and k != p.pos_names.len - 1 {
			return Optional::Some(CliError(tag = "cli-invalid-schema", arg = "", message = "multiple positional must be last", index = k));
		}
		k = k + 1;
	}
	return Optional<CliError>::None();
}

fn _get_option_value(option_value_indices: &Array<Int>, option_values: &Array<String>, option_index: Int) nothrow -> Optional<&String> {
	var i = 0;
	while i < option_value_indices.len {
		if option_value_indices[i] == option_index {
			return Optional::Some(&option_values[i]);
		}
		i = i + 1;
	}
	return Optional<&String>::None();
}

implement ArgParser {
	/// Registers a boolean flag (no value).
	///
	/// **Parameters:**
	/// - `long` — long name without leading `--` (e.g. `"verbose"`).
	/// - `short` — single-character short name without leading `-`
	///   (e.g. `"v"`).  Empty string disables the short form.
	/// - `help` — one-line help text shown by `--help`.
	pub fn flag(self: &mut ArgParser, long: String, short: String, help: String) nothrow -> &mut ArgParser {
		self.option_longs.push(move long);
		self.option_shorts.push(move short);
		self.option_value_names.push("");
		self.option_helps.push(move help);
		self.option_required.push(false);
		self.option_kinds.push(OPTION_KIND_FLAG);
		return self;
	}

	/// Registers a string-valued option.
	///
	/// **Parameters:**
	/// - `long`, `short`, `help` — same shape as `flag`.
	/// - `value_name` — placeholder shown in `--help` (e.g. `"PATH"`).
	/// - `required` — when `true`, parsing fails if this option is
	///   absent.
	pub fn option_string(self: &mut ArgParser, long: String, short: String, value_name: String, help: String, required: Bool) nothrow -> &mut ArgParser {
		self.option_longs.push(move long);
		self.option_shorts.push(move short);
		self.option_value_names.push(move value_name);
		self.option_helps.push(move help);
		self.option_required.push(required);
		self.option_kinds.push(OPTION_KIND_STRING);
		return self;
	}

	/// Registers an integer-valued option.  Same shape as
	/// `option_string` but the parser validates the value as an
	/// `Int`; a non-integer value yields `CliError(tag = "invalid-int")`.
	pub fn option_int(self: &mut ArgParser, long: String, short: String, value_name: String, help: String, required: Bool) nothrow -> &mut ArgParser {
		self.option_longs.push(move long);
		self.option_shorts.push(move short);
		self.option_value_names.push(move value_name);
		self.option_helps.push(move help);
		self.option_required.push(required);
		self.option_kinds.push(OPTION_KIND_INT);
		return self;
	}

	/// Registers a positional argument.
	///
	/// **Parameters:**
	/// - `name` — display name (shown in `--help`).
	/// - `help` — one-line description.
	/// - `required` — when `true`, parsing fails if this position
	///   is absent.
	/// - `multiple` — when `true`, this positional consumes all
	///   remaining argv entries.  Only valid on the last
	///   registered positional.
	pub fn positional(self: &mut ArgParser, name: String, help: String, required: Bool, multiple: Bool) nothrow -> &mut ArgParser {
		self.pos_names.push(move name);
		self.pos_helps.push(move help);
		self.pos_required.push(required);
		self.pos_multiple.push(multiple);
		return self;
	}

	/// Generates a formatted help string for this parser, suitable
	/// for printing on `--help`.
	pub fn help_text(self: &ArgParser) nothrow -> String {
		var out = "Usage: " + self.app;
		if self.option_longs.len > 0 {
			out = out + " [OPTIONS]";
		}
		var i = 0;
		while i < self.pos_names.len {
			if self.pos_required[i] {
				if self.pos_multiple[i] {
					out = out + " <" + self.pos_names[i] + "...>";
				} else {
					out = out + " <" + self.pos_names[i] + ">";
				}
			} else {
				if self.pos_multiple[i] {
					out = out + " [" + self.pos_names[i] + "...]";
				} else {
					out = out + " [" + self.pos_names[i] + "]";
				}
			}
			i = i + 1;
		}
		out = out + "\n\n" + self.about + "\n";
		out = out + "\nOptions:\n";
		out = out + "  -h, --help     Show help\n";
		out = out + "  -V, --version  Show version\n";
		i = 0;
		while i < self.option_longs.len {
			var line = "  ";
			if self.option_shorts[i] != "" {
				line = line + "-" + self.option_shorts[i] + ", ";
			} else {
				line = line + "    ";
			}
			line = line + "--" + self.option_longs[i];
			if self.option_kinds[i] != OPTION_KIND_FLAG {
				line = line + " <" + self.option_value_names[i] + ">";
			}
			line = line + "  " + self.option_helps[i];
			if self.option_required[i] {
				line = line + " (required)";
			}
			out = out + line + "\n";
			i = i + 1;
		}
		return out;
	}

	/// Parses `argv` against the registered flags / options /
	/// positionals.
	///
	/// argv[0] is treated as the program name and skipped — pass
	/// `argv` unchanged from `main(argv)`.
	///
	/// **Returns:** `Ok(ParsedArgs)` on success.  `Err(CliError)`
	/// on malformed input; the special tag `"cli-help-requested"`
	/// is returned when `--help` / `-h` appears (callers usually
	/// treat this as exit-zero, not an error).
	///
	/// **See also:** `ParsedArgs`, `CliError`.
	pub fn parse(self: &ArgParser, argv: &Array<String>) nothrow -> core.Result<ParsedArgs, CliError> {
		match _validate_schema(self) {
			Some(e) => { return core.Result::Err(e); },
			None => { }
		}
		var flag_option_indices: Array<Int> = [];
		var option_value_indices: Array<Int> = [];
		var option_values: Array<String> = [];
		var positionals: Array<String> = [];
		var i = 1;
		var positional_mode = false;
		while i < argv.len {
			val tok = &argv[i];
			if not positional_mode and _string_eq_value(tok, "--") {
				positional_mode = true;
				i = i + 1;
				continue;
			}
			if not positional_mode and _string_eq_value(tok, "--help") {
				return _err("cli-help-requested", "", "help requested", i);
			}
			if not positional_mode and _string_eq_value(tok, "--version") {
				return _err("cli-version-requested", "", "version requested", i);
			}
			if not positional_mode and _string_eq_value(tok, "-h") {
				return _err("cli-help-requested", "", "help requested", i);
			}
			if not positional_mode and _string_eq_value(tok, "-V") {
				return _err("cli-version-requested", "", "version requested", i);
			}
			if not positional_mode and _starts_with_dash_dash(tok) and tok.byte_length() > 2 {
				val eq = _find_byte(tok, cast<Byte>(61));
				var long_name = "";
				var has_inline = false;
				var inline_value = "";
				if eq >= 0 {
					long_name = _slice_string(tok, 2, eq);
					inline_value = _slice_string(tok, eq + 1, tok.byte_length());
					has_inline = true;
				} else {
					long_name = _slice_string(tok, 2, tok.byte_length());
				}
				val idx = _find_option_by_long(&self.option_longs, &long_name);
				if idx < 0 {
					return _err("cli-unknown-option", "", "unknown option", i);
				}
				if self.option_kinds[idx] == OPTION_KIND_FLAG {
					if has_inline {
						return _err("cli-unexpected-option-value", "", "flag does not take a value", i);
					}
					if _is_seen(&flag_option_indices, &option_value_indices, idx) {
						return _err("cli-duplicate-option", "", "duplicate option", i);
					}
					flag_option_indices.push(idx);
					i = i + 1;
					continue;
				}
				var value = "";
				if has_inline {
					value = move inline_value;
				} else {
					if i + 1 >= argv.len {
						return _err("cli-missing-option-value", "", "missing option value", i);
					}
					value = _dup_string(&argv[i + 1]);
					i = i + 1;
				}
				if _is_seen(&flag_option_indices, &option_value_indices, idx) {
					return _err("cli-duplicate-option", "", "duplicate option", i);
				}
				if self.option_kinds[idx] == OPTION_KIND_INT {
					match parse_std.parse_int(value) {
						core.Result::Ok(_) => { },
						core.Result::Err(_) => { return _err("cli-invalid-int", "", "invalid integer option value", i); }
					}
				}
				option_value_indices.push(idx);
				option_values.push(move value);
				i = i + 1;
				continue;
			}
			if not positional_mode and _starts_with_dash(tok) and tok.byte_length() > 1 {
				if tok.byte_length() != 2 {
					return _err("cli-unsupported-short-cluster", "", "short option clusters are unsupported in MVP", i);
				}
				val short_name = _slice_string(tok, 1, 2);
				val idx = _find_option_by_short(&self.option_shorts, &short_name);
				if idx < 0 {
					return _err("cli-unknown-option", "", "unknown option", i);
				}
				if self.option_kinds[idx] == OPTION_KIND_FLAG {
					if _is_seen(&flag_option_indices, &option_value_indices, idx) {
						return _err("cli-duplicate-option", "", "duplicate option", i);
					}
					flag_option_indices.push(idx);
					i = i + 1;
					continue;
				}
				if i + 1 >= argv.len {
					return _err("cli-missing-option-value", "", "missing option value", i);
				}
				val value = _dup_string(&argv[i + 1]);
				if _is_seen(&flag_option_indices, &option_value_indices, idx) {
					return _err("cli-duplicate-option", "", "duplicate option", i);
				}
				if self.option_kinds[idx] == OPTION_KIND_INT {
					match parse_std.parse_int(value) {
						core.Result::Ok(_) => { },
						core.Result::Err(_) => { return _err("cli-invalid-int", "", "invalid integer option value", i + 1); }
					}
				}
				option_value_indices.push(idx);
				option_values.push(move value);
				i = i + 2;
				continue;
			}
				val pos = _dup_string(tok);
				positionals.push(move pos);
			i = i + 1;
		}
		i = 0;
		while i < self.option_longs.len {
			if self.option_required[i] and not _is_seen(&flag_option_indices, &option_value_indices, i) {
				return _err("cli-missing-required-option", "", "missing required option", argv.len);
			}
			i = i + 1;
		}
		var pi = 0;
		while pi < self.pos_names.len {
			if self.pos_multiple[pi] and pi != self.pos_names.len - 1 {
				return _err("cli-invalid-schema", "", "multiple positional must be last", pi);
			}
			if self.pos_required[pi] and positionals.len <= pi {
				return _err("cli-missing-required-positional", "", "missing required positional", argv.len);
			}
			pi = pi + 1;
		}
		if self.pos_names.len > 0 {
			if not self.pos_multiple[self.pos_names.len - 1] and positionals.len > self.pos_names.len {
				return _err("cli-unexpected-positional", "", "unexpected positional argument", self.pos_names.len + 1);
			}
		} else {
			if positionals.len > 0 {
				return _err("cli-unexpected-positional", "", "unexpected positional argument", 1);
			}
		}
		return core.Result::Ok(ParsedArgs(flag_option_indices = move flag_option_indices, option_value_indices = move option_value_indices, option_values = move option_values, positionals = move positionals));
	}
}

implement ParsedArgs {
	/// Returns `true` if the named flag was present in argv.
	///
	/// `parser` is the parser that produced these `ParsedArgs` —
	/// needed to look up the flag by long name.
	pub fn has_flag(self: &ParsedArgs, long: String, parser: &ArgParser) nothrow -> Bool {
		val idx = _find_option_by_long(&parser.option_longs, &long);
		if idx < 0 {
			return false;
		}
		return _contains_int(&self.flag_option_indices, idx);
	}

	/// Returns the value of a string-valued option, or `None` if
	/// absent.
	pub fn get_string(self: &ParsedArgs, long: String, parser: &ArgParser) nothrow -> Optional<&String> {
		val idx = _find_option_by_long(&parser.option_longs, &long);
		if idx < 0 {
			return Optional<&String>::None();
		}
		return _get_option_value(&self.option_value_indices, &self.option_values, idx);
	}

	/// Returns the value of an int-valued option, or `None` if
	/// absent.  Already validated as `Int` during `parse`.
	pub fn get_int(self: &ParsedArgs, long: String, parser: &ArgParser) nothrow -> Optional<Int> {
		val idx = _find_option_by_long(&parser.option_longs, &long);
		if idx < 0 {
			return Optional<Int>::None();
		}
		match _get_option_value(&self.option_value_indices, &self.option_values, idx) {
			Some(v) => {
				match parse_std.parse_int(_dup_string(v)) {
					core.Result::Ok(n) => { return Optional::Some(n); },
					core.Result::Err(_) => { return Optional<Int>::None(); }
				}
			},
			None => { return Optional<Int>::None(); }
		}
	}

	/// Returns the positional argument at index `idx` (0-based), or
	/// `None` if `idx` is out of range.
	pub fn positional_at(self: &ParsedArgs, idx: Int) nothrow -> Optional<&String> {
		if idx < 0 or idx >= self.positionals.len {
			return Optional<&String>::None();
		}
		return Optional::Some(&self.positionals[idx]);
	}

	/// Returns the number of positional arguments observed.
	pub fn positional_len(self: &ParsedArgs) nothrow -> Int {
		return self.positionals.len;
	}
}

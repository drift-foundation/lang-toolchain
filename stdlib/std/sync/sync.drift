module std.sync

import lang.atomic as atomic;
import std.core as core;

export {
	MemoryOrder,
	Handle,
	RefToken,
	AtomicHandle,
	AtomicRef,
	AtomicBool,
	AtomicInt,
	AtomicUint,
	AtomicUint64,
	MpscQueue,
	EpochDomain,
	EpochParticipant,
	handle,
	null_handle,
	ref_token,
	null_ref_token,
	atomic_bool,
	atomic_int,
	atomic_uint,
	atomic_uint64,
	mpsc_queue,
	atomic_handle,
	atomic_ref,
	thread_fence,
	signal_fence,
	epoch_domain,
	epoch_participant,
	epoch_enter,
	epoch_leave,
	epoch_retire,
	epoch_try_advance,
	epoch_current,
	epoch_pending,
	epoch_reclaimed
};

pub type MemoryOrder = atomic.MemoryOrder;

pub struct AtomicBool {
	inner: atomic.AtomicBool
}

pub struct AtomicInt {
	inner: atomic.AtomicInt
}

pub struct AtomicUint {
	inner: atomic.AtomicUint
}

pub struct AtomicUint64 {
	inner: atomic.AtomicUint64
}

pub struct Handle<T> {
	raw: Uint
}

pub struct AtomicHandle<T> {
	inner: atomic.AtomicUint
}

pub struct RefToken<T> {
	inner: Handle<T>
}

pub struct AtomicRef<T> {
	inner: AtomicHandle<T>
}

pub struct MpscQueue<T> {
	cap: Uint,
	head: atomic.AtomicUint,
	tail: atomic.AtomicUint,
	slots: Array<AtomicHandle<T>>,
	states: Array<atomic.AtomicUint>
}

pub struct EpochDomain {
	current: atomic.AtomicUint,
	active: atomic.AtomicUint,
	pending: atomic.AtomicUint,
	reclaimed: atomic.AtomicUint
}

pub struct EpochParticipant {
	active: Bool,
	epoch: Uint
}

pub fn atomic_bool(v: Bool) nothrow -> AtomicBool {
	return AtomicBool(inner = atomic.atomic_bool(v));
}

pub fn atomic_int(v: Int) nothrow -> AtomicInt {
	return AtomicInt(inner = atomic.atomic_int(v));
}

pub fn atomic_uint(v: Uint) nothrow -> AtomicUint {
	return AtomicUint(inner = atomic.atomic_uint(v));
}

pub fn atomic_uint64(v: Uint64) nothrow -> AtomicUint64 {
	return AtomicUint64(inner = atomic.atomic_uint64(v));
}

pub fn handle<T>(raw: Uint) nothrow -> Handle<T> {
	return Handle<type T>(raw = raw);
}

pub fn null_handle<T>() nothrow -> Handle<T> {
	return Handle<type T>(raw = cast<Uint>(0));
}

pub fn atomic_handle<T>(v: Handle<T>) nothrow -> AtomicHandle<T> {
	val x = atomic.atomic_uint(v.raw);
	return AtomicHandle<type T>(inner = x);
}

pub fn ref_token<T>(raw: Uint) nothrow -> RefToken<T> {
	val h = handle<type T>(raw);
	return RefToken<type T>(inner = h);
}

pub fn null_ref_token<T>() nothrow -> RefToken<T> {
	val h = null_handle<type T>();
	return RefToken<type T>(inner = h);
}

pub fn atomic_ref<T>(v: RefToken<T>) nothrow -> AtomicRef<T> {
	val a = atomic_handle<type T>(v.inner);
	return AtomicRef<type T>(inner = a);
}

pub fn mpsc_queue<T>(capacity: Int) nothrow -> MpscQueue<T> {
	var cap = capacity;
	if cap < 2 {
		cap = 2;
	}
	var slots: Array<AtomicHandle<T>> = [];
	var states: Array<atomic.AtomicUint> = [];
	var i = 0;
	while i < cap {
		var slot = atomic_handle<type T>(null_handle<type T>());
		slots.push(move slot);
		var st = atomic.atomic_uint(cast<Uint>(i));
		states.push(move st);
		i = i + 1;
	}
	return MpscQueue(cast<Uint>(cap), atomic.atomic_uint(cast<Uint>(0)), atomic.atomic_uint(cast<Uint>(0)), move slots, move states);
}

pub fn thread_fence(order: MemoryOrder) nothrow -> Void {
	atomic.thread_fence(order);
	return;
}

pub fn signal_fence(order: MemoryOrder) nothrow -> Void {
	atomic.signal_fence(order);
	return;
}

fn _ord_relaxed() nothrow -> Int { return 0; }
fn _ord_acquire() nothrow -> Int { return 1; }
fn _ord_release() nothrow -> Int { return 2; }
fn _ord_acqrel() nothrow -> Int { return 3; }

pub fn epoch_domain() nothrow -> EpochDomain {
	return EpochDomain(current = atomic.atomic_uint(cast<Uint>(0)), active = atomic.atomic_uint(cast<Uint>(0)), pending = atomic.atomic_uint(cast<Uint>(0)), reclaimed = atomic.atomic_uint(cast<Uint>(0)));
}

pub fn epoch_participant() nothrow -> EpochParticipant {
	return EpochParticipant(active = false, epoch = cast<Uint>(0));
}

pub fn epoch_enter(d: &EpochDomain, p: &mut EpochParticipant) nothrow -> Void {
	if p.active {
		return;
	}
	val cur = atomic.atomic_load_uint(&d.current, _ord_acquire());
	p.active = true;
	p.epoch = cur;
	val _ = atomic.atomic_fetch_add_uint(&d.active, cast<Uint>(1), _ord_acqrel());
	return;
}

pub fn epoch_leave(d: &EpochDomain, p: &mut EpochParticipant) nothrow -> Void {
	if not p.active {
		return;
	}
	p.active = false;
	val _ = atomic.atomic_fetch_sub_uint(&d.active, cast<Uint>(1), _ord_acqrel());
	return;
}

pub fn epoch_retire(d: &EpochDomain, p: &EpochParticipant) nothrow -> Void {
	if p.active and p.epoch > atomic.atomic_load_uint(&d.current, _ord_acquire()) {
		return;
	}
	val _ = atomic.atomic_fetch_add_uint(&d.pending, cast<Uint>(1), _ord_acqrel());
	return;
}

pub fn epoch_try_advance(d: &EpochDomain) nothrow -> Int {
	if atomic.atomic_load_uint(&d.active, _ord_acquire()) != cast<Uint>(0) {
		return 0;
	}
	val _ = atomic.atomic_fetch_add_uint(&d.current, cast<Uint>(1), _ord_acqrel());
	val reclaim = atomic.atomic_exchange_uint(&d.pending, cast<Uint>(0), _ord_acqrel());
	if reclaim != cast<Uint>(0) {
		val _ = atomic.atomic_fetch_add_uint(&d.reclaimed, reclaim, _ord_acqrel());
	}
	return cast<Int>(reclaim);
}

pub fn epoch_current(d: &EpochDomain) nothrow -> Uint {
	return atomic.atomic_load_uint(&d.current, _ord_acquire());
}

pub fn epoch_pending(d: &EpochDomain) nothrow -> Uint {
	return atomic.atomic_load_uint(&d.pending, _ord_acquire());
}

pub fn epoch_reclaimed(d: &EpochDomain) nothrow -> Uint {
	return atomic.atomic_load_uint(&d.reclaimed, _ord_acquire());
}

implement<T> core.Copy for Handle<T> {
}

implement<T> Handle<T> {
	pub fn to_uint(self: &Handle<T>) nothrow -> Uint {
		return self.raw;
	}

	pub fn is_null(self: &Handle<T>) nothrow -> Bool {
		return self.raw == cast<Uint>(0);
	}
}

implement<T> core.Copy for RefToken<T> {
}

implement<T> RefToken<T> {
	pub fn to_uint(self: &RefToken<T>) nothrow -> Uint {
		return self.inner.raw;
	}

	pub fn is_null(self: &RefToken<T>) nothrow -> Bool {
		return self.inner.is_null();
	}
}

implement AtomicBool {
	pub fn load(self: &AtomicBool, order: MemoryOrder) nothrow -> Bool {
		return self.inner.load(order);
	}

	pub fn store(self: &AtomicBool, v: Bool, order: MemoryOrder) nothrow -> Void {
		self.inner.store(v, order);
		return;
	}

	pub fn exchange(self: &AtomicBool, v: Bool, order: MemoryOrder) nothrow -> Bool {
		return self.inner.exchange(v, order);
	}

	pub fn compare_exchange(self: &AtomicBool, expected: Bool, desired: Bool, success_order: MemoryOrder, failure_order: MemoryOrder) nothrow -> Bool {
		return self.inner.compare_exchange(expected, desired, success_order, failure_order);
	}

	pub fn compare_exchange_observed(self: &AtomicBool, expected: Bool, desired: Bool, success_order: MemoryOrder, failure_order: MemoryOrder) nothrow -> Bool {
		return self.inner.compare_exchange_observed(expected, desired, success_order, failure_order);
	}
}


implement<T> AtomicHandle<T> {
	/// `Handle<T>` form of `AtomicBool.load`.
	pub fn load(self: &AtomicHandle<T>, order: MemoryOrder) nothrow -> Handle<T> {
		val raw = self.inner.load(order);
		return Handle<type T>(raw = raw);
	}

	/// `Handle<T>` form of `AtomicBool.store`.
	pub fn store(self: &AtomicHandle<T>, v: Handle<T>, order: MemoryOrder) nothrow -> Void {
		self.inner.store(v.raw, order);
		return;
	}

	/// `Handle<T>` form of `AtomicBool.exchange`.
	pub fn exchange(self: &AtomicHandle<T>, v: Handle<T>, order: MemoryOrder) nothrow -> Handle<T> {
		val raw = self.inner.exchange(v.raw, order);
		return Handle<type T>(raw = raw);
	}

	/// `Handle<T>` form of `AtomicBool.compare_exchange`.
	pub fn compare_exchange(self: &AtomicHandle<T>, expected: Handle<T>, desired: Handle<T>, success_order: MemoryOrder, failure_order: MemoryOrder) nothrow -> Bool {
		return self.inner.compare_exchange(expected.raw, desired.raw, success_order, failure_order);
	}

	/// `Handle<T>` form of `AtomicBool.compare_exchange_observed`.
	pub fn compare_exchange_observed(self: &AtomicHandle<T>, expected: Handle<T>, desired: Handle<T>, success_order: MemoryOrder, failure_order: MemoryOrder) nothrow -> Handle<T> {
		val raw = self.inner.compare_exchange_observed(expected.raw, desired.raw, success_order, failure_order);
		return Handle<type T>(raw = raw);
	}
}

implement<T> MpscQueue<T> {
	/// Returns the queue's slot capacity.
	pub fn capacity(self: &MpscQueue<T>) nothrow -> Int {
		return cast<Int>(self.cap);
	}

	/// Appends `v` to the queue.
	///
	/// Safe to call concurrently from multiple producer threads.
	/// Uses bounded compare-exchange retries; never blocks.
	///
	/// **Returns:** `true` if the value was enqueued; `false` if the
	/// queue was observed full at the time of the call (the consumer
	/// is behind).
	///
	/// **See also:** `MpscQueue.pop`.
	pub fn push(self: &MpscQueue<T>, v: Handle<T>) nothrow -> Bool {
		var pos = atomic.atomic_load_uint(&self.tail, _ord_relaxed());
		while true {
			val idx = cast<Int>(pos % self.cap);
			val seq = atomic.atomic_load_uint(&self.states[idx], _ord_acquire());
			if seq == pos {
				val observed = atomic.atomic_compare_exchange_observed_uint(&self.tail, pos, pos + cast<Uint>(1), _ord_acqrel(), _ord_acquire());
				if observed == pos {
					atomic.atomic_store_uint(&self.slots[idx].inner, v.raw, _ord_relaxed());
					atomic.atomic_store_uint(&self.states[idx], pos + cast<Uint>(1), _ord_release());
					return true;
				}
				pos = observed;
				continue;
			}
			if seq < pos {
				return false;
			}
			pos = atomic.atomic_load_uint(&self.tail, _ord_acquire());
		}
		return false;
	}

	/// Removes and returns the next value from the queue.
	///
	/// Safe to call only from a single consumer thread.  Returns
	/// `None` if the queue is empty.
	///
	/// **See also:** `MpscQueue.push`.
	pub fn pop(self: &MpscQueue<T>) nothrow -> Optional<Handle<T>> {
		var pos = atomic.atomic_load_uint(&self.head, _ord_relaxed());
		while true {
			val idx = cast<Int>(pos % self.cap);
			val seq = atomic.atomic_load_uint(&self.states[idx], _ord_acquire());
			val ready = pos + cast<Uint>(1);
			if seq == ready {
				val observed = atomic.atomic_compare_exchange_observed_uint(&self.head, pos, ready, _ord_acqrel(), _ord_acquire());
				if observed == pos {
					val old_raw = atomic.atomic_exchange_uint(&self.slots[idx].inner, cast<Uint>(0), _ord_relaxed());
					atomic.atomic_store_uint(&self.states[idx], pos + self.cap, _ord_release());
					return Optional::Some(handle<type T>(old_raw));
				}
				pos = observed;
				continue;
			}
			if seq < ready {
				return Optional::None();
			}
			pos = atomic.atomic_load_uint(&self.head, _ord_acquire());
		}
		return Optional::None();
	}
}

implement<T> AtomicRef<T> {
	/// `RefToken<T>` form of `AtomicBool.load`.
	pub fn load(self: &AtomicRef<T>, order: MemoryOrder) nothrow -> RefToken<T> {
		val h = self.inner.load(order);
		return RefToken<type T>(inner = h);
	}

	/// `RefToken<T>` form of `AtomicBool.store`.
	pub fn store(self: &AtomicRef<T>, v: RefToken<T>, order: MemoryOrder) nothrow -> Void {
		self.inner.store(v.inner, order);
		return;
	}

	/// `RefToken<T>` form of `AtomicBool.exchange`.
	pub fn exchange(self: &AtomicRef<T>, v: RefToken<T>, order: MemoryOrder) nothrow -> RefToken<T> {
		val h = self.inner.exchange(v.inner, order);
		return RefToken<type T>(inner = h);
	}

	/// `RefToken<T>` form of `AtomicBool.compare_exchange`.
	pub fn compare_exchange(self: &AtomicRef<T>, expected: RefToken<T>, desired: RefToken<T>, success_order: MemoryOrder, failure_order: MemoryOrder) nothrow -> Bool {
		return self.inner.compare_exchange(expected.inner, desired.inner, success_order, failure_order);
	}

	/// `RefToken<T>` form of `AtomicBool.compare_exchange_observed`.
	pub fn compare_exchange_observed(self: &AtomicRef<T>, expected: RefToken<T>, desired: RefToken<T>, success_order: MemoryOrder, failure_order: MemoryOrder) nothrow -> RefToken<T> {
		val h = self.inner.compare_exchange_observed(expected.inner, desired.inner, success_order, failure_order);
		return RefToken<type T>(inner = h);
	}
}

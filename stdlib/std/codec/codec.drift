module std.codec;

import std.core as core;
import std.io as io;

export {
	CodecError,
	HexDecoder,
	Base64Decoder,
	Base32Decoder,
	hex_encode,
	hex_decode,
	hex_decoder,
	base64_encode,
	base64_decode,
	base64_decoder,
	base64url_encode,
	base64url_decode,
	base32_encode,
	base32_decode,
	base32_decoder
};

/// Error returned by failable codec decoders.
///
/// `tag` is a stable machine-readable code (e.g. `"odd-length"`,
/// `"invalid-char"`, `"bad-padding"`).  `offset` is the zero-based
/// byte position in the input where the decoder gave up.
///
/// `CodecError` implements `core.Throw` and `core.Diagnostic`.
pub struct CodecError {
	pub tag: String,
	pub offset: Int
}

/// Configurable hex (base-16) decoder.
///
/// Constructed via `hex_decoder()` with strict defaults
/// (no whitespace, no `0x` prefix).  Use `.allow_whitespace(true)`
/// to skip ASCII whitespace between hex digits and
/// `.allow_prefix_0x(true)` to accept a leading `0x` / `0X`.  Call
/// `.decode(s)` to decode.
///
/// **See also:** `hex_decoder`, `hex_encode`, `hex_decode`.
pub struct HexDecoder {
	allow_whitespace: Bool,
	allow_prefix_0x: Bool
}

/// Configurable base64 decoder.
///
/// Strict defaults (no whitespace, standard alphabet only).  Use
/// `.allow_whitespace(true)` to skip ASCII whitespace and
/// `.allow_url_safe(true)` to accept the URL-safe alphabet
/// (`-` and `_` in place of `+` and `/`).
///
/// **See also:** `base64_decoder`, `base64_encode`, `base64_decode`,
/// `base64url_decode`.
pub struct Base64Decoder {
	allow_whitespace: Bool,
	allow_url_safe: Bool
}

/// Configurable base32 decoder.
///
/// Strict defaults (no whitespace, uppercase RFC 4648 alphabet
/// only).  Use `.allow_whitespace(true)` to skip ASCII whitespace
/// and `.allow_lowercase(true)` to accept lowercase letters
/// (mapped to their uppercase equivalents).
///
/// **See also:** `base32_decoder`, `base32_encode`, `base32_decode`.
pub struct Base32Decoder {
	allow_whitespace: Bool,
	allow_lowercase: Bool
}

implement core.Diagnostic for CodecError {
	pub fn to_json_text(self: &CodecError) nothrow -> String {
		return core.diagnostic_json_string(&self.tag);
	}
}

implement core.Throw for CodecError {
	pub fn throw_self(self: CodecError) throws {
		throw std.err:ResultError(dv = DiagnosticValue::String(self.tag));
	}
}

/// Constructs a strict-default `HexDecoder` (no whitespace, no `0x`
/// prefix).
pub fn hex_decoder() nothrow -> HexDecoder {
	return HexDecoder(allow_whitespace = false, allow_prefix_0x = false);
}

/// Constructs a strict-default `Base64Decoder` (no whitespace,
/// standard alphabet only).
pub fn base64_decoder() nothrow -> Base64Decoder {
	return Base64Decoder(allow_whitespace = false, allow_url_safe = false);
}

/// Constructs a strict-default `Base32Decoder` (no whitespace,
/// uppercase only).
pub fn base32_decoder() nothrow -> Base32Decoder {
	return Base32Decoder(allow_whitespace = false, allow_lowercase = false);
}

implement HexDecoder {
	/// Allows / disallows ASCII whitespace between hex digits.
	pub fn allow_whitespace(self: &mut HexDecoder, flag: Bool) nothrow -> &mut HexDecoder {
		self.allow_whitespace = flag;
		return self;
	}

	/// Allows / disallows a leading `0x` or `0X` prefix on the input.
	pub fn allow_prefix_0x(self: &mut HexDecoder, flag: Bool) nothrow -> &mut HexDecoder {
		self.allow_prefix_0x = flag;
		return self;
	}

	/// Decodes `s` to bytes per the configured rules.
	///
	/// **Returns:** `Ok(bytes)` on success; `Err(CodecError)` on
	/// invalid input.
	pub fn decode(self: &HexDecoder, s: &String) nothrow -> core.Result<Array<Byte>, CodecError> {
		return _hex_decode_impl(s, self.allow_whitespace, self.allow_prefix_0x);
	}
}

implement Base64Decoder {
	/// Allows / disallows ASCII whitespace in the input.
	pub fn allow_whitespace(self: &mut Base64Decoder, flag: Bool) nothrow -> &mut Base64Decoder {
		self.allow_whitespace = flag;
		return self;
	}

	/// Allows / disallows the URL-safe alphabet (`-` / `_`).
	pub fn allow_url_safe(self: &mut Base64Decoder, flag: Bool) nothrow -> &mut Base64Decoder {
		self.allow_url_safe = flag;
		return self;
	}

	/// Decodes `s` to bytes per the configured rules.
	///
	/// **Returns:** `Ok(bytes)` on success; `Err(CodecError)` on
	/// invalid input.
	pub fn decode(self: &Base64Decoder, s: &String) nothrow -> core.Result<Array<Byte>, CodecError> {
		return _base64_decode_impl(s, self.allow_whitespace, self.allow_url_safe);
	}
}

implement Base32Decoder {
	/// Allows / disallows ASCII whitespace in the input.
	pub fn allow_whitespace(self: &mut Base32Decoder, flag: Bool) nothrow -> &mut Base32Decoder {
		self.allow_whitespace = flag;
		return self;
	}

	/// Allows / disallows lowercase letters (case-folded to
	/// uppercase per RFC 4648).
	pub fn allow_lowercase(self: &mut Base32Decoder, flag: Bool) nothrow -> &mut Base32Decoder {
		self.allow_lowercase = flag;
		return self;
	}

	/// Decodes `s` to bytes per the configured rules.
	///
	/// **Returns:** `Ok(bytes)` on success; `Err(CodecError)` on
	/// invalid input.
	pub fn decode(self: &Base32Decoder, s: &String) nothrow -> core.Result<Array<Byte>, CodecError> {
		return _base32_decode_impl(s, self.allow_whitespace, self.allow_lowercase);
	}
}

/// Encodes `bytes` to a lowercase hex string (no `0x` prefix).
///
/// **See also:** `hex_decode`, `HexDecoder`.
pub fn hex_encode(bytes: &Array<Byte>) nothrow -> String {
	val n = bytes.len;
	if n <= 0 {
		return "";
	}
	var out = io.buffer(n * 2);
	var i = 0;
	while i < n {
		val u = _byte_u8(bytes[i]);
		val hi = (u / 16) % 16;
		val lo = u % 16;
		io.buffer_write(&mut out, i * 2, _hex_digit_byte(hi));
		io.buffer_write(&mut out, i * 2 + 1, _hex_digit_byte(lo));
		i = i + 1;
	}
	return core.string_from_utf8_bytes(io.buffer_ptr(&out), n * 2);
}

/// Strict hex decode of `s` (no whitespace, no `0x` prefix).
///
/// Use `hex_decoder()` to obtain a decoder with relaxed
/// configuration knobs.
///
/// **Returns:** `Ok(bytes)` on success; `Err(CodecError)` on
/// odd-length, invalid-character, or other malformed input.
///
/// **See also:** `HexDecoder`, `hex_encode`.
pub fn hex_decode(s: &String) nothrow -> core.Result<Array<Byte>, CodecError> {
	return _hex_decode_impl(s, false, false);
}

/// Encodes `bytes` to a standard base64 string with `=` padding.
///
/// **See also:** `base64_decode`, `base64url_encode`.
pub fn base64_encode(bytes: &Array<Byte>) nothrow -> String {
	val n = bytes.len;
	if n <= 0 {
		return "";
	}
	val out_len = ((n + 2) / 3) * 4;
	var out = io.buffer(out_len);
	var i = 0;
	var o = 0;
	while i < n {
		val b0 = _byte_u8(bytes[i]);
		var b1 = 0;
		var b2 = 0;
		var rem = n - i;
		if rem > 1 {
			b1 = _byte_u8(bytes[i + 1]);
		}
		if rem > 2 {
			b2 = _byte_u8(bytes[i + 2]);
		}
		val c0 = (b0 / 4) % 64;
		val c1 = ((b0 % 4) * 16 + (b1 / 16)) % 64;
		val c2 = ((b1 % 16) * 4 + (b2 / 64)) % 64;
		val c3 = b2 % 64;
		io.buffer_write(&mut out, o, _b64_alphabet_byte(c0));
		io.buffer_write(&mut out, o + 1, _b64_alphabet_byte(c1));
		if rem > 1 {
			io.buffer_write(&mut out, o + 2, _b64_alphabet_byte(c2));
		} else {
			io.buffer_write(&mut out, o + 2, cast<Byte>(61));
		}
		if rem > 2 {
			io.buffer_write(&mut out, o + 3, _b64_alphabet_byte(c3));
		} else {
			io.buffer_write(&mut out, o + 3, cast<Byte>(61));
		}
		i = i + 3;
		o = o + 4;
	}
	return core.string_from_utf8_bytes(io.buffer_ptr(&out), out_len);
}

/// Strict base64 decode of `s` (no whitespace, standard alphabet
/// only).
///
/// Use `base64_decoder()` to obtain a decoder with relaxed
/// configuration knobs.
///
/// **Returns:** `Ok(bytes)` on success; `Err(CodecError)` on
/// invalid input.
///
/// **See also:** `Base64Decoder`, `base64_encode`,
/// `base64url_decode`.
pub fn base64_decode(s: &String) nothrow -> core.Result<Array<Byte>, CodecError> {
	return _base64_decode_impl(s, false, false);
}

/// Encodes `bytes` to an RFC 4648 base32 string with `=` padding
/// and uppercase alphabet.
///
/// **See also:** `base32_decode`.
pub fn base32_encode(bytes: &Array<Byte>) nothrow -> String {
	val n = bytes.len;
	if n <= 0 {
		return "";
	}
	val out_len = ((n + 4) / 5) * 8;
	var out = io.buffer(out_len);
	var i = 0;
	var o = 0;
	while i < n {
		var b0 = 0;
		var b1 = 0;
		var b2 = 0;
		var b3 = 0;
		var b4 = 0;
		val rem = n - i;
		b0 = _byte_u8(bytes[i]);
		if rem > 1 { b1 = _byte_u8(bytes[i + 1]); }
		if rem > 2 { b2 = _byte_u8(bytes[i + 2]); }
		if rem > 3 { b3 = _byte_u8(bytes[i + 3]); }
		if rem > 4 { b4 = _byte_u8(bytes[i + 4]); }
		val c0 = (b0 / 8) % 32;
		val c1 = ((b0 % 8) * 4 + (b1 / 64)) % 32;
		val c2 = (b1 / 2) % 32;
		val c3 = ((b1 % 2) * 16 + (b2 / 16)) % 32;
		val c4 = ((b2 % 16) * 2 + (b3 / 128)) % 32;
		val c5 = (b3 / 4) % 32;
		val c6 = ((b3 % 4) * 8 + (b4 / 32)) % 32;
		val c7 = b4 % 32;
		io.buffer_write(&mut out, o, _b32_alphabet_byte(c0));
		io.buffer_write(&mut out, o + 1, _b32_alphabet_byte(c1));
		if rem == 1 {
			io.buffer_write(&mut out, o + 2, cast<Byte>(61));
			io.buffer_write(&mut out, o + 3, cast<Byte>(61));
			io.buffer_write(&mut out, o + 4, cast<Byte>(61));
			io.buffer_write(&mut out, o + 5, cast<Byte>(61));
			io.buffer_write(&mut out, o + 6, cast<Byte>(61));
			io.buffer_write(&mut out, o + 7, cast<Byte>(61));
		} else {
			if rem == 2 {
				io.buffer_write(&mut out, o + 2, _b32_alphabet_byte(c2));
				io.buffer_write(&mut out, o + 3, _b32_alphabet_byte(c3));
				io.buffer_write(&mut out, o + 4, cast<Byte>(61));
				io.buffer_write(&mut out, o + 5, cast<Byte>(61));
				io.buffer_write(&mut out, o + 6, cast<Byte>(61));
				io.buffer_write(&mut out, o + 7, cast<Byte>(61));
			} else {
				if rem == 3 {
					io.buffer_write(&mut out, o + 2, _b32_alphabet_byte(c2));
					io.buffer_write(&mut out, o + 3, _b32_alphabet_byte(c3));
					io.buffer_write(&mut out, o + 4, _b32_alphabet_byte(c4));
					io.buffer_write(&mut out, o + 5, cast<Byte>(61));
					io.buffer_write(&mut out, o + 6, cast<Byte>(61));
					io.buffer_write(&mut out, o + 7, cast<Byte>(61));
				} else {
					if rem == 4 {
						io.buffer_write(&mut out, o + 2, _b32_alphabet_byte(c2));
						io.buffer_write(&mut out, o + 3, _b32_alphabet_byte(c3));
						io.buffer_write(&mut out, o + 4, _b32_alphabet_byte(c4));
						io.buffer_write(&mut out, o + 5, _b32_alphabet_byte(c5));
						io.buffer_write(&mut out, o + 6, _b32_alphabet_byte(c6));
						io.buffer_write(&mut out, o + 7, cast<Byte>(61));
					} else {
						io.buffer_write(&mut out, o + 2, _b32_alphabet_byte(c2));
						io.buffer_write(&mut out, o + 3, _b32_alphabet_byte(c3));
						io.buffer_write(&mut out, o + 4, _b32_alphabet_byte(c4));
						io.buffer_write(&mut out, o + 5, _b32_alphabet_byte(c5));
						io.buffer_write(&mut out, o + 6, _b32_alphabet_byte(c6));
						io.buffer_write(&mut out, o + 7, _b32_alphabet_byte(c7));
					}
				}
			}
		}
		i = i + 5;
		o = o + 8;
	}
	return core.string_from_utf8_bytes(io.buffer_ptr(&out), out_len);
}

/// Strict base32 decode of `s` (no whitespace, uppercase only).
///
/// Use `base32_decoder()` for a decoder with relaxed knobs.
///
/// **Returns:** `Ok(bytes)` on success; `Err(CodecError)` on
/// invalid input.
///
/// **See also:** `Base32Decoder`, `base32_encode`.
pub fn base32_decode(s: &String) nothrow -> core.Result<Array<Byte>, CodecError> {
	return _base32_decode_impl(s, false, false);
}

/// Encodes `bytes` to a URL-safe base64 string.
///
/// Uses the `-` / `_` alphabet (no `+` / `/`) and omits `=`
/// padding — safe for use in URLs and filenames.
///
/// **See also:** `base64url_decode`, `base64_encode`.
pub fn base64url_encode(bytes: &Array<Byte>) nothrow -> String {
	val n = bytes.len;
	if n <= 0 {
		return "";
	}
	val full_groups = n / 3;
	val rem = n % 3;
	var out_len = full_groups * 4;
	if rem == 1 {
		out_len = out_len + 2;
	}
	if rem == 2 {
		out_len = out_len + 3;
	}
	var out = io.buffer(out_len);
	var i = 0;
	var o = 0;
	while i + 2 < n {
		val b0 = _byte_u8(bytes[i]);
		val b1 = _byte_u8(bytes[i + 1]);
		val b2 = _byte_u8(bytes[i + 2]);
		val c0 = (b0 / 4) % 64;
		val c1 = ((b0 % 4) * 16 + (b1 / 16)) % 64;
		val c2 = ((b1 % 16) * 4 + (b2 / 64)) % 64;
		val c3 = b2 % 64;
		io.buffer_write(&mut out, o, _b64url_alphabet_byte(c0));
		io.buffer_write(&mut out, o + 1, _b64url_alphabet_byte(c1));
		io.buffer_write(&mut out, o + 2, _b64url_alphabet_byte(c2));
		io.buffer_write(&mut out, o + 3, _b64url_alphabet_byte(c3));
		i = i + 3;
		o = o + 4;
	}
	if rem == 1 {
		val b0 = _byte_u8(bytes[i]);
		val c0 = (b0 / 4) % 64;
		val c1 = ((b0 % 4) * 16) % 64;
		io.buffer_write(&mut out, o, _b64url_alphabet_byte(c0));
		io.buffer_write(&mut out, o + 1, _b64url_alphabet_byte(c1));
	}
	if rem == 2 {
		val b0 = _byte_u8(bytes[i]);
		val b1 = _byte_u8(bytes[i + 1]);
		val c0 = (b0 / 4) % 64;
		val c1 = ((b0 % 4) * 16 + (b1 / 16)) % 64;
		val c2 = ((b1 % 16) * 4) % 64;
		io.buffer_write(&mut out, o, _b64url_alphabet_byte(c0));
		io.buffer_write(&mut out, o + 1, _b64url_alphabet_byte(c1));
		io.buffer_write(&mut out, o + 2, _b64url_alphabet_byte(c2));
	}
	return core.string_from_utf8_bytes(io.buffer_ptr(&out), out_len);
}

/// Decodes a URL-safe base64 string `s` to bytes.
///
/// Accepts both the URL-safe (`-` / `_`) and standard (`+` / `/`)
/// alphabets, and tolerates missing `=` padding.
///
/// **Returns:** `Ok(bytes)` on success; `Err(CodecError)` on
/// invalid input.
///
/// **See also:** `base64url_encode`, `base64_decode`.
pub fn base64url_decode(s: &String) nothrow -> core.Result<Array<Byte>, CodecError> {
	val n = s.byte_length();
	if n == 0 {
		var empty: Array<Byte> = [];
		return core.Result::Ok(move empty);
	}
	if n % 4 == 1 {
		return core.Result::Err(CodecError(tag = "base64url-invalid-length", offset = n));
	}
	var out: Array<Byte> = [];
	var i = 0;
	while i + 3 < n {
		val b0 = core.string_byte_at(s, i);
		val b1 = core.string_byte_at(s, i + 1);
		val b2 = core.string_byte_at(s, i + 2);
		val b3 = core.string_byte_at(s, i + 3);
		if _byte_u8(b0) == 61 {
			return core.Result::Err(CodecError(tag = "base64url-padding-rejected", offset = i));
		}
		if _byte_u8(b1) == 61 {
			return core.Result::Err(CodecError(tag = "base64url-padding-rejected", offset = i + 1));
		}
		if _byte_u8(b2) == 61 {
			return core.Result::Err(CodecError(tag = "base64url-padding-rejected", offset = i + 2));
		}
		if _byte_u8(b3) == 61 {
			return core.Result::Err(CodecError(tag = "base64url-padding-rejected", offset = i + 3));
		}
		val v0 = _b64url_value(b0);
		val v1 = _b64url_value(b1);
		val v2 = _b64url_value(b2);
		val v3 = _b64url_value(b3);
		if v0 == -1 {
			return core.Result::Err(CodecError(tag = "base64url-invalid-char", offset = i));
		}
		if v1 == -1 {
			return core.Result::Err(CodecError(tag = "base64url-invalid-char", offset = i + 1));
		}
		if v2 == -1 {
			return core.Result::Err(CodecError(tag = "base64url-invalid-char", offset = i + 2));
		}
		if v3 == -1 {
			return core.Result::Err(CodecError(tag = "base64url-invalid-char", offset = i + 3));
		}
		val o0 = (v0 * 4 + (v1 / 16)) % 256;
		val o1 = ((v1 % 16) * 16 + (v2 / 4)) % 256;
		val o2 = ((v2 % 4) * 64 + v3) % 256;
		out.push(cast<Byte>(o0));
		out.push(cast<Byte>(o1));
		out.push(cast<Byte>(o2));
		i = i + 4;
	}
	val tail = n - i;
	if tail == 2 {
		val b0 = core.string_byte_at(s, i);
		val b1 = core.string_byte_at(s, i + 1);
		if _byte_u8(b0) == 61 {
			return core.Result::Err(CodecError(tag = "base64url-padding-rejected", offset = i));
		}
		if _byte_u8(b1) == 61 {
			return core.Result::Err(CodecError(tag = "base64url-padding-rejected", offset = i + 1));
		}
		val v0 = _b64url_value(b0);
		val v1 = _b64url_value(b1);
		if v0 == -1 {
			return core.Result::Err(CodecError(tag = "base64url-invalid-char", offset = i));
		}
		if v1 == -1 {
			return core.Result::Err(CodecError(tag = "base64url-invalid-char", offset = i + 1));
		}
		if v1 % 16 != 0 {
			return core.Result::Err(CodecError(tag = "base64url-non-canonical", offset = i + 1));
		}
		val o0 = (v0 * 4 + (v1 / 16)) % 256;
		out.push(cast<Byte>(o0));
	}
	if tail == 3 {
		val b0 = core.string_byte_at(s, i);
		val b1 = core.string_byte_at(s, i + 1);
		val b2 = core.string_byte_at(s, i + 2);
		if _byte_u8(b0) == 61 {
			return core.Result::Err(CodecError(tag = "base64url-padding-rejected", offset = i));
		}
		if _byte_u8(b1) == 61 {
			return core.Result::Err(CodecError(tag = "base64url-padding-rejected", offset = i + 1));
		}
		if _byte_u8(b2) == 61 {
			return core.Result::Err(CodecError(tag = "base64url-padding-rejected", offset = i + 2));
		}
		val v0 = _b64url_value(b0);
		val v1 = _b64url_value(b1);
		val v2 = _b64url_value(b2);
		if v0 == -1 {
			return core.Result::Err(CodecError(tag = "base64url-invalid-char", offset = i));
		}
		if v1 == -1 {
			return core.Result::Err(CodecError(tag = "base64url-invalid-char", offset = i + 1));
		}
		if v2 == -1 {
			return core.Result::Err(CodecError(tag = "base64url-invalid-char", offset = i + 2));
		}
		if v2 % 4 != 0 {
			return core.Result::Err(CodecError(tag = "base64url-non-canonical", offset = i + 2));
		}
		val o0 = (v0 * 4 + (v1 / 16)) % 256;
		val o1 = ((v1 % 16) * 16 + (v2 / 4)) % 256;
		out.push(cast<Byte>(o0));
		out.push(cast<Byte>(o1));
	}
	return core.Result::Ok(move out);
}

fn _hex_decode_impl(s: &String, allow_whitespace: Bool, allow_prefix_0x: Bool) nothrow -> core.Result<Array<Byte>, CodecError> {
	val n = s.byte_length();
	var start = 0;
	if allow_prefix_0x and n >= 2 {
		val b0 = core.string_byte_at(s, 0);
		val b1 = core.string_byte_at(s, 1);
		if b0 == cast<Byte>(48) and (b1 == cast<Byte>(120) or b1 == cast<Byte>(88)) {
			start = 2;
		}
	}
	var clean: Array<Byte> = [];
	var pos: Array<Int> = [];
	var i = start;
	while i < n {
		val b = core.string_byte_at(s, i);
		if allow_whitespace and _is_ascii_whitespace(b) {
			i = i + 1;
			continue;
		}
		clean.push(b);
		pos.push(i);
		i = i + 1;
	}
	if clean.len % 2 != 0 {
		return core.Result::Err(CodecError(tag = "hex-odd-length", offset = n));
	}
	var out: Array<Byte> = [];
	var j = 0;
	while j < clean.len {
		val hi = _hex_value(clean[j]);
		if hi < 0 {
			return core.Result::Err(CodecError(tag = "hex-invalid-char", offset = pos[j]));
		}
		val lo = _hex_value(clean[j + 1]);
		if lo < 0 {
			return core.Result::Err(CodecError(tag = "hex-invalid-char", offset = pos[j + 1]));
		}
		out.push(cast<Byte>(hi * 16 + lo));
		j = j + 2;
	}
	return core.Result::Ok(move out);
}

fn _base64_decode_impl(s: &String, allow_whitespace: Bool, allow_url_safe: Bool) nothrow -> core.Result<Array<Byte>, CodecError> {
	val n = s.byte_length();
	var clean: Array<Byte> = [];
	var pos: Array<Int> = [];
	var i = 0;
	while i < n {
		val b = core.string_byte_at(s, i);
		if allow_whitespace and _is_ascii_whitespace(b) {
			i = i + 1;
			continue;
		}
		clean.push(b);
		pos.push(i);
		i = i + 1;
	}
	if clean.len % 4 != 0 {
		return core.Result::Err(CodecError(tag = "base64-invalid-length", offset = n));
	}
	var out: Array<Byte> = [];
	i = 0;
	while i < clean.len {
		val b0 = clean[i];
		val b1 = clean[i + 1];
		val b2 = clean[i + 2];
		val b3 = clean[i + 3];
		val v0 = _b64_value(b0, allow_url_safe);
		val v1 = _b64_value(b1, allow_url_safe);
		val v2 = _b64_value(b2, allow_url_safe);
		val v3 = _b64_value(b3, allow_url_safe);
		if v0 == -1 {
			return core.Result::Err(CodecError(tag = "base64-invalid-char", offset = pos[i]));
		}
		if v1 == -1 {
			return core.Result::Err(CodecError(tag = "base64-invalid-char", offset = pos[i + 1]));
		}
		if v0 == -2 {
			return core.Result::Err(CodecError(tag = "base64-invalid-padding", offset = pos[i]));
		}
		if v1 == -2 {
			return core.Result::Err(CodecError(tag = "base64-invalid-padding", offset = pos[i + 1]));
		}
		if v2 == -1 {
			return core.Result::Err(CodecError(tag = "base64-invalid-char", offset = pos[i + 2]));
		}
		if v3 == -1 {
			return core.Result::Err(CodecError(tag = "base64-invalid-char", offset = pos[i + 3]));
		}
		if v2 == -2 {
			if v3 != -2 {
				return core.Result::Err(CodecError(tag = "base64-invalid-padding", offset = pos[i + 3]));
			}
			if i + 4 != clean.len {
				return core.Result::Err(CodecError(tag = "base64-trailing-data", offset = pos[i + 4]));
			}
			val o0 = (v0 * 4 + (v1 / 16)) % 256;
			out.push(cast<Byte>(o0));
			i = i + 4;
			continue;
		}
		if v3 == -2 {
			if i + 4 != clean.len {
				return core.Result::Err(CodecError(tag = "base64-trailing-data", offset = pos[i + 4]));
			}
			val o0 = (v0 * 4 + (v1 / 16)) % 256;
			val o1 = ((v1 % 16) * 16 + (v2 / 4)) % 256;
			out.push(cast<Byte>(o0));
			out.push(cast<Byte>(o1));
			i = i + 4;
			continue;
		}
		val o0 = (v0 * 4 + (v1 / 16)) % 256;
		val o1 = ((v1 % 16) * 16 + (v2 / 4)) % 256;
		val o2 = ((v2 % 4) * 64 + v3) % 256;
		out.push(cast<Byte>(o0));
		out.push(cast<Byte>(o1));
		out.push(cast<Byte>(o2));
		i = i + 4;
	}
	return core.Result::Ok(move out);
}

fn _base32_decode_impl(s: &String, allow_whitespace: Bool, allow_lowercase: Bool) nothrow -> core.Result<Array<Byte>, CodecError> {
	val n = s.byte_length();
	var clean: Array<Byte> = [];
	var pos: Array<Int> = [];
	var i = 0;
	while i < n {
		val b = core.string_byte_at(s, i);
		if allow_whitespace and _is_ascii_whitespace(b) {
			i = i + 1;
			continue;
		}
		clean.push(b);
		pos.push(i);
		i = i + 1;
	}
	if clean.len % 8 != 0 {
		return core.Result::Err(CodecError(tag = "base32-invalid-length", offset = n));
	}
	var out: Array<Byte> = [];
	i = 0;
	while i < clean.len {
		var vals: Array<Int> = [];
		var j = 0;
		while j < 8 {
			val v = _b32_value(clean[i + j], allow_lowercase);
			if v == -1 {
				return core.Result::Err(CodecError(tag = "base32-invalid-char", offset = pos[i + j]));
			}
			vals.push(v);
			j = j + 1;
		}
		var pad = 0;
		j = 7;
		while j >= 0 {
			if vals[j] == -2 {
				pad = pad + 1;
				j = j - 1;
				continue;
			}
			break;
		}
		j = 0;
		while j < 8 - pad {
			if vals[j] == -2 {
				return core.Result::Err(CodecError(tag = "base32-invalid-padding", offset = pos[i + j]));
			}
			j = j + 1;
		}
		if pad > 0 and i + 8 != clean.len {
			return core.Result::Err(CodecError(tag = "base32-trailing-data", offset = pos[i + 8]));
		}
		if not (pad == 0 or pad == 1 or pad == 3 or pad == 4 or pad == 6) {
			return core.Result::Err(CodecError(tag = "base32-invalid-padding", offset = pos[i + (8 - pad)]));
		}
		val v0 = vals[0];
		val v1 = vals[1];
		val v2 = vals[2];
		val v3 = vals[3];
		val v4 = vals[4];
		val v5 = vals[5];
		val v6 = vals[6];
		val v7 = vals[7];
		val b0 = (v0 * 8 + (v1 / 4)) % 256;
		val b1 = ((v1 % 4) * 64 + v2 * 2 + (v3 / 16)) % 256;
		val b2 = ((v3 % 16) * 16 + (v4 / 2)) % 256;
		val b3 = ((v4 % 2) * 128 + v5 * 4 + (v6 / 8)) % 256;
		val b4 = ((v6 % 8) * 32 + v7) % 256;
		if pad == 6 {
			out.push(cast<Byte>(b0));
		} else {
			if pad == 4 {
				out.push(cast<Byte>(b0));
				out.push(cast<Byte>(b1));
			} else {
				if pad == 3 {
					out.push(cast<Byte>(b0));
					out.push(cast<Byte>(b1));
					out.push(cast<Byte>(b2));
				} else {
					if pad == 1 {
						out.push(cast<Byte>(b0));
						out.push(cast<Byte>(b1));
						out.push(cast<Byte>(b2));
						out.push(cast<Byte>(b3));
					} else {
						out.push(cast<Byte>(b0));
						out.push(cast<Byte>(b1));
						out.push(cast<Byte>(b2));
						out.push(cast<Byte>(b3));
						out.push(cast<Byte>(b4));
					}
				}
			}
		}
		i = i + 8;
	}
	return core.Result::Ok(move out);
}

fn _is_ascii_whitespace(b: Byte) nothrow -> Bool {
	return b == cast<Byte>(32) or b == cast<Byte>(9) or b == cast<Byte>(10) or b == cast<Byte>(13);
}

fn _hex_value(b: Byte) nothrow -> Int {
	val v = _byte_u8(b);
	if v >= 48 and v <= 57 {
		return v - 48;
	}
	if v >= 65 and v <= 70 {
		return v - 65 + 10;
	}
	if v >= 97 and v <= 102 {
		return v - 97 + 10;
	}
	return -1;
}

fn _hex_digit_byte(v: Int) nothrow -> Byte {
	if v >= 0 and v <= 9 {
		return cast<Byte>(48 + v);
	}
	return cast<Byte>(97 + (v - 10));
}

fn _b64_alphabet_byte(v: Int) nothrow -> Byte {
	return core.string_byte_at("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/", v);
}

fn _b64_value(b: Byte, allow_url_safe: Bool) nothrow -> Int {
	val v = _byte_u8(b);
	if v >= 65 and v <= 90 {
		return v - 65;
	}
	if v >= 97 and v <= 122 {
		return v - 97 + 26;
	}
	if v >= 48 and v <= 57 {
		return v - 48 + 52;
	}
	if v == 43 {
		return 62;
	}
	if v == 47 {
		return 63;
	}
	if allow_url_safe and v == 45 {
		return 62;
	}
	if allow_url_safe and v == 95 {
		return 63;
	}
	if v == 61 {
		return -2;
	}
	return -1;
}

fn _b64url_alphabet_byte(v: Int) nothrow -> Byte {
	return core.string_byte_at("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_", v);
}

fn _b64url_value(b: Byte) nothrow -> Int {
	val v = _byte_u8(b);
	if v >= 65 and v <= 90 {
		return v - 65;
	}
	if v >= 97 and v <= 122 {
		return v - 97 + 26;
	}
	if v >= 48 and v <= 57 {
		return v - 48 + 52;
	}
	if v == 45 {
		return 62;
	}
	if v == 95 {
		return 63;
	}
	return -1;
}

fn _b32_alphabet_byte(v: Int) nothrow -> Byte {
	return core.string_byte_at("ABCDEFGHIJKLMNOPQRSTUVWXYZ234567", v);
}

fn _b32_value(b: Byte, allow_lowercase: Bool) nothrow -> Int {
	val v = _byte_u8(b);
	if v >= 65 and v <= 90 {
		return v - 65;
	}
	if v >= 50 and v <= 55 {
		return v - 50 + 26;
	}
	if allow_lowercase and v >= 97 and v <= 122 {
		return v - 97;
	}
	if v == 61 {
		return -2;
	}
	return -1;
}

fn _byte_u8(b: Byte) nothrow -> Int {
	var v = cast<Int>(b);
	if v < 0 {
		v = v + 256;
	}
	return v;
}

module std.regex;

import std.core as core;
import std.io as io;
import std.text as text;

export {
	Regex,
	RegexError,
	RegexMatch,
	RegexNode,
	CharClass,
	CharRange,
	Quantifier,
	AnchorKind,
	_NfaOp,
	_NfaProg,
	compile,
	is_match,
	find_first,
	replace_first,
	replace_all,
	_node_size,
	_emit_node,
	_nfa_compile,
	_byte_matches,
	_try_match_at,
	_find_from,
	_find_from_gen_saturated,
	_substr,
	is_match_view,
	find_first_view,
	match_view,
	match_subview
};

// ---------------------------------------------------------------------------
// Public error type
// ---------------------------------------------------------------------------

/// Error returned by `compile` when a pattern is malformed.
///
/// `tag` is a stable machine-readable code (e.g. `"unclosed-group"`,
/// `"empty-class"`, `"trailing-backslash"`).  `offset` is the
/// zero-based byte position in the pattern where the parser gave up.
///
/// `RegexError` is a `pub error`, so the compiler synthesizes its
/// `core.Throw` and `core.Diagnostic` impls; `or_throw()` and
/// auto-try unwrap it directly.
///
/// **See also:** `compile`, `Regex`.
pub error RegexError {
	tag: String,
	offset: Int,
}

// ---------------------------------------------------------------------------
// Public match result
// ---------------------------------------------------------------------------

/// Byte-offset span of a successful match within an input string.
///
/// `start` is the zero-based index of the first matched byte; `end`
/// is the exclusive end index.  The matched substring is bytes
/// `[start, end)`.  `RegexMatch` is `Copy`.
///
/// **See also:** `find_first`.
pub struct RegexMatch {
	pub start: Int,
	pub end: Int
}

implement core.Copy for RegexMatch {
}

// ---------------------------------------------------------------------------
// AST types
//
// FROZEN CONTRACT — NFA lowering depends on these invariants:
//
//   Precedence (tightest binds first):
//     1. Atom        — Literal, Dot, Anchor, Class, grouped sub-expr
//     2. Quantifier  — Repeat wraps exactly one atom (child.len == 1)
//     3. Concat      — Group.children: flat left-to-right array, never nested
//     4. Alternation — Alternation.branches: flat array, never nested
//
//   Structural:
//     - Single-element sequences unwrap: a sequence of one atom produces
//       the atom directly, not Group([atom]).
//     - Empty sequences produce Group(children=[]) (zero-length match).
//     - Repeat.child is a 1-element array (not a bare node) because
//       RegexNode is not Copy; the array provides owned storage.
//     - Alternation is only emitted when 2+ branches exist.
//
//   Escape normalization (stable — NFA may pattern-match on these):
//     \d  → Class(negated=false, ranges=[(48,57)])
//     \D  → Class(negated=true,  ranges=[(48,57)])
//     \w  → Class(negated=false, ranges=[(65,90),(97,122),(48,57),(95,95)])
//     \W  → Class(negated=true,  ranges=[(65,90),(97,122),(48,57),(95,95)])
//     \s  → Class(negated=false, ranges=[(32,32),(9,9),(10,10),(13,13)])
//     \S  → Class(negated=true,  ranges=[(32,32),(9,9),(10,10),(13,13)])
//     \t  → Literal(9)   \n → Literal(10)   \r → Literal(13)
//
//   Error tags (offset = byte position in pattern):
//     unclosed-group, unclosed-class, empty-class, dangling-quantifier,
//     trailing-backslash, trailing-backslash-in-class, invalid-escape,
//     invalid-escape-in-class, reversed-range, incomplete-range,
//     unexpected-paren, unexpected-char
// ---------------------------------------------------------------------------

/// Position-anchor kind in a `RegexNode::Anchor` AST node.
///
/// `Start` corresponds to `^` (beginning of input); `End`
/// corresponds to `$` (end of input).
pub variant AnchorKind {
	Start,
	End,
	@tombstone Tombstone
}

implement core.Copy for AnchorKind {
}

/// Inclusive `[lo, hi]` byte range used inside a `CharClass`.
///
/// `Copy`.
pub struct CharRange {
	pub lo: Byte,
	pub hi: Byte
}

implement core.Copy for CharRange {
}

/// Character class (`[...]` or escape-derived class like `\d`,
/// `\w`, `\s`) — a set of byte ranges with an optional negation.
///
/// `negated = true` matches any byte NOT in `ranges`.
pub struct CharClass {
	pub negated: Bool,
	pub ranges: Array<CharRange>
}

/// Repetition quantifier kind in a `RegexNode::Repeat` AST node.
///
/// `Star` is `*` (zero or more); `Plus` is `+` (one or more);
/// `Question` is `?` (zero or one).
pub variant Quantifier {
	Star,
	Plus,
	Question,
	@tombstone Tombstone
}

implement core.Copy for Quantifier {
}

/// Parsed regex AST node.  See the in-source "FROZEN CONTRACT"
/// header above this declaration for invariants the NFA lowering
/// depends on.
///
/// Cases:
/// - `Literal(byte_val)` — match a single byte exactly.
/// - `Dot` — match any single byte.
/// - `Anchor(kind)` — `^` or `$` zero-width position match.
/// - `Class(cls)` — match against a `CharClass`.
/// - `Group(children)` — concatenation of child nodes (left to right).
/// - `Alternation(branches)` — match the first successful branch.
/// - `Repeat(child, quant)` — apply `quant` to a single child node
///   (the `child` array always has length 1).
pub variant RegexNode {
	Literal(byte_val: Byte),
	Dot,
	Anchor(kind: AnchorKind),
	Class(cls: CharClass),
	Group(children: Array<RegexNode>),
	Alternation(branches: Array<RegexNode>),
	Repeat(child: Array<RegexNode>, quant: Quantifier),
	@tombstone Tombstone
}

/// Compiled regular expression, ready for matching.
///
/// Construct via `compile(pattern)`.  The `root` AST is exposed for
/// inspection; `nfa` is the internal compiled program (do not
/// modify).
///
/// **See also:** `compile`, `is_match`, `find_first`,
/// `replace_first`, `replace_all`.
pub struct Regex {
	pub root: RegexNode,
	nfa: _NfaProg
}

// ---------------------------------------------------------------------------
// Parser — single-pass recursive descent over pattern bytes
// ---------------------------------------------------------------------------

struct Parser {
	src: String,
	len: Int,
	pos: Int
}

fn _new_parser(pattern: &String) nothrow -> Parser {
	return Parser(src = *pattern, len = pattern.byte_length(), pos = 0);
}

fn _peek(p: &mut Parser) nothrow -> Int {
	if p.pos >= p.len {
		return 0 - 1;
	}
	return cast<Int>(core.string_byte_at(p.src, p.pos));
}

fn _advance(p: &mut Parser) nothrow -> Byte {
	val b = core.string_byte_at(p.src, p.pos);
	p.pos = p.pos + 1;
	return b;
}

fn _at_end(p: &mut Parser) nothrow -> Bool {
	return p.pos >= p.len;
}

fn _err(tag: &String, offset: Int) nothrow -> core.Result<RegexNode, RegexError> {
	return core.Result::Err(RegexError(tag = *tag, offset = offset));
}

// ---------------------------------------------------------------------------
// Top-level entry: parse alternation
// ---------------------------------------------------------------------------

/// Parses `pattern` and compiles it to a matchable `Regex`.
///
/// Supported syntax: literal bytes, `.` dot, `^` / `$` anchors,
/// `[...]` character classes (with negation `[^...]` and ranges
/// `a-z`), `*` / `+` / `?` quantifiers, alternation `a|b`,
/// grouping `(...)`, and the standard escapes `\d` `\D` `\w` `\W`
/// `\s` `\S` `\t` `\n` `\r`.  Backreferences and named groups are
/// not supported.
///
/// **Returns:** `Ok(Regex)` on success.  `Err(RegexError)` carrying
/// a stable failure tag and the byte offset where parsing failed.
///
/// **See also:** `Regex`, `RegexError`, `is_match`, `find_first`.
pub fn compile(pattern: &String) nothrow -> core.Result<Regex, RegexError> {
	var p = _new_parser(pattern);
	match _parse_alternation(p) {
		core.Result::Ok(node) => {
			if not _at_end(p) {
				val tag = "unexpected-char";
				return core.Result::Err(RegexError(tag = tag, offset = p.pos));
			}
			val nfa = _nfa_compile(node);
			return core.Result::Ok(Regex(root = move node, nfa = move nfa));
		},
		core.Result::Err(e) => {
			return core.Result::Err(move e);
		}
	}
}

// alternation = sequence ('|' sequence)*
fn _parse_alternation(p: &mut Parser) nothrow -> core.Result<RegexNode, RegexError> {
	match _parse_sequence(p) {
		core.Result::Err(e) => { return core.Result::Err(move e); },
		core.Result::Ok(first) => {
			if _peek(p) != 124 {
				return core.Result::Ok(move first);
			}
			var branches = Array<type RegexNode>::with_capacity(4);
			branches.push(first);
			while _peek(p) == 124 {
				p.pos = p.pos + 1;
				match _parse_sequence(p) {
					core.Result::Err(e) => { return core.Result::Err(move e); },
					core.Result::Ok(branch) => {
						branches.push(branch);
					}
				}
			}
			return core.Result::Ok(RegexNode::Alternation(branches = move branches));
		}
	}
}

// sequence = quantified*
fn _parse_sequence(p: &mut Parser) nothrow -> core.Result<RegexNode, RegexError> {
	var children = Array<type RegexNode>::with_capacity(8);
	while not _at_end(p) {
		val ch = _peek(p);
		// Stop at alternation pipe or closing paren.
		if ch == 124 or ch == 41 {
			break;
		}
		match _parse_quantified(p) {
			core.Result::Err(e) => { return core.Result::Err(move e); },
			core.Result::Ok(node) => {
				children.push(node);
			}
		}
	}
	if children.len == 1 {
		// Unwrap single-element group to keep AST lean.
		match children.pop() {
			Optional::Some(only) => { return core.Result::Ok(move only); },
			Optional::None() => { }
		}
	}
	return core.Result::Ok(RegexNode::Group(children = move children));
}

// quantified = atom ('*' | '+' | '?')?
fn _parse_quantified(p: &mut Parser) nothrow -> core.Result<RegexNode, RegexError> {
	match _parse_atom(p) {
		core.Result::Err(e) => { return core.Result::Err(move e); },
		core.Result::Ok(atom) => {
			if _at_end(p) {
				return core.Result::Ok(move atom);
			}
			val ch = _peek(p);
			if ch == 42 {
				p.pos = p.pos + 1;
				var wrap = Array<type RegexNode>::with_capacity(1);
				wrap.push(atom);
				return core.Result::Ok(RegexNode::Repeat(child = move wrap, quant = Quantifier::Star()));
			}
			if ch == 43 {
				p.pos = p.pos + 1;
				var wrap = Array<type RegexNode>::with_capacity(1);
				wrap.push(atom);
				return core.Result::Ok(RegexNode::Repeat(child = move wrap, quant = Quantifier::Plus()));
			}
			if ch == 63 {
				p.pos = p.pos + 1;
				var wrap = Array<type RegexNode>::with_capacity(1);
				wrap.push(atom);
				return core.Result::Ok(RegexNode::Repeat(child = move wrap, quant = Quantifier::Question()));
			}
			return core.Result::Ok(move atom);
		}
	}
}

// atom = '.' | '^' | '$' | '(' alternation ')' | '[' charclass ']' | '\\' escape | literal
fn _parse_atom(p: &mut Parser) nothrow -> core.Result<RegexNode, RegexError> {
	val ch = _peek(p);

	// Dot: any character.
	if ch == 46 {
		p.pos = p.pos + 1;
		return core.Result::Ok(RegexNode::Dot());
	}

	// Caret: start anchor.
	if ch == 94 {
		p.pos = p.pos + 1;
		return core.Result::Ok(RegexNode::Anchor(kind = AnchorKind::Start()));
	}

	// Dollar: end anchor.
	if ch == 36 {
		p.pos = p.pos + 1;
		return core.Result::Ok(RegexNode::Anchor(kind = AnchorKind::End()));
	}

	// Open paren: grouped sub-expression.
	if ch == 40 {
		p.pos = p.pos + 1;
		match _parse_alternation(p) {
			core.Result::Err(e) => { return core.Result::Err(move e); },
			core.Result::Ok(inner) => {
				if _at_end(p) or _peek(p) != 41 {
					val tag = "unclosed-group";
					return _err(tag, p.pos);
				}
				p.pos = p.pos + 1;
				return core.Result::Ok(move inner);
			}
		}
	}

	// Open bracket: character class.
	if ch == 91 {
		return _parse_char_class(p);
	}

	// Backslash: escape sequence.
	if ch == 92 {
		return _parse_escape(p);
	}

	// Bare closing paren without matching open.
	if ch == 41 {
		val tag = "unexpected-paren";
		return _err(tag, p.pos);
	}

	// Bare quantifier with no preceding atom.
	if ch == 42 or ch == 43 or ch == 63 {
		val tag = "dangling-quantifier";
		return _err(tag, p.pos);
	}

	// Literal byte.
	val b = _advance(p);
	return core.Result::Ok(RegexNode::Literal(byte_val = b));
}

// ---------------------------------------------------------------------------
// Escape sequences: \d \D \w \W \s \S and metachar literals
// ---------------------------------------------------------------------------

fn _parse_escape(p: &mut Parser) nothrow -> core.Result<RegexNode, RegexError> {
	val start = p.pos;
	p.pos = p.pos + 1;
	if _at_end(p) {
		val tag = "trailing-backslash";
		return _err(tag, start);
	}
	val ch = cast<Int>(_advance(p));

	// \d  → [0-9]
	if ch == 100 {
		return core.Result::Ok(_class_digit(false));
	}
	// \D  → [^0-9]
	if ch == 68 {
		return core.Result::Ok(_class_digit(true));
	}
	// \w  → [A-Za-z0-9_]
	if ch == 119 {
		return core.Result::Ok(_class_word(false));
	}
	// \W  → [^A-Za-z0-9_]
	if ch == 87 {
		return core.Result::Ok(_class_word(true));
	}
	// \s  → [ \t\n\r]
	if ch == 115 {
		return core.Result::Ok(_class_space(false));
	}
	// \S  → [^ \t\n\r]
	if ch == 83 {
		return core.Result::Ok(_class_space(true));
	}

	// \t
	if ch == 116 {
		return core.Result::Ok(RegexNode::Literal(byte_val = cast<Byte>(9)));
	}
	// \n
	if ch == 110 {
		return core.Result::Ok(RegexNode::Literal(byte_val = cast<Byte>(10)));
	}
	// \r
	if ch == 114 {
		return core.Result::Ok(RegexNode::Literal(byte_val = cast<Byte>(13)));
	}

	// Metacharacter literal escapes: \. \^ \$ \( \) \[ \] \| \* \+ \? \\
	if ch == 46 or ch == 94 or ch == 36 or ch == 40 or ch == 41 or ch == 91 or ch == 93 or ch == 124 or ch == 42 or ch == 43 or ch == 63 or ch == 92 {
		return core.Result::Ok(RegexNode::Literal(byte_val = cast<Byte>(ch)));
	}

	val tag = "invalid-escape";
	return _err(tag, start);
}

// ---------------------------------------------------------------------------
// Built-in character class constructors
// ---------------------------------------------------------------------------

fn _class_digit(neg: Bool) nothrow -> RegexNode {
	var ranges = Array<type CharRange>::with_capacity(1);
	ranges.push(CharRange(lo = cast<Byte>(48), hi = cast<Byte>(57)));
	return RegexNode::Class(cls = CharClass(negated = neg, ranges = move ranges));
}

fn _class_word(neg: Bool) nothrow -> RegexNode {
	var ranges = Array<type CharRange>::with_capacity(4);
	ranges.push(CharRange(lo = cast<Byte>(65), hi = cast<Byte>(90)));
	ranges.push(CharRange(lo = cast<Byte>(97), hi = cast<Byte>(122)));
	ranges.push(CharRange(lo = cast<Byte>(48), hi = cast<Byte>(57)));
	ranges.push(CharRange(lo = cast<Byte>(95), hi = cast<Byte>(95)));
	return RegexNode::Class(cls = CharClass(negated = neg, ranges = move ranges));
}

fn _class_space(neg: Bool) nothrow -> RegexNode {
	var ranges = Array<type CharRange>::with_capacity(4);
	ranges.push(CharRange(lo = cast<Byte>(32), hi = cast<Byte>(32)));
	ranges.push(CharRange(lo = cast<Byte>(9), hi = cast<Byte>(9)));
	ranges.push(CharRange(lo = cast<Byte>(10), hi = cast<Byte>(10)));
	ranges.push(CharRange(lo = cast<Byte>(13), hi = cast<Byte>(13)));
	return RegexNode::Class(cls = CharClass(negated = neg, ranges = move ranges));
}

// ---------------------------------------------------------------------------
// Character class parsing: [abc], [a-z], [^...], [\d], etc.
// ---------------------------------------------------------------------------

fn _parse_char_class(p: &mut Parser) nothrow -> core.Result<RegexNode, RegexError> {
	val start = p.pos;
	p.pos = p.pos + 1;

	var negated = false;
	if not _at_end(p) and _peek(p) == 94 {
		negated = true;
		p.pos = p.pos + 1;
	}

	var ranges = Array<type CharRange>::with_capacity(4);
	var first = true;

	while not _at_end(p) and (_peek(p) != 93 or first) {
		first = false;
		val ch = _peek(p);

		// Escape inside class.
		if ch == 92 {
			p.pos = p.pos + 1;
			if _at_end(p) {
				val tag = "trailing-backslash-in-class";
				return _err(tag, p.pos - 1);
			}
			val esc = cast<Int>(_advance(p));
			// Shorthand classes inside []: \d \w \s and their negations.
			if esc == 100 {
				ranges.push(CharRange(lo = cast<Byte>(48), hi = cast<Byte>(57)));
				continue;
			}
			if esc == 119 {
				ranges.push(CharRange(lo = cast<Byte>(65), hi = cast<Byte>(90)));
				ranges.push(CharRange(lo = cast<Byte>(97), hi = cast<Byte>(122)));
				ranges.push(CharRange(lo = cast<Byte>(48), hi = cast<Byte>(57)));
				ranges.push(CharRange(lo = cast<Byte>(95), hi = cast<Byte>(95)));
				continue;
			}
			if esc == 115 {
				ranges.push(CharRange(lo = cast<Byte>(32), hi = cast<Byte>(32)));
				ranges.push(CharRange(lo = cast<Byte>(9), hi = cast<Byte>(9)));
				ranges.push(CharRange(lo = cast<Byte>(10), hi = cast<Byte>(10)));
				ranges.push(CharRange(lo = cast<Byte>(13), hi = cast<Byte>(13)));
				continue;
			}
			// \t \n \r inside class.
			if esc == 116 {
				match _maybe_range(p, cast<Byte>(9), ranges) {
					core.Result::Err(e) => { return core.Result::Err(move e); },
					core.Result::Ok(_) => { continue; }
				}
			}
			if esc == 110 {
				match _maybe_range(p, cast<Byte>(10), ranges) {
					core.Result::Err(e) => { return core.Result::Err(move e); },
					core.Result::Ok(_) => { continue; }
				}
			}
			if esc == 114 {
				match _maybe_range(p, cast<Byte>(13), ranges) {
					core.Result::Err(e) => { return core.Result::Err(move e); },
					core.Result::Ok(_) => { continue; }
				}
			}
			// Metachar escapes inside class: \] \\ \^ \-
			if esc == 93 or esc == 92 or esc == 94 or esc == 45 {
				match _maybe_range(p, cast<Byte>(esc), ranges) {
					core.Result::Err(e) => { return core.Result::Err(move e); },
					core.Result::Ok(_) => { continue; }
				}
			}
			val tag = "invalid-escape-in-class";
			return _err(tag, p.pos - 2);
		}

		// Regular byte — might be start of a range (a-z).
		val lo = _advance(p);
		match _maybe_range(p, lo, ranges) {
			core.Result::Err(e) => { return core.Result::Err(move e); },
			core.Result::Ok(_) => { }
		}
	}

	if _at_end(p) {
		val tag = "unclosed-class";
		return _err(tag, start);
	}
	p.pos = p.pos + 1;

	if ranges.len == 0 {
		val tag = "empty-class";
		return _err(tag, start);
	}

	return core.Result::Ok(RegexNode::Class(cls = CharClass(negated = negated, ranges = move ranges)));
}

// Check for '-' after a byte to form a range; otherwise push as singleton.
fn _maybe_range(p: &mut Parser, lo: Byte, ranges: &mut Array<CharRange>) nothrow -> core.Result<Void, RegexError> {
	if not _at_end(p) and _peek(p) == 45 {
		// Peek ahead: if next-next is ']' or end, treat '-' as literal.
		if p.pos + 1 < p.len and cast<Int>(core.string_byte_at(p.src, p.pos + 1)) != 93 {
			p.pos = p.pos + 1;
			if _at_end(p) {
				val tag = "incomplete-range";
				return core.Result::Err(RegexError(tag = tag, offset = p.pos));
			}
			val hi_ch = _peek(p);
			var hi = cast<Byte>(0);
			// Handle escape on the high end of a range.
			if hi_ch == 92 {
				p.pos = p.pos + 1;
				if _at_end(p) {
					val tag = "trailing-backslash-in-class";
					return core.Result::Err(RegexError(tag = tag, offset = p.pos - 1));
				}
				val esc = cast<Int>(_advance(p));
				if esc == 116 { hi = cast<Byte>(9); }
				else { if esc == 110 { hi = cast<Byte>(10); }
				else { if esc == 114 { hi = cast<Byte>(13); }
				else { if esc == 93 or esc == 92 or esc == 94 or esc == 45 { hi = cast<Byte>(esc); }
				else {
					val tag = "invalid-escape-in-class";
					return core.Result::Err(RegexError(tag = tag, offset = p.pos - 2));
				} } } }
			} else {
				hi = _advance(p);
			}
			if cast<Int>(lo) > cast<Int>(hi) {
				val tag = "reversed-range";
				return core.Result::Err(RegexError(tag = tag, offset = p.pos - 1));
			}
			ranges.push(CharRange(lo = lo, hi = hi));
			return core.Result::Ok(core.void_value());
		}
	}
	ranges.push(CharRange(lo = lo, hi = lo));
	return core.Result::Ok(core.void_value());
}

// ---------------------------------------------------------------------------
// NFA instruction set (private)
// ---------------------------------------------------------------------------

/// Internal NFA opcode.  Implementation detail of the regex engine —
/// not user-facing API.
pub variant _NfaOp {
	ByteMatch(b: Byte),
	AnyByte,
	Ranges(range_start: Int, range_count: Int, negated: Bool),
	Split(a: Int, b: Int),
	Jump(target: Int),
	AssertStart,
	AssertEnd,
	Accept,
	@tombstone Tombstone
}

implement core.Copy for _NfaOp {
}

// NFA program: instruction array + side table of ranges for Ranges ops.
/// Internal NFA program.  Implementation detail of the regex engine
/// — not user-facing API.
pub struct _NfaProg {
	ops: Array<_NfaOp>,
	ranges: Array<CharRange>
}

// ---------------------------------------------------------------------------
// NFA compiler: RegexNode AST → _NfaOp instruction array
//
// Uses pre-computed instruction sizes to emit absolute jump targets
// without backpatching.
// ---------------------------------------------------------------------------

/// Internal: NFA-program size estimator.
pub fn _node_size(node: &RegexNode) nothrow -> Int {
	match node {
		Literal(_) => { return 1; },
		Dot => { return 1; },
		RegexNode::Anchor(_) => { return 1; },
		RegexNode::Class(_) => { return 1; },
		RegexNode::Group(children) => {
			var total = 0;
			var i = 0;
			while i < children.len {
				total = total + _node_size(children[i]);
				i = i + 1;
			}
			return total;
		},
		RegexNode::Alternation(branches) => {
			if branches.len == 0 { return 0; }
			var total = 0;
			var i = 0;
			while i < branches.len {
				total = total + _node_size(branches[i]);
				i = i + 1;
			}
			if branches.len > 1 {
				total = total + 2 * (branches.len - 1);
			}
			return total;
		},
		RegexNode::Repeat(child, quant) => {
			val cs = _node_size(child[0]);
			match quant {
				Quantifier::Star => { return cs + 2; },
				Quantifier::Plus => { return cs + 1; },
				Quantifier::Question => { return cs + 1; },
				default => { return 0; }
			}
			return 0;
		},
		default => { return 0; }
	}
	return 0;
}

/// Internal: emits NFA opcodes for a single AST node.
pub fn _emit_node(node: &RegexNode, nfa: &mut _NfaProg) nothrow -> Void {
	match node {
		Literal(byte_val) => {
			nfa.ops.push(_NfaOp::ByteMatch(b = byte_val));
		},
		Dot => {
			nfa.ops.push(_NfaOp::AnyByte());
		},
		RegexNode::Anchor(kind) => {
			match kind {
				AnchorKind::Start => { nfa.ops.push(_NfaOp::AssertStart()); },
				AnchorKind::End => { nfa.ops.push(_NfaOp::AssertEnd()); },
				default => { }
			}
		},
		RegexNode::Class(cls) => {
			val rs = nfa.ranges.len;
			var ri = 0;
			while ri < cls.ranges.len {
				nfa.ranges.push(cls.ranges[ri]);
				ri = ri + 1;
			}
			nfa.ops.push(_NfaOp::Ranges(range_start = rs, range_count = cls.ranges.len, negated = cls.negated));
		},
		RegexNode::Group(children) => {
			var i = 0;
			while i < children.len {
				_emit_node(children[i], nfa);
				i = i + 1;
			}
		},
		RegexNode::Alternation(branches) => {
			val n = branches.len;
			if n == 0 {
				// empty alternation — nothing to emit
			} else { if n == 1 {
				_emit_node(branches[0], nfa);
			} else {
				// Pre-compute branch sizes for absolute target calculation.
				var sizes = Array<type Int>::with_capacity(n);
				var si = 0;
				while si < n {
					sizes.push(_node_size(branches[si]));
					si = si + 1;
				}
				// end_pos = current_pos + sum(sizes) + 2*(n-1)
				var total = 0;
				si = 0;
				while si < n { total = total + sizes[si]; si = si + 1; }
				total = total + 2 * (n - 1);
				val end_pos = nfa.ops.len + total;
				// Emit branches 0..n-2, each wrapped in Split + Jump.
				var bi = 0;
				while bi < n - 1 {
					val body_start = nfa.ops.len + 1;
					val after_jump = body_start + sizes[bi] + 1;
					nfa.ops.push(_NfaOp::Split(a = body_start, b = after_jump));
					_emit_node(branches[bi], nfa);
					nfa.ops.push(_NfaOp::Jump(target = end_pos));
					bi = bi + 1;
				}
				// Last branch — no wrapper.
				_emit_node(branches[n - 1], nfa);
			} }
		},
		RegexNode::Repeat(child, quant) => {
			val child_size = _node_size(child[0]);
			match quant {
				Quantifier::Star => {
					// Split(body, after) | body | Jump(split)
					val split_pos = nfa.ops.len;
					val body_start = split_pos + 1;
					val after = body_start + child_size + 1;
					nfa.ops.push(_NfaOp::Split(a = body_start, b = after));
					_emit_node(child[0], nfa);
					nfa.ops.push(_NfaOp::Jump(target = split_pos));
				},
				Quantifier::Plus => {
					// body | Split(body, after)
					val body_start = nfa.ops.len;
					_emit_node(child[0], nfa);
					val after = nfa.ops.len + 1;
					nfa.ops.push(_NfaOp::Split(a = body_start, b = after));
				},
				Quantifier::Question => {
					// Split(body, after) | body
					val body_start = nfa.ops.len + 1;
					val after = body_start + child_size;
					nfa.ops.push(_NfaOp::Split(a = body_start, b = after));
					_emit_node(child[0], nfa);
				},
				default => { }
			}
		},
		default => { }
	}
}

/// Internal: compiles a parsed AST into an NFA program.
pub fn _nfa_compile(root: &RegexNode) nothrow -> _NfaProg {
	var nfa = _NfaProg(
		ops = Array<type _NfaOp>::with_capacity(_node_size(root) + 1),
		ranges = Array<type CharRange>::with_capacity(16)
	);
	_emit_node(root, nfa);
	nfa.ops.push(_NfaOp::Accept());
	return move nfa;
}

// ---------------------------------------------------------------------------
// NFA executor — Thompson simulation over a function-local PACKED
// workspace (_NfaScratch).
//
// ZERO allocations per candidate start and per consumed byte; exactly
// ONE workspace allocation per top-level search (independent of input
// length and start count).  Epoch marks give an O(1) state-set clear;
// the next closure is built DIRECTLY from matching states (no seeds
// array); epsilon closure is an ITERATIVE mark-on-push worklist (no
// recursion, bounded by prog_len).
// ---------------------------------------------------------------------------

// Packed matcher workspace.  PRIVATE and function-local — NEVER
// stored in Regex: matching stays thread-safe, reentrant, and
// callable through shared &Regex.  One Array<Int> of length
// 4*prog_len, partitioned into regions
//     [ marks | state list A | state list B | worklist ]
// at bases 0 / P / 2P / 3P.  marks are epoch numbers:
// visited(pc) <=> ws[pc] == gen.  The two state-list regions swap
// ROLES between "current" and "next" via cur_base — no allocation,
// no copying.  Region cursors are bounded structurally: the epoch
// guard admits each pc into a list or the worklist at most once per
// epoch, so no region can exceed prog_len entries (the packed
// array's own bounds check is the fail-closed backstop).
struct _NfaScratch {
	ws: Array<Int>,
	prog_len: Int,
	gen: Int,
	cur_base: Int,
	cur_len: Int
}

fn _scratch_new(prog_len: Int) nothrow -> _NfaScratch {
	var ws = Array<type Int>::with_capacity(4 * prog_len);
	var i = 0;
	while i < 4 * prog_len {
		ws.push(0);
		i = i + 1;
	}
	return _NfaScratch(ws = move ws, prog_len = prog_len, gen = 0,
		cur_base = prog_len, cur_len = 0);
}

// Epoch advance with a DETERMINISTIC overflow reset (never labeled
// unreachable): at the ceiling, zero every mark and restart from
// generation 0.  One O(prog) sweep per ~2^63 advances; behavior is
// identical across the reset (tooth: _find_from_gen_saturated).
// gen starts at 0 and is incremented BEFORE first use — an all-zero
// marks region is never a valid "visited" state.
fn _scratch_next_gen(sc: &mut _NfaScratch) nothrow -> Void {
	if sc.gen >= 9223372036854775806 {
		var i = 0;
		while i < sc.prog_len {
			sc.ws[i] = 0;
			i = i + 1;
		}
		sc.gen = 0;
	}
	sc.gen = sc.gen + 1;
}

// Iterative epsilon closure from `seed` into the state-list region at
// `tgt_base` (current length `tgt_len`) under the CURRENT epoch.
// Marks on PUSH (worklist bounded by prog_len); Split pushes b BEFORE
// a so a expands first, matching the deleted recursive walker's DFS —
// closure CONTENTS are epoch-guarded sets, so match results are
// order-independent regardless.  Consuming ops and Accept join the
// state list.  Returns the region's new length.
fn _closure_into(nfa: &_NfaProg, sc: &mut _NfaScratch, tgt_base: Int, tgt_len: Int, seed: Int, pos: Int, input_len: Int) nothrow -> Int {
	val prog_len = sc.prog_len;
	val stack_base = 3 * prog_len;
	var slen = 0;
	var tl = tgt_len;
	if seed >= 0 and seed < prog_len and sc.ws[seed] != sc.gen {
		sc.ws[seed] = sc.gen;
		sc.ws[stack_base + slen] = seed;
		slen = slen + 1;
	}
	while slen > 0 {
		slen = slen - 1;
		val pc = sc.ws[stack_base + slen];
		val op = nfa.ops[pc];
		match op {
			_NfaOp::Split(a, b) => {
				if b >= 0 and b < prog_len and sc.ws[b] != sc.gen {
					sc.ws[b] = sc.gen;
					sc.ws[stack_base + slen] = b;
					slen = slen + 1;
				}
				if a >= 0 and a < prog_len and sc.ws[a] != sc.gen {
					sc.ws[a] = sc.gen;
					sc.ws[stack_base + slen] = a;
					slen = slen + 1;
				}
			},
			_NfaOp::Jump(target) => {
				if target >= 0 and target < prog_len and sc.ws[target] != sc.gen {
					sc.ws[target] = sc.gen;
					sc.ws[stack_base + slen] = target;
					slen = slen + 1;
				}
			},
			_NfaOp::AssertStart => {
				val nxt = pc + 1;
				if pos == 0 and nxt < prog_len and sc.ws[nxt] != sc.gen {
					sc.ws[nxt] = sc.gen;
					sc.ws[stack_base + slen] = nxt;
					slen = slen + 1;
				}
			},
			_NfaOp::AssertEnd => {
				val nxt = pc + 1;
				if pos == input_len and nxt < prog_len and sc.ws[nxt] != sc.gen {
					sc.ws[nxt] = sc.gen;
					sc.ws[stack_base + slen] = nxt;
					slen = slen + 1;
				}
			},
			_NfaOp::ByteMatch(_) => {
				sc.ws[tgt_base + tl] = pc;
				tl = tl + 1;
			},
			_NfaOp::AnyByte => {
				sc.ws[tgt_base + tl] = pc;
				tl = tl + 1;
			},
			_NfaOp::Ranges(_, _, _) => {
				sc.ws[tgt_base + tl] = pc;
				tl = tl + 1;
			},
			_NfaOp::Accept => {
				sc.ws[tgt_base + tl] = pc;
				tl = tl + 1;
			},
			default => { }
		}
	}
	return tl;
}

/// Internal: byte-class match test for a given NFA opcode.
pub fn _byte_matches(nfa: &_NfaProg, pc: Int, b: Byte) nothrow -> Bool {
	val op = nfa.ops[pc];
	match op {
		_NfaOp::ByteMatch(expected) => {
			return b == expected;
		},
		_NfaOp::AnyByte => {
			return true;
		},
		_NfaOp::Ranges(range_start, range_count, negated) => {
			var found = false;
			var i = 0;
			while i < range_count {
				val r = nfa.ranges[range_start + i];
				if b >= r.lo and b <= r.hi {
					found = true;
					break;
				}
				i = i + 1;
			}
			if negated { return not found; }
			return found;
		},
		_NfaOp::Split(_, _) => { return false; },
		_NfaOp::Jump(_) => { return false; },
		_NfaOp::AssertStart => { return false; },
		_NfaOp::AssertEnd => { return false; },
		_NfaOp::Accept => { return false; },
		default => { return false; }
	}
}

// Run NFA from a fixed start position; return longest match end or -1.
/// Internal: attempts a single anchored match starting at `start`,
/// returning the matched byte-length or `-1` on no match.
/// COMPATIBILITY WRAPPER: constructs one workspace per invocation —
/// looping callers should prefer the public search entry points,
/// which share one workspace across the whole search.
pub fn _try_match_at(nfa: &_NfaProg, input: &String, start: Int) nothrow -> Int {
	val src = text._byte_source_all(input);
	var sc = _scratch_new(nfa.ops.len);
	return _try_match_at_scratch(nfa, src, start, sc);
}

// THE matcher authority: every entry point (String or view) funnels
// here.  The subject is a borrowed `text._StringByteSource` window:
// positions (`start`, returned end, anchor semantics) are
// WINDOW-RELATIVE — `^` asserts position 0 OF THE WINDOW, `$` asserts
// its size — and reads go through the source's range-guarded `read`.
// String entries build `_byte_source_all` (borrow, zero retains), view
// entries `_byte_source`; String-form behavior is bit-identical to the
// pre-source implementation, and the source's private fields mean a
// narrow view's window can never read the rest of its backing.
//
// The workspace `sc` is caller-provided and REUSED: this function
// performs ZERO allocations — per attempt it advances the epoch and
// truncates the current list; per byte it builds the next closure
// directly into the other list region under a fresh epoch and swaps
// region roles.
fn _try_match_at_scratch(nfa: &_NfaProg, src: &text._StringByteSource, start: Int, sc: &mut _NfaScratch) nothrow -> Int {
	val input_len = src.size();
	val prog_len = nfa.ops.len;
	val accept_pc = prog_len - 1;
	assert(sc.prog_len == prog_len, "regex workspace/program size mismatch");

	_scratch_next_gen(sc);
	sc.cur_base = prog_len;
	sc.cur_len = _closure_into(nfa, sc, prog_len, 0, 0, start, input_len);

	var best_end = 0 - 1;
	if sc.ws[accept_pc] == sc.gen {
		best_end = start;
	}

	var pos = start;
	while pos < input_len and sc.cur_len > 0 {
		val b = src.read(pos);

		// Direct next-closure construction: each consuming state that
		// matches this byte expands straight into the OTHER list
		// region under one fresh epoch shared by the whole closure.
		var nxt_base = prog_len;
		if sc.cur_base == prog_len {
			nxt_base = 2 * prog_len;
		}
		val cur_base = sc.cur_base;
		val cur_len = sc.cur_len;
		_scratch_next_gen(sc);
		var nxt_len = 0;
		var ci = 0;
		while ci < cur_len {
			val pc = sc.ws[cur_base + ci];
			if _byte_matches(nfa, pc, b) {
				nxt_len = _closure_into(nfa, sc, nxt_base, nxt_len, pc + 1, pos + 1, input_len);
			}
			ci = ci + 1;
		}
		sc.cur_base = nxt_base;
		sc.cur_len = nxt_len;

		if sc.ws[accept_pc] == sc.gen {
			best_end = pos + 1;
		}
		pos = pos + 1;
	}

	return best_end;
}

// ---------------------------------------------------------------------------
// Public match API — search semantics
//
// is_match: returns true if pattern matches anywhere in input.
// find_first: returns leftmost match (greedy — longest at that start).
// ---------------------------------------------------------------------------

/// Returns `true` if `re` matches anywhere in the VIEW's bytes.
///
/// The view IS the subject string: `^`/`$` anchor at the view's
/// boundaries.  Reads through the borrowed view — never retains,
/// never materializes the subject.
pub fn is_match_view(re: &Regex, v: &text.StringByteView) nothrow -> Bool {
	match find_first_view(re, v) {
		Optional::Some(_) => { return true; },
		Optional::None() => { return false; }
	}
}

/// Returns the leftmost match of `re` in the VIEW's bytes (greedy —
/// longest at that start), or `None`.
///
/// Match offsets are VIEW-RELATIVE (compose directly with
/// `match_subview`); `^`/`$` anchor at the view's boundaries.  Never
/// retains, never materializes the subject.  Exactly ONE workspace
/// allocation for the whole search, independent of view length.
pub fn find_first_view(re: &Regex, v: &text.StringByteView) nothrow -> Optional<RegexMatch> {
	val src = text._byte_source(v);
	var sc = _scratch_new(re.nfa.ops.len);
	return _find_from_scratch(re.nfa, src, 0, sc);
}

/// Checked, OPT-IN conversion: a `RegexMatch` over `s` into a
/// retained view of `s`.
///
/// `RegexMatch` is a cheap `Copy` span with public fields and NO
/// source identity, so this is bounds-CHECKED against the `s` it is
/// GIVEN and carries no provenance claim beyond that: malformed
/// (`start < 0`, `end < start`) and out-of-range spans return
/// `Err(text.TextError(tag = "out-of-bounds", offset = m.start))`.
/// The FULL validation happens BEFORE any arithmetic, so fabricated
/// extreme spans (e.g. `start = INT_MIN, end = INT_MAX`) cannot
/// overflow the length subtraction.  On success: exactly one retain,
/// no byte copies.
pub fn match_view(m: RegexMatch, s: &String) nothrow -> core.Result<text.StringByteView, text.TextError> {
	if m.start < 0 or m.end < m.start or m.end > s.byte_length() {
		return core.Result::Err(text.TextError(tag = "out-of-bounds", offset = m.start));
	}
	// 0 <= start <= end <= len: the subtraction cannot overflow.
	return text.byte_view(s, m.start, m.end - m.start);
}

/// Checked conversion: a VIEW-RELATIVE `RegexMatch` (as returned by
/// `find_first_view`) over `v` into a subview of `v`.
///
/// Same checked, provenance-free contract as `match_view`; offsets
/// compose onto `v`'s backing.  Exactly one retain on success.
pub fn match_subview(m: RegexMatch, v: &text.StringByteView) nothrow -> core.Result<text.StringByteView, text.TextError> {
	if m.start < 0 or m.end < m.start or m.end > v.byte_length() {
		return core.Result::Err(text.TextError(tag = "out-of-bounds", offset = m.start));
	}
	// 0 <= start <= end <= view len: the subtraction cannot overflow.
	return v.subview(m.start, m.end - m.start);
}

/// Returns `true` if `re` matches anywhere in `input`.
///
/// Equivalent to `find_first(re, input).is_some()` but skips
/// allocating the `RegexMatch` value.  Performs exactly ONE
/// workspace allocation for the whole call, independent of input
/// length; never retains the subject.
///
/// **See also:** `find_first`, `is_match_view`.
pub fn is_match(re: &Regex, input: &String) nothrow -> Bool {
	val src = text._byte_source_all(input);
	var sc = _scratch_new(re.nfa.ops.len);
	val input_len = src.size();
	var start = 0;
	while start <= input_len {
		if _try_match_at_scratch(re.nfa, src, start, sc) >= 0 {
			return true;
		}
		start = start + 1;
	}
	return false;
}

/// Returns the leftmost match of `re` in `input` (greedy — longest
/// at that start), or `None` if no match exists.
///
/// Performs exactly ONE workspace allocation for the whole search,
/// independent of input length and of how many candidate starts are
/// attempted; never retains the subject.
///
/// **See also:** `is_match`, `replace_first`, `RegexMatch`.
pub fn find_first(re: &Regex, input: &String) nothrow -> Optional<RegexMatch> {
	return _find_from(re, input, 0);
}

// Search for the first match starting at byte offset `from`.
/// Internal: like `find_first` but starting search from `from`.
/// COMPATIBILITY WRAPPER: constructs one workspace per invocation, so
/// a manual advance-past-match loop performs exactly (matches + 1)
/// workspace allocations per full scan.  `replace_all` no longer uses
/// this — it shares one workspace across its entire operation.
pub fn _find_from(re: &Regex, input: &String, from: Int) nothrow -> Optional<RegexMatch> {
	val src = text._byte_source_all(input);
	var sc = _scratch_new(re.nfa.ops.len);
	return _find_from_scratch(re.nfa, src, from, sc);
}

/// Internal TEST HOOK for the epoch-overflow reset: identical to
/// `_find_from` but starts the workspace generation AT the reset
/// ceiling, so the deterministic reset fires during the search.
/// Results must be indistinguishable from `_find_from`.
pub fn _find_from_gen_saturated(re: &Regex, input: &String, from: Int) nothrow -> Optional<RegexMatch> {
	val src = text._byte_source_all(input);
	var sc = _scratch_new(re.nfa.ops.len);
	sc.gen = 9223372036854775806;
	return _find_from_scratch(re.nfa, src, from, sc);
}

// Windowed search loop (see _try_match_at_scratch).  Returned match
// offsets are WINDOW-RELATIVE.  The caller-provided workspace is
// reused across every candidate start.
fn _find_from_scratch(nfa: &_NfaProg, src: &text._StringByteSource, from: Int, sc: &mut _NfaScratch) nothrow -> Optional<RegexMatch> {
	val sublen = src.size();
	var start = from;
	while start <= sublen {
		val end = _try_match_at_scratch(nfa, src, start, sc);
		if end >= 0 {
			return Optional::Some(RegexMatch(start = start, end = end));
		}
		start = start + 1;
	}
	return Optional::None();
}

// ---------------------------------------------------------------------------
// Substring helper (nothrow, no Result) — caller must ensure valid bounds.
// Returns "" when len == 0.  Uses io.buffer for byte-level copy.
// ---------------------------------------------------------------------------

/// Internal: byte-range substring helper used by replace operations.
pub fn _substr(s: &String, start: Int, len: Int) nothrow -> String {
	if len == 0 {
		return "";
	}
	var b = io.buffer(len);
	var i = 0;
	while i < len {
		io.buffer_write(b, i, core.string_byte_at(s, start + i));
		i = i + 1;
	}
	return core.string_from_utf8_bytes(io.buffer_ptr(b), len);
}

// ---------------------------------------------------------------------------
// Replacement API — literal replacement, non-overlapping, left-to-right
//
// Semantics (frozen):
//   - Literal replacement only (no backrefs/capture interpolation).
//   - Non-overlapping, left-to-right scan.
//   - Zero-length matches advance cursor by 1 byte (forward-progress rule).
//   - Empty pattern: replace_all inserts `repl` before every byte and after
//     the last byte (N+1 insertions for N-byte input).
//   - Empty replacement: equivalent to deleting matched text.
//   - Empty input + empty pattern: replace_all returns `repl` (one match).
// ---------------------------------------------------------------------------

/// Returns a new string with the leftmost match of `re` in `input`
/// replaced by `repl`.
///
/// `repl` is a literal replacement — backreferences (`$1`, `\1`)
/// are NOT interpreted.
///
/// **See also:** `replace_all`, `find_first`.
pub fn replace_first(re: &Regex, input: &String, repl: &String) nothrow -> String {
	match _find_from(re, input, 0) {
		Optional::Some(m) => {
			val input_len = input.byte_length();
			val prefix = _substr(input, 0, m.start);
			val suffix = _substr(input, m.end, input_len - m.end);
			return prefix + *repl + suffix;
		},
		Optional::None() => {
			return *input;
		}
	}
}

/// Returns a new string with every non-overlapping match of `re` in
/// `input` replaced by `repl`.
///
/// `repl` is a literal replacement.  Empty matches are advanced
/// past one byte at a time to avoid an infinite loop.
///
/// **See also:** `replace_first`.
pub fn replace_all(re: &Regex, input: &String, repl: &String) nothrow -> String {
	val input_len = input.byte_length();
	// ONE workspace for the ENTIRE operation: every internal search
	// below reuses it.
	val src = text._byte_source_all(input);
	var sc = _scratch_new(re.nfa.ops.len);
	var result = "";
	var cursor = 0;
	while cursor <= input_len {
		match _find_from_scratch(re.nfa, src, cursor, sc) {
			Optional::Some(m) => {
				// Append text between previous cursor and match start.
				if m.start > cursor {
					result = result + _substr(input, cursor, m.start - cursor);
				}
				// Append replacement.
				result = result + *repl;
				// Forward-progress rule: if the match is zero-length,
				// advance cursor by 1 byte to avoid infinite loop.
				if m.end == m.start {
					// Copy the byte at the current position (if any)
					// before advancing past it.
					if cursor < input_len {
						result = result + _substr(input, cursor, 1);
					}
					cursor = cursor + 1;
				} else {
					cursor = m.end;
				}
			},
			Optional::None() => {
				// No more matches — append the remaining input.
				if cursor < input_len {
					result = result + _substr(input, cursor, input_len - cursor);
				}
				break;
			}
		}
	}
	return result;
}

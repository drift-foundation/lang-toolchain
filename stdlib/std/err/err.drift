module std.err;

import std.core as core;

use trait core.Diagnostic;

export {
	IteratorOpId,
	IndexError,
	IteratorInvalidated,
	ResultError,
	throw_iterator_invalidated
};

/// Identifies which iterator operation surfaced an
/// invalidation (used by `IteratorInvalidated` exceptions).
///
/// Numeric tags are ABI-stable — append-only, never reorder.
///
/// **See also:** `IteratorInvalidated`, `throw_iterator_invalidated`.
pub variant IteratorOpId {
	Next,
	Prev,
	Len,
	CompareAt,
	Swap,
	CompareKey,
}

/// Thrown when a container access uses an out-of-range index.
///
/// `container_id` identifies the container kind via its canonical
/// id (e.g. `"std.containers:Array"`, `"std.containers:Deque"`).
/// `index` is the offending index.
pub error IndexError {
	container_id: String,
	index: Int,
}

/// Thrown when an iterator is used after its underlying container
/// has been mutated.
///
/// `container_id` identifies the container; `op_id` identifies the
/// specific iterator method that surfaced the invalidation.
///
/// **See also:** `IteratorOpId`, `throw_iterator_invalidated`.
pub error IteratorInvalidated {
	container_id: String,
	op_id: IteratorOpId,
}

/// Generic throwable wrapping a `DiagnosticValue` payload.
///
/// Used by `or_throw` and other auto-conversions when a more
/// specific exception type isn't available — the error type's
/// `Throw` impl projects its state to a `DiagnosticValue` and
/// raises this exception.
pub error ResultError {
	dv: DiagnosticValue,
}

/// Convenience wrapper that constructs and throws an
/// `IteratorInvalidated` exception.
pub fn throw_iterator_invalidated(container_id: String, op_id: IteratorOpId) -> Void {
	throw IteratorInvalidated(
		container_id = container_id,
		op_id = op_id
	);
}

implement core.Copy for IteratorOpId {
}

implement core.Diagnostic for IteratorOpId {
	pub fn to_json_text(self: &IteratorOpId) nothrow -> String {
		// ABI-stable numeric tags: append-only; never reorder.
		return match self {
			Next => {
				core.diagnostic_json_int(0)
			},
			Prev => {
				core.diagnostic_json_int(1)
			},
			Len => {
				core.diagnostic_json_int(2)
			},
			CompareAt => {
				core.diagnostic_json_int(3)
			},
			Swap => {
				core.diagnostic_json_int(4)
			},
			CompareKey => {
				core.diagnostic_json_int(5)
			},
		};
	}
}

module std.meta;

import std.core as core;

export { Caller, caller, build_info, toolchain_version, runtime_abi, artifact_name, artifact_version, artifact_description, artifact_license };

/// Source-location record captured by the `caller()` intrinsic.
///
/// Carries the calling site's module id, source file path, and line
/// number.  Used by macros (e.g. `log.info!`) that need to report
/// "where was I invoked" without the user passing the location
/// explicitly.
///
/// **See also:** `caller`, `Caller.module_id`, `Caller.file`,
/// `Caller.line`.
pub struct Caller {
	module_id_v: String,
	file_v: String,
	line_v: Int
}

implement Caller {
	/// Returns the calling site's module id (e.g. `"main"`,
	/// `"acme.lib"`).
	pub fn module_id(self: &Caller) nothrow -> &String {
		return &self.module_id_v;
	}

	/// Returns the calling site's source file path.
	pub fn file(self: &Caller) nothrow -> &String {
		return &self.file_v;
	}

	/// Returns the calling site's 1-based line number.
	pub fn line(self: &Caller) nothrow -> Int {
		return self.line_v;
	}

	/// Returns the byte length of `module_id`.
	pub fn module_id_len(self: &Caller) nothrow -> Int {
		return byte_length(self.module_id_v);
	}

	/// Returns the byte length of `file`.
	pub fn file_len(self: &Caller) nothrow -> Int {
		return byte_length(self.file_v);
	}
}

/// Returns a `Caller` describing the source location of the call
/// site.
///
/// Compiler intrinsic — the returned `Caller` is computed at the
/// invoking source position, not inside the helper.  Pass through
/// macros so they can attach call-site metadata to their output.
@intrinsic pub fn caller() nothrow -> Caller;

/// Returns the artifact's build-information document.
///
/// Canonical `drift-build-info/v1` JSON, baked into the artifact at
/// compile time (no file or process I/O at runtime). Sections:
/// `toolchain` (compiler identity), `build` (build-instance facts),
/// `artifact` (manifest identity, or `null` for unstamped compiles),
/// `dependencies` (the exact package pins actually compiled against),
/// and `extra` (application metadata from `--meta`). The same
/// document is embedded verbatim in the executable's
/// `.drift_build_info` section for external readers
/// (`drift inspect build-info`).
///
/// Prefer the typed accessors below; parse this JSON directly only
/// for fields they do not cover (e.g. `extra`).
///
/// Higher-level consumers parse the `dependencies` (and `extra`)
/// sections from this document directly (see `std.cli`'s built-in
/// `--version` renderer, which reads the dependency list for its
/// `deps:` line). **See also:** `toolchain_version`, `runtime_abi`,
/// `artifact_name`. **Example:** `examples/build_info.drift`.
@intrinsic pub fn build_info() nothrow -> String;

// Private scalar intrinsics. Each value is derived by the compiler
// from the SAME assembled document `build_info()` returns — never
// independently from flags or version constants — so the accessors
// can never skew against the stamp. The artifact intrinsics use the
// empty string as the "unstamped" sentinel; that is sound because
// the document validator rejects empty artifact identity fields, so
// "" is unrepresentable as a real value. The sentinel is PRIVATE:
// public accessors return Optional<String>.
@intrinsic fn _bi_toolchain_version() nothrow -> String;
@intrinsic fn _bi_runtime_abi() nothrow -> Int;
@intrinsic fn _bi_artifact_name() nothrow -> String;
@intrinsic fn _bi_artifact_version() nothrow -> String;
@intrinsic fn _bi_artifact_description() nothrow -> String;
@intrinsic fn _bi_artifact_license() nothrow -> String;

/// Returns the compiler version this artifact was built with (e.g.
/// `"0.33.93"`).
pub fn toolchain_version() nothrow -> String {
	return _bi_toolchain_version();
}

/// Returns the runtime ABI version this artifact was built against.
pub fn runtime_abi() nothrow -> Int {
	return _bi_runtime_abi();
}

fn _optional_field(v: String) nothrow -> Optional<String> {
	if v.byte_length() == 0 {
		return Optional<type String>::None();
	}
	return Optional<type String>::Some(move v);
}

/// Returns the manifest artifact name, or `None` for an unstamped
/// compile (built without the `--artifact-*` identity flags).
pub fn artifact_name() nothrow -> Optional<String> {
	return _optional_field(_bi_artifact_name());
}

/// Returns the manifest artifact version, or `None` for an unstamped
/// compile.
pub fn artifact_version() nothrow -> Optional<String> {
	return _optional_field(_bi_artifact_version());
}

/// Returns the manifest artifact description, or `None` for an
/// unstamped compile.
pub fn artifact_description() nothrow -> Optional<String> {
	return _optional_field(_bi_artifact_description());
}

/// Returns the manifest artifact license, or `None` for an unstamped
/// compile.
pub fn artifact_license() nothrow -> Optional<String> {
	return _optional_field(_bi_artifact_license());
}

module std.concurrent;

import std.core as core;
import std.mem as mem;
import lang.thread as thread;
import lang.atomic as atomic;

use trait core.Fn0;
use trait core.Fn1;
use trait core.Copy;
use trait core.Borrow;
use trait core.BorrowMut;
use trait core.Destructible;

export {
	Duration,
	ConcurrencyError,
	VtResultNotAvailable,
	ExecSubmitFailed,
	InvalidDuration,
	MemoryOrder,
	AtomicBool,
	AtomicInt,
	AtomicUint,
	AtomicUint64,
	SaturationPolicy,
	ExecutorPolicy,
	ExecutorPolicyBuilder,
	Executor,
	Arc,
	Mutex,
	MutexGuard,
	VirtualThread,
	Future,
	FutureGroup,
	Scope,
	arc,
	mutex,
	lock,
	mutex_guard_get_mut,
	executor_policy_builder,
	build_executor,
	atomic_bool,
	atomic_int,
	atomic_uint,
	atomic_uint64,
	spawn,
	spawn_cb,
	spawn_on,
	spawn_future,
	spawn_future_on,
	future_group,
	scope,
	sleep,
	default_executor,
	set_default_executor,
	ProcessSignal,
	await_signal
};

pub struct Duration {
	// Invariant: millis >= 0 (negative durations are invalid; runtime should assert).
	pub millis: Int
}

implement core.Copy for Duration {
}

pub type MemoryOrder = atomic.MemoryOrder;
pub type AtomicBool = atomic.AtomicBool;
pub type AtomicInt = atomic.AtomicInt;
pub type AtomicUint = atomic.AtomicUint;
pub type AtomicUint64 = atomic.AtomicUint64;

pub variant ConcurrencyError {
	Timeout,
	Cancelled,
	Closed,
	Busy,
	Failed(err: Error),
}

implement core.Diagnostic for ConcurrencyError {
	pub fn to_diag(self: &ConcurrencyError) nothrow -> DiagnosticValue {
		return match self {
			Timeout => {
				DiagnosticValue::Int(-1)
			},
			Cancelled => {
				DiagnosticValue::Int(-2)
			},
			Closed => {
				DiagnosticValue::Int(-3)
			},
			Busy => {
				DiagnosticValue::Int(-4)
			},
			Failed(_) => {
				DiagnosticValue::Int(-5)
			}
		};
	}
}

implement core.Throw for ConcurrencyError {
	pub fn throw_self(self: ConcurrencyError) throws {
		match &self {
			Timeout => { throw std.err:ResultError(dv = DiagnosticValue::Int(-1)); },
			Cancelled => { throw std.err:ResultError(dv = DiagnosticValue::Int(-2)); },
			Closed => { throw std.err:ResultError(dv = DiagnosticValue::Int(-3)); },
			Busy => { throw std.err:ResultError(dv = DiagnosticValue::Int(-4)); },
			Failed(_) => { throw std.err:ResultError(dv = DiagnosticValue::Int(-5)); },
		}
	}
}

pub fn atomic_bool(v: Bool) nothrow -> AtomicBool {
	return atomic.atomic_bool(v);
}

pub fn atomic_int(v: Int) nothrow -> AtomicInt {
	return atomic.atomic_int(v);
}

pub fn atomic_uint(v: Uint) nothrow -> AtomicUint {
	return atomic.atomic_uint(v);
}

pub fn atomic_uint64(v: Uint64) nothrow -> AtomicUint64 {
	return atomic.atomic_uint64(v);
}

pub exception VtResultNotAvailable();
pub exception ExecSubmitFailed(code: Int);
pub exception InvalidDuration(millis: Int);

// Process signal types delivered by await_signal().  Linux only.
pub variant ProcessSignal {
	Interrupt,   // SIGINT (Ctrl-C)
	Terminate,   // SIGTERM
}

pub variant SaturationPolicy {
	Block,
	ReturnBusy,
}

pub struct ExecutorPolicy {
	min_threads: Int,
	max_threads: Int,
	queue_limit: Int,
	timeout: Duration,
	on_saturation: SaturationPolicy,
	stack_bytes: Int,
}

implement core.Copy for ExecutorPolicy {
}

pub struct ExecutorPolicyBuilder {
	min_threads: Int,
	max_threads: Int,
	queue_limit: Int,
	timeout: Duration,
	on_saturation: SaturationPolicy,
	stack_bytes: Int,
}

pub struct Executor {
	policy: ExecutorPolicy,
	handle: Int
}

implement core.Copy for Executor {
}

pub struct VirtualThread<T> {
	joined: Bool,
	handle: Int,
	result: mem.RawBuffer<T>,
	cancelled: Bool,
	submit_error: Int
}

pub struct Scope {
}

pub struct Future<T> {
	vt: VirtualThread<T>
}

pub struct FutureGroup<T> {
	items: Array<Future<T>>
}

pub struct ArcBox<T> {
	count: atomic.AtomicInt,
	value: T
}

pub struct Arc<T> {
	buf: mem.RawBuffer<ArcBox<T>>
}

pub struct Mutex<T> {
	locked: atomic.AtomicBool,
	value: T
}

pub struct MutexGuard<T> {
	mtx: &Mutex<T>,
	value_ptr: mem.Ptr<T>
}

pub fn arc<T>(var value: T) nothrow -> Arc<T> {
	unsafe {
		var buf = mem.alloc_uninit<type ArcBox<T>>(1);
		var box = ArcBox<type T>(count = atomic_int(1), value = move value);
		mem.write<type ArcBox<T>>(&mut buf, 0, move box);
		return Arc<type T>(buf = move buf);
	}
}

implement<T> Arc<T> {
	pub fn clone(self: &Arc<T>) nothrow -> Arc<T> {
		unsafe {
			val slot = mem.ptr_at_ref<type ArcBox<T>>(&self.buf, 0);
			val _ = atomic.atomic_fetch_add_int(&slot.count, 1, 0);
		}
		val buf_ptr = mem.rawbuffer_ptr<type ArcBox<T>>(&self.buf);
		val buf_cap = mem.rawbuffer_cap<type ArcBox<T>>(&self.buf);
		return Arc<type T>(buf = mem.rawbuffer_from_parts<type ArcBox<T>>(buf_ptr, buf_cap));
	}

	pub fn get(self: &Arc<T>) nothrow -> &T {
		unsafe {
			val slot = mem.ptr_at_ref<type ArcBox<T>>(&self.buf, 0);
			return &slot.value;
		}
	}

	pub fn get_mut(self: &mut Arc<T>) nothrow -> &mut T {
		unsafe {
			val slot = mem.ptr_at_mut<type ArcBox<T>>(&mut self.buf, 0);
			return &mut slot.value;
		}
	}
}

implement<T> core.Borrow<T> for Arc<T> {
	pub fn borrow(self: &Arc<T>) nothrow -> &T {
		return self.get();
	}
}

implement<T> core.BorrowMut<T> for Arc<T> {
	pub fn borrow_mut(self: &mut Arc<T>) nothrow -> &mut T {
		return self.get_mut();
	}
}

implement<T> core.Destructible for Arc<T> {
	pub fn destroy(var self: Arc<T>) nothrow -> Void {
		unsafe {
			// Moved-from Arc values are represented as zero/raw-null buffers.
			// Dropping that sentinel must be a no-op.
			val ptr = mem.rawbuffer_ptr<type ArcBox<T>>(&self.buf);
			if mem.ptr_is_null<type Byte>(ptr) {
				return;
			}
		}
		var prev = 0;
		unsafe {
			val slot = mem.ptr_at_ref<type ArcBox<T>>(&self.buf, 0);
			prev = atomic.atomic_fetch_sub_int(&slot.count, 1, 2);
		}
		if prev == 1 {
			unsafe {
				// Acquire barrier pairs with prior Release decrements before final destroy.
				val slot = mem.ptr_at_ref<type ArcBox<T>>(&self.buf, 0);
				val _ = atomic.atomic_load_int(&slot.count, 1);
				var buf = self.buf;
				var inner = mem.read<type ArcBox<T>>(&mut buf, 0);
				core.drop_value<type ArcBox<T>>(inner);
				mem.dealloc<type ArcBox<T>>(buf);
			}
		}
	}
}

pub fn mutex<T>(value: T) nothrow -> Mutex<T> {
	return Mutex<type T>(locked = atomic_bool(false), value = value);
}

pub fn lock<T>(m: &Mutex<T>) nothrow -> MutexGuard<T> {
	while not atomic.atomic_compare_exchange_bool(&m.locked, false, true, 1, 0) {
	}
	unsafe {
		val vp = mem.ptr_from_ref<type T>(&m.value);
		return MutexGuard<type T>(mtx = m, value_ptr = vp);
	}
}

pub fn mutex_guard_get_mut<T>(g: &mut MutexGuard<T>) nothrow -> &mut T {
	unsafe {
		return mem.ptr_as_mut_ref<type T>(g.value_ptr);
	}
}

implement<T> Mutex<T> {
	pub fn lock(self: &Mutex<T>) nothrow -> MutexGuard<T> {
		while not atomic.atomic_compare_exchange_bool(&self.locked, false, true, 1, 0) {
		}
		unsafe {
			val vp = mem.ptr_from_ref<type T>(&self.value);
			return MutexGuard<type T>(mtx = self, value_ptr = vp);
		}
	}
}

implement<T> MutexGuard<T> {
	pub fn get_mut(self: &mut MutexGuard<T>) nothrow -> &mut T {
		unsafe {
			return mem.ptr_as_mut_ref<type T>(self.value_ptr);
		}
	}
}

implement<T> core.BorrowMut<T> for MutexGuard<T> {
	pub fn borrow_mut(self: &mut MutexGuard<T>) nothrow -> &mut T {
		return self.get_mut();
	}
}

implement<T> core.Destructible for MutexGuard<T> {
	pub fn destroy(self: MutexGuard<T>) nothrow -> Void {
		atomic.atomic_store_bool(&self.mtx.locked, false, 2);
	}
}


pub fn executor_policy_builder() nothrow -> ExecutorPolicyBuilder {
	return ExecutorPolicyBuilder(
		min_threads = 1,
		max_threads = 1,
		queue_limit = 0,
		timeout = Duration(millis = 0),
		on_saturation = SaturationPolicy::ReturnBusy(),
		stack_bytes = 262144
	);
}

implement ExecutorPolicyBuilder {
	pub fn min_threads(self: &mut ExecutorPolicyBuilder, v: Int) nothrow -> &mut ExecutorPolicyBuilder {
		self.min_threads = v;
		return self;
	}

	pub fn max_threads(self: &mut ExecutorPolicyBuilder, v: Int) nothrow -> &mut ExecutorPolicyBuilder {
		self.max_threads = v;
		return self;
	}

	pub fn queue_limit(self: &mut ExecutorPolicyBuilder, v: Int) nothrow -> &mut ExecutorPolicyBuilder {
		self.queue_limit = v;
		return self;
	}

	pub fn timeout(self: &mut ExecutorPolicyBuilder, v: Duration) nothrow -> &mut ExecutorPolicyBuilder {
		self.timeout = v;
		return self;
	}

	pub fn on_saturation(self: &mut ExecutorPolicyBuilder, var v: SaturationPolicy) nothrow -> &mut ExecutorPolicyBuilder {
		self.on_saturation = move v;
		return self;
	}

	pub fn stack_bytes(self: &mut ExecutorPolicyBuilder, v: Int) nothrow -> &mut ExecutorPolicyBuilder {
		self.stack_bytes = v;
		return self;
	}

	pub fn build(self: &ExecutorPolicyBuilder) nothrow -> ExecutorPolicy {
		return ExecutorPolicy(
			min_threads = self.min_threads,
			max_threads = self.max_threads,
			queue_limit = self.queue_limit,
			timeout = self.timeout,
			on_saturation = self.on_saturation,
			stack_bytes = self.stack_bytes
		);
	}

	pub fn build_executor(self: &ExecutorPolicyBuilder) nothrow -> Executor {
		var policy = self.build();
		var sat = 0;
		match policy.on_saturation {
			ReturnBusy => { sat = 1; },
			default => { sat = 0; },
		}
		var handle = thread.exec_create(
			policy.min_threads,
			policy.max_threads,
			policy.queue_limit,
			policy.timeout.millis,
			sat,
			policy.stack_bytes
		);
		return Executor(policy = policy, handle = handle);
	}
}

pub fn default_executor() nothrow -> Executor {
	var b = executor_policy_builder();
	var h = thread.exec_default_get();
	if h == 0 {
		var exec = b.build_executor();
		thread.exec_default_set(exec.handle);
		return exec;
	}
	return Executor(policy = b.build(), handle = h);
}

pub fn build_executor(policy: ExecutorPolicy) nothrow -> Executor {
	var sat = 0;
	match policy.on_saturation {
		ReturnBusy => { sat = 1; },
		default => { sat = 0; },
	}
	var handle = thread.exec_create(
		policy.min_threads,
		policy.max_threads,
		policy.queue_limit,
		policy.timeout.millis,
		sat,
		policy.stack_bytes
	);
	return Executor(policy = policy, handle = handle);
}

pub fn set_default_executor(exec: Executor) nothrow -> Void {
	thread.exec_default_set(exec.handle);
	return;
}

pub fn spawn<T>(var cb: core.Callback0<T>) nothrow -> VirtualThread<T> {
	var exec = default_executor();
	unsafe {
		var buf = mem.alloc_uninit<type T>(1);
		val ptr = mem.rawbuffer_ptr<type T>(&buf);
		val cap = mem.rawbuffer_cap<type T>(&buf);
		var buf_for_cb = mem.rawbuffer_from_parts<type T>(ptr, cap);
		var buf_for_join = mem.rawbuffer_from_parts<type T>(ptr, cap);
		var thunk: core.Callback0<Void> = core.callback0(| | captures(move cb, move buf_for_cb) => {
			unsafe {
				var v = cb.call();
				mem.write(&mut buf_for_cb, 0, move v);
			}
			return;
		});
		var h = thread.vt_spawn(thunk, exec.handle);
		val submit_code = thread.exec_submit(exec.handle, h);
		if submit_code != 0 {
			val ptr2 = mem.rawbuffer_ptr<type T>(&buf_for_join);
			val cap2 = mem.rawbuffer_cap<type T>(&buf_for_join);
			var buf2 = mem.rawbuffer_from_parts<type T>(ptr2, cap2);
			mem.dealloc<type T>(buf2);
			thread.vt_drop(h);
			return VirtualThread<type T>(joined = false, handle = 0, result = move buf_for_join, cancelled = false, submit_error = submit_code);
		}
		return VirtualThread<type T>(joined = false, handle = h, result = move buf_for_join, cancelled = false, submit_error = 0);
	}
}

pub fn spawn_cb<T>(var cb: core.Callback0<T>) nothrow -> VirtualThread<T> {
	var exec = default_executor();
	unsafe {
		var buf = mem.alloc_uninit<type T>(1);
		val ptr = mem.rawbuffer_ptr<type T>(&buf);
		val cap = mem.rawbuffer_cap<type T>(&buf);
		var buf_for_cb = mem.rawbuffer_from_parts<type T>(ptr, cap);
		var buf_for_join = mem.rawbuffer_from_parts<type T>(ptr, cap);
		var thunk: core.Callback0<Void> = core.callback0(| | captures(move cb, move buf_for_cb) => {
			unsafe {
				var v = cb.call();
				mem.write(&mut buf_for_cb, 0, move v);
			}
			return;
		});
		var h = thread.vt_spawn(thunk, exec.handle);
		val submit_code = thread.exec_submit(exec.handle, h);
		if submit_code != 0 {
			val ptr2 = mem.rawbuffer_ptr<type T>(&buf_for_join);
			val cap2 = mem.rawbuffer_cap<type T>(&buf_for_join);
			var buf2 = mem.rawbuffer_from_parts<type T>(ptr2, cap2);
			mem.dealloc<type T>(buf2);
			thread.vt_drop(h);
			return VirtualThread<type T>(joined = false, handle = 0, result = move buf_for_join, cancelled = false, submit_error = submit_code);
		}
		return VirtualThread<type T>(joined = false, handle = h, result = move buf_for_join, cancelled = false, submit_error = 0);
	}
}

pub fn spawn_on<T>(exec: Executor, var cb: core.Callback0<T>) nothrow -> core.Result<VirtualThread<T>, ConcurrencyError> {
	unsafe {
		var buf = mem.alloc_uninit<type T>(1);
		val ptr = mem.rawbuffer_ptr<type T>(&buf);
		val cap = mem.rawbuffer_cap<type T>(&buf);
		var buf_for_cb = mem.rawbuffer_from_parts<type T>(ptr, cap);
		var buf_for_join = mem.rawbuffer_from_parts<type T>(ptr, cap);
		var thunk: core.Callback0<Void> = core.callback0(| | captures(move cb, move buf_for_cb) => {
			unsafe {
				var v = cb.call();
				mem.write(&mut buf_for_cb, 0, move v);
			}
			return;
		});
		var h = thread.vt_spawn(thunk, exec.handle);
		var submit_code = thread.exec_submit(exec.handle, h);
		if submit_code == 0 {
			return core.Result::Ok(VirtualThread<type T>(joined = false, handle = h, result = move buf_for_join, cancelled = false, submit_error = 0));
		}
		val ptr2 = mem.rawbuffer_ptr<type T>(&buf_for_join);
		val cap2 = mem.rawbuffer_cap<type T>(&buf_for_join);
		var buf2 = mem.rawbuffer_from_parts<type T>(ptr2, cap2);
		mem.dealloc<type T>(buf2);
		thread.vt_drop(h);
		if submit_code == 1 {
			return core.Result::Err(ConcurrencyError::Busy());
		}
		if submit_code == 2 {
			return core.Result::Err(ConcurrencyError::Timeout());
		}
		try {
			throw ExecSubmitFailed(code = submit_code);
		} catch e {
			return core.Result::Err(ConcurrencyError::Failed(e));
		}
	}
}

pub fn spawn_future<T>(var cb: core.Callback0<T>) nothrow -> Future<T> {
	var vt = spawn<type T>(move cb);
	return Future<type T>(move vt);
}

pub fn spawn_future_on<T>(exec: Executor, var cb: core.Callback0<T>) nothrow -> core.Result<Future<T>, ConcurrencyError> {
	var res = spawn_on<type T>(exec, move cb);
	return match res {
		Ok(vt) => { core.Result::Ok(Future<type T>(vt)) },
		Err(err) => { core.Result::Err(err) },
		default => { core.Result::Err(ConcurrencyError::Busy()) }
	};
}

pub fn future_group<T>() nothrow -> FutureGroup<T> {
	var items: Array<Future<T>> = [];
	return FutureGroup<type T>(move items);
}

fn _check_duration(d: Duration) nothrow -> core.Result<Void, ConcurrencyError> {
	if d.millis < 0 {
		try {
			throw InvalidDuration(millis = d.millis);
		} catch e {
			return core.Result::Err(ConcurrencyError::Failed(e));
		}
	}
	return core.Result::Ok(core.void_value());
}


implement<T> VirtualThread<T> {
	pub fn join(self: &mut VirtualThread<T>) nothrow -> core.Result<T, ConcurrencyError> {
		if self.joined {
			return core.Result::Err(ConcurrencyError::Closed());
		}
		if self.submit_error != 0 {
			var code = self.submit_error;
			self.joined = true;
			self.handle = 0;
			try {
				throw ExecSubmitFailed(code = code);
			} catch e {
				return core.Result::Err(ConcurrencyError::Failed(e));
			}
		}
		if self.cancelled {
			thread.vt_join(self.handle);
			self.joined = true;
			self.handle = 0;
			unsafe {
				val ptr = mem.rawbuffer_ptr<type T>(&self.result);
				val cap = mem.rawbuffer_cap<type T>(&self.result);
				var buf = mem.rawbuffer_from_parts<type T>(ptr, cap);
				mem.dealloc<type T>(buf);
			}
			return core.Result::Err(ConcurrencyError::Cancelled());
		}
		thread.vt_join(self.handle);
		self.joined = true;
		self.handle = 0;
		unsafe {
			var v = mem.read<type T>(&mut self.result, 0);
			val ptr = mem.rawbuffer_ptr<type T>(&self.result);
			val cap = mem.rawbuffer_cap<type T>(&self.result);
			var buf = mem.rawbuffer_from_parts<type T>(ptr, cap);
			mem.dealloc<type T>(buf);
			return core.Result::Ok(move v);
		}
	}

	pub fn join_timeout(self: &mut VirtualThread<T>, d: Duration) nothrow -> core.Result<T, ConcurrencyError> {
		var ok = _check_duration(d);
		match ok {
			Err(err) => { return core.Result::Err(err); },
			Ok(_) => { }
		}
		if self.joined {
			return core.Result::Err(ConcurrencyError::Closed());
		}
		if self.submit_error != 0 {
			var code = self.submit_error;
			self.joined = true;
			self.handle = 0;
			try {
				throw ExecSubmitFailed(code = code);
			} catch e {
				return core.Result::Err(ConcurrencyError::Failed(e));
			}
		}
		if self.cancelled {
			thread.vt_join(self.handle);
			self.joined = true;
			self.handle = 0;
			unsafe {
				val ptr = mem.rawbuffer_ptr<type T>(&self.result);
				val cap = mem.rawbuffer_cap<type T>(&self.result);
				var buf = mem.rawbuffer_from_parts<type T>(ptr, cap);
				mem.dealloc<type T>(buf);
			}
			return core.Result::Err(ConcurrencyError::Cancelled());
		}
		var done = thread.vt_is_completed(self.handle);
		if done != 0 {
			thread.vt_join(self.handle);
			self.joined = true;
			self.handle = 0;
			unsafe {
				var v = mem.read<type T>(&mut self.result, 0);
				val ptr = mem.rawbuffer_ptr<type T>(&self.result);
				val cap = mem.rawbuffer_cap<type T>(&self.result);
				var buf = mem.rawbuffer_from_parts<type T>(ptr, cap);
				mem.dealloc<type T>(buf);
				return core.Result::Ok(move v);
			}
		}
		if d.millis == 0 {
			return core.Result::Err(ConcurrencyError::Timeout());
		}
		var code = thread.vt_join_timeout(self.handle, d.millis);
		if code != 0 {
			return core.Result::Err(ConcurrencyError::Timeout());
		}
		self.joined = true;
		self.handle = 0;
		unsafe {
			var v = mem.read<type T>(&mut self.result, 0);
			val ptr = mem.rawbuffer_ptr<type T>(&self.result);
			val cap = mem.rawbuffer_cap<type T>(&self.result);
			var buf = mem.rawbuffer_from_parts<type T>(ptr, cap);
			mem.dealloc<type T>(buf);
			return core.Result::Ok(move v);
		}
	}

	pub fn cancel(self: &mut VirtualThread<T>) nothrow -> Void {
		if self.joined {
			return;
		}
		if self.handle == 0 {
			return;
		}
		var ok = thread.vt_cancel(self.handle);
		if ok == 0 {
			self.cancelled = true;
		}
		return;
	}
}

implement<T> core.Destructible for VirtualThread<T> {
	pub fn destroy(var self: VirtualThread<T>) nothrow -> Void {
		if self.joined {
			return;
		}
		if self.handle != 0 {
			thread.vt_drop(self.handle);
		}
		unsafe {
			val ptr = mem.rawbuffer_ptr<type T>(&self.result);
			val cap = mem.rawbuffer_cap<type T>(&self.result);
			var buf = mem.rawbuffer_from_parts<type T>(ptr, cap);
			mem.dealloc<type T>(buf);
		}
	}
}

implement<T> Future<T> {
	pub fn join(self: &mut Future<T>) nothrow -> core.Result<T, ConcurrencyError> {
		return self.vt.join();
	}

	pub fn join_timeout(self: &mut Future<T>, d: Duration) nothrow -> core.Result<T, ConcurrencyError> {
		return self.vt.join_timeout(d);
	}

	pub fn cancel(self: &mut Future<T>) nothrow -> Void {
		self.vt.cancel();
		return;
	}

	pub fn is_done(self: &Future<T>) nothrow -> Bool {
		return self.vt.joined;
	}
}

implement<T> FutureGroup<T> require T is core.Copy {
	pub fn add(self: &mut FutureGroup<T>, var f: Future<T>) nothrow -> Void {
		self.items.push(move f);
		return;
	}

	pub fn join_all(self: &mut FutureGroup<T>) nothrow -> core.Result<Array<T>, ConcurrencyError> {
		var out: Array<T> = [];
		var i: Int = 0;
		while i < self.items.len {
			var res = self.items[i].join();
			match res {
				Ok(v) => { out.push(v); },
				Err(err) => { return core.Result::Err(err); },
				default => { return core.Result::Err(ConcurrencyError::Busy()); }
			}
			i += 1;
		}
		return core.Result::Ok(out);
	}

	pub fn join_any(self: &mut FutureGroup<T>) nothrow -> core.Result<T, ConcurrencyError> {
		if self.items.len == 0 {
			return core.Result::Err(ConcurrencyError::Timeout());
		}
		while true {
			var i: Int = 0;
			var pending: Bool = false;
			while i < self.items.len {
				var f = &mut self.items[i];
				if f.vt.joined {
					i += 1;
					continue;
				}
				pending = true;
				var done = thread.vt_is_completed(f.vt.handle);
				if done != 0 {
					unsafe {
						var v = mem.read<type T>(&mut f.vt.result, 0);
						return core.Result::Ok(v);
					}
				}
				i += 1;
			}
			if !pending {
				return core.Result::Err(ConcurrencyError::Closed());
			}
			var me = thread.vt_current();
			if me != 0 {
				thread.vt_park_until(thread.now_ms() + 1);
			} else {
				thread.vt_park_until(1);
			}
		}
		return core.Result::Err(ConcurrencyError::Timeout());
	}
}

pub fn scope<F>(f: F) -> core.Result<Void, ConcurrencyError> require F is core.Fn1<Scope, Void> {
	var s = Scope();
	f.call(move s);
	return core.Result::Ok(core.void_value());
}

pub fn sleep(d: Duration) nothrow -> core.Result<Void, ConcurrencyError> {
	var ok = _check_duration(d);
	match ok {
		Err(err) => { return core.Result::Err(err); },
		Ok(_) => { }
	}
	if d.millis == 0 {
		return core.Result::Err(ConcurrencyError::Timeout());
	}
	var deadline = thread.now_ms() + d.millis;
	var vt = thread.vt_current();
	if vt == 0 {
		thread.vt_park_until(d.millis);
		return core.Result::Ok(core.void_value());
	}
	thread.reactor_register_timer(deadline, vt);
	thread.vt_park_until(deadline);
	return core.Result::Ok(core.void_value());
}

// Block the calling virtual thread until a supported process signal is
// delivered, then return which signal was received.
//
// Contract (normative):
//
//   Platform support
//     Linux only. Other platforms are not supported and the runtime makes no
//     guarantees about behavior off Linux.
//
//   Supported signals
//     - SIGINT  -> ProcessSignal::Interrupt   (typically Ctrl-C)
//     - SIGTERM -> ProcessSignal::Terminate
//     No other signals are observable through this API. Signals outside this
//     set continue to follow their default disposition and are not delivered
//     to the waiter.
//
//   Single-waiter rule
//     At most one virtual thread per process may be blocked in
//     await_signal() at a time. The intended use is a single shutdown
//     coordinator near main(). Calling await_signal() concurrently from a
//     second VT while another is already waiting is a hard program error and
//     aborts the process with a diagnostic; it is not a recoverable
//     exception. After the in-flight call returns, a subsequent call from
//     another VT is allowed.
//
//   Throw contract
//     nothrow. The function returns a ProcessSignal on success and aborts on
//     misuse; there is no error result type to inspect.
//
//   Delivery semantics
//     The call blocks until exactly one supported signal is delivered, then
//     returns. It does not coalesce or queue subsequent signals; to react to
//     repeated signals, call await_signal() again.
pub fn await_signal() nothrow -> ProcessSignal {
	val signo = thread.signal_await();
	if signo == 15 {
		return ProcessSignal::Terminate();
	}
	return ProcessSignal::Interrupt();
}

pub fn block_on_io(fd: Int, interest: Int, deadline_ms: Int) nothrow -> Void {
	var vt = thread.vt_current();
	if vt == 0 {
		return;
	}
	thread.reactor_register_io(fd, interest, vt, deadline_ms);
	if deadline_ms > 0 {
		thread.vt_park_until(deadline_ms);
	} else {
		thread.vt_park(0);
	}
	return;
}

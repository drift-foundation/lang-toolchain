module std.concurrent;

import std.core as core;
import std.core.shareable as shareable;
import std.mem as mem;
import lang.thread as thread;
import lang.atomic as atomic;

use trait core.Fn0;
use trait core.Fn1;
use trait core.Copy;
use trait shareable.Share;
use trait core.Borrow;
use trait core.BorrowMut;
use trait core.Destructible;

export {
	Duration,
	ConcurrencyError,
	CONCURRENCY_KIND_TIMEOUT,
	CONCURRENCY_KIND_CANCELLED,
	CONCURRENCY_KIND_CLOSED,
	CONCURRENCY_KIND_BUSY,
	CONCURRENCY_KIND_FAILED,
	VtResultNotAvailable,
	ExecSubmitFailed,
	InvalidDuration,
	MemoryOrder,
	AtomicBool,
	AtomicInt,
	AtomicUint,
	AtomicUint64,
	SaturationPolicy,
	ExecutorPolicy,
	ExecutorPolicyBuilder,
	Executor,
	Mutex,
	MutexGuard,
	Condvar,
	VirtualThread,
	Future,
	FutureGroup,
	Scope,
	mutex,
	lock,
	mutex_guard_get_mut,
	condvar,
	CONCURRENCY_KIND_REQUIRES_VTHREAD,
	executor_policy_builder,
	build_executor,
	atomic_bool,
	atomic_int,
	atomic_uint,
	atomic_uint64,
	spawn,
	spawn_cb,
	spawn_on,
	spawn_future,
	spawn_future_on,
	future_group,
	scope,
	sleep,
	yield_now,
	default_executor,
	set_default_executor,
	ProcessSignal,
	await_signal,
	Sender,
	Receiver,
	ChannelHalves,
	channel,
	// 0.33.80 blocking-FFI facility surface (export omission fixed in
	// 0.33.81 — the declarations were pub from day one, but without
	// export{} entries the TYPE was unnameable cross-module, blocking
	// the store-your-executor integration shape the facility's own
	// docs prescribe).
	BlockingExecutor,
	blocking_executor_builder,
	build_blocking_executor,
	spawn_blocking_on,
	run_blocking_on,
	spawn_on_labeled
};

// Source compatibility for `Arc<T>` / `arc()`.  These moved to
// `std.core` — their semantic contract is shared ownership, not
// concurrency (atomic refcounts is implementation, not contract).
// User code that imports `std.concurrent as conc` and writes
// `conc.Arc<T>` / `conc.arc(value)` continues to compile against
// the same type identity (`std.core.arc.Arc<T>`).  See ABI 11
// history entry for the relocation.
//
// `Arc` / `arc()` come through the submodule re-export below.
// `arc()` lives directly in `std.core.arc` (alongside `Arc<T>`) so
// the wildcard re-export covers it without a trampoline — and so
// `core.arc(...)` in user code disambiguates cleanly between the
// function and the submodule (the function wins because the
// wildcard pulls it into `std.core`'s symbol table).
//
// No matching `import std.core.arc as ...` line is needed for this
// re-export to resolve: the export-path is module-qualified, so
// the parser walks it directly.  The `ArcHeader` / `ArcBox` types
// are not in `std.core.arc`'s export list — they are
// allocation-layout internals and never were public API.
export { std.core.arc.* };

/// Span of time used by timeouts, sleeps, and join deadlines, measured
/// in milliseconds.
///
/// Invariant: `millis >= 0`.  Negative values are rejected at runtime
/// by the helpers that consume `Duration` (notably `sleep` and
/// `VirtualThread.join_timeout`), which return
/// `Err(ConcurrencyError(kind = CONCURRENCY_KIND_FAILED, code = -5))`.  `Duration`
/// is `Copy`, so it can be passed around freely.
///
/// **See also:** `sleep`, `VirtualThread.join_timeout`,
/// `InvalidDuration`.
pub struct Duration {
	pub millis: Int
}

implement core.Copy for Duration {
}

/// Re-export of `lang.atomic.MemoryOrder` — the memory ordering tag
/// passed to atomic load/store/RMW operations.
pub type MemoryOrder = atomic.MemoryOrder;

/// Re-export of `lang.atomic.AtomicBool` — atomic `Bool` cell with
/// load / store / compare-exchange operations.
pub type AtomicBool = atomic.AtomicBool;

/// Re-export of `lang.atomic.AtomicInt` — atomic `Int` cell with
/// load / store / fetch-add / compare-exchange operations.
pub type AtomicInt = atomic.AtomicInt;

/// Re-export of `lang.atomic.AtomicUint` — atomic `Uint` cell.
pub type AtomicUint = atomic.AtomicUint;

/// Re-export of `lang.atomic.AtomicUint64` — atomic `Uint64` cell.
pub type AtomicUint64 = atomic.AtomicUint64;

/// Error returned by `std.concurrent` operations that may fail or
/// be canceled.
///
/// Flat shape (`pub error`) with a string `kind` discriminator and
/// integer `code`:
///
///   * `kind == CONCURRENCY_KIND_TIMEOUT` — the operation's deadline
///     elapsed before a result was produced (`sleep`, `join_timeout`,
///     `FutureGroup.join_any` on an empty group).
///   * `kind == CONCURRENCY_KIND_CANCELLED` — the target was canceled
///     before it completed.
///   * `kind == CONCURRENCY_KIND_CLOSED` — the handle has already
///     been joined or otherwise consumed.
///   * `kind == CONCURRENCY_KIND_BUSY` — an executor or queue rejected
///     the submission because of saturation.
///   * `kind == CONCURRENCY_KIND_FAILED` — wraps a deeper failure
///     when no other kind fits (e.g. an executor's `ExecSubmitFailed`
///     or `InvalidDuration`).  `code` carries a stable sentinel
///     (`-5`); the originating Error envelope is not preserved across
///     the carrier.
///
/// `pub error`: the compiler synthesizes `core.Throw` and
/// `core.Diagnostic`; `or_throw()` and auto-try unwrap it directly.
pub error ConcurrencyError {
	kind: String,
	code: Int,
}

/// `ConcurrencyError.kind` discriminator: deadline elapsed.
pub const CONCURRENCY_KIND_TIMEOUT: String = "timeout";

/// `ConcurrencyError.kind` discriminator: target was canceled.
pub const CONCURRENCY_KIND_CANCELLED: String = "cancelled";

/// `ConcurrencyError.kind` discriminator: handle already consumed.
pub const CONCURRENCY_KIND_CLOSED: String = "closed";

/// `ConcurrencyError.kind` discriminator: executor / queue saturated.
pub const CONCURRENCY_KIND_BUSY: String = "busy";

/// `ConcurrencyError.kind` discriminator: wraps a deeper failure.
pub const CONCURRENCY_KIND_FAILED: String = "failed";

/// `ConcurrencyError.kind` discriminator: operation requires a VT
/// context but was called outside one.  Used by `Condvar.wait` /
/// `wait_timeout` / `wait_until` when invoked from a non-VT
/// caller (analogue of `std.net`'s `NET_ERROR_KIND_REQUIRES_VTHREAD`).
pub const CONCURRENCY_KIND_REQUIRES_VTHREAD: String = "requires_vthread";

// Wait-kind tags passed to `thread.vt_set_wait` so the runtime liveness
// interrogator (`kill -USR2 <pid>`) can report what a parked VT is waiting on.
// These MUST match `enum DriftWaitKind` in
// `lang/language_runtime/posix/liveness_runtime.h`.  Only the kinds annotated
// from Drift are listed here; JOIN/IO are tagged in the C runtime, and Mutex
// is absent (it spins, so contention surfaces as a long-RUNNING VT).  Channel
// waits surface as CONDVAR since the channel blocks on an internal condvar.
const WAIT_KIND_TIMER: Int = 1;
const WAIT_KIND_CONDVAR: Int = 4;

/// Constructs an atomic `Bool` cell initialized to `v`.
///
/// **See also:** `AtomicBool`, `atomic_int`.
pub fn atomic_bool(v: Bool) nothrow -> AtomicBool {
	return atomic.atomic_bool(v);
}

/// Constructs an atomic `Int` cell initialized to `v`.
///
/// **See also:** `AtomicInt`, `atomic_uint`.
pub fn atomic_int(v: Int) nothrow -> AtomicInt {
	return atomic.atomic_int(v);
}

/// Constructs an atomic `Uint` cell initialized to `v`.
///
/// **See also:** `AtomicUint`, `atomic_uint64`.
pub fn atomic_uint(v: Uint) nothrow -> AtomicUint {
	return atomic.atomic_uint(v);
}

/// Constructs an atomic `Uint64` cell initialized to `v`.
///
/// **See also:** `AtomicUint64`.
pub fn atomic_uint64(v: Uint64) nothrow -> AtomicUint64 {
	return atomic.atomic_uint64(v);
}

/// Reserved exception type for "join produced no value" situations.
/// Currently unused — retained for forward compatibility.
pub error VtResultNotAvailable {}

/// Carries the runtime submit-failure code wrapped by
/// `ConcurrencyError(kind=CONCURRENCY_KIND_FAILED)` when an executor rejects a `spawn_on`
/// submission for a reason other than saturation or timeout.
///
/// `code` is the platform-specific error code; the catching site
/// typically maps it to a coarse `ConcurrencyError` variant.
pub error ExecSubmitFailed {
	code: Int,
}

/// Carries the offending value when a `Duration`-taking helper is
/// called with `millis < 0`.  Wrapped by
/// `ConcurrencyError(kind = CONCURRENCY_KIND_FAILED, code = -5)`.
pub error InvalidDuration {
	millis: Int,
}

/// Process signal types delivered by `await_signal`.  Linux only.
///
/// `Interrupt` is `SIGINT` (typically `Ctrl-C`).  `Terminate` is
/// `SIGTERM`.  `User1` is `SIGUSR1` — an application-controlled signal
/// (e.g. a configuration/plugin reload trigger); it shares the same
/// single-waiter signalfd path and does not collide with the liveness
/// interrogator's `SIGUSR2`.  No other signals are observable through
/// this API.
///
/// **See also:** `await_signal`.
pub variant ProcessSignal {
	Interrupt,
	Terminate,
	User1,
}

/// Policy controlling what an executor does when its task queue is
/// saturated (full).
///
/// `Block` — the submitter blocks until queue space opens up or the
/// executor's submit timeout elapses.  `ReturnBusy` — the submitter
/// is rejected immediately with `ConcurrencyError(kind=CONCURRENCY_KIND_BUSY)`.
///
/// **See also:** `ExecutorPolicyBuilder.on_saturation`.
pub variant SaturationPolicy {
	Block,
	ReturnBusy,
}

/// Frozen configuration for an `Executor`.
///
/// Built via `ExecutorPolicyBuilder` and consumed by `build_executor`.
/// Marked `Copy` so it can be reused across multiple executor
/// constructions.  The fields are private; configuration is via the
/// builder.
///
/// **See also:** `ExecutorPolicyBuilder`, `build_executor`,
/// `default_executor`.
pub struct ExecutorPolicy {
	min_threads: Int,
	max_threads: Int,
	queue_limit: Int,
	timeout: Duration,
	on_saturation: SaturationPolicy,
	stack_bytes: Int,
}

implement core.Copy for ExecutorPolicy {
}

/// Mutable builder for `ExecutorPolicy`.
///
/// Constructed via `executor_policy_builder()` with conservative
/// defaults (1 worker, no queue limit, immediate timeout, return-busy
/// on saturation, 256 KiB stack).  Configurator methods mutate the
/// builder in place and return `&mut Self` for chaining.  Call
/// `.build()` to freeze into an `ExecutorPolicy`, or
/// `.build_executor()` to construct the running `Executor` directly.
///
/// **See also:** `executor_policy_builder`,
/// `ExecutorPolicyBuilder.build`, `ExecutorPolicyBuilder.build_executor`.
pub struct ExecutorPolicyBuilder {
	min_threads: Int,
	max_threads: Int,
	queue_limit: Int,
	timeout: Duration,
	on_saturation: SaturationPolicy,
	stack_bytes: Int,
}

/// Handle to a running thread-pool executor.
///
/// Construct via `build_executor(policy)` or `default_executor()`.
/// `Executor` is `Copy` — the underlying handle is shared, not owned
/// by any particular value.  Pass to `spawn_on` / `spawn_future_on`
/// to submit tasks against this executor instead of the default.
///
/// **See also:** `default_executor`, `build_executor`,
/// `set_default_executor`, `spawn_on`.
pub struct Executor {
	policy: ExecutorPolicy,
	handle: Int
}

implement core.Copy for Executor {
}

// `ResultState<T>` — co-owned buffer for `VirtualThread<T>` result.
// Shared between the returned handle and the spawn thunk via
// `core.Arc<Mutex<ResultState<T>>>`.  Closes the R1-R8
// result-ownership matrix (see `work/stdlib-concurrency/plan.md`
// §5.2; R1-R5 are the original ownership-protocol family that this
// type addresses, R6-R8 are an adjacent `FutureGroup.join_any`
// cluster fixed in the same slice):
//
//   * `buf` — the storage; allocated once in `spawn*`.
//   * `initialized` — `true` iff the cb thunk has published a `T`
//     into `buf`.  Set by the thunk under the lock; cleared by any
//     consumer (join Ok / join Cancelled / VT destroy) that
//     `mem.read`s the value out.
//   * `abandoned` — `true` iff the `VirtualThread<T>` handle has
//     been dropped (or join consumed it).  Read by the thunk to
//     decide publish-vs-drop-locally.
//
// **Single deallocation point.**  `Destructible for ResultState<T>`
// is the only site that calls `mem.dealloc<T>(buf)`.  It runs when
// the last `Arc` clone (held by either the handle or the cb thunk)
// dies.  Join / cancel / destroy paths only consume any published
// `T` (running its destructor) and set `initialized = false`; they
// never free the buffer themselves.  This invariant rules out
// double-free (R2) and aliasing-between-spawn-and-destructor (R1).
struct ResultState<T> {
	buf: mem.RawBuffer<T>,
	initialized: Bool,
	abandoned: Bool
}

implement<T> core.Destructible for ResultState<T> {
	pub fn destroy(var self: ResultState<T>) nothrow -> Void {
		unsafe {
			if self.initialized {
				var v = mem.read<type T>(&mut self.buf, 0);
				// Drop the consumed `T` via `core.drop_value` so
				// the generic monomorphisation works for move-only
				// `T` (the `val _ = v` shape attempts to *copy* and
				// fails to compile when `T` is not Copy — STDLIB
				// regression observed by the app team in 0.33.2).
				// Closes R3 (drop-after-completed) and the
				// post-thunk-publish branches of R1.
				core.drop_value<type T>(move v);
			}
			val ptr = mem.rawbuffer_ptr<type T>(&self.buf);
			val cap = mem.rawbuffer_cap<type T>(&self.buf);
			var b = mem.rawbuffer_from_parts<type T>(ptr, cap);
			mem.dealloc<type T>(b);
		}
	}
}

/// Handle to an in-flight virtual-thread task that produces a value
/// of type `T`.
///
/// Construct via `spawn` (default executor), `spawn_cb`, or
/// `spawn_on` (specific executor).  Use `.join` (blocking) or
/// `.join_timeout(d)` (bounded) to wait for the result.  `.cancel()`
/// requests cooperative cancellation.
///
/// **Result-buffer ownership protocol:** the result storage is held
/// in an `Arc<Mutex<ResultState<T>>>` (`state` field) shared between
/// this handle and the cb thunk.  Drop, join, and cancel paths
/// linearize through the mutex; only `ResultState`'s `Destructible`
/// frees the buffer, exactly once when the last `Arc` clone dies.
/// This closes the R1-R8 ownership matrix documented in
/// `work/stdlib-concurrency/plan.md` §5 (R1-R5 are the original
/// ownership family on `VirtualThread<T>`; R6-R8 are the adjacent
/// `FutureGroup.join_any` cluster).
///
/// Dropping a `VirtualThread<T>` handle detaches from the result: the
/// task is still allowed to run to completion, and any produced `T` is
/// dropped locally instead of being published to a joined handle.  Use
/// `.cancel()` for cooperative cancellation; handle drop is not
/// cancellation, including for queued tasks that have not started yet.
///
/// **See also:** `spawn`, `Future`, `VirtualThread.join`,
/// `VirtualThread.join_timeout`, `VirtualThread.cancel`.
pub struct VirtualThread<T> {
	joined: Bool,
	handle: Int,
	state: core.Arc<Mutex<ResultState<T>>>,
	cancelled: Bool,
	submit_error: Int
}

/// Marker handle passed to the closure given to `scope`.
///
/// Currently empty — reserved as the ergonomic anchor for future
/// scoped-spawn APIs.  The type's existence lets `scope` express its
/// callback shape (`F is core.Fn1<Scope, Void>`).
///
/// **See also:** `scope`.
pub struct Scope {
}

/// Future-style wrapper around a `VirtualThread<T>`.
///
/// Equivalent to a `VirtualThread<T>` for joining/cancelling, with
/// the addition of `.is_done` for non-blocking readiness checks and
/// the ability to be aggregated in a `FutureGroup<T>`.
///
/// Construct via `spawn_future` or `spawn_future_on`.
///
/// **See also:** `spawn_future`, `FutureGroup`, `Future.join`,
/// `Future.is_done`.
pub struct Future<T> {
	vt: VirtualThread<T>
}

/// Collection of `Future<T>` values supporting batched join.
///
/// Construct via `future_group<T>()`, then add futures with `.add(f)`.
/// `.join_all()` waits for every future and collects the results;
/// `.join_any()` returns the first ready value.  Requires `T: Copy`
/// because both terminators may move out of internal storage.
///
/// **See also:** `future_group`, `Future`, `FutureGroup.add`,
/// `FutureGroup.join_all`, `FutureGroup.join_any`.
pub struct FutureGroup<T> {
	items: Array<Future<T>>
}

// `ArcHeader` / `ArcBox<T>` / `Arc<T>` and the per-`T` drop thunk
// moved to `std.core.arc` (re-exported above).  See ABI 11 history
// entry for the rationale (semantic contract is shared ownership,
// not concurrency).

// Stage 3 fat-Arc primitives `_arc_fat_bump_strong_via_ctrl` /
// `_arc_fat_drop_via_ctrl` and `Arc<T>` itself moved to
// `std.core.arc` along with the rest of the Arc machinery.

/// Mutual-exclusion lock around a `T`.
///
/// Construct via `mutex(value)`.  Acquire via `.lock()` (which
/// returns a `MutexGuard<T>`) or the free `lock()` function.  The
/// guard's `Destructible` impl releases the lock on scope exit, so
/// the typical pattern is `var g = lock(&m); g.get_mut().method()`.
///
/// `Mutex` is built on `AtomicBool` + spin; it is **not** a parking
/// or futex-based lock.  Hold it for short critical sections only.
///
/// **See also:** `mutex`, `lock`, `Mutex.lock`, `MutexGuard`, `Arc`.
pub struct Mutex<T> {
	locked: atomic.AtomicBool,
	value: T
}

/// RAII guard returned by `Mutex.lock` / `lock(&m)`.
///
/// Holds the mutex until dropped, at which point the guard's
/// `Destructible` impl releases the lock.  Use `.get_mut()` (or the
/// free `mutex_guard_get_mut(&mut g)`) to access the protected value.
/// Implements `core.BorrowMut<T>` so the guard composes with `&mut T`
/// receivers via UFCS.
///
/// The `locked` field tracks whether the guard currently owns the
/// underlying lock.  It is normally `true` for the guard's whole
/// lifetime; `Condvar.wait` (and only Condvar) flips it via
/// `unlock_for_condvar` / `relock_for_condvar` around the park.
/// The destructor respects the flag so a guard that was unlocked
/// for Condvar but never relocked does not double-unlock.
///
/// **See also:** `Mutex`, `MutexGuard.get_mut`, `mutex_guard_get_mut`.
pub struct MutexGuard<T> {
	mtx: &Mutex<T>,
	value_ptr: mem.Ptr<T>,
	locked: Bool
}

// `arc<T>()` factory, the Stage 2 `_arc_*_impl<T>` helpers,
// `implement<T> Arc<T> { clone / get / get_mut / as_interface }`,
// and the Borrow/BorrowMut/Destructible/Share impls all moved to
// `std.core` along with the rest of the Arc ownership surface.
// `Arc<T>` and `arc()` remain accessible through `std.concurrent`
// via the source-compat re-exports near the top of this file.

/// Constructs a `Mutex<T>` wrapping `value`, initially unlocked.
///
/// **See also:** `Mutex`, `lock`, `Arc`.
pub fn mutex<T>(value: T) nothrow -> Mutex<T> {
	return Mutex<type T>(locked = atomic_bool(false), value = move value);
}

/// Acquires the mutex, spinning until it is uncontended.
///
/// Free-function form of `Mutex.lock`.  Returns a `MutexGuard<T>`
/// that releases the lock when dropped.
///
/// **Parameters:**
/// - `m` — the mutex to acquire.
///
/// **See also:** `Mutex.lock`, `MutexGuard`,
/// `mutex_guard_get_mut`.
pub fn lock<T>(m: &Mutex<T>) nothrow -> MutexGuard<T> {
	while not atomic.atomic_compare_exchange_bool(&m.locked, false, true, 1, 0) {
	}
	unsafe {
		val vp = mem.ptr_from_ref<type T>(&m.value);
		return MutexGuard<type T>(mtx = m, value_ptr = vp, locked = true);
	}
}

/// Free-function form of `MutexGuard.get_mut`.  Returns a mutable
/// reference to the protected value.
///
/// **Parameters:**
/// - `g` — the held guard.
///
/// **See also:** `MutexGuard.get_mut`, `lock`.
pub fn mutex_guard_get_mut<T>(g: &mut MutexGuard<T>) nothrow -> &mut T {
	assert(g.locked, "mutex_guard_get_mut called on unlocked guard (Condvar unlock_for_condvar without matching relock?)");
	unsafe {
		return mem.ptr_as_mut_ref<type T>(g.value_ptr);
	}
}

implement<T> Mutex<T> {
	/// Method form of `lock`.  See that function for full semantics.
	pub fn lock(self: &Mutex<T>) nothrow -> MutexGuard<T> {
		while not atomic.atomic_compare_exchange_bool(&self.locked, false, true, 1, 0) {
		}
		unsafe {
			val vp = mem.ptr_from_ref<type T>(&self.value);
			return MutexGuard<type T>(mtx = self, value_ptr = vp, locked = true);
		}
	}
}

implement<T> MutexGuard<T> {
	/// Returns a mutable reference to the value protected by the
	/// underlying mutex.
	///
	/// The reference is valid until the guard is dropped.
	///
	/// **Asserts that the guard is currently locked.**  Calling
	/// after `unlock_for_condvar` without a matching
	/// `relock_for_condvar` is a contract violation and panics —
	/// otherwise the caller could read/mutate the protected value
	/// while the underlying lock is not held, breaking mutual
	/// exclusion.
	///
	/// **See also:** `mutex_guard_get_mut`, `Mutex.lock`.
	pub fn get_mut(self: &mut MutexGuard<T>) nothrow -> &mut T {
		assert(self.locked, "MutexGuard.get_mut called on unlocked guard (Condvar unlock_for_condvar without matching relock?)");
		unsafe {
			return mem.ptr_as_mut_ref<type T>(self.value_ptr);
		}
	}

	/// **Internal — for `std.concurrent.Condvar` only.**
	///
	/// Releases the underlying lock without dropping the guard.
	/// Must be paired with a matching `relock_for_condvar` call
	/// before the guard is dropped or any guarded value is read.
	///
	/// Asserts at runtime that the guard is currently locked —
	/// calling on an already-unlocked guard is a contract
	/// violation.  The state invariant guarantees that:
	///   - The destructor does not double-unlock if a guard is
	///     dropped while unlocked-for-condvar (a contract
	///     violation that we surface via the leftover lock rather
	///     than by corrupting the mutex).
	///   - `relock_for_condvar` cannot be accidentally called
	///     without a matching prior unlock.
	pub fn unlock_for_condvar(self: &mut MutexGuard<T>) nothrow -> Void {
		assert(self.locked, "unlock_for_condvar on already-unlocked guard");
		atomic.atomic_store_bool(&self.mtx.locked, false, 2);
		self.locked = false;
	}

	/// **Internal — for `std.concurrent.Condvar` only.**
	///
	/// Reacquires the lock after a matching `unlock_for_condvar`
	/// call.  Spins until the lock is uncontended (same discipline
	/// as `Mutex.lock`).
	///
	/// Asserts at runtime that the guard is currently unlocked —
	/// calling without a matching prior `unlock_for_condvar` is a
	/// contract violation.
	pub fn relock_for_condvar(self: &mut MutexGuard<T>) nothrow -> Void {
		assert(not self.locked, "relock_for_condvar on already-locked guard");
		while not atomic.atomic_compare_exchange_bool(&self.mtx.locked, false, true, 1, 0) {
		}
		self.locked = true;
	}
}

implement<T> core.BorrowMut<T> for MutexGuard<T> {
	pub fn borrow_mut(self: &mut MutexGuard<T>) nothrow -> &mut T {
		// Inherits the locked-state assertion from get_mut.
		return self.get_mut();
	}
}

implement<T> core.Destructible for MutexGuard<T> {
	pub fn destroy(self: MutexGuard<T>) nothrow -> Void {
		if self.locked {
			atomic.atomic_store_bool(&self.mtx.locked, false, 2);
		}
		// else: the guard was left unlocked via `unlock_for_condvar`
		// without a matching `relock_for_condvar` — a contract
		// violation.  We drop the unlock here to avoid double-unlock
		// (which on a spin-CAS lock would race a concurrent locker
		// into a corrupted "false but held" state).  The mutex stays
		// unlocked (since unlock_for_condvar already released it),
		// which is the correct end-state if the contract violation
		// happened on a drop path; if a caller leaks a guard while
		// unlocked-for-condvar, the leak is the bug, not the
		// destructor.
	}
}


// ─── Condvar ────────────────────────────────────────────────────────
//
// POSIX/Mesa-style condition variable.  Used in the standard
// while-loop-around-predicate pattern:
//
//   var guard = mtx.lock();
//   while not predicate(&guard) {
//       cv.wait(&mut guard);
//   }
//   // do work with the guard held
//
// `wait` atomically (from the caller's view) releases the mutex,
// parks the calling VT, and reacquires the mutex on wake.  The
// "atomicity" comes from the underlying `vt_park` / `vt_unpark`
// wake-token protocol: if `signal_one` fires between the waiter's
// enqueue and its park, the wake token is recorded and the
// subsequent park returns immediately — no missed wake.
//
// Stale-token avoidance is the load-bearing internal invariant:
// `vt_unpark(handle)` is only ever called after a successful
// `Waiter.active.compare_exchange(true, false)`.  Both the signal
// path and the wake path follow this discipline so a timed-out
// waiter's stale handle does not later leak an unpark onto a VT
// that has moved on to other work.
//
// See `doc/conventions/tmp-root.md` companion doc and
// `work/stdlib-condvar/plan.md` for the design rationale.


// Per-waiter record.  `active` is the CAS coordination point:
// signal/close paths CAS true→false before unpark; the waiter
// CAS's itself before returning on any wake path.  Exactly one
// side wins; the other skips its unpark.
struct PoolWaiter {
	vt: thread.VtHandle,
	active: atomic.AtomicBool,
}

// Internal state — held inside an Arc so Condvar handles are
// cheaply borrowable by all parties.
struct CondvarState {
	list_lock: Mutex<Array<core.Arc<PoolWaiter>>>,
	closed: atomic.AtomicBool,
}

/// Condition variable for parking a VT until a signal arrives.
///
/// Constructed via `condvar()`.  Pair with a `Mutex<T>` that
/// guards your predicate; `wait` releases the mutex and parks
/// the calling VT; `signal_one` / `signal_all` wake parked
/// waiters; `close` is a one-way shutdown (wakes all waiters with
/// `CLOSED`, makes future `wait` calls fail-fast).
///
/// **Always loop:** wakes may be spurious; the caller MUST
/// re-check the predicate after `wait` returns and re-park if
/// the predicate still does not hold.
///
/// **See also:** `condvar`, `Mutex`, `MutexGuard`.
pub struct Condvar {
	state: core.Arc<CondvarState>
}

/// Constructs a fresh Condvar.
///
/// **See also:** `Condvar`.
pub fn condvar() nothrow -> Condvar {
	val empty: Array<core.Arc<PoolWaiter>> = [];
	val state = CondvarState(
		list_lock = mutex(empty),
		closed = atomic_bool(false)
	);
	return Condvar(state = core.arc(state));
}

implement Condvar {
	/// Wakes one waiter.  No-op if no waiter is currently parked.
	/// Wakes "some waiter" — ordering is unspecified.
	///
	/// **Thread-safe.**  Does NOT require holding the predicate's
	/// mutex.  Callers typically signal while holding the predicate
	/// mutex (so the predicate update + signal happen atomically
	/// from the waiter's view), but this is caller discipline, not
	/// a Condvar requirement.
	pub fn signal_one(self: &Condvar) nothrow -> Void {
		// Pop records under the lock; CAS each until we successfully
		// claim one or the list empties.  Skip-on-CAS-fail handles
		// the dead-record case (waiter timed out / self-cancelled
		// before we got here).
		val claimed = _claim_one(&self.state.get().list_lock);
		match claimed {
			Optional::Some(w) => { thread.vt_unpark(w.get().vt); },
			default => { }
		}
	}

	/// Wakes all currently-parked waiters.  Future waiters (those
	/// who call `wait` after `signal_all` returns) are unaffected.
	///
	/// Same thread-safety as `signal_one` — does not require the
	/// predicate's mutex.
	pub fn signal_all(self: &Condvar) nothrow -> Void {
		val claimed = _drain_active(&self.state.get().list_lock);
		_unpark_all(&claimed);
	}

	/// Wakes all currently-parked waiters with `CLOSED`; future
	/// `wait` / `wait_timeout` / `wait_until` calls return
	/// `Err(CLOSED)` immediately without parking.
	///
	/// **One-way.**  A closed Condvar is not reusable.
	///
	/// **Drift extension, not POSIX condvar semantics.**  POSIX
	/// condvars do not own lifecycle; the equivalent pattern is
	/// "set a separate closed flag + broadcast".  Drift's `close`
	/// is sugar for that pattern — combined into a single
	/// primitive because getting the flag/broadcast ordering wrong
	/// is a common source of pool / channel / shutdown bugs.
	pub fn close(self: &Condvar) nothrow -> Void {
		self.state.get().closed.store(true, atomic.MemoryOrder::Release());
		val claimed = _drain_active(&self.state.get().list_lock);
		_unpark_all(&claimed);
	}

	/// Atomically (from the caller's view) releases `guard`, parks
	/// the calling VT, and reacquires the lock on wake.
	///
	/// Returns `Ok(())` on a normal wake (signal or spurious — the
	/// caller MUST loop and re-check the predicate either way).
	/// Returns `Err(ConcurrencyError(kind=CLOSED))` if the Condvar
	/// was closed (either before this call or while we were
	/// parked).  Returns
	/// `Err(ConcurrencyError(kind=REQUIRES_VTHREAD))` if called
	/// outside a VT context — does NOT park.
	pub fn wait<T>(self: &Condvar, guard: &mut MutexGuard<T>) nothrow -> core.Result<Void, ConcurrencyError> {
		return _wait_inner(self, guard, false, 0);
	}

	/// Like `wait`, but returns `Err(TIMEOUT)` if `d` elapses
	/// before a signal arrives.
	///
	/// Returns `Err(ConcurrencyError(kind=FAILED))` if `d.millis`
	/// is negative — matches the `_check_duration` contract used
	/// elsewhere in `std.concurrent` (`sleep` / `join_timeout`).
	pub fn wait_timeout<T>(self: &Condvar, guard: &mut MutexGuard<T>, d: Duration) nothrow -> core.Result<Void, ConcurrencyError> {
		match _check_duration(d) {
			core.Result::Err(e) => { return core.Result::Err(move e); },
			core.Result::Ok(_) => { }
		}
		val deadline = thread.now_ms() + d.millis;
		return _wait_inner(self, guard, true, deadline);
	}

	/// Absolute-deadline variant of `wait_timeout`.  `deadline_ms`
	/// is monotonic-clock absolute time (compare against
	/// `thread.now_ms()`).
	///
	/// A `deadline_ms` already in the past (including 0 or
	/// negative) returns `Err(TIMEOUT)` immediately without
	/// parking.  This contrasts with `wait()` which is always
	/// indefinite — there is no overload via a "0 means forever"
	/// sentinel.  Use `wait()` for indefinite waits; use this
	/// when you have an absolute deadline.
	pub fn wait_until<T>(self: &Condvar, guard: &mut MutexGuard<T>, deadline_ms: Int) nothrow -> core.Result<Void, ConcurrencyError> {
		return _wait_inner(self, guard, true, deadline_ms);
	}
}


// Common wait body shared by wait / wait_timeout / wait_until.
//
// `has_deadline=false` → park indefinitely (`vt_park(0)`); the
// `deadline_ms` arg is ignored.
// `has_deadline=true` → park until `deadline_ms` (absolute
// monotonic).  A deadline already in the past (including 0 or
// negative) returns TIMEOUT immediately without parking.
//
// We use an explicit flag rather than a sentinel value because 0
// is a valid (already-expired) absolute deadline; using it as a
// sentinel for indefinite-park caused a real bug pre-fix where
// `wait_until(0)` parked forever instead of returning TIMEOUT.
fn _wait_inner<T>(cv: &Condvar, guard: &mut MutexGuard<T>, has_deadline: Bool, deadline_ms: Int) nothrow -> core.Result<Void, ConcurrencyError> {
	// Off-VT guard.  Must surface before any state mutation: an
	// off-VT caller cannot park (no vt_park target), and we don't
	// want to enqueue a Waiter { vt: 0 } that signal paths would
	// then issue vt_unpark(0) on.
	val me = thread.vt_current();
	if me == 0 {
		return core.Result::Err(ConcurrencyError(
			kind = CONCURRENCY_KIND_REQUIRES_VTHREAD,
			code = 0
		));
	}

	// Fast path: closed.  No point enqueuing only to drain.
	if cv.state.get().closed.load(atomic.MemoryOrder::Acquire()) {
		return core.Result::Err(ConcurrencyError(
			kind = CONCURRENCY_KIND_CLOSED,
			code = -3
		));
	}

	// Deadline already passed?  Fail-fast.  Applies only when the
	// caller specified a deadline — wait() (has_deadline=false)
	// is always indefinite and never falls through here.
	if has_deadline and thread.now_ms() >= deadline_ms {
		return core.Result::Err(ConcurrencyError(
			kind = CONCURRENCY_KIND_TIMEOUT,
			code = -1
		));
	}

	val waiter = core.arc(PoolWaiter(
		vt = me,
		active = atomic_bool(true)
	));

	// Push waiter record onto the list (under the list-lock).
	{
		var lg = cv.state.get().list_lock.lock();
		val list = lg.get_mut();
		list.push(waiter.share());
	}

	// Re-check closed AFTER push — closes the race where close()
	// flipped the flag and drained the list between our pre-check
	// above and our push.  If we lose the race, self-CAS, prune
	// our record from the list, and return CLOSED.
	//
	// K-review finding (2026-05-15): without the prune, the
	// self-claimed waiter stays in the list forever — close() has
	// already happened so no subsequent signal/drain will visit
	// the list to remove it, AND the condvar's other waiters (if
	// any) are also drained, so no other waker will iterate the
	// list either.  `_prune_inactive` is O(n) over the current
	// list; under contention this branch is rare (close racing
	// with our push), so the cost is bounded.
	if cv.state.get().closed.load(atomic.MemoryOrder::Acquire()) {
		if waiter.get().active.compare_exchange(true, false, atomic.MemoryOrder::AcqRel(), atomic.MemoryOrder::Acquire()) {
			_prune_inactive(&cv.state.get().list_lock);
			return core.Result::Err(ConcurrencyError(
				kind = CONCURRENCY_KIND_CLOSED,
				code = -3
			));
		}
		// CAS failed: a signal beat us; fall through and consume
		// the wake normally.
	}

	// Release the predicate mutex and park.
	guard.unlock_for_condvar();
	// Liveness: label this park as a condvar wait (cleared on resume).
	thread.vt_set_wait(WAIT_KIND_CONDVAR, 0);
	if has_deadline {
		thread.vt_park_until(deadline_ms);
	} else {
		thread.vt_park(0);
	}
	guard.relock_for_condvar();

	// *** Self-CAS — runs on EVERY wake path. ***
	// CAS success: we self-claimed; no signal will issue a stale
	// unpark for our record.  CAS failure: a signal already
	// claimed us.
	val self_won = waiter.get().active.compare_exchange(true, false, atomic.MemoryOrder::AcqRel(), atomic.MemoryOrder::Acquire());

	// Self-prune to prevent unbounded list growth.  Without this,
	// a workload of pure timeouts (many wait_timeout calls, no
	// signals) leaves dead waiter records in the list — they're
	// only pruned by later signal_one / signal_all CAS-fail-skip,
	// and never if no signal arrives.  We walk under the
	// list_lock and remove all inactive records — our own (which
	// we just self-claimed) and any others left over from earlier
	// self-claims.  O(n) per wake, bounded by current waiter
	// count.  Skipped when self_won is false: a signal claimed
	// us, which means signal_one already pulled our record out of
	// the list before unparking us.
	if self_won {
		_prune_inactive(&cv.state.get().list_lock);
	}

	// Classify return.  Order: closed > timeout > normal/spurious.
	if cv.state.get().closed.load(atomic.MemoryOrder::Acquire()) {
		return core.Result::Err(ConcurrencyError(
			kind = CONCURRENCY_KIND_CLOSED,
			code = -3
		));
	}
	if self_won and has_deadline and thread.now_ms() >= deadline_ms {
		return core.Result::Err(ConcurrencyError(
			kind = CONCURRENCY_KIND_TIMEOUT,
			code = -1
		));
	}
	// self_won && deadline elapsed → TIMEOUT (handled above).
	// self_won && no deadline → spurious wake; return Ok and let
	//   caller's loop re-check predicate + call wait again.
	// !self_won → a signal claimed us; return Ok.
	return core.Result::Ok(core.void_value());
}


// Pop and try to claim one active waiter from the list.  Returns
// the claimed Arc<Waiter> (caller calls vt_unpark), or None if
// the list is empty.  Skip-on-CAS-fail handles dead records left
// by timed-out / self-cancelled waiters.
fn _claim_one(list_lock: &Mutex<Array<core.Arc<PoolWaiter>>>) nothrow -> Optional<core.Arc<PoolWaiter>> {
	var lg = list_lock.lock();
	val list = lg.get_mut();
	while list.len > 0 {
		var w = list.remove(0);
		if w.get().active.compare_exchange(true, false, atomic.MemoryOrder::AcqRel(), atomic.MemoryOrder::Acquire()) {
			return Optional::Some(move w);
		}
		// CAS failed: dead record; drop w (Arc decref) and try next.
	}
	return Optional::None();
}

// Drain all active waiters from the list under the lock; release
// the lock; return them in an array for the caller to unpark.
// Splitting the drain from the unparks avoids thundering-herd
// contention on the list_lock when many wakers try to relock the
// list (they don't — but the woken VTs may call back into Condvar
// for unrelated reasons; holding the list_lock across unparks
// would serialize them unnecessarily).
fn _drain_active(list_lock: &Mutex<Array<core.Arc<PoolWaiter>>>) nothrow -> Array<core.Arc<PoolWaiter>> {
	var claimed: Array<core.Arc<PoolWaiter>> = [];
	var lg = list_lock.lock();
	val list = lg.get_mut();
	while list.len > 0 {
		var w = list.remove(0);
		if w.get().active.compare_exchange(true, false, atomic.MemoryOrder::AcqRel(), atomic.MemoryOrder::Acquire()) {
			claimed.push(move w);
		}
		// CAS failed: dead record; drop w.
	}
	return move claimed;
}

// Walk the list under list_lock and drop every inactive record.
// Called from _wait_inner after a self-claimed wake.  Bounds the
// list size for workloads with many timeouts and no signals.
//
// Iteration: scan from index 0; if active is false, remove and
// re-scan from same index (since remove shifts subsequent
// entries left).  If active is true, advance.  O(n) worst case
// per call; n is bounded by current waiter count.
fn _prune_inactive(list_lock: &Mutex<Array<core.Arc<PoolWaiter>>>) nothrow -> Void {
	var lg = list_lock.lock();
	val list = lg.get_mut();
	var i = 0;
	while i < list.len {
		if list[i].get().active.load(atomic.MemoryOrder::Acquire()) {
			i = i + 1;
		} else {
			val _ = list.remove(i);
			// Don't increment i — the entry at i+1 has shifted to i.
		}
	}
}

fn _unpark_all(claimed: &Array<core.Arc<PoolWaiter>>) nothrow -> Void {
	var i = 0;
	while i < claimed.len {
		thread.vt_unpark(claimed[i].get().vt);
		i = i + 1;
	}
}


// ─── channel<T> — supervised async completion notification ───────────
//
// Unbounded multi-producer / single-consumer typed channel.
// Closure semantics:
//   * Sender dropped (last `Arc<Sender<T>>` ref gone if shared)
//     → `sender_closed = true`; blocked `recv` wakes with CLOSED
//     after draining queued values.
//   * Receiver dropped → `receiver_closed = true`; future `send`
//     calls return CLOSED; any queued undelivered values are
//     destroyed in-place (run their `Destructible`).
//
// All state (queue + flags) lives under one mutex.  This linearizes
// send / recv / sender-close / receiver-close against each other —
// see plan §2.1 for the linearization argument that closes the
// receiver-close-vs-send race.  No `try_send` / `try_recv` / `len()`
// / bounded buffering / `select` in v1.

struct ChannelState<T> {
	queue: Array<T>,
	sender_closed: Bool,
	receiver_closed: Bool
}

struct ChannelInner<T> {
	state: Mutex<ChannelState<T>>,
	not_empty: Condvar
}

/// Send-side handle for a `channel<T>()`.  Move-only.  Share across
/// multiple producers via `core.Arc<Sender<T>>`.  When the last
/// `Sender<T>` instance is dropped (or its last `Arc` reference),
/// the channel's send-side closes: any blocked `recv` wakes with
/// `Err(CLOSED)` once the queue is empty; later sends — there
/// won't be any if you respect ownership — observe a closed
/// receiver and return `Err(CLOSED)`.
///
/// **See also:** `channel`, `Receiver`, `Sender.send`.
pub struct Sender<T> {
	inner: core.Arc<ChannelInner<T>>
}

/// Receive-side handle for a `channel<T>()`.  Move-only and
/// single-consumer (do NOT share through `Arc`; only one receiver
/// per channel).  Dropping the receiver closes the receive side:
/// any subsequent `send` returns `Err(CLOSED)`, and any values
/// currently queued are destroyed in-place.
///
/// **See also:** `channel`, `Sender`, `Receiver.recv`.
pub struct Receiver<T> {
	inner: core.Arc<ChannelInner<T>>
}

/// Return shape for `channel<T>()`.  Drift does not allow
/// `move self.field` partial moves, so the halves live in
/// `Optional<...>` slots and are extracted via the
/// `take_sender` / `take_receiver` methods that `mem.replace`
/// them out:
///
/// ```drift
/// var halves = conc.channel<type Int>();
/// var sender = halves.take_sender();
/// var receiver = halves.take_receiver();
/// ```
///
/// Each `take_*` may be called at most once.  Calling either a
/// second time aborts via `assert` — the user has already moved
/// the half out and the slot is `None`.
pub struct ChannelHalves<T> {
	pub sender: Optional<Sender<T>>,
	pub receiver: Optional<Receiver<T>>
}

// Sentinel "closed" channel used as the unreachable-return value
// from the asserting `take_*` methods.  Building a fresh closed
// channel makes the type checker happy without exposing any
// user-observable garbage: even if the assert were ever bypassed,
// the returned sender/receiver would refuse all operations with
// `CLOSED`.
fn _closed_channel_inner<T>() nothrow -> core.Arc<ChannelInner<T>> {
	var empty_q: Array<T> = [];
	var st = ChannelState<type T>(
		queue = move empty_q,
		sender_closed = true,
		receiver_closed = true
	);
	var ci = ChannelInner<type T>(
		state = mutex(move st),
		not_empty = condvar()
	);
	return core.arc(move ci);
}

implement<T> ChannelHalves<T> {
	/// Moves the `Sender<T>` half out of the `ChannelHalves`.
	/// **Asserts** that the sender has not already been taken.
	/// Typical use immediately after `channel<T>()`:
	///
	/// ```drift
	/// var halves = conc.channel<type Int>();
	/// var sender = halves.take_sender();
	/// var receiver = halves.take_receiver();
	/// ```
	pub fn take_sender(self: &mut ChannelHalves<T>) nothrow -> Sender<T> {
		var taken = mem.replace(
			&mut self.sender,
			Optional<type Sender<T>>::None()
		);
		match taken {
			Some(s) => { return move s; },
			None => {
				assert(false, "ChannelHalves.take_sender called twice");
				return Sender<type T>(inner = _closed_channel_inner<type T>());
			},
			default => {
				return Sender<type T>(inner = _closed_channel_inner<type T>());
			}
		}
	}

	/// Moves the `Receiver<T>` half out of the `ChannelHalves`.
	/// **Asserts** that the receiver has not already been taken.
	pub fn take_receiver(self: &mut ChannelHalves<T>) nothrow -> Receiver<T> {
		var taken = mem.replace(
			&mut self.receiver,
			Optional<type Receiver<T>>::None()
		);
		match taken {
			Some(r) => { return move r; },
			None => {
				assert(false, "ChannelHalves.take_receiver called twice");
				return Receiver<type T>(inner = _closed_channel_inner<type T>());
			},
			default => {
				return Receiver<type T>(inner = _closed_channel_inner<type T>());
			}
		}
	}
}

/// Constructs a fresh unbounded `channel<T>` and returns its
/// sender / receiver halves bound together in a `ChannelHalves<T>`.
///
/// **Move-only halves.**  The returned `Sender<T>` and `Receiver<T>`
/// are not `Copy` — use `core.arc(sender)` to share the send side
/// across multiple producers.  Cloning the receiver is not
/// supported (single-consumer channel).
///
/// **Closure semantics:**
///   * The last `Sender<T>` drop marks the send side closed;
///     `recv` drains any pending values before returning
///     `Err(CLOSED)`.
///   * The `Receiver<T>` drop marks the receive side closed; any
///     subsequent `send` returns `Err(CLOSED)`, and the receiver's
///     destructor drains and destroys any undelivered queued
///     values.
///
/// **No `T: Share` bound in v1.**  The channel transfers
/// ownership of each `T` from sender to receiver — that's a move,
/// not a clone, so `Share` is not the right gate.  A `T: Send`
/// trait (when one exists) would be the appropriate constraint;
/// until then, the channel publishes with no `T` bound.
///
/// **See also:** `Sender`, `Receiver`, `ChannelHalves`,
/// `Sender.send`, `Receiver.recv`, `Receiver.recv_timeout`.
pub fn channel<T>() nothrow -> ChannelHalves<T> {
	var initial_queue: Array<T> = [];
	var st = ChannelState<type T>(
		queue = move initial_queue,
		sender_closed = false,
		receiver_closed = false
	);
	var inner = ChannelInner<type T>(
		state = mutex(move st),
		not_empty = condvar()
	);
	var arc_inner = core.arc(move inner);
	val send_side = Sender<type T>(inner = arc_inner.clone());
	val recv_side = Receiver<type T>(inner = move arc_inner);
	return ChannelHalves<type T>(
		sender = Optional<type Sender<T>>::Some(move send_side),
		receiver = Optional<type Receiver<T>>::Some(move recv_side)
	);
}

implement<T> Sender<T> {
	/// Enqueues `v` on the channel.  Linearizes through the
	/// channel's state mutex.
	///
	/// **Returns:** `Ok(void)` when the value is enqueued.
	/// `Err(ConcurrencyError(kind = CLOSED))` if the receiver has
	/// already been dropped — the moved-in `v` is destroyed in the
	/// return path (its `Destructible` runs as the binding goes
	/// out of scope).
	pub fn send(self: &Sender<T>, var v: T) nothrow -> core.Result<Void, ConcurrencyError> {
		{
			var guard = self.inner.get().state.lock();
			val s = guard.get_mut();
			if s.receiver_closed {
				// `v` drops at fn-exit; `T::destroy` runs.
				return core.Result::Err(ConcurrencyError(
					kind = CONCURRENCY_KIND_CLOSED,
					code = -3
				));
			}
			s.queue.push(move v);
		}
		self.inner.get().not_empty.signal_one();
		return core.Result::Ok(core.void_value());
	}
}

implement<T> core.Destructible for Sender<T> {
	/// Closes the send side.  Marks `sender_closed = true` under the
	/// state mutex and wakes all blocked receivers via the
	/// `not_empty` Condvar so they can observe the closed flag and
	/// return `Err(CLOSED)` once the queue is drained.
	pub fn destroy(var self: Sender<T>) nothrow -> Void {
		{
			var guard = self.inner.get().state.lock();
			val s = guard.get_mut();
			s.sender_closed = true;
		}
		self.inner.get().not_empty.signal_all();
		// `self.inner` Arc clone drops at fn-exit; when the
		// Receiver's Arc clone also drops, ChannelInner dies and
		// any remaining queue contents are destroyed via Array's
		// own Destructible.
	}
}

implement<T> Receiver<T> {
	/// Blocks until a value is available or the send side closes.
	///
	/// **Returns:** `Ok(T)` with the next queued value.
	/// `Err(ConcurrencyError(kind = CLOSED))` only when the queue
	/// is empty AND the last sender has dropped.  Spurious wakes
	/// are tolerated: the loop re-checks queue/closed state on
	/// every wake.
	pub fn recv(self: &mut Receiver<T>) nothrow -> core.Result<T, ConcurrencyError> {
		var guard = self.inner.get().state.lock();
		while true {
			{
				val s = guard.get_mut();
				if s.queue.len > 0 {
					var v = s.queue.remove(0);
					return core.Result::Ok(move v);
				}
				if s.sender_closed {
					return core.Result::Err(ConcurrencyError(
						kind = CONCURRENCY_KIND_CLOSED,
						code = -3
					));
				}
			}
			val res = self.inner.get().not_empty.wait(&mut guard);
			match res {
				Err(e) => { return core.Result::Err(move e); },
				Ok(_) => { }
			}
		}
		// Unreachable; appease type checker.
		return core.Result::Err(ConcurrencyError(
			kind = CONCURRENCY_KIND_CLOSED,
			code = -3
		));
	}

	/// Bounded variant of `recv`.  Returns
	/// `Err(ConcurrencyError(kind = TIMEOUT))` if no value arrives
	/// before `d` elapses.  Same drain-then-CLOSED contract as
	/// `recv` when the senders are gone.
	pub fn recv_timeout(self: &mut Receiver<T>, d: Duration) nothrow -> core.Result<T, ConcurrencyError> {
		var ok = _check_duration(d);
		match ok {
			Err(err) => { return core.Result::Err(move err); },
			Ok(_) => { }
		}
		val deadline = thread.now_ms() + d.millis;
		var guard = self.inner.get().state.lock();
		while true {
			{
				val s = guard.get_mut();
				if s.queue.len > 0 {
					var v = s.queue.remove(0);
					return core.Result::Ok(move v);
				}
				if s.sender_closed {
					return core.Result::Err(ConcurrencyError(
						kind = CONCURRENCY_KIND_CLOSED,
						code = -3
					));
				}
			}
			if thread.now_ms() >= deadline {
				return core.Result::Err(ConcurrencyError(
					kind = CONCURRENCY_KIND_TIMEOUT,
					code = -1
				));
			}
			val res = self.inner.get().not_empty.wait_until(&mut guard, deadline);
			match res {
				Err(e) => {
					if e.kind == CONCURRENCY_KIND_TIMEOUT {
						return core.Result::Err(ConcurrencyError(
							kind = CONCURRENCY_KIND_TIMEOUT,
							code = -1
						));
					}
					return core.Result::Err(move e);
				},
				Ok(_) => { }
			}
		}
		return core.Result::Err(ConcurrencyError(
			kind = CONCURRENCY_KIND_TIMEOUT,
			code = -1
		));
	}
}

implement<T> core.Destructible for Receiver<T> {
	/// Closes the receive side.  Marks `receiver_closed = true`
	/// under the state mutex, **detaches** the queued values into
	/// a local array under the same lock, then releases the lock
	/// and lets the local array drop — every queued value's
	/// `Destructible` runs *outside* the channel state mutex.
	///
	/// **Why detach.**  A queued `T`'s destructor is arbitrary
	/// user code; in particular it may drop the last
	/// `Arc<Sender<T>>` for *this* channel (or otherwise call
	/// back into the channel), which would try to re-acquire the
	/// same state mutex and deadlock.  Detaching uses
	/// `mem.replace` to swap the live queue array out for a fresh
	/// empty array — an O(1) array-handoff pointer swap — so the
	/// close step under the lock executes no user code.  Each
	/// queued `T::destroy` runs after the guard scope exits,
	/// when the detached local array drops at fn-exit.
	///
	/// No signal needed in v1 (unbounded channel has no blocked
	/// senders).
	pub fn destroy(var self: Receiver<T>) nothrow -> Void {
		var detached: Array<T> = [];
		{
			var guard = self.inner.get().state.lock();
			val s = guard.get_mut();
			s.receiver_closed = true;
			val empty_replacement: Array<T> = [];
			detached = mem.replace(&mut s.queue, move empty_replacement);
		}
		// Lock released here.  `detached` drops at fn-exit; each
		// `T`'s `Destructible` runs without holding the channel
		// state mutex.  This is the load-bearing detach: a queued
		// `T`'s destructor that releases the last `Arc<Sender<T>>`
		// for *this* channel (or otherwise re-enters the channel)
		// must NOT execute under the channel state mutex, or it
		// will deadlock when `Sender::destroy` tries to relock
		// (Drift's `Mutex` is spin-CAS, so the observable failure
		// mode is an infinite CPU spin rather than a futex wait).
	}
}


/// Returns a fresh `ExecutorPolicyBuilder` with conservative defaults
/// (1 worker thread, no queue limit, immediate timeout, return-busy on
/// saturation, 256 KiB stack).
///
/// **See also:** `ExecutorPolicyBuilder`, `build_executor`.
pub fn executor_policy_builder() nothrow -> ExecutorPolicyBuilder {
	return ExecutorPolicyBuilder(
		min_threads = 1,
		max_threads = 1,
		queue_limit = 0,
		timeout = Duration(millis = 0),
		on_saturation = SaturationPolicy::ReturnBusy(),
		stack_bytes = 262144
	);
}

implement ExecutorPolicyBuilder {
	/// Sets the minimum number of worker threads kept alive.
	///
	/// **Parameters:**
	/// - `v` — minimum thread count.
	pub fn min_threads(self: &mut ExecutorPolicyBuilder, v: Int) nothrow -> &mut ExecutorPolicyBuilder {
		self.min_threads = v;
		return self;
	}

	/// Sets the maximum number of worker threads the executor may
	/// spin up.
	///
	/// **Parameters:**
	/// - `v` — maximum thread count.
	pub fn max_threads(self: &mut ExecutorPolicyBuilder, v: Int) nothrow -> &mut ExecutorPolicyBuilder {
		self.max_threads = v;
		return self;
	}

	/// Sets the maximum number of pending tasks queued before
	/// saturation policy applies.  `0` means unbounded.
	///
	/// **Parameters:**
	/// - `v` — queue capacity (0 = unbounded).
	///
	/// **See also:** `ExecutorPolicyBuilder.on_saturation`.
	pub fn queue_limit(self: &mut ExecutorPolicyBuilder, v: Int) nothrow -> &mut ExecutorPolicyBuilder {
		self.queue_limit = v;
		return self;
	}

	/// Sets the per-submit blocking timeout used when the queue is
	/// full and the saturation policy is `Block`.
	///
	/// **Parameters:**
	/// - `v` — submit-blocking timeout.
	pub fn timeout(self: &mut ExecutorPolicyBuilder, v: Duration) nothrow -> &mut ExecutorPolicyBuilder {
		self.timeout = v;
		return self;
	}

	/// Sets the saturation policy — what to do when the queue is
	/// full.
	///
	/// **Parameters:**
	/// - `v` — `SaturationPolicy::Block` or `SaturationPolicy::ReturnBusy`.
	///
	/// **See also:** `SaturationPolicy`.
	pub fn on_saturation(self: &mut ExecutorPolicyBuilder, var v: SaturationPolicy) nothrow -> &mut ExecutorPolicyBuilder {
		self.on_saturation = move v;
		return self;
	}

	/// Sets the per-virtual-thread stack size in bytes.
	///
	/// **Parameters:**
	/// - `v` — stack size in bytes.
	pub fn stack_bytes(self: &mut ExecutorPolicyBuilder, v: Int) nothrow -> &mut ExecutorPolicyBuilder {
		self.stack_bytes = v;
		return self;
	}

	/// Materializes the builder into an immutable `ExecutorPolicy`.
	///
	/// **Returns:** a `Copy` policy value suitable for passing to
	/// `build_executor`.
	///
	/// **See also:** `ExecutorPolicyBuilder.build_executor`,
	/// `build_executor`.
	pub fn build(self: &ExecutorPolicyBuilder) nothrow -> ExecutorPolicy {
		return ExecutorPolicy(
			min_threads = self.min_threads,
			max_threads = self.max_threads,
			queue_limit = self.queue_limit,
			timeout = self.timeout,
			on_saturation = self.on_saturation,
			stack_bytes = self.stack_bytes
		);
	}

	/// Convenience that calls `.build()` and immediately constructs
	/// the running `Executor` from the resulting policy.
	///
	/// **Returns:** an `Executor` ready to receive `spawn_on`
	/// submissions.
	///
	/// **See also:** `build_executor`.
	pub fn build_executor(self: &ExecutorPolicyBuilder) nothrow -> Executor {
		var policy = self.build();
		var sat = 0;
		match policy.on_saturation {
			ReturnBusy => { sat = 1; },
			default => { sat = 0; },
		}
		var handle = thread.exec_create(
			policy.min_threads,
			policy.max_threads,
			policy.queue_limit,
			policy.timeout.millis,
			sat,
			policy.stack_bytes
		);
		return Executor(policy = policy, handle = handle);
	}
}

/// Returns the process-wide default `Executor`, lazily constructing
/// one with default policy on the first call.
///
/// Subsequent calls return the same handle.  Override the default
/// with `set_default_executor`.
///
/// **See also:** `set_default_executor`, `build_executor`,
/// `executor_policy_builder`.
pub fn default_executor() nothrow -> Executor {
	var b = executor_policy_builder();
	var h = thread.exec_default_get();
	if h == 0 {
		var exec = b.build_executor();
		thread.exec_default_set(exec.handle);
		return exec;
	}
	return Executor(policy = b.build(), handle = h);
}

/// Constructs a running `Executor` from `policy`.
///
/// **Parameters:**
/// - `policy` — the executor configuration to apply.
///
/// **Returns:** an `Executor` ready to receive `spawn_on` submissions.
///
/// **See also:** `default_executor`, `executor_policy_builder`.
pub fn build_executor(policy: ExecutorPolicy) nothrow -> Executor {
	var sat = 0;
	match policy.on_saturation {
		ReturnBusy => { sat = 1; },
		default => { sat = 0; },
	}
	var handle = thread.exec_create(
		policy.min_threads,
		policy.max_threads,
		policy.queue_limit,
		policy.timeout.millis,
		sat,
		policy.stack_bytes
	);
	return Executor(policy = policy, handle = handle);
}

/// A dedicated executor whose worker threads are EXPECTED to be pinned
/// by blocking C calls (non-pollable FFI: database engines, DNS-style
/// syscalls, legacy C libraries).  Nominal wrapper over `Executor`:
/// same runtime machinery, blocking-appropriate defaults, and a stable
/// name for the blocking contract — blocking work runs on these
/// workers and NEVER pins a cooperative virtual-thread carrier.
///
/// Submission is bounded: the queue limit plus the saturation policy
/// (`Block` with a timeout by default) make admission the executor's
/// job — callers get ordinary `Result` errors, never an unbounded
/// pile-up.  In-flight C calls are not cancellable; the worker count
/// is the containment bound for wedged foreign calls.
///
/// **See also:** `blocking_executor_builder`, `build_blocking_executor`,
/// `spawn_blocking_on`, `run_blocking_on`.
pub struct BlockingExecutor {
	exec: Executor
}

implement core.Copy for BlockingExecutor {
}

/// Returns an `ExecutorPolicyBuilder` preset for blocking foreign
/// work: 4 fixed workers (created eagerly at build, parked when
/// idle), queue limit 64, `Block` saturation with a 5 s admission
/// timeout, 256 KiB stacks.
///
/// **Returns:** builder; adjust and pass to `build_blocking_executor`.
///
/// **See also:** `BlockingExecutor`, `build_blocking_executor`.
pub fn blocking_executor_builder() nothrow -> ExecutorPolicyBuilder {
	return ExecutorPolicyBuilder(
		min_threads = 4,
		max_threads = 4,
		queue_limit = 64,
		timeout = Duration(millis = 5000),
		on_saturation = SaturationPolicy::Block(),
		stack_bytes = 262144
	);
}

/// Materializes a `BlockingExecutor` from a policy (typically from
/// `blocking_executor_builder`).  Both saturation policies are
/// supported: `Block` parks the submitter (without pinning its
/// carrier) until capacity is transferred or the policy timeout
/// elapses; `ReturnBusy` fails submission immediately when full.
///
/// **Parameters:**
/// - `policy` — executor policy (worker count, queue bound, saturation).
///
/// **Returns:** the blocking executor (process-lifetime; workers are
/// joined by the runtime at exit).
///
/// **See also:** `blocking_executor_builder`, `spawn_blocking_on`.
pub fn build_blocking_executor(policy: ExecutorPolicy, name: String) nothrow -> BlockingExecutor {
	val ex = build_executor(policy);
	thread.exec_set_name(ex.handle, move name);
	return BlockingExecutor(exec = ex);
}

/// Submits `cb` to a blocking executor and returns a joinable handle.
/// Asynchronous form; mirrors `spawn_on` exactly, including its error
/// mapping (`busy` / `timeout` / `cancelled` as `ConcurrencyError`).
///
/// **Parameters:**
/// - `exec` — the blocking executor.
/// - `cb` — the blocking closure; runs on a blocking worker thread.
///
/// **Returns:** `Ok(VirtualThread<T>)` once ADMITTED (with `Block`
/// saturation the call may park until capacity frees), or the
/// admission error.
///
/// **See also:** `run_blocking_on`, `spawn_on`.
pub fn spawn_blocking_on<T>(exec: &BlockingExecutor, label: String, var cb: core.Callback0<T>) nothrow -> core.Result<VirtualThread<T>, ConcurrencyError> {
	return spawn_on_labeled(exec.exec, move label, move cb);
}

/// Runs `cb` on a blocking worker and waits for its result — the
/// common shape for structural foreign batches (e.g. one database
/// transaction per call).  The calling virtual thread parks while the
/// work runs; its carrier is free the whole time.
///
/// Domain errors should travel inside `T` (return
/// `core.Result<Payload, DomainError>` from the closure);
/// `ConcurrencyError` is reserved for infrastructure outcomes.
///
/// **Parameters:**
/// - `exec` — the blocking executor.
/// - `cb` — the blocking closure.
///
/// **Returns:** the closure's value, or the admission/join error.
///
/// **See also:** `spawn_blocking_on`.
pub fn run_blocking_on<T>(exec: &BlockingExecutor, label: String, var cb: core.Callback0<T>) nothrow -> core.Result<T, ConcurrencyError> {
	match spawn_blocking_on(exec, move label, move cb) {
		core.Result::Ok(vt) => {
			var owned = move vt;
			return owned.join();
		},
		core.Result::Err(e) => {
			return core.Result::Err(move e);
		},
	}
}

/// Replaces the process-wide default `Executor`.
///
/// Subsequent calls to `default_executor()` return the supplied
/// handle.  Useful at startup to pin a specific policy globally.
///
/// **Parameters:**
/// - `exec` — executor to install as the default.
///
/// **See also:** `default_executor`, `build_executor`.
pub fn set_default_executor(exec: Executor) nothrow -> Void {
	thread.exec_default_set(exec.handle);
	return;
}

// Internal helper: invoked by the cb thunk after `cb.call()` produces
// `v`.  Under the state lock, either publishes `v` into the shared
// buffer (handle still attached) or drops `v` locally (handle was
// abandoned).  Closes the R1 (drop-while-running) UAF: a destructor
// that sets `abandoned = true` before broadcasting cv reliably steers
// the late-publishing thunk into the drop-locally branch.
fn _publish_or_drop<T>(state: &core.Arc<Mutex<ResultState<T>>>, var v: T) nothrow -> Void {
	// `state` is borrowed, not moved.  This keeps the cb thunk's
	// captured Arc clone alive in the thunk env across this call,
	// so the runtime's drop path (drift_drop_callback at process
	// exit / executor shutdown for parked-mid-cb VTs) reliably
	// runs the Arc's Destructible — closing the parked-cb leak
	// shape from the 0.32.8 fix family.
	var guard = state.get().lock();
	val rs = guard.get_mut();
	if rs.abandoned {
		// Drop `v` via `core.drop_value` (generic over move-only
		// `T`).  Closes the abandoned-publish branch of R1.
		core.drop_value<type T>(move v);
		return;
	}
	unsafe {
		mem.write<type T>(&mut rs.buf, 0, move v);
	}
	rs.initialized = true;
	return;
}

// Internal helper: constructs the shared state Arc.  Allocates the
// raw buffer, wraps it in `ResultState<T>`, then `Mutex<...>`, then
// `Arc<...>`.  Called by every `spawn*` path.
fn _make_result_state<T>() nothrow -> core.Arc<Mutex<ResultState<T>>> {
	unsafe {
		var buf = mem.alloc_uninit<type T>(1);
		var rs = ResultState<type T>(
			buf = move buf,
			initialized = false,
			abandoned = false
		);
		return core.arc(mutex(move rs));
	}
}

/// Spawns `cb` on the default executor and returns a
/// `VirtualThread<T>` handle for joining the result.
///
/// **Parameters:**
/// - `cb` — callback whose return value will become the joined
///   result.
///
/// **Returns:** a `VirtualThread<T>` whose `submit_error` is non-zero
/// if the executor refused submission (check via `.join` to surface
/// the error as `ConcurrencyError(kind = CONCURRENCY_KIND_FAILED, code = -5)`).
/// Use `spawn_on` if you want the submit failure surfaced as a
/// `Result` directly instead of being deferred to join.
///
/// **See also:** `spawn_on`, `spawn_future`, `default_executor`,
/// `VirtualThread`.
///
/// **Example:** `examples/sync_mpsc_queue/main.drift`.
pub fn spawn<T>(var cb: core.Callback0<T>) nothrow -> VirtualThread<T> {
	var exec = default_executor();
	var state = _make_result_state<type T>();
	val state_for_cb = state.clone();
	var thunk: core.Callback0<Void> = core.callback0(
		| | captures(move cb, move state_for_cb) => {
			_publish_or_drop(&state_for_cb, cb.call());
			return;
		}
	);
	var h = thread.vt_spawn(move thunk, exec.handle);
	val submit_code = thread.exec_submit(exec.handle, h);
	if submit_code != 0 {
		// Buffer ownership stays with `state`; the returned handle's
		// Destructible (and ultimately `ResultState::destroy` on the
		// last-Arc transition) handles cleanup.  No manual dealloc
		// here — that was the R2 double-free.
		thread.vt_drop(h);
		return VirtualThread<type T>(
			joined = false,
			handle = 0,
			state = move state,
			cancelled = false,
			submit_error = submit_code
		);
	}
	return VirtualThread<type T>(
		joined = false,
		handle = h,
		state = move state,
		cancelled = false,
		submit_error = 0
	);
}

/// Compatibility alias for `spawn`.  Identical behavior; retained for
/// older callers that distinguished callback shapes.
///
/// **See also:** `spawn`.
pub fn spawn_cb<T>(var cb: core.Callback0<T>) nothrow -> VirtualThread<T> {
	var exec = default_executor();
	var state = _make_result_state<type T>();
	val state_for_cb = state.clone();
	var thunk: core.Callback0<Void> = core.callback0(
		| | captures(move cb, move state_for_cb) => {
			_publish_or_drop(&state_for_cb, cb.call());
			return;
		}
	);
	var h = thread.vt_spawn(move thunk, exec.handle);
	val submit_code = thread.exec_submit(exec.handle, h);
	if submit_code != 0 {
		thread.vt_drop(h);
		return VirtualThread<type T>(
			joined = false,
			handle = 0,
			state = move state,
			cancelled = false,
			submit_error = submit_code
		);
	}
	return VirtualThread<type T>(
		joined = false,
		handle = h,
		state = move state,
		cancelled = false,
		submit_error = 0
	);
}

/// Spawns `cb` on the supplied executor and surfaces submission
/// failure as a `Result`.
///
/// **Parameters:**
/// - `exec` — executor to submit against.
/// - `cb` — callback whose return value will become the joined
///   result.
///
/// **Returns:** `Ok(VirtualThread<T>)` if the submit succeeded.
/// `Err(ConcurrencyError(kind=CONCURRENCY_KIND_BUSY))` if the executor is saturated and
/// configured to return-busy.  `Err(ConcurrencyError(kind=CONCURRENCY_KIND_TIMEOUT))` if
/// the saturation policy is `Block` and the submit timeout elapsed.
/// `Err(ConcurrencyError(kind = CONCURRENCY_KIND_FAILED, code = -5))` for
/// other submit failures.
///
/// **See also:** `spawn`, `spawn_future_on`, `Executor`,
/// `SaturationPolicy`.
pub fn spawn_on<T>(exec: Executor, var cb: core.Callback0<T>) nothrow -> core.Result<VirtualThread<T>, ConcurrencyError> {
	var state = _make_result_state<type T>();
	val state_for_cb = state.clone();
	var thunk: core.Callback0<Void> = core.callback0(
		| | captures(move cb, move state_for_cb) => {
			_publish_or_drop(&state_for_cb, cb.call());
			return;
		}
	);
	var h = thread.vt_spawn(move thunk, exec.handle);
	var submit_code = thread.exec_submit(exec.handle, h);
	if submit_code == 0 {
		return core.Result::Ok(VirtualThread<type T>(
			joined = false,
			handle = h,
			state = move state,
			cancelled = false,
			submit_error = 0
		));
	}
	// On submit failure, `state` (and its `ResultState<T>`) goes out
	// of scope here; `Destructible for ResultState<T>` deallocs the
	// buffer exactly once when the last Arc clone dies.  The thunk's
	// state-for-cb clone gets dropped via `vt_drop`'s pre-start
	// cleanup branch (or by the runtime's cb-drop logic on a queued
	// task), and our own `state` drops at the end of this scope.
	thread.vt_drop(h);
	if submit_code == 1 {
		return core.Result::Err(ConcurrencyError(kind = CONCURRENCY_KIND_BUSY, code = -4));
	}
	if submit_code == 2 {
		return core.Result::Err(ConcurrencyError(kind = CONCURRENCY_KIND_TIMEOUT, code = -1));
	}
	if submit_code == 3 {
		// Block(timeout) admission wait abandoned because the submitting
		// VT was cancelled.  Explicit mapping — falling through to the
		// FAILED catch-all would hide a well-defined outcome.
		return core.Result::Err(ConcurrencyError(kind = CONCURRENCY_KIND_CANCELLED, code = -6));
	}
	try {
		throw ExecSubmitFailed(code = submit_code);
	} catch e {
		return core.Result::Err(ConcurrencyError(kind = CONCURRENCY_KIND_FAILED, code = -5));
	}
}

/// `spawn_on` with a liveness OPERATION LABEL: the label (and the
/// calling VT's id, recorded separately as the submitter) is attached
/// to the submission before it enters the executor, so `kill -USR2`
/// snapshots name the operation in every state — admission wait,
/// queued, running, or pinned inside a C call.
///
/// **Parameters:**
/// - `exec` — target executor.
/// - `label` — short operation label (≤ 48 bytes; e.g. `lmdb.write_txn`).
/// - `cb` — the work.
///
/// **See also:** `spawn_on`, `spawn_blocking_on`.
pub fn spawn_on_labeled<T>(exec: Executor, label: String, var cb: core.Callback0<T>) nothrow -> core.Result<VirtualThread<T>, ConcurrencyError> {
	var state = _make_result_state<type T>();
	val state_for_cb = state.clone();
	var thunk: core.Callback0<Void> = core.callback0(
		| | captures(move cb, move state_for_cb) => {
			_publish_or_drop(&state_for_cb, cb.call());
			return;
		}
	);
	var h = thread.vt_spawn(move thunk, exec.handle);
	thread.vt_set_op(h, move label);
	var submit_code = thread.exec_submit(exec.handle, h);
	if submit_code == 0 {
		return core.Result::Ok(VirtualThread<type T>(
			joined = false,
			handle = h,
			state = move state,
			cancelled = false,
			submit_error = 0
		));
	}
	thread.vt_drop(h);
	if submit_code == 1 {
		return core.Result::Err(ConcurrencyError(kind = CONCURRENCY_KIND_BUSY, code = -4));
	}
	if submit_code == 2 {
		return core.Result::Err(ConcurrencyError(kind = CONCURRENCY_KIND_TIMEOUT, code = -1));
	}
	if submit_code == 3 {
		return core.Result::Err(ConcurrencyError(kind = CONCURRENCY_KIND_CANCELLED, code = -6));
	}
	try {
		throw ExecSubmitFailed(code = submit_code);
	} catch e {
		return core.Result::Err(ConcurrencyError(kind = CONCURRENCY_KIND_FAILED, code = -5));
	}
}

/// `Future`-shaped form of `spawn`.  Wraps the resulting
/// `VirtualThread<T>` in a `Future<T>` so it can be added to a
/// `FutureGroup`.
///
/// **See also:** `spawn`, `Future`, `FutureGroup`.
pub fn spawn_future<T>(var cb: core.Callback0<T>) nothrow -> Future<T> {
	var vt = spawn<type T>(move cb);
	return Future<type T>(move vt);
}

/// `Future`-shaped form of `spawn_on`.  Submission failures surface
/// as `Err(ConcurrencyError)` (same shape as `spawn_on`).
///
/// **See also:** `spawn_on`, `Future`, `FutureGroup`.
pub fn spawn_future_on<T>(exec: Executor, var cb: core.Callback0<T>) nothrow -> core.Result<Future<T>, ConcurrencyError> {
	var res = spawn_on<type T>(exec, move cb);
	return match res {
		Ok(vt) => { core.Result::Ok(Future<type T>(move vt)) },
		Err(err) => { core.Result::Err(move err) },
		default => { core.Result::Err(ConcurrencyError(kind = CONCURRENCY_KIND_BUSY, code = -4)) }
	};
}

/// Constructs an empty `FutureGroup<T>`.
///
/// Add futures with `.add(f)`, then call `.join_all()` or
/// `.join_any()` to await them.  Requires `T: Copy` — see
/// `FutureGroup` for why.
///
/// **See also:** `FutureGroup`, `spawn_future`.
pub fn future_group<T>() nothrow -> FutureGroup<T> {
	var items: Array<Future<T>> = [];
	return FutureGroup<type T>(move items);
}

fn _check_duration(d: Duration) nothrow -> core.Result<Void, ConcurrencyError> {
	if d.millis < 0 {
		try {
			throw InvalidDuration(millis = d.millis);
		} catch e {
			return core.Result::Err(ConcurrencyError(kind = CONCURRENCY_KIND_FAILED, code = -5));
		}
	}
	return core.Result::Ok(core.void_value());
}


implement<T> VirtualThread<T> {
	/// Blocks until the spawned task completes, then returns its
	/// produced value.
	///
	/// Marks `self` as joined; further joins return
	/// `Err(ConcurrencyError(kind=CONCURRENCY_KIND_CLOSED))`.  If the underlying executor
	/// rejected the original submission, the deferred error surfaces
	/// here as `Err(ConcurrencyError(kind = CONCURRENCY_KIND_FAILED, code = -5))`.
	/// If the task was cancelled, returns `Err(Cancelled)` after the
	/// internal cleanup completes.
	///
	/// **Returns:** `Ok(T)` with the task's produced value.
	/// `Err(ConcurrencyError)` for closed/failed/cancelled cases.
	///
	/// **See also:** `VirtualThread.join_timeout`,
	/// `VirtualThread.cancel`.
	pub fn join(self: &mut VirtualThread<T>) nothrow -> core.Result<T, ConcurrencyError> {
		if self.joined {
			return core.Result::Err(ConcurrencyError(kind = CONCURRENCY_KIND_CLOSED, code = -3));
		}
		if self.submit_error != 0 {
			var code = self.submit_error;
			self.joined = true;
			self.handle = 0;
			try {
				throw ExecSubmitFailed(code = code);
			} catch e {
				return core.Result::Err(ConcurrencyError(kind = CONCURRENCY_KIND_FAILED, code = -5));
			}
		}
		if self.cancelled {
			thread.vt_join(self.handle);
			self.joined = true;
			self.handle = 0;
			// Discard any published result under the lock.  No
			// dealloc — `ResultState::destroy` (last-Arc) handles
			// that.  Closes R4.
			{
				var guard = self.state.get().lock();
				val rs = guard.get_mut();
				if rs.initialized {
					unsafe {
						var v = mem.read<type T>(&mut rs.buf, 0);
						// `core.drop_value` instead of `val _ = v`
						// so generic move-only `T` compiles.
						core.drop_value<type T>(move v);
					}
					rs.initialized = false;
				}
			}
			return core.Result::Err(ConcurrencyError(kind = CONCURRENCY_KIND_CANCELLED, code = -2));
		}
		thread.vt_join(self.handle);
		self.joined = true;
		self.handle = 0;
		// Move the published result out under the lock and return it.
		var guard = self.state.get().lock();
		val rs = guard.get_mut();
		unsafe {
			var v = mem.read<type T>(&mut rs.buf, 0);
			rs.initialized = false;
			return core.Result::Ok(move v);
		}
	}

	/// Blocks until the spawned task completes or `d` elapses.
	///
	/// Same success/failure shape as `join`, plus
	/// `Err(ConcurrencyError(kind=CONCURRENCY_KIND_TIMEOUT))` when the deadline hits before
	/// the task is done.  `d.millis < 0` is rejected as
	/// `Err(Failed(InvalidDuration(...)))`; `d.millis == 0` returns
	/// `Err(Timeout)` immediately if the task is not already
	/// completed.
	///
	/// **Parameters:**
	/// - `d` — maximum time to wait.
	///
	/// **Returns:** `Ok(T)` on completion within the deadline;
	/// `Err(ConcurrencyError)` otherwise.
	///
	/// **See also:** `VirtualThread.join`, `VirtualThread.cancel`.
	pub fn join_timeout(self: &mut VirtualThread<T>, d: Duration) nothrow -> core.Result<T, ConcurrencyError> {
		var ok = _check_duration(d);
		match ok {
			Err(err) => { return core.Result::Err(move err); },
			Ok(_) => { }
		}
		if self.joined {
			return core.Result::Err(ConcurrencyError(kind = CONCURRENCY_KIND_CLOSED, code = -3));
		}
		if self.submit_error != 0 {
			var code = self.submit_error;
			self.joined = true;
			self.handle = 0;
			try {
				throw ExecSubmitFailed(code = code);
			} catch e {
				return core.Result::Err(ConcurrencyError(kind = CONCURRENCY_KIND_FAILED, code = -5));
			}
		}
		if self.cancelled {
			thread.vt_join(self.handle);
			self.joined = true;
			self.handle = 0;
			// Discard any published result under the lock.  Closes R5.
			{
				var guard = self.state.get().lock();
				val rs = guard.get_mut();
				if rs.initialized {
					unsafe {
						var v = mem.read<type T>(&mut rs.buf, 0);
						// `core.drop_value` instead of `val _ = v`
						// so generic move-only `T` compiles.
						core.drop_value<type T>(move v);
					}
					rs.initialized = false;
				}
			}
			return core.Result::Err(ConcurrencyError(kind = CONCURRENCY_KIND_CANCELLED, code = -2));
		}
		var done = thread.vt_is_completed(self.handle);
		if done != 0 {
			thread.vt_join(self.handle);
			self.joined = true;
			self.handle = 0;
			var guard = self.state.get().lock();
			val rs = guard.get_mut();
			unsafe {
				var v = mem.read<type T>(&mut rs.buf, 0);
				rs.initialized = false;
				return core.Result::Ok(move v);
			}
		}
		if d.millis == 0 {
			return core.Result::Err(ConcurrencyError(kind = CONCURRENCY_KIND_TIMEOUT, code = -1));
		}
		var code = thread.vt_join_timeout(self.handle, d.millis);
		if code != 0 {
			return core.Result::Err(ConcurrencyError(kind = CONCURRENCY_KIND_TIMEOUT, code = -1));
		}
		self.joined = true;
		self.handle = 0;
		var guard = self.state.get().lock();
		val rs = guard.get_mut();
		unsafe {
			var v = mem.read<type T>(&mut rs.buf, 0);
			rs.initialized = false;
			return core.Result::Ok(move v);
		}
	}

	/// Requests cooperative cancellation of the spawned task.
	///
	/// No-op if the thread is already joined or if no live handle is
	/// attached.  After a successful cancellation request, the next
	/// `join`/`join_timeout` call returns
	/// `Err(ConcurrencyError(kind=CONCURRENCY_KIND_CANCELLED))`.
	///
	/// **See also:** `VirtualThread.join`, `VirtualThread.join_timeout`.
	pub fn cancel(self: &mut VirtualThread<T>) nothrow -> Void {
		if self.joined {
			return;
		}
		if self.handle == 0 {
			return;
		}
		var ok = thread.vt_cancel(self.handle);
		if ok == 0 {
			self.cancelled = true;
		}
		return;
	}

	/// Non-blocking terminal-state predicate.
	///
	/// **Returns:** `true` iff this handle has reached a terminal
	/// state — `.join` has already consumed it (`joined = true`),
	/// the original submission failed and the deferred error is
	/// queued to surface from `.join` (`submit_error != 0`), or
	/// the runtime has marked the task complete
	/// (`thread.vt_is_completed(handle) != 0`).  Returns `false`
	/// while the task is still running, and **also** returns
	/// `false` for a task that has had `.cancel()` requested but
	/// has not yet been observed complete by the runtime — a
	/// cancellation *request* is not completion.
	///
	/// **Use:** the polling alternative to a channel-driven
	/// reaper.  A loop of
	/// `while !vt.is_complete() { conc.sleep(...); }` followed by
	/// `vt.join()` is a correctness-safe sweep pattern: every
	/// non-terminal value is returned from this method as `false`
	/// (so the caller spins) and every terminal one returns `true`
	/// (so the caller commits to `.join` without risk of blocking
	/// forever).
	///
	/// **See also:** `VirtualThread.join`, `VirtualThread.cancel`,
	/// `Future.is_complete`.
	pub fn is_complete(self: &VirtualThread<T>) nothrow -> Bool {
		if self.joined {
			return true;
		}
		if self.submit_error != 0 {
			return true;
		}
		if self.handle == 0 {
			// No live handle and no submit-error sentinel; the
			// handle was already torn down via an out-of-band
			// path.  Treat as terminal to avoid an infinite poll.
			return true;
		}
		return thread.vt_is_completed(self.handle) != 0;
	}
}

implement<T> core.Destructible for VirtualThread<T> {
	pub fn destroy(var self: VirtualThread<T>) nothrow -> Void {
		if self.joined {
			return;
		}
		// Under the state lock: mark abandoned (so a late-publishing
		// thunk drops its `v` locally instead of writing to the
		// buffer — closes R1), and consume any already-published `T`
		// to run its `Destructible` (closes R3).  No dealloc here;
		// `ResultState::destroy` on the last Arc transition handles
		// that.
		{
			var guard = self.state.get().lock();
			val rs = guard.get_mut();
			rs.abandoned = true;
			if rs.initialized {
				unsafe {
					var v = mem.read<type T>(&mut rs.buf, 0);
					// `core.drop_value` instead of `val _ = v` so
					// generic move-only `T` compiles.
					core.drop_value<type T>(move v);
				}
				rs.initialized = false;
			}
		}
		if self.handle != 0 {
			thread.vt_drop(self.handle);
		}
		// `self.state`'s Arc clone drops at fn-exit.  When the cb
		// thunk's Arc clone also drops, the last Arc dies and
		// `ResultState::destroy` deallocates the buffer.
	}
}

implement<T> Future<T> {
	/// Method form of the inner `VirtualThread.join`.  See that method
	/// for full semantics.
	pub fn join(self: &mut Future<T>) nothrow -> core.Result<T, ConcurrencyError> {
		return self.vt.join();
	}

	/// Method form of the inner `VirtualThread.join_timeout`.  See
	/// that method for full semantics.
	pub fn join_timeout(self: &mut Future<T>, d: Duration) nothrow -> core.Result<T, ConcurrencyError> {
		return self.vt.join_timeout(d);
	}

	/// Method form of the inner `VirtualThread.cancel`.  See that
	/// method for full semantics.
	pub fn cancel(self: &mut Future<T>) nothrow -> Void {
		self.vt.cancel();
		return;
	}

	/// Returns `true` if the future has already been joined.
	///
	/// Non-blocking — does not check the underlying task; only
	/// reflects whether `.join` / `.join_timeout` has run to
	/// completion on this `Future` value.
	///
	/// **See also:** `Future.join`, `Future.join_timeout`.
	pub fn is_done(self: &Future<T>) nothrow -> Bool {
		return self.vt.joined;
	}

	/// Method form of `VirtualThread.is_complete`.  Delegates to
	/// the inner VT; see that method for full semantics.
	pub fn is_complete(self: &Future<T>) nothrow -> Bool {
		return self.vt.is_complete();
	}
}

implement<T> FutureGroup<T> require T is core.Copy {
	/// Adds `f` to the group.  Order of insertion is preserved by
	/// `join_all`.
	///
	/// **Parameters:**
	/// - `f` — future to take ownership of.
	pub fn add(self: &mut FutureGroup<T>, var f: Future<T>) nothrow -> Void {
		self.items.push(move f);
		return;
	}

	/// Joins every future in the group sequentially and returns the
	/// collected results in insertion order.
	///
	/// Stops at the first `Err` and returns it; futures after the
	/// failing one are left un-joined (their destructors will drop
	/// them on scope exit).
	///
	/// **Returns:** `Ok(Array<T>)` if every future produced a value;
	/// `Err(ConcurrencyError)` from the first failing join.
	///
	/// **See also:** `FutureGroup.join_any`.
	pub fn join_all(self: &mut FutureGroup<T>) nothrow -> core.Result<Array<T>, ConcurrencyError> {
		var out: Array<T> = [];
		var i: Int = 0;
		while i < self.items.len {
			var res = self.items[i].join();
			match res {
				Ok(v) => { out.push(v); },
				Err(err) => { return core.Result::Err(move err); },
				default => { return core.Result::Err(ConcurrencyError(kind = CONCURRENCY_KIND_BUSY, code = -4)); }
			}
			i += 1;
		}
		return core.Result::Ok(move out);
	}

	/// Returns the result of the first ready future in the group,
	/// polling each in turn and parking briefly between sweeps.
	///
	/// **Returns:** `Ok(T)` from the first ready future.
	/// `Err(ConcurrencyError(kind=CONCURRENCY_KIND_TIMEOUT))` if the group is empty.
	/// `Err(ConcurrencyError(kind=CONCURRENCY_KIND_CLOSED))` if every future is already
	/// joined and no value remains to be observed.
	///
	/// Note: the value returned by `join_any` is read out of the
	/// future's internal storage but the future is **not** marked as
	/// joined here; `join_all` may observe it again.  Callers that
	/// need single-shot semantics should `add` each future to a fresh
	/// group, or call `.join` directly.
	///
	/// **See also:** `FutureGroup.join_all`.
	pub fn join_any(self: &mut FutureGroup<T>) nothrow -> core.Result<T, ConcurrencyError> {
		if self.items.len == 0 {
			return core.Result::Err(ConcurrencyError(kind = CONCURRENCY_KIND_TIMEOUT, code = -1));
		}
		while true {
			var i: Int = 0;
			var pending: Bool = false;
			while i < self.items.len {
				var f = &mut self.items[i];
				if f.vt.joined {
					i += 1;
					continue;
				}
				// Terminal: submit failed.  `handle == 0`, so
				// `vt_is_completed` would return 0 forever and the
				// polling loop would never terminate.  Delegate to
				// `.join()` which routes through the submit-error
				// path and returns `Err(FAILED)`.  Closes R8.
				if f.vt.submit_error != 0 {
					return f.vt.join();
				}
				pending = true;
				var done = thread.vt_is_completed(f.vt.handle);
				if done != 0 {
					// Runtime says the VT is complete, but that does
					// NOT prove a value was published: a future
					// cancelled before its callback starts also
					// reaches completed=1, with the result slot
					// still uninitialized.  Check `rs.initialized`
					// under the lock to distinguish:
					//
					//   * `initialized == true`  — peek via Copy.
					//   * `initialized == false` — delegate to
					//     `f.vt.join()` so the cancellation path
					//     handles cleanup and returns Err(CANCELLED)
					//     without reading uninitialised memory
					//     (closes R7).
					//
					// `T: core.Copy` (required at the impl header)
					// — see R6 design note: Copy does NOT imply
					// "no destructor"; `String` is Copy with
					// retain/release.  We read with Copy semantics
					// via `*mem.ptr_at_ref` so retain fires and the
					// buffered ownership stake survives for any
					// subsequent `join_all`.
					var has_value: Bool = false;
					{
						var guard = f.vt.state.get().lock();
						val rs = guard.get_mut();
						has_value = rs.initialized;
						if has_value {
							unsafe {
								val v_ref = mem.ptr_at_ref<type T>(&rs.buf, 0);
								return core.Result::Ok(*v_ref);
							}
						}
					}
					// Completed but never published — typically
					// cancelled before start.  Route through the
					// normal join() cancellation cleanup; the lock
					// is released here so join() can acquire its
					// own.
					return f.vt.join();
				}
				i += 1;
			}
			if !pending {
				return core.Result::Err(ConcurrencyError(kind = CONCURRENCY_KIND_CLOSED, code = -3));
			}
			var me = thread.vt_current();
			if me != 0 {
				thread.vt_park_until(thread.now_ms() + 1);
			} else {
				thread.vt_park_until(1);
			}
		}
		return core.Result::Err(ConcurrencyError(kind = CONCURRENCY_KIND_TIMEOUT, code = -1));
	}
}

/// Runs `f` with a fresh `Scope` handle.
///
/// Currently a thin shape — invokes `f.call(scope)` once and returns
/// `Ok(void)`.  Reserved as the entry point for scoped-spawn APIs
/// that will guarantee all spawned tasks complete before `scope`
/// returns.
///
/// **Parameters:**
/// - `f` — callable with shape `Fn1<Scope, Void>`.
///
/// **Returns:** `Ok(void)` after `f` returns.  Currently never
/// returns `Err`, but the result type is reserved for future
/// scoped-spawn failure modes.
///
/// **See also:** `Scope`.
pub fn scope<F>(f: F) -> core.Result<Void, ConcurrencyError> require F is core.Fn1<Scope, Void> {
	var s = Scope();
	f.call(move s);
	return core.Result::Ok(core.void_value());
}

/// Cooperatively relinquishes the current virtual thread to the
/// scheduler's ready queue, resuming on the next scheduler turn.
///
/// This is the cheap cooperative scheduling point: no timer, no
/// allocation, no minimum delay — unlike `sleep`, which has a 1 ms
/// floor (and `sleep(Duration(0))`, which returns an immediate
/// `Err(Timeout)` rather than yielding).  Use it to hand the worker to
/// another ready VT between non-blocking sweeps of an event loop.
///
/// **On a VT:** re-enqueues the caller as READY behind the other
/// ready VTs and switches to the scheduler, so a co-located peer VT
/// makes progress before this one resumes.
///
/// **Off the VT runtime** (e.g. the main thread before any VT exists):
/// behaves as whatever `lang.thread.vt_yield` does there — an OS-level
/// `sched_yield()`.
///
/// **See also:** `sleep`, `spawn`.
pub fn yield_now() nothrow -> Void {
	thread.vt_yield();
}

/// Suspends the calling virtual thread for `d`.
///
/// Off the virtual-thread runtime (e.g. on the main thread before any
/// VT exists), this yields control for `d.millis` real milliseconds
/// without registering a reactor timer.
///
/// **Parameters:**
/// - `d` — duration to sleep.
///
/// **Returns:** `Ok(void)` on normal wake-up.
/// `Err(Failed(InvalidDuration(...)))` if `d.millis < 0`.
/// `Err(Timeout)` if `d.millis == 0` (zero-sleep is treated as an
/// immediate timeout, not a no-op).
///
/// **See also:** `Duration`.
pub fn sleep(d: Duration) nothrow -> core.Result<Void, ConcurrencyError> {
	var ok = _check_duration(d);
	match ok {
		Err(err) => { return core.Result::Err(move err); },
		Ok(_) => { }
	}
	if d.millis == 0 {
		return core.Result::Err(ConcurrencyError(kind = CONCURRENCY_KIND_TIMEOUT, code = -1));
	}
	var deadline = thread.now_ms() + d.millis;
	var vt = thread.vt_current();
	if vt == 0 {
		thread.vt_park_until(d.millis);
		return core.Result::Ok(core.void_value());
	}
	// Spurious-wakeup-tolerant timed wait (the correct condition-recheck
	// discipline): register the wake timer ONCE, then loop on a PLAIN park,
	// re-checking the clock each time.  A spurious wake — e.g. a stale wake
	// left by some prior operation's late-firing deadline timer — just causes
	// a re-park for the remaining time instead of returning early.  Using a
	// plain `vt_park` (not `vt_park_until`) inside the loop avoids registering
	// a fresh timer per iteration, so no extra timers accumulate to fire late
	// (the alternating-instant-sleep pattern).  A cancelled VT breaks out
	// promptly (a cancelled `vt_park` returns immediately).
	thread.reactor_register_timer(deadline, vt);
	while thread.now_ms() < deadline {
		if thread.vt_is_cancelled() != 0 {
			break;
		}
		thread.vt_set_wait(WAIT_KIND_TIMER, 0);
		thread.vt_park(0);
	}
	return core.Result::Ok(core.void_value());
}

/// Blocks the calling virtual thread until a supported process
/// signal (`SIGINT`, `SIGTERM`, or `SIGUSR1`) is delivered, then
/// returns which one.
///
/// **Platform:** Linux only.  Behavior off Linux is unsupported.
///
/// **Single-waiter rule:** at most one virtual thread per process may
/// be blocked in `await_signal` at a time — the intended use is a
/// single shutdown coordinator near `main`.  A second concurrent
/// caller while one is already waiting is a hard program error and
/// aborts the process with a diagnostic; it is **not** a recoverable
/// exception.  Sequential reuse from a different VT after the
/// in-flight call returns is allowed.
///
/// **Throw contract:** `nothrow`.  Misuse aborts; success returns a
/// `ProcessSignal`.
///
/// **Delivery semantics:** the call blocks until a supported signal is
/// delivered, then returns.  Standard (non-realtime) signals **coalesce**
/// in the kernel: several rapid deliveries of the *same* signal while no
/// waiter is parked may surface as a **single** return.  Treat a signal
/// as an idempotent "an event of this kind happened, rescan current
/// state" edge, **not** a per-delivery counter.  Call `await_signal`
/// again to react to the next edge.
///
/// **Returns:** `ProcessSignal::Interrupt` for `SIGINT`,
/// `ProcessSignal::Terminate` for `SIGTERM`,
/// `ProcessSignal::User1` for `SIGUSR1`.
///
/// **See also:** `ProcessSignal`.
pub fn await_signal() nothrow -> ProcessSignal {
	// Linux signal numbers; named to mirror the `SIGTERM == 15` house
	// style and document the magic constants.
	val SIGNO_SIGTERM: Int = 15;
	val SIGNO_SIGUSR1: Int = 10;
	val signo = thread.signal_await();
	// The runtime returns -1 for any misuse / unsupported case: off-VT,
	// no signalfd, a second concurrent waiter, or non-Linux.  Per the
	// single-waiter contract above this is a hard program error, not a
	// recoverable signal — abort with a diagnostic rather than
	// fabricating an `Interrupt`.
	assert(signo != -1,
		"await_signal: signal infrastructure unavailable or a second "
		+ "concurrent waiter was detected (single-waiter contract "
		+ "violation); see ProcessSignal docs. Linux only.");
	if signo == SIGNO_SIGTERM {
		return ProcessSignal::Terminate();
	}
	if signo == SIGNO_SIGUSR1 {
		return ProcessSignal::User1();
	}
	return ProcessSignal::Interrupt();
}

/// Parks the calling virtual thread on the I/O reactor until `fd`
/// becomes ready for the given interest, or until `deadline_ms`
/// elapses.
///
/// Low-level primitive used by stdlib I/O modules to integrate
/// blocking syscalls with the virtual-thread scheduler.  No-op on
/// the main thread (`vt_current() == 0`).
///
/// **Parameters:**
/// - `fd` — file descriptor to register with the reactor.
/// - `interest` — readiness mask (1 = readable, 4 = writable;
///   matches the values used by the runtime reactor).
/// - `deadline_ms` — absolute wake-up time in milliseconds; `0`
///   means park indefinitely.
///
/// **See also:** `sleep`.
pub fn block_on_io(fd: Int, interest: Int, deadline_ms: Int) nothrow -> Void {
	var vt = thread.vt_current();
	if vt == 0 {
		return;
	}
	thread.reactor_register_io(fd, interest, vt, deadline_ms);
	if deadline_ms > 0 {
		thread.vt_park_until(deadline_ms);
	} else {
		thread.vt_park(0);
	}
	return;
}

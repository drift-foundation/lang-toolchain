module std.text

import std.core as core;
import std.io as io;
import std.mem as mem;

export {
	TokenizeAction,
	TokenSpan,
	TokenConsumer,
	Utf8Error,
	utf8_from_bytes,
	utf8_from_bytes_range,
	TextError,
	substring,
	is_digit,
	is_alpha,
	is_alnum,
	is_space,
	StringBuilder,
	string_builder,
	sb_append_string,
	sb_len,
	sb_build
};

pub variant TokenizeAction {
	Continue,
	Stop,
}

pub struct TokenSpan {
	pub start: Int,
	pub end: Int,
}

pub interface TokenConsumer<Tok, Err> {
	fn on_token(self: &mut Self, tok: Tok, span: TokenSpan) nothrow -> TokenizeAction;
	fn on_error(self: &mut Self, err: Err, at: Int) nothrow -> TokenizeAction;
}

implement core.Copy for TokenizeAction {
}

implement core.Copy for TokenSpan {
}

pub struct Utf8Error {
	pub tag: String,
	pub offset: Int
}

implement core.Diagnostic for Utf8Error {
	pub fn to_diag(self: &Utf8Error) nothrow -> DiagnosticValue {
		return DiagnosticValue::String(self.tag);
	}
}

fn _byte_u8(b: Byte) nothrow -> Int {
	var v = cast<Int>(b);
	if v < 0 {
		v = v + 256;
	}
	return v;
}

fn _is_cont(v: Int) nothrow -> Bool {
	return v >= 128 and v <= 191;
}

fn _need_bytes(n: Int, i: Int, want: Int) nothrow -> Bool {
	return i + want <= n;
}

fn _validate_utf8_range(bytes: &Array<Byte>, start: Int, end: Int) nothrow -> core.Result<Void, Utf8Error> {
	if start < 0 or end < start or end > bytes.len {
		return core.Result::Err(Utf8Error(tag = "invalid-range", offset = 0));
	}
	var i = start;
	while i < end {
		val b0 = _byte_u8(bytes[i]);
		if b0 <= 127 {
			i = i + 1;
			continue;
		}
		if b0 >= 194 and b0 <= 223 {
			if not _need_bytes(end, i, 2) {
				return core.Result::Err(Utf8Error(tag = "unexpected-eof", offset = i - start));
			}
			val b1 = _byte_u8(bytes[i + 1]);
			if not _is_cont(b1) {
				return core.Result::Err(Utf8Error(tag = "invalid-continuation", offset = i + 1 - start));
			}
			i = i + 2;
			continue;
		}
		if b0 == 224 {
			if not _need_bytes(end, i, 3) {
				return core.Result::Err(Utf8Error(tag = "unexpected-eof", offset = i - start));
			}
			val b1 = _byte_u8(bytes[i + 1]);
			val b2 = _byte_u8(bytes[i + 2]);
			if b1 < 160 or b1 > 191 {
				return core.Result::Err(Utf8Error(tag = "invalid-continuation", offset = i + 1 - start));
			}
			if not _is_cont(b2) {
				return core.Result::Err(Utf8Error(tag = "invalid-continuation", offset = i + 2 - start));
			}
			i = i + 3;
			continue;
		}
		if b0 >= 225 and b0 <= 236 {
			if not _need_bytes(end, i, 3) {
				return core.Result::Err(Utf8Error(tag = "unexpected-eof", offset = i - start));
			}
			val b1 = _byte_u8(bytes[i + 1]);
			val b2 = _byte_u8(bytes[i + 2]);
			if not _is_cont(b1) {
				return core.Result::Err(Utf8Error(tag = "invalid-continuation", offset = i + 1 - start));
			}
			if not _is_cont(b2) {
				return core.Result::Err(Utf8Error(tag = "invalid-continuation", offset = i + 2 - start));
			}
			i = i + 3;
			continue;
		}
		if b0 == 237 {
			if not _need_bytes(end, i, 3) {
				return core.Result::Err(Utf8Error(tag = "unexpected-eof", offset = i - start));
			}
			val b1 = _byte_u8(bytes[i + 1]);
			val b2 = _byte_u8(bytes[i + 2]);
			if b1 < 128 or b1 > 159 {
				return core.Result::Err(Utf8Error(tag = "invalid-continuation", offset = i + 1 - start));
			}
			if not _is_cont(b2) {
				return core.Result::Err(Utf8Error(tag = "invalid-continuation", offset = i + 2 - start));
			}
			i = i + 3;
			continue;
		}
		if b0 >= 238 and b0 <= 239 {
			if not _need_bytes(end, i, 3) {
				return core.Result::Err(Utf8Error(tag = "unexpected-eof", offset = i - start));
			}
			val b1 = _byte_u8(bytes[i + 1]);
			val b2 = _byte_u8(bytes[i + 2]);
			if not _is_cont(b1) {
				return core.Result::Err(Utf8Error(tag = "invalid-continuation", offset = i + 1 - start));
			}
			if not _is_cont(b2) {
				return core.Result::Err(Utf8Error(tag = "invalid-continuation", offset = i + 2 - start));
			}
			i = i + 3;
			continue;
		}
		if b0 == 240 {
			if not _need_bytes(end, i, 4) {
				return core.Result::Err(Utf8Error(tag = "unexpected-eof", offset = i - start));
			}
			val b1 = _byte_u8(bytes[i + 1]);
			val b2 = _byte_u8(bytes[i + 2]);
			val b3 = _byte_u8(bytes[i + 3]);
			if b1 < 144 or b1 > 191 {
				return core.Result::Err(Utf8Error(tag = "invalid-continuation", offset = i + 1 - start));
			}
			if not _is_cont(b2) {
				return core.Result::Err(Utf8Error(tag = "invalid-continuation", offset = i + 2 - start));
			}
			if not _is_cont(b3) {
				return core.Result::Err(Utf8Error(tag = "invalid-continuation", offset = i + 3 - start));
			}
			i = i + 4;
			continue;
		}
		if b0 >= 241 and b0 <= 243 {
			if not _need_bytes(end, i, 4) {
				return core.Result::Err(Utf8Error(tag = "unexpected-eof", offset = i - start));
			}
			val b1 = _byte_u8(bytes[i + 1]);
			val b2 = _byte_u8(bytes[i + 2]);
			val b3 = _byte_u8(bytes[i + 3]);
			if not _is_cont(b1) {
				return core.Result::Err(Utf8Error(tag = "invalid-continuation", offset = i + 1 - start));
			}
			if not _is_cont(b2) {
				return core.Result::Err(Utf8Error(tag = "invalid-continuation", offset = i + 2 - start));
			}
			if not _is_cont(b3) {
				return core.Result::Err(Utf8Error(tag = "invalid-continuation", offset = i + 3 - start));
			}
			i = i + 4;
			continue;
		}
		if b0 == 244 {
			if not _need_bytes(end, i, 4) {
				return core.Result::Err(Utf8Error(tag = "unexpected-eof", offset = i - start));
			}
			val b1 = _byte_u8(bytes[i + 1]);
			val b2 = _byte_u8(bytes[i + 2]);
			val b3 = _byte_u8(bytes[i + 3]);
			if b1 < 128 or b1 > 143 {
				return core.Result::Err(Utf8Error(tag = "invalid-continuation", offset = i + 1 - start));
			}
			if not _is_cont(b2) {
				return core.Result::Err(Utf8Error(tag = "invalid-continuation", offset = i + 2 - start));
			}
			if not _is_cont(b3) {
				return core.Result::Err(Utf8Error(tag = "invalid-continuation", offset = i + 3 - start));
			}
			i = i + 4;
			continue;
		}
		return core.Result::Err(Utf8Error(tag = "invalid-leading-byte", offset = i - start));
	}
	return core.Result::Ok(core.void_value());
}

pub fn utf8_from_bytes(bytes: &Array<Byte>) nothrow -> core.Result<String, Utf8Error> {
	return utf8_from_bytes_range(bytes, 0, bytes.len);
}

pub fn utf8_from_bytes_range(bytes: &Array<Byte>, start: Int, end: Int) nothrow -> core.Result<String, Utf8Error> {
	match _validate_utf8_range(bytes, start, end) {
		core.Result::Err(e) => { return core.Result::Err(e); },
		core.Result::Ok(_) => { }
	}
	val n = end - start;
	if n <= 0 {
		return core.Result::Ok("");
	}
	var b = io.buffer(n);
	var i = 0;
	while i < n {
		io.buffer_write(&mut b, i, bytes[start + i]);
		i = i + 1;
	}
	return core.Result::Ok(core.string_from_utf8_bytes(io.buffer_ptr(&b), io.buffer_len(&b)));
}

pub struct TextError {
	pub tag: String,
	pub offset: Int
}

implement core.Diagnostic for TextError {
	pub fn to_diag(self: &TextError) nothrow -> DiagnosticValue {
		return DiagnosticValue::String(self.tag);
	}
}

pub fn substring(s: &String, start: Int, len: Int) nothrow -> core.Result<String, TextError> {
	val n = s.byte_length();
	if start < 0 or len < 0 or start > n or len > n - start {
		return core.Result::Err(TextError(tag = "out-of-bounds", offset = start));
	}
	if len == 0 {
		return core.Result::Ok("");
	}
	var b = io.buffer(len);
	var i = 0;
	while i < len {
		io.buffer_write(&mut b, i, core.string_byte_at(s, start + i));
		i = i + 1;
	}
	return core.Result::Ok(core.string_from_utf8_bytes(io.buffer_ptr(&b), len));
}

pub fn is_digit(b: Byte) nothrow -> Bool {
	return b >= cast<Byte>(48) and b <= cast<Byte>(57);
}

pub fn is_alpha(b: Byte) nothrow -> Bool {
	return (b >= cast<Byte>(65) and b <= cast<Byte>(90)) or (b >= cast<Byte>(97) and b <= cast<Byte>(122));
}

pub fn is_alnum(b: Byte) nothrow -> Bool {
	return is_digit(b) or is_alpha(b);
}

pub fn is_space(b: Byte) nothrow -> Bool {
	return b == cast<Byte>(32) or b == cast<Byte>(9) or b == cast<Byte>(10) or b == cast<Byte>(13);
}

pub struct StringBuilder {
	buf: mem.RawBuffer<Byte>,
	cap: Int,
	len: Int
}

implement core.Destructible for StringBuilder {
	pub fn destroy(var self: StringBuilder) nothrow -> Void {
		if self.cap > 0 {
			val ptr = mem.rawbuffer_ptr<type Byte>(&self.buf);
			val cap = mem.rawbuffer_cap<type Byte>(&self.buf);
			var tmp = mem.rawbuffer_from_parts<type Byte>(ptr, cap);
			mem.dealloc<type Byte>(tmp);
		}
	}
}

pub fn string_builder(initial_cap: Int) nothrow -> StringBuilder {
	var cap = initial_cap;
	if cap < 16 {
		cap = 16;
	}
	unsafe {
		var b = mem.alloc_uninit<type Byte>(cap);
		return StringBuilder(buf = move b, cap = cap, len = 0);
	}
}

fn _sb_grow(self: &mut StringBuilder, needed: Int) nothrow -> Void {
	val cur_cap = self.cap;
	val cur_len = self.len;
	var new_cap = cur_cap * 2;
	if new_cap < needed {
		new_cap = needed;
	}
	unsafe {
		var new_buf = mem.alloc_uninit<type Byte>(new_cap);
		var i = 0;
		while i < cur_len {
			val b = mem.read<type Byte>(&mut self.buf, i);
			mem.write<type Byte>(&mut new_buf, i, b);
			i = i + 1;
		}
		if cur_cap > 0 {
			val old_ptr = mem.rawbuffer_ptr<type Byte>(&self.buf);
			val old_cap = mem.rawbuffer_cap<type Byte>(&self.buf);
			var old_tmp = mem.rawbuffer_from_parts<type Byte>(old_ptr, old_cap);
			mem.dealloc<type Byte>(old_tmp);
		}
		self.buf = move new_buf;
		self.cap = new_cap;
	}
}

pub fn sb_append_string(self: &mut StringBuilder, s: &String) nothrow -> Void {
	val n = s.byte_length();
	if n == 0 {
		return;
	}
	val needed = self.len + n;
	if needed > self.cap {
		_sb_grow(self, needed);
	}
	val base = self.len;
	var i = 0;
	while i < n {
		mem.write<type Byte>(&mut self.buf, base + i, core.string_byte_at(s, i));
		i = i + 1;
	}
	self.len = base + n;
}

pub fn sb_len(self: &StringBuilder) nothrow -> Int {
	return self.len;
}

pub fn sb_build(self: &mut StringBuilder) nothrow -> String {
	if self.len == 0 {
		return "";
	}
	val ptr = mem.rawbuffer_ptr<type Byte>(&self.buf);
	return core.string_from_utf8_bytes(ptr, self.len);
}

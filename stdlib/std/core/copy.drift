module std.core.copy;

// Implementation file for the `Copy` trait.  User-facing access is
// `core.Copy` via the `std.core` re-export in `core.drift`; do not
// import `std.core.copy` directly from user code unless you have a
// specific reason.

export {
	Copy
};

/// Marker trait: types with bitwise-copyable semantics.
///
/// `Copy` types may be passed by value without moving — read-after-
/// pass is permitted.  Default impls: `Int`, `Uint`, `Uint64`,
/// `Bool`, `Float`, `Byte`, `String`, `Void`, `&T` (for any `T`),
/// `Optional<T>` when `T: Copy`, `mem.Ptr<T>`.
///
/// String is `Copy` because its representation is an ARC handle;
/// copying bumps the refcount, no byte-level duplication.
///
/// (`DiagnosticValue` and `DiagnosticEntry` retain internal Copy
/// impls through the Slice 7a→7b transition for the legacy DV
/// bridge but are no longer part of the user-facing surface; see
/// `slice7-followups.md`.)
pub trait Copy {
}

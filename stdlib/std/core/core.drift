// Note: `Copy` is now defined in `stdlib/std/core/copy.drift`
// (`module std.core.copy`) and re-exported by this module so that
// `core.Copy` remains the user-facing access path.  See the
// `export { std.core.copy.* }` line above.

/// Trait for types that need explicit destruction logic.
///
/// `destroy(self)` is invoked at the end of an owned value's
/// lifetime to release backing resources (memory, file descriptors,
/// locks, etc.).  Implementing `Destructible` is what makes a type
/// non-`Copy` and triggers the compiler's drop-tracking.
///
/// **See also:** `Copy` (mutually exclusive in practice).
pub trait Destructible {
	fn destroy(self: Self) nothrow -> Void;
}

/// Trait for types that produce a JSON-text projection of themselves
/// for error-reporting paths.
///
/// Slice 5 (Phase 5a) — single owner of the JSON shape.  A type has
/// EXACTLY ONE Diagnostic JSON owner: a manual
/// `implement core.Diagnostic for T` impl, OR a compiler-synthesized
/// impl on a `pub error T` whose fields are all projectable.  No
/// blending of manual field behavior with compiler-generated outer
/// shape — if you write the impl, you own the whole JSON.
///
/// Field projectability (compile-time gate on synthesis — see
/// `E_PUB_ERROR_FIELD_NOT_PROJECTABLE`):
///   * Scalars are projectable (`Int`, `Uint`, `Bool`, `Float`,
///     `String`).
///   * `pub error` is projectable through its own (synthesized or
///     manual) Diagnostic impl.
///   * Ordinary `pub struct` / `pub variant` fields are projectable
///     ONLY when they have an explicit `implement core.Diagnostic
///     for T` — no automatic structural dump.
///   * Collections (`Optional<U>`, `Array<U>`, `Map<K, V>`) are NEVER
///     auto-projectable — wrap behind a carrier with a manual impl.
///   * `RawPtr<T>` / `Ptr<T>` / `TypeBox` / function-typed fields are
///     not projectable.
///
/// Built-in impls below: `Int`, `Uint`, `Bool`, `Float`, `String`.
pub trait Diagnostic {
	fn to_json_text(self: &Self) nothrow -> String;
}

// Slice 7b (0.31.63, 2026-05-06): `DiagnosticEntry` struct and
// `diagnostic_entry` helper deleted — both were internal-only
// carriage for the legacy DV bridge and have no callers post-Slice 7b
// migration of throw-side and captured-locals projection to direct
// `core.diagnostic_json_*` dispatch.

/// Trait for error types that can raise themselves as a typed
/// exception.
///
/// `throw_self(self)` is a terminal-`throws` method (never returns
/// normally — must throw).  Required by `or_throw` (and the
/// compiler-owned auto-try inside `throws` functions) so a
/// `Result<T, E>` whose Err type is a `pub error` can be unwrapped.
///
/// **Slice 5 (Phase 5a) — `pub error` carries the contract.**
/// Every `pub error E` decl gets a compiler-synthesized
/// `implement core.Throw for E` whose body throws `E` directly via
/// the existing language throw lowering (params JSON / envelope
/// construction stays centralized).  User code does NOT hand-write
/// `Throw` impls for `pub error` types — the compiler owns it.
///
/// The scalar impls below (`Int`, `Uint`, `Bool`, `Float`,
/// `String`) are TRANSITIONAL / INTERNAL compatibility for legacy
/// stdlib paths.  They are NOT a supported user-facing `or_throw`
/// Err path under Phase 5a: `Result<T, scalar>.or_throw()` is
/// rejected at the call site with `E_OR_THROW_NOT_ERROR_TYPE` (see
/// `Result.or_throw`).
///
/// **See also:** `Result.or_throw`, the auto-try contract in
/// `doc/effective-drift.md`.
pub trait Throw {
	fn throw_self(self: Self) throws;
}

/// Trait for owning wrappers that expose a `&T` view of their
/// contents.
///
/// Implemented by `conc.Arc<T>`.  Allows generic code that takes
/// `&T` to accept an `Arc<T>` via UFCS resolution.
pub trait Borrow<T> {
	fn borrow(self: &Self) nothrow -> &T;
}

/// `&mut` form of `Borrow<T>`.  Implemented by `conc.Arc<T>` and
/// `conc.MutexGuard<T>`.
pub trait BorrowMut<T> {
	fn borrow_mut(self: &mut Self) nothrow -> &mut T;
}

/// Trait for zero-argument throwing callables.
///
/// `call(self)` may throw; the return type `R` is the success
/// value.  Used as a constraint on closure-arg helpers.
///
/// **See also:** `callback_throw0`, `Fn0`.
pub trait FnThrow0<R> {
	fn call(self: &Self) -> R;
}

/// Trait for single-argument throwing callables.  See `FnThrow0`.
pub trait FnThrow1<A, R> {
	fn call(self: &Self, a: A) -> R;
}

/// Trait for two-argument throwing callables.  See `FnThrow0`.
pub trait FnThrow2<A, B, R> {
	fn call(self: &Self, a: A, b: B) -> R;
}

/// Trait for three-argument throwing callables.  See `FnThrow0`.
pub trait FnThrow3<A, B, C, R> {
	fn call(self: &Self, a: A, b: B, c: C) -> R;
}

/// Trait for four-argument throwing callables.  See `FnThrow0`.
pub trait FnThrow4<A, B, C, D, R> {
	fn call(self: &Self, a: A, b: B, c: C, d: D) -> R;
}

/// Trait for five-argument throwing callables.  See `FnThrow0`.
pub trait FnThrow5<A, B, C, D, E, R> {
	fn call(self: &Self, a: A, b: B, c: C, d: D, e: E) -> R;
}

/// Trait for six-argument throwing callables.  See `FnThrow0`.
pub trait FnThrow6<A, B, C, D, E, F2, R> {
	fn call(self: &Self, a: A, b: B, c: C, d: D, e: E, f: F2) -> R;
}

/// Boxed throwing callable interface, zero arguments.
///
/// Construct via `callback_throw0(f)` from any `f` implementing
/// `FnThrow0<R>`.  Stored representation; pass `CallbackThrow0<R>`
/// values across boundaries that don't expose the original
/// generic type.
pub interface CallbackThrow0<R> {
	fn call(self: &Self) -> R;
}

/// Boxed throwing callable interface, single argument.  See
/// `CallbackThrow0`.
pub interface CallbackThrow1<A, R> {
	fn call(self: &Self, a: A) -> R;
}

/// Boxed throwing callable interface, two arguments.  See
/// `CallbackThrow0`.
pub interface CallbackThrow2<A, B, R> {
	fn call(self: &Self, a: A, b: B) -> R;
}

/// Boxed throwing callable interface, three arguments.  See
/// `CallbackThrow0`.
pub interface CallbackThrow3<A, B, C, R> {
	fn call(self: &Self, a: A, b: B, c: C) -> R;
}

/// Boxed throwing callable interface, four arguments.  See
/// `CallbackThrow0`.
pub interface CallbackThrow4<A, B, C, D, R> {
	fn call(self: &Self, a: A, b: B, c: C, d: D) -> R;
}

/// Boxed throwing callable interface, five arguments.  See
/// `CallbackThrow0`.
pub interface CallbackThrow5<A, B, C, D, E, R> {
	fn call(self: &Self, a: A, b: B, c: C, d: D, e: E) -> R;
}

/// Boxed throwing callable interface, six arguments.  See
/// `CallbackThrow0`.
pub interface CallbackThrow6<A, B, C, D, E, F2, R> {
	fn call(self: &Self, a: A, b: B, c: C, d: D, e: E, f: F2) -> R;
}

/// Discriminated success / error type — Drift's primary value-level
/// error representation.
///
/// `Ok(value)` carries a successful `T`; `Err(err)` carries an
/// error `E`.  The `@tombstone` arm is internal — it represents
/// post-move state and should not appear in user code.
///
/// Use `match` to destructure, or `or_throw` (when `E` is a
/// `pub error`) to unwrap, or rely on the auto-try contract inside
/// `throws` functions.
///
/// **Slice 5 (Phase 5a):** `or_throw()` requires `E` to be a
/// `pub error` type — the compiler synthesizes the `Throw` impl
/// for every `pub error`.  Other Err shapes (scalars, `pub struct`,
/// `pub variant`) must be unwrapped via explicit `match`.
///
/// **See also:** `Result.or_throw`, `Result.on_error`, the auto-try
/// contract in `doc/effective-drift.md`.
pub variant Result<T, E> {
	Ok(value: T),
	Err(err: E),
	@tombstone Tombstone
}

implement<T, E> Result<T, E> {
/// Unwraps the Ok value or throws the `Err` payload directly as the
/// matching typed `pub error`.
///
/// The single user-facing explicit-unwrap operation on `Result`.
/// Inside `throws` functions and `try {}` blocks, the compiler-owned
/// auto-try contract synthesizes `or_throw()` automatically — see
/// `doc/effective-drift.md`.
///
/// **Slice 5 (Phase 5a) contract:** `E` MUST be a `pub error` type.
/// The compiler synthesizes `implement core.Throw for E` for every
/// `pub error E`, so the `require E is Throw` clause is satisfied
/// implicitly.  Calling `or_throw` on a `Result<T, E>` whose Err is
/// NOT a `pub error` (scalar, `pub struct`, `pub variant`) is
/// rejected at the call site with `E_OR_THROW_NOT_ERROR_TYPE` — those
/// shapes must be unwrapped via explicit `match`.
///
/// On the `Err` path, the synthesized impl throws `E` directly (no
/// `ResultError` wrap), so `catch E(e)` binds the typed envelope and
/// `e.<schema_field>` / `e.encode_compact()` work in one binder.
///
/// **Returns:** the `Ok` value.  Never returns on `Err` (control
/// transfers to the nearest catch via the synthesized `Throw` impl).
///
/// **See also:** `Result`, `Throw`, `Result.on_error`.
pub fn or_throw(self: Result<T, E>) -> T require E is Throw {
		match self {
			Ok(v) => { return move v; },
			Err(err) => { Throw::throw_self(move err); },
			default => { throw std.err:ResultError(diag_json = diagnostic_json_int(0)); }
		}
	}

	/// Unwraps the Ok value or invokes the recovery callback `f` on
	/// the Err.
	///
	/// Use when the caller has a domain-specific recovery strategy
	/// for `Err` that produces a fallback `T` (rather than throwing
	/// or matching).
	pub fn on_error(self: Result<T, E>, f: CallbackThrow1<E, T>) -> T {
		match self {
			Ok(v) => { return move v; },
			Err(err) => { return f.call(move err); },
			default => { throw std.err:ResultError(diag_json = diagnostic_json_int(0)); }
		}
	}
}

implement<T> Optional<T> {
	/// Unwraps the Some value or invokes the fallback callback `f`
	/// on `None`.
	///
	/// Mirror of `Result.on_error` for `Optional`.
	pub fn on_none(self: Optional<T>, f: CallbackThrow0<T>) -> T {
		match self {
			Some(v) => { return move v; },
			None => { return f.call(); }
		}
	}

	/// Unwraps the `Some` value or returns `fallback` on `None`.
	///
	/// Canonical fluent-chain ergonomic over `Optional<T>`.  Use this
	/// when the fallback is a value already on hand; for fallbacks
	/// that need to be computed lazily (or that can throw), use
	/// `on_none` with a callback instead.
	///
	/// Pinned by `test_params_cursor_access_over_pub_error` —
	/// `e.params.get(k).as_int().unwrap_or(-1)` is the canonical
	/// fluent shape over a `JsonCursor` parse result.
	pub fn unwrap_or(self: Optional<T>, fallback: T) nothrow -> T {
		match self {
			Some(v) => { return move v; },
			None => { return move fallback; }
		}
	}
}

/// Trait for zero-argument non-throwing callables.  See `FnThrow0`.
pub trait Fn0<R> {
	fn call(self: &Self) nothrow -> R;
}

/// Trait for single-argument non-throwing callables.  See `Fn0`.
pub trait Fn1<A, R> {
	fn call(self: &Self, a: A) nothrow -> R;
}

/// Trait for two-argument non-throwing callables.  See `Fn0`.
pub trait Fn2<A, B, R> {
	fn call(self: &Self, a: A, b: B) nothrow -> R;
}

/// Trait for three-argument non-throwing callables.  See `Fn0`.
pub trait Fn3<A, B, C, R> {
	fn call(self: &Self, a: A, b: B, c: C) nothrow -> R;
}

/// Trait for four-argument non-throwing callables.  See `Fn0`.
pub trait Fn4<A, B, C, D, R> {
	fn call(self: &Self, a: A, b: B, c: C, d: D) nothrow -> R;
}

/// Trait for five-argument non-throwing callables.  See `Fn0`.
pub trait Fn5<A, B, C, D, E, R> {
	fn call(self: &Self, a: A, b: B, c: C, d: D, e: E) nothrow -> R;
}

/// Trait for six-argument non-throwing callables.  See `Fn0`.
pub trait Fn6<A, B, C, D, E, F2, R> {
	fn call(self: &Self, a: A, b: B, c: C, d: D, e: E, f: F2) nothrow -> R;
}

/// Returns the unique `Void` value.
///
/// Useful for code that needs to construct a `Void`-typed
/// expression explicitly (e.g. `core.Result::Ok(core.void_value())`
/// for a `Result<Void, E>`).
pub fn void_value() nothrow -> Void {
	return;
}

/// Interior-mutability cell for a `T`.
///
/// `Cell<T>` lets a value be mutated through a `&Cell<T>` shared
/// reference without `&mut`.  Used by single-threaded state-tracking
/// internals (e.g. `io.File.closed`).  Not thread-safe — see
/// `conc.AtomicBool` / `conc.Mutex` for cross-thread cells.
///
/// **See also:** `cell`, `Cell.get`, `Cell.set`.
pub struct Cell<T> {
	value: T
}

/// Constructs a `Cell<T>` wrapping `value`.
pub fn cell<T>(var value: T) nothrow -> Cell<T> {
	return Cell<type T>(value = move value);
}

implement<T> Cell<T> {
	/// Returns a copy of the cell's current value.  Requires
	/// `T: Copy`.
	pub fn get(self: &Cell<T>) nothrow -> T require T is Copy {
		return self.value;
	}

	/// Replaces the cell's value with `value` (drops the previous).
	///
	/// Note: takes `&Cell<T>` (shared ref), not `&mut` — interior
	/// mutability is the whole point.  The previous value is
	/// dropped via the raw pointer write (no destructor invocation
	/// for the old value beyond what `ptr_write` does).
	pub fn set(self: &Cell<T>, var value: T) nothrow -> Void {
		unsafe {
			val ptr = mem.ptr_from_ref<type T>(self.value);
			mem.ptr_write<type T>(ptr, move value);
		}
	}
}

/// Boxed non-throwing callable interface, zero arguments.
///
/// Construct via `callback0(f)` from any `f` implementing
/// `Fn0<R>`.  Erases the original generic type so the callback can
/// be stored in heterogeneous containers and crossed across module
/// boundaries.
///
/// **See also:** `callback0`, `Fn0`, `CallbackThrow0`.
pub interface Callback0<R> {
	fn call(self: &Self) nothrow -> R;
}

/// Boxed non-throwing callable interface, single argument.  See
/// `Callback0`.
pub interface Callback1<A, R> {
	fn call(self: &Self, a: A) nothrow -> R;
}

/// Boxed non-throwing callable interface, two arguments.  See
/// `Callback0`.
pub interface Callback2<A, B, R> {
	fn call(self: &Self, a: A, b: B) nothrow -> R;
}

/// Boxed non-throwing callable interface, three arguments.  See
/// `Callback0`.
pub interface Callback3<A, B, C, R> {
	fn call(self: &Self, a: A, b: B, c: C) nothrow -> R;
}

/// Boxed non-throwing callable interface, four arguments.  See
/// `Callback0`.
pub interface Callback4<A, B, C, D, R> {
	fn call(self: &Self, a: A, b: B, c: C, d: D) nothrow -> R;
}

/// Boxed non-throwing callable interface, five arguments.  See
/// `Callback0`.
pub interface Callback5<A, B, C, D, E, R> {
	fn call(self: &Self, a: A, b: B, c: C, d: D, e: E) nothrow -> R;
}

/// Boxed non-throwing callable interface, six arguments.  See
/// `Callback0`.
pub interface Callback6<A, B, C, D, E, F2, R> {
	fn call(self: &Self, a: A, b: B, c: C, d: D, e: E, f: F2) nothrow -> R;
}

/// Boxes a zero-argument non-throwing callable as a `Callback0<R>`.
@intrinsic pub fn callback0<F, R>(f: F) nothrow -> Callback0<R> require F is Fn0<R>;

/// Boxes a single-argument non-throwing callable as `Callback1<A, R>`.
@intrinsic pub fn callback1<F, A, R>(f: F) nothrow -> Callback1<A, R> require F is Fn1<A, R>;

/// Boxes a two-argument non-throwing callable as `Callback2<A, B, R>`.
@intrinsic pub fn callback2<F, A, B, R>(f: F) nothrow -> Callback2<A, B, R> require F is Fn2<A, B, R>;

/// Boxes a zero-argument throwing callable as `CallbackThrow0<R>`.
@intrinsic pub fn callback_throw0<F, R>(f: F) nothrow -> CallbackThrow0<R> require F is FnThrow0<R>;

/// Boxes a single-argument throwing callable as `CallbackThrow1<A, R>`.
@intrinsic pub fn callback_throw1<F, A, R>(f: F) nothrow -> CallbackThrow1<A, R> require F is FnThrow1<A, R>;

/// Boxes a two-argument throwing callable as `CallbackThrow2<A, B, R>`.
@intrinsic pub fn callback_throw2<F, A, B, R>(f: F) nothrow -> CallbackThrow2<A, B, R> require F is FnThrow2<A, B, R>;

/// Boxes a three-argument non-throwing callable as `Callback3<A, B, C, R>`.
@intrinsic pub fn callback3<F, A, B, C, R>(f: F) nothrow -> Callback3<A, B, C, R> require F is Fn3<A, B, C, R>;

/// Boxes a four-argument non-throwing callable as `Callback4<...>`.
@intrinsic pub fn callback4<F, A, B, C, D, R>(f: F) nothrow -> Callback4<A, B, C, D, R> require F is Fn4<A, B, C, D, R>;

/// Boxes a five-argument non-throwing callable as `Callback5<...>`.
@intrinsic pub fn callback5<F, A, B, C, D, E, R>(f: F) nothrow -> Callback5<A, B, C, D, E, R> require F is Fn5<A, B, C, D, E, R>;

/// Boxes a six-argument non-throwing callable as `Callback6<...>`.
@intrinsic pub fn callback6<F, A, B, C, D, E, F2, R>(f: F) nothrow -> Callback6<A, B, C, D, E, F2, R> require F is Fn6<A, B, C, D, E, F2, R>;

/// Boxes a three-argument throwing callable as `CallbackThrow3<...>`.
@intrinsic pub fn callback_throw3<F, A, B, C, R>(f: F) nothrow -> CallbackThrow3<A, B, C, R> require F is FnThrow3<A, B, C, R>;

/// Boxes a four-argument throwing callable as `CallbackThrow4<...>`.
@intrinsic pub fn callback_throw4<F, A, B, C, D, R>(f: F) nothrow -> CallbackThrow4<A, B, C, D, R> require F is FnThrow4<A, B, C, D, R>;

/// Boxes a five-argument throwing callable as `CallbackThrow5<...>`.
@intrinsic pub fn callback_throw5<F, A, B, C, D, E, R>(f: F) nothrow -> CallbackThrow5<A, B, C, D, E, R> require F is FnThrow5<A, B, C, D, E, R>;

/// Boxes a six-argument throwing callable as `CallbackThrow6<...>`.
@intrinsic pub fn callback_throw6<F, A, B, C, D, E, F2, R>(f: F) nothrow -> CallbackThrow6<A, B, C, D, E, F2, R> require F is FnThrow6<A, B, C, D, E, F2, R>;

/// Returns a stable `Uint64` type-id for `T`, used as the key by
/// the registry / type-box machinery.
///
/// **See also:** `runtime.GlobalRegistry`, `runtime.TypeBox`.
@intrinsic pub fn type_id<T>() nothrow -> Uint64;

// `drop_value` moved to `std.core.arc` (declared next to `arc()` /
// the Arc drop thunk that is its primary internal user, breaking
// what would otherwise be a `std.core.arc → std.core` cycle).
// Re-exported through `export { std.core.arc.* }` above so the
// canonical user access path remains `core.drop_value<T>(value)`.

implement copy_mod.Copy for Int {
}

implement copy_mod.Copy for Uint {
}

implement copy_mod.Copy for Uint64 {
}

implement copy_mod.Copy for Bool {
}

implement copy_mod.Copy for Float {
}

implement copy_mod.Copy for Byte {
}

implement copy_mod.Copy for String {
}

// Slice 7b (0.31.63, 2026-05-06): `Copy for DiagnosticValue` and
// `Copy for DiagnosticEntry` impls deleted alongside the structs.

// `MemoryOrder` is declared in `lang.atomic`; its `Copy` impl lives
// here so `lang.atomic` does not need to import `std.core` (which
// would close a cycle through `std.core → std.core.arc →
// lang.atomic`).
implement copy_mod.Copy for atomic.MemoryOrder {
}

// ── Frozen — conditional impls for stdlib generics ────────────────
//
// Primitive Frozen impls (Int / Uint / String / Bool / Float /
// Byte / Void) live in `stdlib/std/core/shareable.drift`,
// alongside the trait declaration.
// The two impls below stay here because `Optional` and `Result` are
// declared in this module — moving these impls would create a
// circular import from `shareable.drift` back to `std.core`.
//
// Per the substrate plan's auto-derive-by-composition rule applied
// to stdlib's own generics: `Optional<T>` / `Result<T, E>` are
// Frozen iff all type-args are Frozen.

implement<T> shareable.Frozen for Optional<T> require T is shareable.Frozen { }
implement<T, E> shareable.Frozen for Result<T, E> require T is shareable.Frozen, E is shareable.Frozen { }

implement copy_mod.Copy for Void {
}

implement<T> copy_mod.Copy for &T {
}

implement<T> copy_mod.Copy for Optional<T> require T is copy_mod.Copy {
}

implement<T> copy_mod.Copy for mem.Ptr<T> {
}

implement Diagnostic for Int {
	pub fn to_json_text(self: &Int) nothrow -> String {
		return diagnostic_json_int(*self);
	}
}

implement Diagnostic for Uint {
	pub fn to_json_text(self: &Uint) nothrow -> String {
		return diagnostic_json_uint(*self);
	}
}

implement Diagnostic for Bool {
	pub fn to_json_text(self: &Bool) nothrow -> String {
		return diagnostic_json_bool(*self);
	}
}

implement Diagnostic for Float {
	pub fn to_json_text(self: &Float) nothrow -> String {
		return diagnostic_json_float(*self);
	}
}

implement Diagnostic for String {
	pub fn to_json_text(self: &String) nothrow -> String {
		return diagnostic_json_string(self);
	}
}

// Slice 7b (0.31.63, 2026-05-06): `Diagnostic for DiagnosticValue`
// impl deleted alongside `_dv_to_json_text`.  No production code
// projects DV values to JSON anymore.

// ── Slice 7a (ABI 13): legacy scalar `Throw for {Int,Uint,Bool,Float,
// String}` impls retired.  `Result<T, scalar>.or_throw()` has been
// rejected at the call site since Slice 5 (Phase 5a) with
// `E_OR_THROW_NOT_ERROR_TYPE`, and no caller in stdlib/tests/examples
// throws a bare scalar value.  Use `pub error E` for any throwable
// error type — the compiler auto-synthesizes `Throw for E`.

/// Canonical container id for `String`, used in
/// `IndexError.container_id` when string operations bounds-check.
pub const STRING_CONTAINER_ID: String = "std.core:String";

/// LOW-LEVEL byte-load primitive (documented-internal: stdlib and
/// compiler plumbing; user code should prefer the Result-returning
/// `byte_at` methods on `String` / `text.StringByteView`).  NOTHROW
/// and FAIL-CLOSED: an out-of-range index is a contract ABORT with a
/// diagnostic, never an exception and never a wild read.  Bounds
/// failure as DATA is the public methods' job.
@intrinsic pub fn string_byte_at(s: &String, i: Int) nothrow -> Byte;

/// Constructs a `String` from `len` UTF-8 bytes starting at `ptr`.
///
/// Does NOT validate UTF-8 — caller is responsible for ensuring the
/// bytes are valid UTF-8.  Use `text.utf8_from_bytes` for the
/// validating, safe form.
@intrinsic pub fn string_from_utf8_bytes(ptr: mem.Ptr<Byte>, len: Int) nothrow -> String;

/// Returns the raw UTF-8 bytes of `s` as an `Array<Byte>`.
///
/// Preserves embedded NUL bytes and multibyte sequences exactly —
/// one Byte per UTF-8 byte.  The returned array's `len` equals
/// `s.byte_length()`, which is *not* the same as the Unicode
/// character count for non-ASCII text.
///
/// Symmetric public pair to `string_from_utf8_bytes`:
/// `string_from_utf8_bytes` (via pointer + length) reconstructs the
/// original string from this array's bytes, with no validation step
/// (the input was already a valid Drift `String`).
///
/// **See also:** `string_from_utf8_bytes`, `string_byte_at`,
/// `text.utf8_from_bytes` (validating decode of arbitrary bytes).
pub fn string_to_utf8_bytes(s: &String) nothrow -> Array<Byte> {
	val n = byte_length(s);
	var out: Array<Byte> = [];
	var i = 0;
	while i < n {
		out.push(string_byte_at(s, i));
		i = i + 1;
	}
	return move out;
}

implement String {
	/// Returns the string's length in bytes (not characters).
	pub fn byte_length(self: &String) nothrow -> Int {
		return byte_length(self);
	}

	/// Returns an owned copy of this string.
	///
	/// This is a cheap ARC refcount increment, not a byte-level copy.
	pub fn clone(self: &String) nothrow -> String {
		return *self;
	}
}


// ── Arc — shared-ownership primitive ─────────────────────────────
//
// `Arc<T>` / `ArcHeader` / `ArcBox<T>` and the `arc<T>()` factory
// live in `std.core.arc` (re-exported above).  The trait impls
// below stay here because they reference `Borrow`, `BorrowMut`,
// `Destructible`, and `shareable.Share` — all declared in
// `std.core` / `std.core.shareable`.  Going the other way would
// force `std.core.arc` to import `std.core` and close a cycle.
// See the module-classification rule in
// `feedback_module_classification_by_contract.md`.

implement<T> Borrow<T> for arc_mod.Arc<T> {
	pub fn borrow(self: &arc_mod.Arc<T>) nothrow -> &T {
		return self.get();
	}
}

implement<T> BorrowMut<T> for arc_mod.Arc<T> {
	pub fn borrow_mut(self: &mut arc_mod.Arc<T>) nothrow -> &mut T {
		return self.get_mut();
	}
}

implement<T> Destructible for arc_mod.Arc<T> {
	/// Compiler-owned intrinsic (ARC_DESTROY) — last-drop of
	/// `Arc<T>`.  For concrete T the lowering redirects to
	/// `_arc_destroy_impl<T>`; the interface-T branch is handled by
	/// the compiler-synthesized fat-Arc destructor.
	@intrinsic pub fn destroy(var self: arc_mod.Arc<T>) nothrow -> Void;
}

/// `Arc<T>` is the canonical shared-owner type.  `share` produces
/// another owner of the same `ArcBox<T>` (the underlying allocation
/// + refcount header) by atomically incrementing the strong count.
/// Cheap — no heap allocation, no value copy.  Aliasing is real:
/// every owner of an `Arc<T>` observes the same value through
/// `arc.get()`.
///
/// Implementation delegates to `Arc.clone` (the existing
/// `_arc_clone_impl` runtime intrinsic).  `Arc.clone` remains
/// available for code that explicitly wants the named clone API;
/// `share` is the language-level spelling for the shared-ownership
/// capability.
implement<T> shareable.Share for arc_mod.Arc<T> {
	pub fn share(self: &arc_mod.Arc<T>) nothrow -> arc_mod.Arc<T> {
		return self.clone();
	}
}

/// `Box<T>` is the unique-ownership single-allocation value indirection
/// (the non-shared sibling of `Arc<T>`).  An ORDINARY generic
/// `Destructible` impl — a plain method, NOT an `@intrinsic` (no
/// `BOX_DESTROY`).  Destruction goes through the public consuming `take`
/// path; the read-only `Box._is_drained` guard short-circuits the
/// re-drop of the box that `take` leaves drained (the ownership ledger
/// suppresses re-dropping a destructor's own `self`, which `take` has
/// consumed, at the Return).
implement<T> Destructible for box_mod.Box<T> {
	pub fn destroy(var self: box_mod.Box<T>) nothrow -> Void {
		// Destruction goes through the public consuming `take` path: it moves the
		// owned `T` out and frees the cell via `mem.replace`-with-`rawbuffer_empty`
		// (never a partial move of `self.buf`).  `take` leaves its consumed `self`
		// drained, which the runtime re-drops at `take`'s scope exit and re-enters
		// this destructor; the `_is_drained` guard short-circuits that re-drop so we
		// never call `take` on a null cell.  `self` is consumed by `take`, so the
		// ownership ledger does not re-drop the destructor's own `self`.
		if box_mod._box_is_drained<type T>(self) {
			return;
		}
		val value = self.take();
		arc_mod.drop_value<type T>(move value);
		return;
	}
}


// ── Diagnostics-context envelope view types (DV→JSON migration, Slice 1) ──
//
// Public dump surface for the migration: `e.params` returns an
// `ErrorParamsView`; `view.encode_compact()` returns the canonical
// JSON text of the exception's declared fields.  Construction of
// the view is compiler-handled (type-checker special-case +
// HIR→MIR field-access lowering); user code does not construct it
// directly in Slice 1.

/// Opaque view over an `Error`'s declared exception field values,
/// serialized as canonical JSON text.  Construct via `e.params` on
/// a catch-bound Error.
pub struct ErrorParamsView {
	json_text: String,
}

implement copy_mod.Copy for ErrorParamsView { }

implement ErrorParamsView {
	/// Returns the canonical JSON text of the exception's declared
	/// fields.  Object form: `{"<key>":<value>,...}` with keys in
	/// lex-utf8 order.  Empty exception → `"{}"`.
	pub fn encode_compact(self: &ErrorParamsView) nothrow -> String {
		return self.json_text;
	}

	/// Look up a declared field by key.  Returns a `JsonCursor` that
	/// distinguishes "absent key" from "present-and-explicit-null"
	/// and supports scalar typed accessors (`as_int`, `as_bool`,
	/// `as_float`, `as_string`).  Slice 4A scope — scalars only;
	/// nested-object/array drilling is a later slice.
	///
	/// `e.params.get("missing").is_missing() == true`
	/// `e.params.get("present").is_null() == true` (when value was JSON `null`)
	/// `e.params.get("count").as_int() == Optional::Some(42)`
	pub fn get(self: &ErrorParamsView, key: String) nothrow -> JsonCursor {
		return _params_cursor_get(self.json_text, key);
	}
}

/// Opaque view over an `Error`'s `^`-captured frames, serialized as
/// a canonical JSON array.  Construct via `e.context` on a
/// catch-bound Error.
pub struct ErrorContextView {
	json_text: String,
}

implement copy_mod.Copy for ErrorContextView { }

implement ErrorContextView {
	/// Returns the canonical JSON text of the exception's
	/// `^`-captured frames.  Array form:
	///
	///     [{"fn":"<fqn>","locals":{<key>:<value>,...}}, ...]
	///
	/// Frames are in unwind observation order — innermost-first
	/// (the function that threw appears first; outer functions
	/// follow as the unwind propagates).  Recursive calls
	/// contribute repeated frame objects (NOT merged).  Empty
	/// context (no `^` captures fired) → `"[]"`.
	pub fn encode_compact(self: &ErrorContextView) nothrow -> String {
		return self.json_text;
	}
}


// ── Internal JSON-text helpers ───────────────────────────────────
//
// Slice 7b (0.31.63, 2026-05-06): the legacy DV-attachment path
// (ConstructError(payload=DV) + ErrorAddAttrDV) is retired from
// production lowering.  `_dv_to_json_text` and the
// `DiagnosticEntry` / `diagnostic_entry` helpers were deleted with
// it.  Throw-side params JSON now comes from
// `core.Diagnostic for E`'s `to_json_text(&E)` impl (manual or
// compiler-synthesized) called by `_construct_error_via_diagnostic`
// in `lang/driftc/stage2/hir_to_mir.py`.  The captured-locals JSON
// frame is built by direct per-scalar dispatch to the
// `core.diagnostic_json_*` helpers (no DV intermediate).
//
// The string-escape / number-format helpers below
// (`_json_quote_string`, the `diagnostic_json_*` family, etc.) are
// kept here because std.core has its own throws and cannot depend on
// std.json — projecting structured fields to canonical JSON at the
// throw site needs a minimal scoped JSON-text projector that does
// not pull std.json into std.core's dependency closure.
//
// Slice 7c-3 (ABI 14, 2026-05-06): the compiler-intrinsic
// `DiagnosticValue` TypeKind / runtime substrate is fully retired
// across the public surface, runtime archive, and compiler
// internals.  The DV→JSON migration is complete.

fn _hex_digit(v: Int) nothrow -> String {
	if v == 0 { return "0"; }
	if v == 1 { return "1"; }
	if v == 2 { return "2"; }
	if v == 3 { return "3"; }
	if v == 4 { return "4"; }
	if v == 5 { return "5"; }
	if v == 6 { return "6"; }
	if v == 7 { return "7"; }
	if v == 8 { return "8"; }
	if v == 9 { return "9"; }
	if v == 10 { return "A"; }
	if v == 11 { return "B"; }
	if v == 12 { return "C"; }
	if v == 13 { return "D"; }
	if v == 14 { return "E"; }
	return "F";
}

fn _byte_hex2(b: Byte) nothrow -> String {
	val v = cast<Int>(b);
	val hi = v / 16;
	val lo = v % 16;
	return _hex_digit(hi) + _hex_digit(lo);
}

fn _byte_to_string(b: Byte) nothrow -> String {
	unsafe {
		var raw = mem.alloc_uninit<type Byte>(1);
		mem.write<type Byte>(raw, 0, b);
		val out = string_from_utf8_bytes(mem.rawbuffer_ptr<type Byte>(raw), 1);
		mem.dealloc<type Byte>(raw);
		return out;
	}
}

/// JSON-quote and escape `s` per RFC 8259.  Returns a complete
/// JSON value: the input string surrounded by double quotes, with
/// `"` / `\` / control characters escaped per JSON rules.  The
/// result is ready to splice into a JSON object/array.
///
/// Slice 5 public surface (spec §9).  Internal callers that
/// historically used `_json_quote_string` continue to work via
/// the wrapper below.
pub fn diagnostic_json_string(s: &String) nothrow -> String {
	return _json_quote_string(s);
}

/// JSON literal `null`.  Slice 5 public helper (spec §9).
pub fn diagnostic_json_null() nothrow -> String {
	return "null";
}

/// JSON literal `true` / `false`.  Slice 5 public helper (spec §9).
pub fn diagnostic_json_bool(v: Bool) nothrow -> String {
	if v {
		return "true";
	}
	return "false";
}

/// Format `n` as a JSON number text (decimal, no quotes).  Slice 5
/// public helper (spec §9).
pub fn diagnostic_json_int(n: Int) nothrow -> String {
	return f"{n}";
}

/// Format `n` as a JSON number text (decimal, no quotes).  Slice 5
/// public helper (spec §9).
pub fn diagnostic_json_uint(n: Uint) nothrow -> String {
	return f"{n}";
}

/// Format `f` as a JSON number text (canonical decimal form per
/// the runtime's default Float→String conversion).  Slice 5 public
/// helper (spec §9).  Non-finite values (NaN/Inf) are explicitly
/// out of scope for v1; if the runtime ever exposes stable
/// non-finite syntax, this helper's behavior is defined then.
pub fn diagnostic_json_float(f: Float) nothrow -> String {
	return f"{f}";
}

/// JSON-quotes and escapes `s` per RFC 8259.  Returns
/// `"\"<escaped>\""`.  Private — Slice 1 transitional helper.
fn _json_quote_string(s: &String) nothrow -> String {
	var out = "\"";
	val n = s.byte_length();
	var i = 0;
	while i < n {
		val b = string_byte_at(s, i);
		if b == cast<Byte>(34) {
			out = out + "\\\"";
		} else {
			if b == cast<Byte>(92) {
				out = out + "\\\\";
			} else {
				if b == cast<Byte>(8) {
					out = out + "\\b";
				} else {
					if b == cast<Byte>(12) {
						out = out + "\\f";
					} else {
						if b == cast<Byte>(10) {
							out = out + "\\n";
						} else {
							if b == cast<Byte>(13) {
								out = out + "\\r";
							} else {
								if b == cast<Byte>(9) {
									out = out + "\\t";
								} else {
									if b < cast<Byte>(32) {
										out = out + "\\u00" + _byte_hex2(b);
									} else {
										out = out + _byte_to_string(b);
									}
								}
							}
						}
					}
				}
			}
		}
		i = i + 1;
	}
	return out + "\"";
}

// ── JsonCursor — diagnostics-only fluent lookup over canonical JSON ──
//
// Slice 4A surface for `<error>.params.get("k").as_*()` typed lookup.
// Distinguishes "absent key" from "present-and-explicit-JSON-null".
// SCALAR ACCESSORS ONLY (Int/Bool/Float/String).  Nested object /
// array drilling is a later slice; for now those values are
// represented by the `Other` variant and probed via the typed
// accessors which all return `Optional::None()`.
//
// DELETION LEDGER (transitional duplicate-name with `std.json.JsonCursor`):
// std.json already has a `JsonCursor` for navigating parsed `JsonNode`
// trees — different shape entirely.  This `core.JsonCursor` is the
// diagnostics-text cursor (no JsonNode dependency); it keeps the
// architecture rule that std.core never imports std.json.  A future
// cleanup may unify the two surfaces or rename the diagnostics one
// (e.g., `core.DiagJsonCursor`).  For Slice 4A the K-spec'd public
// spelling is `JsonCursor` returned from `e.params.get(...)`.
//
// **Float parsing.**  Slice 4A's `as_float` accepts JSON numbers in
// the form `[-]<digits>[.<digits>][[eE][+-]?<digits>]`, matching
// `std.format.format_float` output (which always emits the
// exponent suffix — `1.5` round-trips as `"1.5E0"`).  The exponent
// is applied as a power of 10 via repeated multiply/divide; very
// large exponents are bounded by the loop count.  A future slice
// may swap this for a runtime `drift_string_to_f64` helper for
// full IEEE 754 round-trip fidelity.

pub variant JsonCursor {
	Missing,
	NullValue,
	BoolVal(value: Bool),
	IntVal(value: Int),
	FloatVal(value: Float),
	StringVal(value: String),
	/// Object / Array values — not consumable as scalar in Slice 4A.
	/// Holds the raw canonical JSON text for future drilling.
	Other(text: String),
}

implement copy_mod.Copy for JsonCursor { }

implement JsonCursor {
	pub fn is_missing(self: &JsonCursor) nothrow -> Bool {
		match self {
			Missing => { return true; },
			default => { return false; },
		}
	}

	pub fn is_null(self: &JsonCursor) nothrow -> Bool {
		match self {
			NullValue => { return true; },
			default => { return false; },
		}
	}

	pub fn as_int(self: &JsonCursor) nothrow -> Optional<Int> {
		match self {
			IntVal(v) => { return Optional::Some(*v); },
			default => { return Optional<Int>::None(); },
		}
	}

	pub fn as_bool(self: &JsonCursor) nothrow -> Optional<Bool> {
		match self {
			BoolVal(v) => { return Optional::Some(*v); },
			default => { return Optional<Bool>::None(); },
		}
	}

	/// Returns Some for `FloatVal` only.  `IntVal` does not auto-
	/// promote in Slice 4A (no Int→Float cast in the v1 numeric
	/// scalar cast surface); callers wanting numeric coercion can
	/// match `IntVal` themselves.
	pub fn as_float(self: &JsonCursor) nothrow -> Optional<Float> {
		match self {
			FloatVal(v) => { return Optional::Some(*v); },
			default => { return Optional<Float>::None(); },
		}
	}

	pub fn as_string(self: &JsonCursor) nothrow -> Optional<String> {
		match self {
			StringVal(v) => { return Optional::Some(*v); },
			default => { return Optional<String>::None(); },
		}
	}
}


// ── JSON-text parser (Slice 4A — params lookup only) ────────────
//
// Minimal JSON parser scoped to params lookup.  Designed against
// the canonical writer used at the throw site:
// `core.Diagnostic for E`'s `to_json_text` impl (manual or
// compiler-synthesized) emits a top-level object with declared
// field keys; scalar values use the `core.diagnostic_json_*`
// helpers below; nested object/array values are held as raw text.
// Defensive on malformed input — returns `Missing` rather than
// panicking.  Private; not exported.

fn _byte_is_ws(b: Byte) nothrow -> Bool {
	if b == cast<Byte>(32) { return true; }
	if b == cast<Byte>(9) { return true; }
	if b == cast<Byte>(10) { return true; }
	if b == cast<Byte>(13) { return true; }
	return false;
}

fn _byte_is_digit(b: Byte) nothrow -> Bool {
	val v = cast<Int>(b);
	if v >= 48 {
		if v <= 57 { return true; }
	}
	return false;
}

fn _json_skip_ws(text: &String, p: Int) nothrow -> Int {
	val n = text.byte_length();
	var pos = p;
	while pos < n {
		val b = string_byte_at(text, pos);
		if !_byte_is_ws(b) {
			return pos;
		}
		pos = pos + 1;
	}
	return pos;
}

/// Result of a quoted-JSON-string parse: (`value`, `next_pos`)
/// or (`""`, `-1`) on malformed input.
struct _JsonStrParse {
	value: String,
	next_pos: Int,
}

fn _json_parse_string_at(text: &String, p: Int) nothrow -> _JsonStrParse {
	val n = text.byte_length();
	if p >= n { return _JsonStrParse(value = "", next_pos = -1); }
	if string_byte_at(text, p) != cast<Byte>(34) {
		return _JsonStrParse(value = "", next_pos = -1);
	}
	var pos = p + 1;
	var out = "";
	while pos < n {
		val b = string_byte_at(text, pos);
		if b == cast<Byte>(34) {
			return _JsonStrParse(value = out, next_pos = pos + 1);
		}
		if b == cast<Byte>(92) {
			// Escape sequence.
			pos = pos + 1;
			if pos >= n { return _JsonStrParse(value = "", next_pos = -1); }
			val esc = string_byte_at(text, pos);
			if esc == cast<Byte>(34) {
				out = out + _byte_to_string(cast<Byte>(34));
			} else {
				if esc == cast<Byte>(92) {
					out = out + _byte_to_string(cast<Byte>(92));
				} else {
					if esc == cast<Byte>(110) {
						// `\n`
						out = out + _byte_to_string(cast<Byte>(10));
					} else {
						if esc == cast<Byte>(114) {
							out = out + _byte_to_string(cast<Byte>(13));
						} else {
							if esc == cast<Byte>(116) {
								out = out + _byte_to_string(cast<Byte>(9));
							} else {
								if esc == cast<Byte>(98) {
									out = out + _byte_to_string(cast<Byte>(8));
								} else {
									if esc == cast<Byte>(102) {
										out = out + _byte_to_string(cast<Byte>(12));
									} else {
										// `\u00XX` and other escapes — defensive
										// fallback: include literal escape sequence
										// rather than failing.  Slice 4A's writer
										// (_json_quote_string) only emits the cases
										// handled above; pathological inputs land
										// here.  Return Missing-equivalent.
										return _JsonStrParse(value = "", next_pos = -1);
									}
								}
							}
						}
					}
				}
			}
			pos = pos + 1;
		} else {
			out = out + _byte_to_string(b);
			pos = pos + 1;
		}
	}
	return _JsonStrParse(value = "", next_pos = -1);
}

/// Skip one JSON value starting at `pos`.  Returns the position
/// just past the end of the value, or `-1` on malformed input.
fn _json_skip_value(text: &String, p: Int) nothrow -> Int {
	val n = text.byte_length();
	if p >= n { return -1; }
	val first = string_byte_at(text, p);
	if first == cast<Byte>(34) {
		// String — reuse parse-and-discard.
		val parsed = _json_parse_string_at(text, p);
		return parsed.next_pos;
	}
	if first == cast<Byte>(123) {
		// Object — track brace depth, respecting strings.
		return _json_skip_balanced(text, p, cast<Byte>(123), cast<Byte>(125));
	}
	if first == cast<Byte>(91) {
		// Array — track bracket depth, respecting strings.
		return _json_skip_balanced(text, p, cast<Byte>(91), cast<Byte>(93));
	}
	// Number / true / false / null — read until ws / `,` / `}` / `]`.
	var pos = p;
	while pos < n {
		val b = string_byte_at(text, pos);
		if _byte_is_ws(b) { return pos; }
		if b == cast<Byte>(44) { return pos; }
		if b == cast<Byte>(125) { return pos; }
		if b == cast<Byte>(93) { return pos; }
		pos = pos + 1;
	}
	return pos;
}

fn _json_skip_balanced(text: &String, p: Int, open: Byte, close: Byte) nothrow -> Int {
	val n = text.byte_length();
	if p >= n { return -1; }
	var pos = p;
	var depth = 0;
	var in_string = false;
	while pos < n {
		val b = string_byte_at(text, pos);
		if in_string {
			if b == cast<Byte>(92) {
				// Skip the escaped byte.
				pos = pos + 2;
				continue;
			}
			if b == cast<Byte>(34) {
				in_string = false;
				pos = pos + 1;
				continue;
			}
			pos = pos + 1;
			continue;
		}
		if b == cast<Byte>(34) {
			in_string = true;
			pos = pos + 1;
			continue;
		}
		if b == open {
			depth = depth + 1;
			pos = pos + 1;
			continue;
		}
		if b == close {
			depth = depth - 1;
			pos = pos + 1;
			if depth == 0 { return pos; }
			continue;
		}
		pos = pos + 1;
	}
	return -1;
}

/// Parse one JSON value at `pos` into a `JsonCursor`.  Returns
/// `JsonCursor::Missing()` on malformed input (defensive
/// fallback).
fn _json_parse_value_at(text: &String, p: Int) nothrow -> JsonCursor {
	val n = text.byte_length();
	if p >= n { return JsonCursor::Missing(); }
	val first = string_byte_at(text, p);
	// Quoted string.
	if first == cast<Byte>(34) {
		val parsed = _json_parse_string_at(text, p);
		if parsed.next_pos < 0 { return JsonCursor::Missing(); }
		return JsonCursor::StringVal(value = parsed.value);
	}
	// `true` / `false` / `null` literals.
	if first == cast<Byte>(116) {
		// `true`
		if _json_match_literal(text, p, "true") { return JsonCursor::BoolVal(value = true); }
		return JsonCursor::Missing();
	}
	if first == cast<Byte>(102) {
		// `false`
		if _json_match_literal(text, p, "false") { return JsonCursor::BoolVal(value = false); }
		return JsonCursor::Missing();
	}
	if first == cast<Byte>(110) {
		// `null`
		if _json_match_literal(text, p, "null") { return JsonCursor::NullValue(); }
		return JsonCursor::Missing();
	}
	// Object / Array — store as Other(raw_text).
	if first == cast<Byte>(123) {
		val end = _json_skip_balanced(text, p, cast<Byte>(123), cast<Byte>(125));
		if end < 0 { return JsonCursor::Missing(); }
		return JsonCursor::Other(text = _string_slice(text, p, end));
	}
	if first == cast<Byte>(91) {
		val end = _json_skip_balanced(text, p, cast<Byte>(91), cast<Byte>(93));
		if end < 0 { return JsonCursor::Missing(); }
		return JsonCursor::Other(text = _string_slice(text, p, end));
	}
	// Number — `[-]<digits>[.<digits>][[eE][+-]?<digits>]`.
	// Exponent suffix is required to round-trip
	// `std.format.format_float` output (e.g. `"1.5E0"`); see the
	// commentary above the variant declaration.
	return _json_parse_number_at(text, p);
}

fn _json_match_literal(text: &String, p: Int, lit: String) nothrow -> Bool {
	val n = text.byte_length();
	val m = lit.byte_length();
	if p + m > n { return false; }
	var i = 0;
	while i < m {
		if string_byte_at(text, p + i) != string_byte_at(lit, i) {
			return false;
		}
		i = i + 1;
	}
	return true;
}

/// Slice `[start, end)` of `text` into a fresh owned `String`.
fn _string_slice(text: &String, start: Int, end: Int) nothrow -> String {
	if end <= start { return ""; }
	var out = "";
	var i = start;
	while i < end {
		out = out + _byte_to_string(string_byte_at(text, i));
		i = i + 1;
	}
	return out;
}

fn _digit_to_float(b: Byte) nothrow -> Float {
	if b == cast<Byte>(48) { return 0.0; }
	if b == cast<Byte>(49) { return 1.0; }
	if b == cast<Byte>(50) { return 2.0; }
	if b == cast<Byte>(51) { return 3.0; }
	if b == cast<Byte>(52) { return 4.0; }
	if b == cast<Byte>(53) { return 5.0; }
	if b == cast<Byte>(54) { return 6.0; }
	if b == cast<Byte>(55) { return 7.0; }
	if b == cast<Byte>(56) { return 8.0; }
	return 9.0;
}

fn _json_parse_number_at(text: &String, p: Int) nothrow -> JsonCursor {
	val n = text.byte_length();
	if p >= n { return JsonCursor::Missing(); }
	var pos = p;
	var negative = false;
	if string_byte_at(text, pos) == cast<Byte>(45) {
		negative = true;
		pos = pos + 1;
	}
	if pos >= n { return JsonCursor::Missing(); }
	if !_byte_is_digit(string_byte_at(text, pos)) { return JsonCursor::Missing(); }
	// Integer part — accumulate Int and Float simultaneously so we can
	// emit IntVal for pure integers and FloatVal for decimals without
	// needing an Int→Float cast (cast<Float>(Int) is not supported in
	// the v1 numeric scalar cast surface).
	var int_acc: Int = 0;
	var float_acc: Float = 0.0;
	while pos < n {
		val b = string_byte_at(text, pos);
		if !_byte_is_digit(b) { break; }
		int_acc = int_acc * 10 + (cast<Int>(b) - 48);
		float_acc = float_acc * 10.0 + _digit_to_float(b);
		pos = pos + 1;
	}
	// Optional decimal part.
	var has_decimal = false;
	if pos < n {
		val b = string_byte_at(text, pos);
		if b == cast<Byte>(46) {
			has_decimal = true;
			pos = pos + 1;
			if pos >= n { return JsonCursor::Missing(); }
			if !_byte_is_digit(string_byte_at(text, pos)) { return JsonCursor::Missing(); }
			var divisor: Float = 1.0;
			while pos < n {
				val db = string_byte_at(text, pos);
				if !_byte_is_digit(db) { break; }
				divisor = divisor * 10.0;
				float_acc = float_acc + _digit_to_float(db) / divisor;
				pos = pos + 1;
			}
		}
	}
	// Optional exponent — matches std.format.format_float output
	// (which always emits `[eE]<sign?><digits>`).
	var has_exponent = false;
	var exp_negative = false;
	var exp_value: Int = 0;
	if pos < n {
		val maybe_e = string_byte_at(text, pos);
		if maybe_e == cast<Byte>(101) or maybe_e == cast<Byte>(69) {
			has_exponent = true;
			pos = pos + 1;
			if pos >= n { return JsonCursor::Missing(); }
			val sign_b = string_byte_at(text, pos);
			if sign_b == cast<Byte>(43) {
				pos = pos + 1;
			} else {
				if sign_b == cast<Byte>(45) {
					exp_negative = true;
					pos = pos + 1;
				}
			}
			if pos >= n { return JsonCursor::Missing(); }
			if !_byte_is_digit(string_byte_at(text, pos)) { return JsonCursor::Missing(); }
			while pos < n {
				val db = string_byte_at(text, pos);
				if !_byte_is_digit(db) { break; }
				exp_value = exp_value * 10 + (cast<Int>(db) - 48);
				pos = pos + 1;
			}
		}
	}
	if has_decimal or has_exponent {
		// FloatVal — apply the exponent.
		if has_exponent {
			var i = 0;
			while i < exp_value {
				if exp_negative {
					float_acc = float_acc / 10.0;
				} else {
					float_acc = float_acc * 10.0;
				}
				i = i + 1;
			}
		}
		if negative { float_acc = 0.0 - float_acc; }
		return JsonCursor::FloatVal(value = float_acc);
	}
	if negative { int_acc = -int_acc; }
	return JsonCursor::IntVal(value = int_acc);
}

/// Look up `key` inside the canonical params JSON object `text`.
/// Returns a `JsonCursor` on success or `JsonCursor::Missing()` if
/// the key is absent or the input is malformed.
fn _params_cursor_get(text: &String, key: &String) nothrow -> JsonCursor {
	val n = text.byte_length();
	var pos = _json_skip_ws(text, 0);
	if pos >= n { return JsonCursor::Missing(); }
	if string_byte_at(text, pos) != cast<Byte>(123) {
		return JsonCursor::Missing();
	}
	pos = pos + 1;
	pos = _json_skip_ws(text, pos);
	while pos < n {
		val b = string_byte_at(text, pos);
		if b == cast<Byte>(125) {
			return JsonCursor::Missing();
		}
		if b != cast<Byte>(34) {
			return JsonCursor::Missing();
		}
		val parsed = _json_parse_string_at(text, pos);
		if parsed.next_pos < 0 { return JsonCursor::Missing(); }
		val k = parsed.value;
		pos = parsed.next_pos;
		pos = _json_skip_ws(text, pos);
		if pos >= n {
			return JsonCursor::Missing();
		}
		if string_byte_at(text, pos) != cast<Byte>(58) {
			return JsonCursor::Missing();
		}
		pos = pos + 1;
		pos = _json_skip_ws(text, pos);
		if k == *key {
			return _json_parse_value_at(text, pos);
		}
		pos = _json_skip_value(text, pos);
		if pos < 0 { return JsonCursor::Missing(); }
		pos = _json_skip_ws(text, pos);
		if pos >= n { return JsonCursor::Missing(); }
		val sep = string_byte_at(text, pos);
		if sep == cast<Byte>(44) {
			pos = pos + 1;
			pos = _json_skip_ws(text, pos);
			continue;
		}
		if sep == cast<Byte>(125) {
			return JsonCursor::Missing();
		}
		return JsonCursor::Missing();
	}
	return JsonCursor::Missing();
}

// ── Compiler-owned typed scalar projection from Error envelope params ──
//
// Slice 5 (slice 3 of impl): emitted by HIR→MIR for typed catch
// binder field access (`e.<declared_field>`).  Each helper takes
// the envelope's params_json text + a field name and returns the
// typed scalar value with deterministic missing-key / wrong-type
// behavior:
//
//   * key absent or value is JSON null   → return type's default
//     (0 / 0u / 0.0 / "" / false)
//   * value present with mismatched type → return type's default
//   * malformed JSON                     → return type's default
//
// Reuses the inline JSON parser (`_params_cursor_get` +
// `JsonCursor` arms) but the helpers themselves are compiler-
// owned: their default-on-missing/mismatch behavior is fixed by
// spec, not by user-visible Optional.unwrap_or / cursor ergonomics.
// Public callers MUST NOT depend on these helpers — they are
// emitted by the compiler at typed-catch field-access sites.

fn _typed_params_field_int(text: &String, key: &String) nothrow -> Int {
	val cursor = _params_cursor_get(text, key);
	match cursor {
		JsonCursor::IntVal(n) => { return n; },
		default => { return 0; },
	}
}

fn _typed_params_field_uint(text: &String, key: &String) nothrow -> Uint {
	val cursor = _params_cursor_get(text, key);
	match cursor {
		JsonCursor::IntVal(n) => {
			if n < 0 { return 0u; }
			return cast<Uint>(n);
		},
		default => { return 0u; },
	}
}

fn _typed_params_field_string(text: &String, key: &String) nothrow -> String {
	val cursor = _params_cursor_get(text, key);
	match cursor {
		JsonCursor::StringVal(s) => { return s; },
		default => { return ""; },
	}
}

fn _typed_params_field_bool(text: &String, key: &String) nothrow -> Bool {
	val cursor = _params_cursor_get(text, key);
	match cursor {
		JsonCursor::BoolVal(b) => { return b; },
		default => { return false; },
	}
}

fn _typed_params_field_float(text: &String, key: &String) nothrow -> Float {
	val cursor = _params_cursor_get(text, key);
	match cursor {
		JsonCursor::FloatVal(f) => { return f; },
		default => { return 0.0; },
	}
}


// Slice 7b (0.31.63, 2026-05-06): `_dv_to_json_text` deleted — the
// last caller (the captured-locals JSON frame builder in
// hir_to_mir.py's `_emit_captured_locals`) was migrated to direct
// per-scalar-type dispatch via `core.diagnostic_json_*` helpers.  The
// throw-side params projection had already been routed through the
// unified `core.Diagnostic for E` lowering in Slice 6/7b, so no
// production lowering path needs the recursive DV→JSON projector
// anymore.

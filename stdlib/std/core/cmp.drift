module std.core.cmp;

export {
	Equatable,
	Comparable
};

/// Trait for types that support equality comparison.
///
/// Default impls: `Int`, `Uint`, `Uint64`, `Bool`, `Byte`, `String`.
///
/// **See also:** `Comparable`.
pub trait Equatable {
	fn eq(self: &Self, other: &Self) nothrow -> Bool;
}

/// Trait for types that support three-way ordering comparison.
///
/// `cmp(self, other)` returns negative if `self < other`, zero if
/// equal, positive if `self > other`.  Required to also implement
/// `Equatable`.  Default impls: `Int`, `Uint`.
///
/// **See also:** `Equatable`, `algo.binary_search`,
/// `containers.TreeMap`.
pub trait Comparable require Self is Equatable {
	fn cmp(self: &Self, other: &Self) nothrow -> Int;
}

implement Equatable for Int {
	pub fn eq(self: &Int, other: &Int) nothrow -> Bool {
		return *self == *other;
	}
}

implement Comparable for Int {
	pub fn cmp(self: &Int, other: &Int) nothrow -> Int {
		val a = *self;
		val b = *other;
		if a < b {
			return -1;
		}
		if a > b {
			return 1;
		}
		return 0;
	}
}

implement Equatable for Uint {
	pub fn eq(self: &Uint, other: &Uint) nothrow -> Bool {
		return *self == *other;
	}
}

implement Comparable for Uint {
	pub fn cmp(self: &Uint, other: &Uint) nothrow -> Int {
		val a = *self;
		val b = *other;
		if a < b {
			return -1;
		}
		if a > b {
			return 1;
		}
		return 0;
	}
}

implement Equatable for Uint64 {
	pub fn eq(self: &Uint64, other: &Uint64) nothrow -> Bool {
		return *self == *other;
	}
}

implement Equatable for Bool {
	pub fn eq(self: &Bool, other: &Bool) nothrow -> Bool {
		return *self == *other;
	}
}

implement Equatable for Byte {
	pub fn eq(self: &Byte, other: &Byte) nothrow -> Bool {
		return *self == *other;
	}
}

implement Equatable for String {
	pub fn eq(self: &String, other: &String) nothrow -> Bool {
		return string_eq(*self, *other);
	}
}

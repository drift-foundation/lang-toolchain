pub error JsonError {
	tag: String,
	offset: Int,
	line: Int,
	col: Int,
	path: String,
	key: String,
}

/// Structured exception thrown by `StrictJsonCursor` traversal failures.
///
/// All fields carry stable, machine-readable values.  No English prose.
/// `reason` is restricted to the following stable token set:
///
/// - `"missing-segment"` — the parent object did not contain `segment`.
/// - `"not-object"` — the parent at this position is not a JSON object
///   (could be array, scalar, or null) and cannot be traversed.
/// - `"type-mismatch-string"` — terminal `.string()` called on a node
///   that is not a JSON String.
/// - `"type-mismatch-int"` — terminal `.int()` called on a node that
///   is not an integer-shaped JSON Number.
/// - `"type-mismatch-bool"` — terminal `.bool()` called on a node that
///   is not a JSON Bool.
/// - `"type-mismatch-float"` — terminal `.float()` called on a node
///   that is not a float-shaped JSON Number.
///
/// `path` is the dotted path to the parent of the failing position.
/// `segment` is the failing key (empty for terminal type-mismatch
/// failures since the failure is at the current node, not a child).
/// `index` is the zero-based depth at which the failure occurred.
pub error JsonPathError {
	path: String,
	segment: String,
	index: Int,
	reason: String,
}

/// `pub error`: compiler synthesizes `core.Throw` / `core.Diagnostic`
/// so `or_throw()` and auto-try unwrap it directly.
pub error JsonErrorData {
	tag: String,
	offset: Int,
	line: Int,
	col: Int,
	path: String,
	key: String,
}

pub variant JsonNode {
	Null,
	Bool(value: Bool),
	Number(raw: String),
	String(value: String),
	Array(values: Array<JsonNode>),
	Object(fields: containers.HashMap<String, std.json.JsonNode>),
	@tombstone Tombstone
}

pub struct JsonArray {
	values: Array<JsonNode>
}

pub struct JsonObject {
	fields: containers.HashMap<String, std.json.JsonNode>
}

pub variant JsonKeyOrder {
	Unordered,
	OrderedLexUtf8
}

pub struct JsonConfig {
	pub key_order: JsonKeyOrder
}

pub struct JsonConfigBuilder {
	key_order: JsonKeyOrder
}

pub variant JsonEntriesIter {
	Empty,
	Object(it: containers.HashMapIter<String, JsonNode, hash.DefaultBuildHasher>)
}

implement core.Copy for JsonKeyOrder {
}

implement core.Copy for JsonConfig {
}

pub fn config_builder() nothrow -> JsonConfigBuilder {
	return JsonConfigBuilder(key_order = JsonKeyOrder::Unordered());
}

pub fn new_array() nothrow -> JsonArray {
	var values: Array<JsonNode> = [];
	return JsonArray(move values);
}

pub fn new_object() nothrow -> JsonObject {
	var fields = containers.hash_map<type String, std.json.JsonNode>();
	return JsonObject(move fields);
}

implement JsonConfigBuilder {
	pub fn key_order(self: &mut JsonConfigBuilder, var v: JsonKeyOrder) nothrow -> &mut JsonConfigBuilder {
		self.key_order = move v;
		return self;
	}

	pub fn build(self: &JsonConfigBuilder) nothrow -> JsonConfig {
		return JsonConfig(key_order = self.key_order);
	}
}

// ── Parser policy (Slice 2) ─────────────────────────────────────────
//
// Orthogonal policies that select standard JSON or a stricter subset (never a
// superset, never a value reinterpretation — sole exception: duplicate-key
// resolution).  Distinct from `JsonConfig` (encode).  See
// `doc/design/drift-stdlib-spec.md` and the stable error-code contract.

/// How `parse_with_config` resolves a repeated object key.  The single explicit
/// interpretation policy: `KeepFirst`/`KeepLast` accept the same input but yield
/// different nodes by definition.
pub variant DuplicateKeyPolicy {
	Reject,
	KeepFirst,
	KeepLast
}

/// What the document's root value may be.
pub variant TopLevelPolicy {
	AnyValue,
	ObjectOrArray,
	ObjectOnly
}

/// Independent numeric subset toggles (each turns a *valid-JSON* number shape off
/// — never extends JSON).  There is no public leading-zeros toggle: leading zeros
/// are invalid JSON and rejected by every public config.
pub struct JsonNumberPolicy {
	pub allow_fractions: Bool,
	pub allow_exponents: Bool,
	pub allow_negative_zero: Bool
}

/// Optional resource limits.  `None` = unlimited.  A negative `Some(n)` is an
/// invalid config (rejected with `"invalid-config"` before parsing), not silently
/// treated as unlimited.
pub struct JsonLimits {
	pub max_document_bytes: Optional<Int>,
	pub max_depth: Optional<Int>,
	pub max_string_bytes: Optional<Int>,
	pub max_number_bytes: Optional<Int>,
	pub max_array_items: Optional<Int>,
	pub max_object_fields: Optional<Int>
}

/// The orthogonal parser-policy bundle.  A profile is just a preset of these
/// fields; every combination is valid.
pub struct JsonParseConfig {
	pub duplicate_keys: DuplicateKeyPolicy,
	pub top_level: TopLevelPolicy,
	pub numbers: JsonNumberPolicy,
	pub limits: JsonLimits
}

implement core.Copy for DuplicateKeyPolicy {
}

implement core.Copy for TopLevelPolicy {
}

implement core.Copy for JsonNumberPolicy {
}

implement core.Copy for JsonLimits {
}

implement core.Copy for JsonParseConfig {
}

fn _no_limits() nothrow -> JsonLimits {
	return JsonLimits(
		max_document_bytes = Optional<Int>::None(),
		max_depth = Optional<Int>::None(),
		max_string_bytes = Optional<Int>::None(),
		max_number_bytes = Optional<Int>::None(),
		max_array_items = Optional<Int>::None(),
		max_object_fields = Optional<Int>::None()
	);
}

/// Most lenient *standard* JSON: keep-last duplicate keys, any root, all RFC-valid
/// number forms (incl. `-0`), no limits.  Rejects leading zeros (invalid JSON).
pub fn permissive() nothrow -> JsonParseConfig {
	return JsonParseConfig(
		duplicate_keys = DuplicateKeyPolicy::KeepLast(),
		top_level = TopLevelPolicy::AnyValue(),
		numbers = JsonNumberPolicy(allow_fractions = true, allow_exponents = true, allow_negative_zero = true),
		limits = _no_limits()
	);
}

/// Standard JSON, but reject duplicate keys (`-0` still allowed; RFC-valid).
pub fn strict() nothrow -> JsonParseConfig {
	return JsonParseConfig(
		duplicate_keys = DuplicateKeyPolicy::Reject(),
		top_level = TopLevelPolicy::AnyValue(),
		numbers = JsonNumberPolicy(allow_fractions = true, allow_exponents = true, allow_negative_zero = true),
		limits = _no_limits()
	);
}

/// Deterministic integer profile: integers only (`0 | -?[1-9][0-9]*` — no
/// fractions/exponents/`-0`/leading zeros), reject duplicate keys.  No bundled
/// limits or top-level restriction (those are orthogonal deployment policies).
pub fn signed_ir() nothrow -> JsonParseConfig {
	return JsonParseConfig(
		duplicate_keys = DuplicateKeyPolicy::Reject(),
		top_level = TopLevelPolicy::AnyValue(),
		numbers = JsonNumberPolicy(allow_fractions = false, allow_exponents = false, allow_negative_zero = false),
		limits = _no_limits()
	);
}

pub struct JsonParseConfigBuilder {
	cfg: JsonParseConfig
}

/// A builder seeded from `permissive()`.  Override fields, then `build()`.
pub fn parse_config_builder() nothrow -> JsonParseConfigBuilder {
	return JsonParseConfigBuilder(cfg = permissive());
}

/// A builder seeded from an explicit profile.
pub fn parse_config_builder_from(base: JsonParseConfig) nothrow -> JsonParseConfigBuilder {
	return JsonParseConfigBuilder(cfg = base);
}

implement JsonParseConfigBuilder {
	pub fn duplicate_keys(self: &mut JsonParseConfigBuilder, var v: DuplicateKeyPolicy) nothrow -> &mut JsonParseConfigBuilder {
		self.cfg.duplicate_keys = move v;
		return self;
	}

	pub fn top_level(self: &mut JsonParseConfigBuilder, var v: TopLevelPolicy) nothrow -> &mut JsonParseConfigBuilder {
		self.cfg.top_level = move v;
		return self;
	}

	pub fn numbers(self: &mut JsonParseConfigBuilder, var v: JsonNumberPolicy) nothrow -> &mut JsonParseConfigBuilder {
		self.cfg.numbers = move v;
		return self;
	}

	pub fn limits(self: &mut JsonParseConfigBuilder, var v: JsonLimits) nothrow -> &mut JsonParseConfigBuilder {
		self.cfg.limits = move v;
		return self;
	}

	/// Validate and produce the config.  Returns `Err("invalid-config")` (with the
	/// offending limit name in `key`) for a negative limit; `Ok(cfg)` otherwise.
	pub fn build(self: &JsonParseConfigBuilder) nothrow -> core.Result<JsonParseConfig, JsonErrorData> {
		match _validate_limits(&self.cfg.limits) {
			Optional::Some(e) => { return core.Result::Err(move e); },
			Optional::None() => { return core.Result::Ok(self.cfg); }
		}
	}
}

/// Returns `Some(invalid-config error)` if any limit is `Some(n < 0)`, else
/// `None`.  Used by `build()` and the parse entry points so a struct-literal
/// config is validated too.
fn _validate_limits(lim: &JsonLimits) nothrow -> Optional<JsonErrorData> {
	match _neg_limit(&lim.max_document_bytes) { Some(_) => { return Optional::Some(_err_invalid_config("max-document-bytes")); }, None => { } }
	match _neg_limit(&lim.max_depth) { Some(_) => { return Optional::Some(_err_invalid_config("max-depth")); }, None => { } }
	match _neg_limit(&lim.max_string_bytes) { Some(_) => { return Optional::Some(_err_invalid_config("max-string-bytes")); }, None => { } }
	match _neg_limit(&lim.max_number_bytes) { Some(_) => { return Optional::Some(_err_invalid_config("max-number-bytes")); }, None => { } }
	match _neg_limit(&lim.max_array_items) { Some(_) => { return Optional::Some(_err_invalid_config("max-array-items")); }, None => { } }
	match _neg_limit(&lim.max_object_fields) { Some(_) => { return Optional::Some(_err_invalid_config("max-object-fields")); }, None => { } }
	return Optional<JsonErrorData>::None();
}

fn _neg_limit(v: &Optional<Int>) nothrow -> Optional<Int> {
	match *v {
		Some(n) => { if n < 0 { return Optional::Some(n); } return Optional<Int>::None(); },
		None => { return Optional<Int>::None(); }
	}
}

fn _err_invalid_config(which: String) nothrow -> JsonErrorData {
	return JsonErrorData(tag = "invalid-config", offset = -1, line = -1, col = -1, path = "", key = which);
}

fn _err_data(tag: String, path: String, key: String) nothrow -> JsonErrorData {
	return JsonErrorData(tag = tag, offset = -1, line = -1, col = -1, path = path, key = key);
}

fn _throw_json(tag: String, path: String, key: String) -> Void {
	throw JsonError(tag = tag, offset = -1, line = -1, col = -1, path = path, key = key);
}

pub fn encode(node: &JsonNode) nothrow -> String {
	return _encode_node(node, &JsonConfig(key_order = JsonKeyOrder::Unordered()));
}

pub fn encode_with_config(node: &JsonNode, cfg: &JsonConfig) nothrow -> String {
	return _encode_node(node, cfg);
}

pub fn encode_compact(node: &JsonNode) nothrow -> String {
	return _encode_node(node, &JsonConfig(key_order = JsonKeyOrder::Unordered()));
}

pub fn encode_compact_with_config(node: &JsonNode, cfg: &JsonConfig) nothrow -> String {
	return _encode_node(node, cfg);
}

/// Parses `text` as a single JSON value (legacy/permissive behavior, preserved
/// exactly).  Equivalent to the unified parser under the private legacy profile —
/// keep-last duplicate keys, any root, lenient numbers INCLUDING leading zeros.
pub fn parse(text: &String) nothrow -> core.Result<JsonNode, JsonErrorData> {
	val ctx = _ParseCtx(cfg = permissive(), legacy = true, locate = false);
	var sp: Optional<_SpanTree> = Optional::None();
	return _parse_document(text, &ctx, &mut sp);
}

/// Parses `text` under an explicit parser policy (§ std.json parser policy).
/// Validates `cfg` first (negative limit ⇒ `Err("invalid-config")`).
pub fn parse_with_config(text: &String, cfg: &JsonParseConfig) nothrow -> core.Result<JsonNode, JsonErrorData> {
	match _validate_limits(&cfg.limits) {
		Optional::Some(e) => { return core.Result::Err(move e); },
		Optional::None() => { }
	}
	val ctx = _ParseCtx(cfg = *cfg, legacy = false, locate = false);
	var sp: Optional<_SpanTree> = Optional::None();
	return _parse_document(text, &ctx, &mut sp);
}

/// `parse_with_config(text, strict())` — standard JSON, reject duplicate keys.
pub fn parse_strict(text: &String) nothrow -> core.Result<JsonNode, JsonErrorData> {
	val s = strict();
	return parse_with_config(text, &s);
}

/// Parses `text` under `cfg` AND retains a source-span sidecar, yielding a
/// `JsonDoc` whose `cursor()` drives the location-aware object-contract helpers
/// (require / forbid_unknown / discriminant / typed getters).  Same policy
/// outcome as `parse_with_config` (the sidecar never changes parsing).
pub fn parse_located(text: &String, cfg: &JsonParseConfig) nothrow -> core.Result<JsonDoc, JsonErrorData> {
	match _validate_limits(&cfg.limits) {
		Optional::Some(e) => { return core.Result::Err(move e); },
		Optional::None() => { }
	}
	val ctx = _ParseCtx(cfg = *cfg, legacy = false, locate = true);
	var sp: Optional<_SpanTree> = Optional::None();
	match _parse_document(text, &ctx, &mut sp) {
		core.Result::Err(e) => { return core.Result::Err(move e); },
		core.Result::Ok(node) => {
			match sp {
				Some(tree) => { return core.Result::Ok(JsonDoc(root = move node, spans = move tree, text = *text)); },
				None => { return core.Result::Err(_err_parse(text, "internal-error", 0)); }
			}
		}
	}
}

fn _parse_document(text: &String, ctx: &_ParseCtx, root_sp: &mut Optional<_SpanTree>) nothrow -> core.Result<JsonNode, JsonErrorData> {
	if _over_limit(&ctx.cfg.limits.max_document_bytes, text.byte_length()) {
		return core.Result::Err(_err_parse(text, "limit-document-bytes", 0));
	}
	var idx = 0;
	_skip_ws(text, &mut idx);
	val root_start = idx;
	match _parse_value(text, &mut idx, ctx, 1, root_sp) {
		core.Result::Err(e) => { return core.Result::Err(move e); },
		core.Result::Ok(v) => {
			_skip_ws(text, &mut idx);
			if idx != text.byte_length() {
				return core.Result::Err(_err_parse(text, "invalid-syntax", idx));
			}
			match _check_top_level(&v, ctx, root_start, text) {
				Optional::Some(e) => { return core.Result::Err(move e); },
				Optional::None() => { }
			}
			return core.Result::Ok(move v);
		}
	}
}

fn _check_top_level(node: &JsonNode, ctx: &_ParseCtx, root_start: Int, text: &String) nothrow -> Optional<JsonErrorData> {
	match ctx.cfg.top_level {
		TopLevelPolicy::AnyValue() => { return Optional<JsonErrorData>::None(); },
		TopLevelPolicy::ObjectOrArray() => {
			val ok = match node {
				JsonNode::Object(_) => { true },
				JsonNode::Array(_) => { true },
				default => { false }
			};
			if ok { return Optional<JsonErrorData>::None(); }
			return Optional::Some(_err_parse(text, "top-level-not-object-or-array", root_start));
		},
		TopLevelPolicy::ObjectOnly() => {
			val ok = match node {
				JsonNode::Object(_) => { true },
				default => { false }
			};
			if ok { return Optional<JsonErrorData>::None(); }
			return Optional::Some(_err_parse(text, "top-level-not-object", root_start));
		}
	}
}

// ── Slice-2 located decoder surface: cursor + helpers ───────────────

fn _span_of(tree: &_SpanTree) nothrow -> JsonByteSpan {
	match tree {
		_SpanTree::Leaf(s) => { return *s; },
		_SpanTree::Arr(s, _items) => { return *s; },
		_SpanTree::Obj(s, _occ, _vals) => { return *s; },
		default => { return JsonByteSpan(start = -1, end = -1); }
	}
}

fn _located_err(text: &String, tag: String, span: JsonByteSpan, pointer: String, key: String) nothrow -> JsonErrorData {
	var line = -1;
	var col = -1;
	_err_parse_line_col(text, span.start, &mut line, &mut col);
	return JsonErrorData(tag = tag, offset = span.start, line = line, col = col, path = pointer, key = key);
}

fn _invalid_pointer(ptr: &String) nothrow -> JsonErrorData {
	return JsonErrorData(tag = "invalid-pointer", offset = -1, line = -1, col = -1, path = ptr.clone(), key = "");
}

fn _digit_char(d: Int) nothrow -> String {
	return _byte_to_string(cast<Byte>(48 + d));
}

fn _int_to_string(v: Int) nothrow -> String {
	if v == 0 { return "0"; }
	val neg = v < 0;
	// Accumulate digits from the NON-positive side so `Int::MIN` (which has no
	// positive negation) is handled without overflow.  `% 10` truncates toward
	// zero, so for n <= 0 the remainder is <= 0 and `-(n % 10)` is the digit.
	var n = v;
	if n > 0 {
		n = 0 - n;
	}
	var digits = "";
	while n < 0 {
		val d = 0 - (n % 10);
		digits = _digit_char(d) + digits;
		n = n / 10;
	}
	if neg {
		return "-" + digits;
	}
	return digits;
}

fn _jp_escape(key: &String) nothrow -> String {
	val n = key.byte_length();
	var out = "";
	var i = 0;
	while i < n {
		val b = core.string_byte_at(key, i);
		if b == cast<Byte>(126) {
			out = out + "~0";
		} else {
			if b == cast<Byte>(47) {
				out = out + "~1";
			} else {
				out = out + _byte_to_string(b);
			}
		}
		i = i + 1;
	}
	return out;
}

/// Un-escapes one RFC-6901 reference token: `~1` → `/`, `~0` → `~`.  Returns
/// `None` if a `~` is not followed by `0`/`1` (including a trailing `~`) — a
/// malformed pointer.
fn _jp_unescape(s: &String) nothrow -> Optional<String> {
	val n = s.byte_length();
	var out = "";
	var i = 0;
	while i < n {
		val b = core.string_byte_at(s, i);
		if b == cast<Byte>(126) {
			if i + 1 >= n {
				return Optional<String>::None();
			}
			val nb = core.string_byte_at(s, i + 1);
			if nb == cast<Byte>(49) {
				out = out + "/";
				i = i + 2;
				continue;
			}
			if nb == cast<Byte>(48) {
				out = out + "~";
				i = i + 2;
				continue;
			}
			return Optional<String>::None();
		}
		out = out + _byte_to_string(b);
		i = i + 1;
	}
	return Optional::Some(out);
}

fn _jp_append(base: &String, key: &String) nothrow -> String {
	return *base + "/" + _jp_escape(key);
}

fn _jp_append_index(base: &String, i: Int) nothrow -> String {
	return *base + "/" + _int_to_string(i);
}

fn _str_in_array(s: &String, arr: &Array<String>) nothrow -> Bool {
	var i = 0;
	while i < arr.len {
		if *s == arr[i] { return true; }
		i = i + 1;
	}
	return false;
}

/// Validate `s` against the RFC-6901 array-index grammar `0 | [1-9][0-9]*` and
/// parse it.  `None` on bad grammar (leading zero, sign, `-`, non-numeric) or
/// `Int` overflow.
fn _parse_array_index(s: &String) nothrow -> Optional<Int> {
	val n = s.byte_length();
	if n == 0 {
		return Optional<Int>::None();
	}
	if n == 1 and core.string_byte_at(s, 0) == cast<Byte>(48) {
		return Optional::Some(0);
	}
	val first = core.string_byte_at(s, 0);
	if first < cast<Byte>(49) or first > cast<Byte>(57) {
		return Optional<Int>::None();
	}
	var i = 1;
	while i < n {
		if not _is_digit(core.string_byte_at(s, i)) {
			return Optional<Int>::None();
		}
		i = i + 1;
	}
	match parse_std.parse_int(*s) {
		core.Result::Ok(v) => { return Optional::Some(v); },
		default => { return Optional<Int>::None(); }
	}
}

/// A located position over a `JsonDoc` (borrows the node + parallel span node +
/// retained text), plus the JSON Pointer to here.
pub struct LocatedCursor {
	node: &JsonNode,
	span: &_SpanTree,
	text: &String,
	pointer: String
}

implement JsonDoc {
	pub fn root(self: &JsonDoc) nothrow -> &JsonNode {
		return &self.root;
	}

	pub fn cursor(self: &JsonDoc) nothrow -> LocatedCursor {
		return LocatedCursor(node = &self.root, span = &self.spans, text = &self.text, pointer = "");
	}

	/// A zero-copy view of an EXPLICIT NUMERIC byte range of the
	/// document's retained text.  This is a plain byte-range
	/// operation: it neither takes nor implies span provenance
	/// (`JsonByteSpan` carries no source identity, so a span-taking
	/// form could silently interpret a span from another document —
	/// use `LocatedCursor.raw_view()` for provenance-safe access).
	/// Delegates verbatim to `txt.byte_view(&self.text, start, len)`
	/// — same `TextError`, same bounds, `offset = start` on failure.
	pub fn byte_range_view(self: &JsonDoc, start: Int, len: Int) nothrow -> core.Result<txt.StringByteView, txt.TextError> {
		return txt.byte_view(&self.text, start, len);
	}

	/// Resolve an ABSOLUTE JSON Pointer (RFC 6901) from the document root.
	pub fn at_pointer(self: &JsonDoc, ptr: &String) nothrow -> core.Result<LocatedCursor, JsonErrorData> {
		val n = ptr.byte_length();
		if n == 0 {
			return core.Result::Ok(self.cursor());
		}
		if core.string_byte_at(ptr, 0) != cast<Byte>(47) {
			return core.Result::Err(_invalid_pointer(ptr));
		}
		var cur = self.cursor();
		var i = 1;
		while i <= n {
			var raw_seg = "";
			while i < n and core.string_byte_at(ptr, i) != cast<Byte>(47) {
				raw_seg = raw_seg + _byte_to_string(core.string_byte_at(ptr, i));
				i = i + 1;
			}
			match _jp_unescape(&raw_seg) {
				Optional::None() => { return core.Result::Err(_invalid_pointer(ptr)); },
				Optional::Some(seg) => {
					match _navigate_segment(&cur, &seg, &raw_seg) {
						core.Result::Err(e) => { return core.Result::Err(move e); },
						core.Result::Ok(next) => { cur = move next; }
					}
				}
			}
			i = i + 1;
		}
		return core.Result::Ok(move cur);
	}
}

fn _navigate_segment(cur: &LocatedCursor, seg: &String, raw_seg: &String) nothrow -> core.Result<LocatedCursor, JsonErrorData> {
	match cur.node {
		JsonNode::Array(_vals) => {
			match _parse_array_index(raw_seg) {
				Optional::Some(ix) => { return cur.index(ix); },
				Optional::None() => {
					return core.Result::Err(_located_err(cur.text, "invalid-array-index", _span_of(cur.span), cur.pointer.clone(), raw_seg.clone()));
				}
			}
		},
		default => {
			return cur.child(seg);
		}
	}
}

implement LocatedCursor {
	pub fn span(self: &LocatedCursor) nothrow -> JsonByteSpan {
		return _span_of(self.span);
	}

	/// A zero-copy `txt.StringByteView` of the raw document bytes
	/// this cursor's node was parsed from (provenance-safe: the span
	/// was produced by the parser over THIS document's retained text,
	/// so it is in-bounds by construction).  One retain, no copies;
	/// materialize with `to_string()` only when the slice must escape.
	///
	/// The API is infallible; if the parser-span invariant is ever
	/// violated (corruption), this FAILS CLOSED with a contract abort
	/// — it never substitutes content.
	pub fn raw_view(self: &LocatedCursor) nothrow -> txt.StringByteView {
		val sp = _span_of(self.span);
		return _span_view_or_abort(self.text, sp.start, sp.end);
	}

	pub fn pointer(self: &LocatedCursor) nothrow -> String {
		return self.pointer.clone();
	}

	pub fn child(self: &LocatedCursor, key: &String) nothrow -> core.Result<LocatedCursor, JsonErrorData> {
		match self.node {
			JsonNode::Object(fields) => {
				match self.span {
					_SpanTree::Obj(_osp, _occ, vspans) => {
						match fields.get(key) {
							Some(child_node) => {
								match vspans.get(key) {
									Some(child_span) => {
										return core.Result::Ok(LocatedCursor(node = child_node, span = child_span, text = self.text, pointer = _jp_append(&self.pointer, key)));
									},
									None => {
										return core.Result::Err(_err_data("internal-error", self.pointer.clone(), ""));
									}
								}
							},
							None => {
								return core.Result::Err(_located_err(self.text, "missing-field", _span_of(self.span), self.pointer.clone(), key.clone()));
							}
						}
					},
					default => {
						return core.Result::Err(_located_err(self.text, "type-mismatch-object", _span_of(self.span), self.pointer.clone(), ""));
					}
				}
			},
			default => {
				return core.Result::Err(_located_err(self.text, "type-mismatch-object", _span_of(self.span), self.pointer.clone(), ""));
			}
		}
	}

	pub fn require_field(self: &LocatedCursor, key: &String) nothrow -> core.Result<LocatedCursor, JsonErrorData> {
		return self.child(key);
	}

	pub fn index(self: &LocatedCursor, ix: Int) nothrow -> core.Result<LocatedCursor, JsonErrorData> {
		match self.node {
			JsonNode::Array(values) => {
				match self.span {
					_SpanTree::Arr(_asp, items) => {
						if ix < 0 or ix >= values.len {
							return core.Result::Err(_located_err(self.text, "index-out-of-range", _span_of(self.span), self.pointer.clone(), _int_to_string(ix)));
						}
						return core.Result::Ok(LocatedCursor(node = &values[ix], span = &items[ix], text = self.text, pointer = _jp_append_index(&self.pointer, ix)));
					},
					default => {
						return core.Result::Err(_located_err(self.text, "type-mismatch-array", _span_of(self.span), self.pointer.clone(), ""));
					}
				}
			},
			default => {
				return core.Result::Err(_located_err(self.text, "type-mismatch-array", _span_of(self.span), self.pointer.clone(), ""));
			}
		}
	}

	pub fn as_string(self: &LocatedCursor) nothrow -> core.Result<String, JsonErrorData> {
		match self.node {
			JsonNode::String(v) => { return core.Result::Ok(v.clone()); },
			default => { return core.Result::Err(_located_err(self.text, "type-mismatch-string", _span_of(self.span), self.pointer.clone(), "")); }
		}
	}

	pub fn as_bool(self: &LocatedCursor) nothrow -> core.Result<Bool, JsonErrorData> {
		match self.node {
			JsonNode::Bool(b) => { return core.Result::Ok(*b); },
			default => { return core.Result::Err(_located_err(self.text, "type-mismatch-bool", _span_of(self.span), self.pointer.clone(), "")); }
		}
	}

	pub fn as_int(self: &LocatedCursor) nothrow -> core.Result<Int, JsonErrorData> {
		match self.node.as_int() {
			Some(v) => { return core.Result::Ok(v); },
			None => { return core.Result::Err(_located_err(self.text, "type-mismatch-int", _span_of(self.span), self.pointer.clone(), "")); }
		}
	}

	pub fn as_uint(self: &LocatedCursor) nothrow -> core.Result<Uint, JsonErrorData> {
		match self.node.as_uint() {
			Some(v) => { return core.Result::Ok(v); },
			None => { return core.Result::Err(_located_err(self.text, "type-mismatch-uint", _span_of(self.span), self.pointer.clone(), "")); }
		}
	}

	pub fn as_float(self: &LocatedCursor) nothrow -> core.Result<Float, JsonErrorData> {
		match self.node.as_float() {
			Some(v) => { return core.Result::Ok(v); },
			None => { return core.Result::Err(_located_err(self.text, "type-mismatch-float", _span_of(self.span), self.pointer.clone(), "")); }
		}
	}

	pub fn as_array_len(self: &LocatedCursor) nothrow -> core.Result<Int, JsonErrorData> {
		match self.node {
			JsonNode::Array(values) => { return core.Result::Ok(values.len); },
			default => { return core.Result::Err(_located_err(self.text, "type-mismatch-array", _span_of(self.span), self.pointer.clone(), "")); }
		}
	}

	pub fn as_object(self: &LocatedCursor) nothrow -> core.Result<LocatedCursor, JsonErrorData> {
		match self.node {
			JsonNode::Object(_f) => { return core.Result::Ok(LocatedCursor(node = self.node, span = self.span, text = self.text, pointer = self.pointer.clone())); },
			default => { return core.Result::Err(_located_err(self.text, "type-mismatch-object", _span_of(self.span), self.pointer.clone(), "")); }
		}
	}

	pub fn optional(self: &LocatedCursor, key: &String) nothrow -> core.Result<Optional<LocatedCursor>, JsonErrorData> {
		match self.node {
			JsonNode::Object(fields) => {
				match self.span {
					_SpanTree::Obj(_osp, _occ, vspans) => {
						match fields.get(key) {
							Some(child_node) => {
								match vspans.get(key) {
									Some(child_span) => {
										return core.Result::Ok(Optional::Some(LocatedCursor(node = child_node, span = child_span, text = self.text, pointer = _jp_append(&self.pointer, key))));
									},
									None => {
										return core.Result::Err(_err_data("internal-error", self.pointer.clone(), ""));
									}
								}
							},
							None => {
								return core.Result::Ok(Optional<LocatedCursor>::None());
							}
						}
					},
					default => {
						return core.Result::Err(_located_err(self.text, "type-mismatch-object", _span_of(self.span), self.pointer.clone(), ""));
					}
				}
			},
			default => {
				return core.Result::Err(_located_err(self.text, "type-mismatch-object", _span_of(self.span), self.pointer.clone(), ""));
			}
		}
	}

	pub fn forbid_unknown(self: &LocatedCursor, allowed: &Array<String>) nothrow -> core.Result<Void, JsonErrorData> {
		match self.span {
			_SpanTree::Obj(_osp, occurrences, _vals) => {
				var i = 0;
				while i < occurrences.len {
					val occ = &occurrences[i];
					if not _str_in_array(&occ.key, allowed) {
						return core.Result::Err(_located_err(self.text, "unknown-field", occ.key_span, _jp_append(&self.pointer, &occ.key), occ.key.clone()));
					}
					i = i + 1;
				}
				return core.Result::Ok(core.void_value());
			},
			default => {
				return core.Result::Err(_located_err(self.text, "type-mismatch-object", _span_of(self.span), self.pointer.clone(), ""));
			}
		}
	}

	pub fn discriminant(self: &LocatedCursor, key: &String) nothrow -> core.Result<String, JsonErrorData> {
		match self.require_field(key) {
			core.Result::Err(e) => { return core.Result::Err(move e); },
			core.Result::Ok(c) => { return c.as_string(); }
		}
	}
}

implement JsonNode {
	pub fn is_null(self: &JsonNode) nothrow -> Bool {
		return match self {
			Null => { true },
			default => { false }
		};
	}

	pub fn as_bool(self: &JsonNode) nothrow -> Optional<Bool> {
		return match self {
			Bool(v) => { Optional::Some(*v) },
			default => { Optional<Bool>::None() }
		};
	}

	pub fn as_int(self: &JsonNode) nothrow -> Optional<Int> {
		return match self {
			Number(raw) => {
				match parse_std.parse_int(*raw) {
					core.Result::Ok(v) => { Optional::Some(v) },
					default => { Optional<Int>::None() }
				}
			},
			default => { Optional<Int>::None() }
		};
	}

	pub fn as_uint(self: &JsonNode) nothrow -> Optional<Uint> {
		return match self {
			Number(raw) => {
				match parse_std.parse_uint(*raw) {
					core.Result::Ok(v) => { Optional::Some(v) },
					default => { Optional<Uint>::None() }
				}
			},
			default => { Optional<Uint>::None() }
		};
	}

	pub fn as_float(self: &JsonNode) nothrow -> Optional<Float> {
		return match self {
			Number(raw) => {
				match parse_std.parse_float(*raw) {
					core.Result::Ok(v) => { Optional::Some(v) },
					default => { Optional<Float>::None() }
				}
			},
			default => { Optional<Float>::None() }
		};
	}

	pub fn as_string(self: &JsonNode) nothrow -> Optional<String> {
		return match self {
			String(v) => { Optional::Some(*v) },
			default => { Optional<String>::None() }
		};
	}

	pub fn as_number_raw(self: &JsonNode) nothrow -> Optional<String> {
		return match self {
			Number(raw) => { Optional::Some(*raw) },
			default => { Optional<String>::None() }
		};
	}

	pub fn as_array(self: &JsonNode) nothrow -> Optional<&Array<JsonNode>> {
		return match self {
			Array(v) => { Optional::Some(v) },
			default => { Optional<&Array<JsonNode>>::None() }
		};
	}

	pub fn as_object(self: &JsonNode) nothrow -> Optional<&containers.HashMap<String, std.json.JsonNode>> {
		match self {
			Object(v) => {
				return Optional::Some(v);
			},
			default => {
			}
		}
		return Optional<&containers.HashMap<String, std.json.JsonNode>>::None();
	}

	pub fn get(self: &JsonNode, key: &String) nothrow -> Optional<&JsonNode> {
		match self {
			Object(fields) => {
				return try fields.get(key) catch { Optional<&JsonNode>::None() };
			},
			default => { return Optional<&JsonNode>::None(); }
		}
	}

	/// Walks a pre-split path (array of key segments) through nested
	/// JSON objects.
	///
	/// This is the segment-array overload.  For convenience, you can
	/// also call `get_path` with a dotted `&String` (see below).
	///
	/// Returns `None` if any segment is missing, if the path walks
	/// through a non-object at any step, or if the path traverses an
	/// array (arrays are not traversable in v1).  Empty segment array
	/// returns `Some(self)`.
	///
	/// Use this overload when keys contain a literal `.`, since the
	/// dotted-string overload cannot represent such keys.
	pub fn get_path(self: &JsonNode, path: &Array<String>) nothrow -> Optional<&JsonNode> {
		return _get_path_at(self, path, 0);
	}

	/// Walks a dotted path through nested JSON objects.
	///
	/// Example: `root.get_path("meta.callback.status")`
	///
	/// Returns `None` if any segment is missing, if the path walks
	/// through a non-object at any step, or if the path traverses an
	/// array (arrays are not traversable in v1).  An empty path
	/// (`""`) returns `Some(self)`.
	///
	/// ## Notes
	///
	/// - This is the dotted-string overload.  When keys contain a
	///   literal `.`, use the segment-array overload
	///   `get_path(&Array<String>)` instead.
	/// - Array index syntax (e.g. `"items.0"`) is not supported in v1;
	///   the segment `"0"` is looked up as an object key and returns
	///   `None` when the parent is an array.
	pub fn get_path(self: &JsonNode, path: &String) nothrow -> Optional<&JsonNode> {
		val segments = _split_dotted_path(path);
		return _get_path_at(self, &segments, 0);
	}

	/// Dotted-path traversal narrowed to `String`.
	///
	/// Shorthand for `get_path(path).as_string()` with the two match
	/// levels collapsed.  Returns `None` if the path is missing or the
	/// final node is not a JSON String.  The returned String is an
	/// owned ARC-retained copy.
	pub fn get_string_at_path(self: &JsonNode, path: &String) nothrow -> Optional<String> {
		match self.get_path(path) {
			Optional::Some(node) => { return node.as_string(); },
			Optional::None() => { return Optional<String>::None(); }
		}
	}

	/// Dotted-path traversal narrowed to `Int`.
	///
	/// Returns `None` if the path is missing, the final node is not a
	/// JSON Number, or the Number does not parse as an integer.
	pub fn get_int_at_path(self: &JsonNode, path: &String) nothrow -> Optional<Int> {
		match self.get_path(path) {
			Optional::Some(node) => { return node.as_int(); },
			Optional::None() => { return Optional<Int>::None(); }
		}
	}

	/// Dotted-path traversal narrowed to `Bool`.
	///
	/// Returns `None` if the path is missing or the final node is not a
	/// JSON Bool.
	pub fn get_bool_at_path(self: &JsonNode, path: &String) nothrow -> Optional<Bool> {
		match self.get_path(path) {
			Optional::Some(node) => { return node.as_bool(); },
			Optional::None() => { return Optional<Bool>::None(); }
		}
	}

	/// Dotted-path traversal narrowed to `Float`.
	///
	/// Returns `None` if the path is missing, the final node is not a
	/// JSON Number, or the Number does not parse as a float.
	pub fn get_float_at_path(self: &JsonNode, path: &String) nothrow -> Optional<Float> {
		match self.get_path(path) {
			Optional::Some(node) => { return node.as_float(); },
			Optional::None() => { return Optional<Float>::None(); }
		}
	}

	/// Borrowed enumeration of an object's `(key, value)` entries.
	///
	/// Returns a `JsonEntriesIter` — a `SinglePassIterator` over
	/// `containers.HashMapItemRef<String, JsonNode>`.  Each yielded `item`
	/// exposes `item.key` (`&String`) and `item.value` (`&JsonNode`): both are
	/// **borrowed** from this node — keys and values are never cloned.
	///
	/// For a **non-object** node — or an empty object — the iterator simply
	/// yields nothing; there is no distinct "not an object" signal (a non-object
	/// and an empty object are indistinguishable through this API).
	///
	/// **Iteration order is unspecified** (it follows the backing `HashMap`'s
	/// order) and MUST NOT be relied upon — in particular it is **not** canonical
	/// and must not be used for canonical/byte-stable output; use
	/// `encode_canonical` for that.
	///
	/// The iterator borrows the object, so the usual `HashMap` borrowing and
	/// iterator-invalidation rules apply: the borrow checker rejects mutating the
	/// source while an iterator is live, and a generation change otherwise trips
	/// the invalidation check.
	///
	/// **Consume with for-in** (no extra imports — `JsonEntriesIter` is
	/// `Iterable`):
	/// ```
	/// for entry in node.entries() {
	///     // entry: containers.HashMapItemRef<String, JsonNode>
	///     // entry.key: &String, entry.value: &JsonNode
	/// }
	/// ```
	/// Or drive it manually with `.next()`, which needs the trait in scope:
	/// ```
	/// import std.iter as iter;
	/// use trait iter.SinglePassIterator;
	/// var it = node.entries();
	/// match it.next() { Some(entry) => { ... }, None => { } }
	/// ```
	///
	/// **See also:** `JsonEntriesIter`, `encode_canonical` (deterministic output).
	pub fn entries(self: &JsonNode) nothrow -> JsonEntriesIter {
		match self {
			Object(fields) => {
				var obj_it = fields.iter();
				return JsonEntriesIter::Object(move obj_it);
			},
			default => {
				return JsonEntriesIter::Empty();
			}
		}
	}

	pub fn expect_bool(self: &JsonNode, path: String, key: String) -> Bool {
		match self {
			Bool(v) => { return *v; },
			default => {
				_throw_json("invalid-datatype", path, key);
				return false;
			}
		}
	}

	pub fn expect_int(self: &JsonNode, path: String, key: String) -> Int {
		match self {
			Number(raw) => {
				match parse_std.parse_int(*raw) {
					core.Result::Ok(v) => { return v; },
					default => {
						_throw_json("invalid-datatype", path, key);
						return 0;
					}
				}
			},
			default => {
				_throw_json("invalid-datatype", path, key);
				return 0;
			}
		}
	}

	pub fn expect_float(self: &JsonNode, path: String, key: String) -> Float {
		match self {
			Number(raw) => {
				match parse_std.parse_float(*raw) {
					core.Result::Ok(v) => { return v; },
					default => {
						_throw_json("invalid-datatype", path, key);
						return 0.0;
					}
				}
			},
			default => {
				_throw_json("invalid-datatype", path, key);
				return 0.0;
			}
		}
	}

	pub fn expect_string(self: &JsonNode, path: String, key: String) -> String {
		match self {
			String(v) => { return *v; },
			default => {
				_throw_json("invalid-datatype", path, key);
				return "";
			}
		}
	}

	pub fn expect_array(self: &JsonNode, path: String, key: String) -> &Array<JsonNode> {
		match self.as_array() {
			Some(v) => { return v; },
			default => {
				_throw_json("invalid-datatype", path, key);
				return self.expect_array(path, key);
			}
		}
	}

	pub fn expect_object(self: &JsonNode, path: String, key: String) -> &containers.HashMap<String, std.json.JsonNode> {
		match self.as_object() {
			Some(v) => { return v; },
			default => {
				_throw_json("invalid-datatype", path, key);
				return self.expect_object(path, key);
			}
		}
	}

	pub fn expect_path(self: &JsonNode, path: &Array<String>) -> &JsonNode {
		match self.get_path(path) {
			Some(v) => { return v; },
			default => {
				_throw_json("missing-path", "", "");
				return self;
			}
		}
	}

	pub fn into_array(self: JsonNode) nothrow -> Optional<JsonArray> {
		match self {
			Array(values) => { return Optional::Some(JsonArray(move values)); },
			default => { return Optional<JsonArray>::None(); }
		}
	}

	pub fn into_object(self: JsonNode) nothrow -> Optional<JsonObject> {
		match self {
			Object(fields) => { return Optional::Some(JsonObject(move fields)); },
			default => { return Optional<JsonObject>::None(); }
		}
	}

	pub fn clone_deep(self: &JsonNode) nothrow -> JsonNode {
		return _clone_deep_impl(self);
	}

	/// Returns a chainable `JsonCursor` positioned at this node.
	///
	/// The cursor borrows from `self`; it does not clone the subtree.
	/// All subsequent `.field(...)` calls follow object keys starting
	/// from here.  Use at the root or any intermediate `&JsonNode` to
	/// start a traversal chain.
	pub fn select(self: &JsonNode) nothrow -> JsonCursor {
		return JsonCursor(node = Optional::Some(self));
	}
}

/// A chainable, borrow-only cursor over a `JsonNode` subtree.
///
/// Created by `JsonNode.select()`.  Every `.field(key)` call returns a
/// new cursor pointing at the child (if the current node is an object
/// containing that key) or a "none" cursor that propagates through the
/// rest of the chain.  Narrowing methods such as `.as_string()` return
/// `Optional<T>` at the end of the chain.
///
/// Cursors are the ergonomic alternative to nested `match` or dotted
/// path strings.  Example:
///
/// ```drift
/// val status = root.select()
///                  .field("meta")
///                  .field("callback")
///                  .field("status")
///                  .as_string_or("");
/// ```
pub struct JsonCursor {
	node: Optional<&JsonNode>
}

implement JsonCursor {
	/// Descends one level into an object field.  If the current cursor
	/// is already "none", or if the current node is not an object, or
	/// if the key is absent, the returned cursor is "none".
	pub fn field(self: &JsonCursor, key: &String) nothrow -> JsonCursor {
		match self.node {
			Optional::Some(n) => {
				match n.get(key) {
					Optional::Some(child) => {
						return JsonCursor(node = Optional::Some(child));
					},
					Optional::None() => {
						return JsonCursor(node = Optional<&JsonNode>::None());
					}
				}
			},
			Optional::None() => {
				return JsonCursor(node = Optional<&JsonNode>::None());
			}
		}
	}

	/// Returns `true` if the cursor still points at a node.
	pub fn exists(self: &JsonCursor) nothrow -> Bool {
		match self.node {
			Optional::Some(_) => { return true; },
			Optional::None() => { return false; }
		}
	}

	/// Narrows the cursor to a `String`.  Returns `None` if the cursor
	/// is not positioned at a JSON String (or is "none").
	pub fn as_string(self: &JsonCursor) nothrow -> Optional<String> {
		match self.node {
			Optional::Some(n) => { return n.as_string(); },
			Optional::None() => { return Optional<String>::None(); }
		}
	}

	/// Narrows to `String`, returning `fallback` on miss or type
	/// mismatch.  Useful as the terminal of a cursor chain when a
	/// default is safe.
	pub fn as_string_or(self: &JsonCursor, fallback: &String) nothrow -> String {
		match self.as_string() {
			Optional::Some(s) => { return s; },
			Optional::None() => { return *fallback; }
		}
	}

	/// Narrows the cursor to an `Int`.
	pub fn as_int(self: &JsonCursor) nothrow -> Optional<Int> {
		match self.node {
			Optional::Some(n) => { return n.as_int(); },
			Optional::None() => { return Optional<Int>::None(); }
		}
	}

	/// Narrows to `Int`, returning `fallback` on miss or type mismatch.
	pub fn as_int_or(self: &JsonCursor, fallback: Int) nothrow -> Int {
		match self.as_int() {
			Optional::Some(v) => { return v; },
			Optional::None() => { return fallback; }
		}
	}

	/// Narrows the cursor to a `Bool`.
	pub fn as_bool(self: &JsonCursor) nothrow -> Optional<Bool> {
		match self.node {
			Optional::Some(n) => { return n.as_bool(); },
			Optional::None() => { return Optional<Bool>::None(); }
		}
	}

	/// Narrows to `Bool`, returning `fallback` on miss or type mismatch.
	pub fn as_bool_or(self: &JsonCursor, fallback: Bool) nothrow -> Bool {
		match self.as_bool() {
			Optional::Some(v) => { return v; },
			Optional::None() => { return fallback; }
		}
	}

	/// Narrows the cursor to a `Float`.
	pub fn as_float(self: &JsonCursor) nothrow -> Optional<Float> {
		match self.node {
			Optional::Some(n) => { return n.as_float(); },
			Optional::None() => { return Optional<Float>::None(); }
		}
	}

	/// Narrows to `Float`, returning `fallback` on miss or type mismatch.
	pub fn as_float_or(self: &JsonCursor, fallback: Float) nothrow -> Float {
		match self.as_float() {
			Optional::Some(v) => { return v; },
			Optional::None() => { return fallback; }
		}
	}

}

/// A strict, throwing chainable cursor over a `JsonNode` subtree.
///
/// Created by `JsonNode.expect()`.  Every `.field(key)` call throws
/// `JsonPathError` if the current position is not an object or if the
/// key is absent.  Terminal `.string()`, `.int()`, `.bool()`, `.float()`
/// calls throw `JsonPathError` with reason `type-mismatch-*` if the
/// position is not the expected type.
///
/// Used for extracting required fields from a JSON contract where a
/// missing or wrong-typed field is a programmer error rather than
/// expected optional data.  Exceptions propagate naturally through the
/// chain and up to the caller.
///
/// ```drift
/// fn extract_status(root: &JsonNode) -> String {
///     return root.expect()
///                .field("meta")
///                .field("callback")
///                .field("status")
///                .string();
/// }
/// ```
///
/// For optional/null-propagating traversal, use `JsonNode.select()`
/// and the `JsonCursor.field(...).as_string_or(...)` family instead.
pub struct StrictJsonCursor {
	node: &JsonNode,
	path: String,
	depth: Int
}

implement StrictJsonCursor {
	/// Descends one level into an object field.  Throws `JsonPathError`
	/// with `reason = "not-object"` if the current position is not a
	/// JSON object, or `reason = "missing-segment"` if the key is
	/// absent.
	pub fn field(self: &StrictJsonCursor, key: &String) -> StrictJsonCursor {
		match self.node.as_object() {
			Optional::Some(_) => {
				match self.node.get(key) {
					Optional::Some(child) => {
						return StrictJsonCursor(
							node = child,
							path = _join_dotted(&self.path, key),
							depth = self.depth + 1
						);
					},
					Optional::None() => {
						throw JsonPathError(
							path = self.path,
							segment = *key,
							index = self.depth,
							reason = "missing-segment"
						);
					}
				}
			},
			Optional::None() => {
				throw JsonPathError(
					path = self.path,
					segment = *key,
					index = self.depth,
					reason = "not-object"
				);
			}
		}
	}

	/// Narrows the cursor to a required `String`.  Throws
	/// `JsonPathError` with `reason = "type-mismatch-string"` on
	/// mismatch.
	pub fn string(self: &StrictJsonCursor) -> String {
		match self.node.as_string() {
			Optional::Some(s) => { return s; },
			Optional::None() => {
				throw JsonPathError(
					path = self.path,
					segment = "",
					index = self.depth,
					reason = "type-mismatch-string"
				);
			}
		}
	}

	/// Narrows the cursor to a required `Int`.  Throws
	/// `JsonPathError` with `reason = "type-mismatch-int"` on mismatch
	/// (including non-integer-shaped Numbers).
	pub fn int(self: &StrictJsonCursor) -> Int {
		match self.node.as_int() {
			Optional::Some(v) => { return v; },
			Optional::None() => {
				throw JsonPathError(
					path = self.path,
					segment = "",
					index = self.depth,
					reason = "type-mismatch-int"
				);
			}
		}
	}

	/// Narrows the cursor to a required `Bool`.  Throws
	/// `JsonPathError` with `reason = "type-mismatch-bool"` on
	/// mismatch.
	pub fn bool(self: &StrictJsonCursor) -> Bool {
		match self.node.as_bool() {
			Optional::Some(v) => { return v; },
			Optional::None() => {
				throw JsonPathError(
					path = self.path,
					segment = "",
					index = self.depth,
					reason = "type-mismatch-bool"
				);
			}
		}
	}

	/// Narrows the cursor to a required `Float`.  Throws
	/// `JsonPathError` with `reason = "type-mismatch-float"` on
	/// mismatch.
	pub fn float(self: &StrictJsonCursor) -> Float {
		match self.node.as_float() {
			Optional::Some(v) => { return v; },
			Optional::None() => {
				throw JsonPathError(
					path = self.path,
					segment = "",
					index = self.depth,
					reason = "type-mismatch-float"
				);
			}
		}
	}
}

implement JsonNode {
	/// Begins a strict (throwing) cursor chain at this node.
	///
	/// All subsequent `.field(...)` and `.string()` / `.int()` /
	/// `.bool()` / `.float()` calls throw `JsonPathError` on miss or
	/// type mismatch.  Use this for required JSON contract extraction.
	/// For optional traversal, use `select()` instead.
	pub fn expect(self: &JsonNode) nothrow -> StrictJsonCursor {
		return StrictJsonCursor(node = self, path = "", depth = 0);
	}
}

// Joins two dotted-path segments.  An empty `prefix` returns `key` as
// the new path; otherwise the result is `prefix + "." + key`.  Used by
// StrictJsonCursor.field to accumulate the path for error context.
fn _join_dotted(prefix: &String, key: &String) nothrow -> String {
	if prefix.byte_length() == 0 {
		return *key;
	}
	val dot = ".";
	return *prefix + dot + *key;
}

implement JsonArray {
	pub fn len(self: &JsonArray) nothrow -> Int {
		return self.values.len;
	}

	pub fn push(self: &mut JsonArray, value: JsonNode) nothrow -> Void {
		self.values.push(move value);
		return;
	}

	pub fn get(self: &JsonArray, index: Int) nothrow -> Optional<&JsonNode> {
		if index < 0 or index >= self.values.len {
			return Optional<&JsonNode>::None();
		}
		return Optional::Some(&self.values[index]);
	}

	pub fn to_node(var self: JsonArray) nothrow -> JsonNode {
		var empty: Array<JsonNode> = [];
		val values = mem.replace<type Array<JsonNode> >(&mut self.values, move empty);
		return JsonNode::Array(move values);
	}
}

implement JsonObject {
	pub fn len(self: &JsonObject) nothrow -> Int {
		return self.fields.len();
	}

	pub fn set(self: &mut JsonObject, key: String, value: JsonNode) nothrow -> Void {
		self.fields.insert(move key, move value);
		return;
	}

	pub fn get(self: &JsonObject, key: &String) nothrow -> Optional<&JsonNode> {
		return try self.fields.get(key) catch { Optional<&JsonNode>::None() };
	}

	pub fn to_node(var self: JsonObject) nothrow -> JsonNode {
		var empty = containers.hash_map<type String, std.json.JsonNode>();
		val fields = mem.replace<type containers.HashMap<String, std.json.JsonNode> >(&mut self.fields, move empty);
		return JsonNode::Object(move fields);
	}
}

implement iter.SinglePassIterator<containers.HashMapItemRef<String, JsonNode>> for JsonEntriesIter {
	pub fn next(self: &mut JsonEntriesIter) nothrow -> Optional<containers.HashMapItemRef<String, JsonNode>> {
		match self {
			JsonEntriesIter::Object(it) => {
				return it.next();
			},
			default => { return Optional<containers.HashMapItemRef<String, JsonNode>>::None(); }
		}
	}
}

// `JsonEntriesIter` is its own iterator: `iter()` returns it unchanged, so
// `for entry in node.entries() { ... }` works directly (no explicit
// `use trait` needed for the for-in form).  `entry` is a borrowed
// `containers.HashMapItemRef<String, JsonNode>` (`entry.key: &String`,
// `entry.value: &JsonNode`).
implement iter.Iterable<JsonEntriesIter, containers.HashMapItemRef<String, JsonNode>, JsonEntriesIter> for JsonEntriesIter {
	pub fn iter(var self: JsonEntriesIter) nothrow -> JsonEntriesIter {
		return move self;
	}
}

fn _get_path_at(node: &JsonNode, path: &Array<String>, idx: Int) nothrow -> Optional<&JsonNode> {
	if idx >= path.len {
		return Optional::Some(node);
	}
	val key = &path[idx];
	match node.get(key) {
		Some(next) => {
			return _get_path_at(next, path, idx + 1);
		},
		default => { return Optional<&JsonNode>::None(); }
	}
}

// Split a dotted path like "meta.callback.status" into its key
// segments.  Empty input returns an empty array (which _get_path_at
// treats as "return self").  A trailing or leading "." produces an
// empty-string segment, which will never match an object key and so
// results in None — this is the intended behavior for malformed
// paths in v1.  Keys containing literal "." are not supported and
// will be split incorrectly; users who need that must call the
// segment-array overload `get_path(&Array<String>)` with a pre-split
// segment array.
fn _split_dotted_path(path: &String) nothrow -> Array<String> {
	var segments: Array<String> = [];
	val n = path.byte_length();
	if n == 0 {
		return move segments;
	}
	var start = 0;
	var i = 0;
	while i < n {
		if core.string_byte_at(path, i) == cast<Byte>(46) {  // '.'
			segments.push(_slice_bytes(path, start, i));
			start = i + 1;
		}
		i = i + 1;
	}
	segments.push(_slice_bytes(path, start, n));
	return move segments;
}

// Extract bytes [start, end) from a String as a new String.  Local
// helper to keep std.json self-contained (std.text.substring would
// introduce a cross-module dependency and returns a Result).
fn _slice_bytes(s: &String, start: Int, end: Int) nothrow -> String {
	val len = end - start;
	if len <= 0 {
		return "";
	}
	var buf = io.buffer(len);
	var i = 0;
	while i < len {
		io.buffer_write(&mut buf, i, core.string_byte_at(s, start + i));
		i = i + 1;
	}
	return core.string_from_utf8_bytes(io.buffer_ptr(&buf), len);
}

fn _err_parse_line_col(text: &String, offset: Int, line: &mut Int, col: &mut Int) nothrow -> Void {
	val n = text.byte_length();
	var end = offset;
	if end < 0 {
		end = 0;
	}
	if end > n {
		end = n;
	}
	var i = 0;
	var ln = 1;
	var cl = 1;
	while i < end {
		val b = core.string_byte_at(text, i);
		if b == cast<Byte>(10) {
			ln = ln + 1;
			cl = 1;
		} else {
			cl = cl + 1;
		}
		i = i + 1;
	}
	*line = ln;
	*col = cl;
}

fn _err_parse(text: &String, tag: String, offset: Int) nothrow -> JsonErrorData {
	var line = -1;
	var col = -1;
	_err_parse_line_col(text, offset, &mut line, &mut col);
	return JsonErrorData(tag = tag, offset = offset, line = line, col = col, path = "", key = "");
}

fn _is_ws(b: Byte) nothrow -> Bool {
	return b == cast<Byte>(32) or b == cast<Byte>(9) or b == cast<Byte>(10) or b == cast<Byte>(13);
}

fn _is_digit(b: Byte) nothrow -> Bool {
	return b >= cast<Byte>(48) and b <= cast<Byte>(57);
}

fn _skip_ws(text: &String, idx: &mut Int) nothrow -> Void {
	val n = text.byte_length();
	while *idx < n {
		val b = core.string_byte_at(text, *idx);
		if not _is_ws(b) {
			return;
		}
		*idx = *idx + 1;
	}
}

fn _byte_to_string(b: Byte) nothrow -> String {
	unsafe {
		var raw = mem.alloc_uninit<type Byte>(1);
		mem.write<type Byte>(&mut raw, 0, b);
		val s = core.string_from_utf8_bytes(mem.rawbuffer_ptr<type Byte>(&raw), 1);
		mem.dealloc<type Byte>(move raw);
		return s;
	}
}

/// Internal (exported for its fail-closed tooth): the raw_view span
/// invariant enforcer.  Parser-produced spans are in-bounds by
/// construction; anything else is CORRUPTION and must abort — never
/// be masked as valid (empty or otherwise) content.
pub fn _span_view_or_abort(text: &String, start: Int, end: Int) nothrow -> txt.StringByteView {
	val n = text.byte_length();
	assert(start >= 0 and end >= start and end <= n,
		"JSON span invariant violated: raw_view over a corrupted span");
	match txt.byte_view(text, start, end - start) {
		core.Result::Ok(v) => { return move v; },
		core.Result::Err(_) => {
			assert(false, "JSON span invariant violated: raw_view over a corrupted span");
			return txt.byte_view_all(text);
		}
	}
}

fn _slice_string(text: &String, start: Int, end: Int) nothrow -> String {
	if end <= start {
		return "";
	}
	val n = end - start;
	unsafe {
		var raw = mem.alloc_uninit<type Byte>(n);
		var i = 0;
		while i < n {
			val b = core.string_byte_at(text, start + i);
			mem.write<type Byte>(&mut raw, i, b);
			i = i + 1;
		}
		val s = core.string_from_utf8_bytes(mem.rawbuffer_ptr<type Byte>(&raw), n);
		mem.dealloc<type Byte>(move raw);
		return s;
	}
}

fn _parse_literal(text: &String, idx: &mut Int, lit: String, node: JsonNode) nothrow -> core.Result<JsonNode, JsonErrorData> {
	val start = *idx;
	val want = lit.byte_length();
	val n = text.byte_length();
	if start + want > n {
		return core.Result::Err(_err_parse(text, "invalid-syntax", start));
	}
	var i = 0;
	while i < want {
		val b = core.string_byte_at(text, start + i);
		val w = core.string_byte_at(&lit, i);
		if b != w {
			return core.Result::Err(_err_parse(text, "invalid-syntax", start + i));
		}
		i = i + 1;
	}
	*idx = start + want;
	return core.Result::Ok(move node);
}

// ── Slice-2 located decoder surface: span types ─────────────────────

/// Half-open byte extent `[start, end)` of a value or key in the source.
pub struct JsonByteSpan {
	pub start: Int,
	pub end: Int
}

implement core.Copy for JsonByteSpan {
}

/// One key occurrence in an object, in source order (duplicates included).
pub struct _KeyOccurrence {
	key: String,
	key_span: JsonByteSpan
}

/// Source-span sidecar, mirroring a `JsonNode`.  Built only by `parse_located`.
pub variant _SpanTree {
	Leaf(span: JsonByteSpan),
	Arr(span: JsonByteSpan, items: Array<_SpanTree>),
	Obj(span: JsonByteSpan, occurrences: Array<_KeyOccurrence>, values: containers.HashMap<String, _SpanTree>),
	@tombstone Tombstone
}

/// A parsed document plus its source-span sidecar and the retained source text
/// (for on-demand line/column).  Produced by `parse_located`; navigate it via
/// `cursor()` / `at_pointer()`.
pub struct JsonDoc {
	root: JsonNode,
	spans: _SpanTree,
	text: String
}

// ── Slice-2 parser context + policy helpers ─────────────────────────

struct _ParseCtx {
	cfg: JsonParseConfig,
	legacy: Bool,    // legacy parse() mode: accept leading zeros, reject \u, allow unescaped controls. Never a public toggle.
	locate: Bool  // build the _SpanTree sidecar (parse_located only)
}

fn _over_limit(lim: &Optional<Int>, count: Int) nothrow -> Bool {
	match *lim {
		Some(m) => { return count > m; },
		None => { return false; }
	}
}

fn _set_leaf(ctx: &_ParseCtx, sp: &mut Optional<_SpanTree>, start: Int, end: Int) nothrow -> Void {
	if ctx.locate {
		*sp = Optional::Some(_SpanTree::Leaf(JsonByteSpan(start = start, end = end)));
	}
}

fn _err_parse_key(text: &String, tag: String, offset: Int, key: String) nothrow -> JsonErrorData {
	var line = -1;
	var col = -1;
	_err_parse_line_col(text, offset, &mut line, &mut col);
	return JsonErrorData(tag = tag, offset = offset, line = line, col = col, path = "", key = key);
}

fn _num_has_fraction(raw: &String) nothrow -> Bool {
	val n = raw.byte_length();
	var i = 0;
	while i < n {
		if core.string_byte_at(raw, i) == cast<Byte>(46) { return true; }
		i = i + 1;
	}
	return false;
}

fn _num_has_exponent(raw: &String) nothrow -> Bool {
	val n = raw.byte_length();
	var i = 0;
	while i < n {
		val b = core.string_byte_at(raw, i);
		if b == cast<Byte>(101) or b == cast<Byte>(69) { return true; }
		i = i + 1;
	}
	return false;
}

fn _num_has_leading_zero(raw: &String) nothrow -> Bool {
	val n = raw.byte_length();
	var i = 0;
	if i < n and core.string_byte_at(raw, i) == cast<Byte>(45) { i = i + 1; }
	if i < n and core.string_byte_at(raw, i) == cast<Byte>(48) {
		val j = i + 1;
		if j < n and _is_digit(core.string_byte_at(raw, j)) { return true; }
	}
	return false;
}

fn _num_is_negative_zero(raw: &String) nothrow -> Bool {
	val n = raw.byte_length();
	if n == 0 or core.string_byte_at(raw, 0) != cast<Byte>(45) { return false; }
	var i = 1;
	var saw_digit = false;
	while i < n {
		val b = core.string_byte_at(raw, i);
		if b == cast<Byte>(101) or b == cast<Byte>(69) { break; }
		if _is_digit(b) {
			saw_digit = true;
			if b != cast<Byte>(48) { return false; }
		}
		i = i + 1;
	}
	return saw_digit;
}

/// Numeric subset policy applied to the verbatim lexeme.  Precedence:
/// leading-zero → negative-zero → fraction → exponent.
fn _check_number_policy(text: &String, raw: &String, start: Int, ctx: &_ParseCtx) nothrow -> Optional<JsonErrorData> {
	if _num_has_leading_zero(raw) and not ctx.legacy {
		return Optional::Some(_err_parse(text, "number-leading-zero", start));
	}
	if _num_is_negative_zero(raw) and not ctx.cfg.numbers.allow_negative_zero {
		return Optional::Some(_err_parse(text, "number-negative-zero", start));
	}
	if _num_has_fraction(raw) and not ctx.cfg.numbers.allow_fractions {
		return Optional::Some(_err_parse(text, "number-fraction", start));
	}
	if _num_has_exponent(raw) and not ctx.cfg.numbers.allow_exponents {
		return Optional::Some(_err_parse(text, "number-exponent", start));
	}
	return Optional<JsonErrorData>::None();
}

fn _hex_val(b: Byte) nothrow -> Int {
	val c = cast<Int>(b);
	if c >= 48 and c <= 57 { return c - 48; }
	if c >= 97 and c <= 102 { return c - 87; }
	if c >= 65 and c <= 70 { return c - 55; }
	return -1;
}

fn _parse_hex4(text: &String, pos: Int, n: Int) nothrow -> Optional<Int> {
	if pos + 4 > n {
		return Optional<Int>::None();
	}
	var v = 0;
	var i = 0;
	while i < 4 {
		val h = _hex_val(core.string_byte_at(text, pos + i));
		if h < 0 {
			return Optional<Int>::None();
		}
		v = v * 16 + h;
		i = i + 1;
	}
	return Optional::Some(v);
}

/// Appends the UTF-8 encoding of Unicode scalar value `cp` to `out`.
fn _append_utf8(out: String, cp: Int) nothrow -> String {
	if cp < 128 {
		return out + _byte_to_string(cast<Byte>(cp));
	}
	if cp < 2048 {
		return out + _byte_to_string(cast<Byte>(192 + (cp / 64))) + _byte_to_string(cast<Byte>(128 + (cp % 64)));
	}
	if cp < 65536 {
		return out + _byte_to_string(cast<Byte>(224 + (cp / 4096))) + _byte_to_string(cast<Byte>(128 + ((cp / 64) % 64))) + _byte_to_string(cast<Byte>(128 + (cp % 64)));
	}
	return out + _byte_to_string(cast<Byte>(240 + (cp / 262144))) + _byte_to_string(cast<Byte>(128 + ((cp / 4096) % 64))) + _byte_to_string(cast<Byte>(128 + ((cp / 64) % 64))) + _byte_to_string(cast<Byte>(128 + (cp % 64)));
}

fn _parse_string(text: &String, idx: &mut Int, ctx: &_ParseCtx) nothrow -> core.Result<String, JsonErrorData> {
	val n = text.byte_length();
	val str_start = *idx;
	if *idx >= n or core.string_byte_at(text, *idx) != cast<Byte>(34) {
		return core.Result::Err(_err_parse(text, "invalid-syntax", *idx));
	}
	*idx = *idx + 1;
	// Escape-free fast path: most JSON strings contain no escapes, so
	// scan ahead first — a clean run decodes as ONE materialization
	// through the range-copy helper (_slice_string: a temporary byte
	// buffer plus the final String storage), replacing the per-byte
	// `out = out + _byte_to_string(b)` reallocation growth of the
	// general loop for the clean case.  Error and limit semantics are IDENTICAL to
	// the general loop: the incremental limit trips at the same byte
	// (scan-consumed count stands in for the decoded length, which
	// are equal while no escape has been seen), control bytes honor
	// ctx.legacy, and an escape falls back to the general loop with
	// the clean prefix pre-copied.
	val content_start = *idx;
	var scan = content_start;
	var matched_quote = false;
	var scanning = true;
	while scan < n and scanning {
		if _over_limit(&ctx.cfg.limits.max_string_bytes, scan - content_start) {
			*idx = scan;
			return core.Result::Err(_err_parse(text, "limit-string-bytes", str_start));
		}
		val fb = core.string_byte_at(text, scan);
		if fb == cast<Byte>(34) {
			matched_quote = true;
			scanning = false;
		} else { if fb == cast<Byte>(92) {
			scanning = false;
		} else {
			var fub = cast<Int>(fb);
			if fub < 0 {
				fub = fub + 256;
			}
			if not ctx.legacy and fub < 32 {
				*idx = scan;
				return core.Result::Err(_err_parse(text, "unescaped-control", scan));
			}
			scan = scan + 1;
		} }
	}
	if matched_quote {
		val fast = _slice_string(text, content_start, scan);
		*idx = scan + 1;
		return core.Result::Ok(move fast);
	}
	// Escape hit (or unterminated): seed the general loop with the
	// clean prefix, positioned at the first non-clean byte.
	var out = _slice_string(text, content_start, scan);
	*idx = scan;
	while *idx < n {
		// Incremental string-byte limit: reject as soon as the decoded length
		// exceeds the cap (do not consume the remainder of the string).
		if _over_limit(&ctx.cfg.limits.max_string_bytes, out.byte_length()) {
			return core.Result::Err(_err_parse(text, "limit-string-bytes", str_start));
		}
		val b = core.string_byte_at(text, *idx);
		if b == cast<Byte>(34) {
			*idx = *idx + 1;
			return core.Result::Ok(out);
		}
		if b == cast<Byte>(92) {
			*idx = *idx + 1;
			if *idx >= n {
				return core.Result::Err(_err_parse(text, "invalid-escape", *idx));
			}
			val e = core.string_byte_at(text, *idx);
			if e == cast<Byte>(34) { out = out + "\""; *idx = *idx + 1; continue; }
			if e == cast<Byte>(92) { out = out + "\\"; *idx = *idx + 1; continue; }
			if e == cast<Byte>(47) { out = out + "/"; *idx = *idx + 1; continue; }
			if e == cast<Byte>(98) { out = out + "\b"; *idx = *idx + 1; continue; }
			if e == cast<Byte>(102) { out = out + "\f"; *idx = *idx + 1; continue; }
			if e == cast<Byte>(110) { out = out + "\n"; *idx = *idx + 1; continue; }
			if e == cast<Byte>(114) { out = out + "\r"; *idx = *idx + 1; continue; }
			if e == cast<Byte>(116) { out = out + "\t"; *idx = *idx + 1; continue; }
			if e == cast<Byte>(117) {
				// `\uXXXX` — RFC string escape (public configs).  Legacy parse()
				// is bug-compatible and does NOT support it.
				if ctx.legacy {
					return core.Result::Err(_err_parse(text, "invalid-escape", *idx));
				}
				match _parse_hex4(text, *idx + 1, n) {
					Optional::None() => { return core.Result::Err(_err_parse(text, "invalid-escape", *idx)); },
					Optional::Some(cp1) => {
						*idx = *idx + 5;
						if cp1 >= 55296 and cp1 <= 56319 {
							// high surrogate → require a following \uXXXX low surrogate
							if *idx >= n or core.string_byte_at(text, *idx) != cast<Byte>(92) {
								return core.Result::Err(_err_parse(text, "invalid-escape", *idx));
							}
							if *idx + 1 >= n or core.string_byte_at(text, *idx + 1) != cast<Byte>(117) {
								return core.Result::Err(_err_parse(text, "invalid-escape", *idx));
							}
							match _parse_hex4(text, *idx + 2, n) {
								Optional::None() => { return core.Result::Err(_err_parse(text, "invalid-escape", *idx)); },
								Optional::Some(cp2) => {
									if cp2 < 56320 or cp2 > 57343 {
										return core.Result::Err(_err_parse(text, "invalid-escape", *idx));
									}
									*idx = *idx + 6;
									val cp = 65536 + (cp1 - 55296) * 1024 + (cp2 - 56320);
									out = _append_utf8(out, cp);
									continue;
								}
							}
						}
						if cp1 >= 56320 and cp1 <= 57343 {
							return core.Result::Err(_err_parse(text, "invalid-escape", *idx));
						}
						out = _append_utf8(out, cp1);
						continue;
					}
				}
			}
			return core.Result::Err(_err_parse(text, "invalid-escape", *idx));
		}
		// Unescaped control bytes U+0000–U+001F are forbidden by RFC 8259; legacy
		// parse() tolerates them.
		var ub = cast<Int>(b);
		if ub < 0 {
			ub = ub + 256;
		}
		if not ctx.legacy and ub < 32 {
			return core.Result::Err(_err_parse(text, "unescaped-control", *idx));
		}
		out = out + _byte_to_string(b);
		*idx = *idx + 1;
	}
	return core.Result::Err(_err_parse(text, "invalid-syntax", *idx));
}

fn _parse_number(text: &String, idx: &mut Int, ctx: &_ParseCtx) nothrow -> core.Result<JsonNode, JsonErrorData> {
	val n = text.byte_length();
	val start = *idx;
	if *idx < n and core.string_byte_at(text, *idx) == cast<Byte>(45) {
		*idx = *idx + 1;
	}
	if *idx >= n or not _is_digit(core.string_byte_at(text, *idx)) {
		return core.Result::Err(_err_parse(text, "invalid-syntax", *idx));
	}
	while *idx < n and _is_digit(core.string_byte_at(text, *idx)) {
		*idx = *idx + 1;
		if _over_limit(&ctx.cfg.limits.max_number_bytes, *idx - start) {
			return core.Result::Err(_err_parse(text, "limit-number-bytes", start));
		}
	}
	if *idx < n and core.string_byte_at(text, *idx) == cast<Byte>(46) {
		*idx = *idx + 1;
		if *idx >= n or not _is_digit(core.string_byte_at(text, *idx)) {
			return core.Result::Err(_err_parse(text, "invalid-syntax", *idx));
		}
		while *idx < n and _is_digit(core.string_byte_at(text, *idx)) {
			*idx = *idx + 1;
			if _over_limit(&ctx.cfg.limits.max_number_bytes, *idx - start) {
				return core.Result::Err(_err_parse(text, "limit-number-bytes", start));
			}
		}
	}
	if *idx < n {
		val e = core.string_byte_at(text, *idx);
		if e == cast<Byte>(101) or e == cast<Byte>(69) {
			*idx = *idx + 1;
			if *idx < n {
				val s = core.string_byte_at(text, *idx);
				if s == cast<Byte>(43) or s == cast<Byte>(45) {
					*idx = *idx + 1;
				}
			}
			if *idx >= n or not _is_digit(core.string_byte_at(text, *idx)) {
				return core.Result::Err(_err_parse(text, "invalid-syntax", *idx));
			}
			while *idx < n and _is_digit(core.string_byte_at(text, *idx)) {
				*idx = *idx + 1;
				if _over_limit(&ctx.cfg.limits.max_number_bytes, *idx - start) {
					return core.Result::Err(_err_parse(text, "limit-number-bytes", start));
				}
			}
		}
	}
	val raw = _slice_string(text, start, *idx);
	match _check_number_policy(text, &raw, start, ctx) {
		Optional::Some(e) => { return core.Result::Err(move e); },
		Optional::None() => { }
	}
	return core.Result::Ok(JsonNode::Number(raw));
}

fn _parse_array(text: &String, idx: &mut Int, ctx: &_ParseCtx, depth: Int, sp: &mut Optional<_SpanTree>) nothrow -> core.Result<JsonNode, JsonErrorData> {
	val n = text.byte_length();
	val arr_start = *idx;
	if *idx >= n or core.string_byte_at(text, *idx) != cast<Byte>(91) {
		return core.Result::Err(_err_parse(text, "invalid-syntax", *idx));
	}
	if _over_limit(&ctx.cfg.limits.max_depth, depth) {
		return core.Result::Err(_err_parse(text, "limit-depth", arr_start));
	}
	*idx = *idx + 1;
	_skip_ws(text, idx);
	var values: Array<JsonNode> = [];
	var items: Array<_SpanTree> = [];
	if *idx < n and core.string_byte_at(text, *idx) == cast<Byte>(93) {
		*idx = *idx + 1;
		if ctx.locate {
			*sp = Optional::Some(_SpanTree::Arr(span = JsonByteSpan(start = arr_start, end = *idx), items = move items));
		}
		return core.Result::Ok(JsonNode::Array(move values));
	}
	while true {
		val elem_start = *idx;
		// Enforce the item limit BEFORE consuming the (max+1)th element.
		if _over_limit(&ctx.cfg.limits.max_array_items, values.len + 1) {
			return core.Result::Err(_err_parse(text, "limit-array-items", elem_start));
		}
		var child_sp: Optional<_SpanTree> = Optional::None();
		match _parse_value(text, idx, ctx, depth + 1, &mut child_sp) {
			core.Result::Err(e) => { return core.Result::Err(move e); },
			core.Result::Ok(v) => { values.push(move v); }
		}
		if ctx.locate {
			match child_sp {
				Some(c) => { items.push(move c); },
				None => { }
			}
		}
		_skip_ws(text, idx);
		if *idx >= n {
			return core.Result::Err(_err_parse(text, "invalid-syntax", *idx));
		}
		val b = core.string_byte_at(text, *idx);
		if b == cast<Byte>(44) {
			*idx = *idx + 1;
			_skip_ws(text, idx);
			continue;
		}
		if b == cast<Byte>(93) {
			*idx = *idx + 1;
			if ctx.locate {
				*sp = Optional::Some(_SpanTree::Arr(span = JsonByteSpan(start = arr_start, end = *idx), items = move items));
			}
			return core.Result::Ok(JsonNode::Array(move values));
		}
		return core.Result::Err(_err_parse(text, "invalid-syntax", *idx));
	}
	return core.Result::Err(_err_parse(text, "invalid-syntax", *idx));
}

fn _parse_object_throwing(text: &String, idx: &mut Int, ctx: &_ParseCtx, depth: Int, sp: &mut Optional<_SpanTree>) -> core.Result<JsonNode, JsonErrorData> {
	val n = text.byte_length();
	val obj_start = *idx;
	if *idx >= n or core.string_byte_at(text, *idx) != cast<Byte>(123) {
		return core.Result::Err(_err_parse(text, "invalid-syntax", *idx));
	}
	if _over_limit(&ctx.cfg.limits.max_depth, depth) {
		return core.Result::Err(_err_parse(text, "limit-depth", obj_start));
	}
	*idx = *idx + 1;
	_skip_ws(text, idx);
	var fields = containers.hash_map<type String, std.json.JsonNode>();
	// `max_object_fields` counts member OCCURRENCES (incl. duplicates), not the
	// unique map size — so a flood of repeated keys can't bypass the limit.
	var member_count = 0;
	// Located sidecar (populated only when ctx.locate): every key occurrence in
	// source order, plus the surviving value span per key (mirrors `fields`).
	var occurrences: Array<_KeyOccurrence> = [];
	var vspans = containers.hash_map<type String, _SpanTree>();
	if *idx < n and core.string_byte_at(text, *idx) == cast<Byte>(125) {
		*idx = *idx + 1;
		if ctx.locate {
			*sp = Optional::Some(_SpanTree::Obj(span = JsonByteSpan(start = obj_start, end = *idx), occurrences = move occurrences, values = move vspans));
		}
		return core.Result::Ok(JsonNode::Object(move fields));
	}
	while true {
		val key_start = *idx;
		var key = "";
		match _parse_string(text, idx, ctx) {
			core.Result::Err(e) => { return core.Result::Err(move e); },
			core.Result::Ok(v) => { key = v; }
		}
		val key_end = *idx;
		if ctx.locate {
			occurrences.push(_KeyOccurrence(key = key.clone(), key_span = JsonByteSpan(start = key_start, end = key_end)));
		}
		// Reject: fail at the SECOND occurrence of a key, before its value is
		// parsed (one contains_key probe; immediate failure at `key_start`).
		match ctx.cfg.duplicate_keys {
			DuplicateKeyPolicy::Reject() => {
				if fields.contains_key(&key) {
					return core.Result::Err(_err_parse_key(text, "duplicate-key", key_start, move key));
				}
			},
			default => { }
		}
		// Enforce the field-occurrence limit BEFORE consuming this member's value.
		member_count = member_count + 1;
		if _over_limit(&ctx.cfg.limits.max_object_fields, member_count) {
			return core.Result::Err(_err_parse(text, "limit-object-fields", key_start));
		}
		_skip_ws(text, idx);
		if *idx >= n or core.string_byte_at(text, *idx) != cast<Byte>(58) {
			return core.Result::Err(_err_parse(text, "invalid-syntax", *idx));
		}
		*idx = *idx + 1;
		_skip_ws(text, idx);
		var child_sp: Optional<_SpanTree> = Optional::None();
		match _parse_value(text, idx, ctx, depth + 1, &mut child_sp) {
			core.Result::Err(e) => { return core.Result::Err(move e); },
			core.Result::Ok(v) => {
				match ctx.cfg.duplicate_keys {
					DuplicateKeyPolicy::KeepFirst() => {
						// one probe: stores when absent, drops key+value when present.
						// The value-span map mirrors `fields` under the same policy.
						if ctx.locate {
							match child_sp {
								Some(c) => { vspans.insert_if_absent(key.clone(), move c); },
								None => { }
							}
						}
						fields.insert_if_absent(move key, move v);
					},
					default => {
						// Reject (unique here) and KeepLast both insert; KeepLast's
						// overwrite IS keep-last (the returned old value is dropped).
						if ctx.locate {
							match child_sp {
								Some(c) => { vspans.insert(key.clone(), move c); },
								None => { }
							}
						}
						fields.insert(move key, move v);
					}
				}
			}
		}
		_skip_ws(text, idx);
		if *idx >= n {
			return core.Result::Err(_err_parse(text, "invalid-syntax", *idx));
		}
		val b = core.string_byte_at(text, *idx);
		if b == cast<Byte>(44) {
			*idx = *idx + 1;
			_skip_ws(text, idx);
			continue;
		}
		if b == cast<Byte>(125) {
			*idx = *idx + 1;
			if ctx.locate {
				*sp = Optional::Some(_SpanTree::Obj(span = JsonByteSpan(start = obj_start, end = *idx), occurrences = move occurrences, values = move vspans));
			}
			return core.Result::Ok(JsonNode::Object(move fields));
		}
		return core.Result::Err(_err_parse(text, "invalid-syntax", *idx));
	}
	return core.Result::Err(_err_parse(text, "invalid-syntax", *idx));
}

fn _parse_object(text: &String, idx: &mut Int, ctx: &_ParseCtx, depth: Int, sp: &mut Optional<_SpanTree>) nothrow -> core.Result<JsonNode, JsonErrorData> {
	return try _parse_object_throwing(text, idx, ctx, depth, sp) catch { core.Result::Err(_err_parse(text, "internal-error", *idx)) };
}

fn _parse_value(text: &String, idx: &mut Int, ctx: &_ParseCtx, depth: Int, sp: &mut Optional<_SpanTree>) nothrow -> core.Result<JsonNode, JsonErrorData> {
	val n = text.byte_length();
	if *idx >= n {
		return core.Result::Err(_err_parse(text, "invalid-syntax", *idx));
	}
	val start = *idx;
	val b = core.string_byte_at(text, *idx);
	if b == cast<Byte>(110) {
		match _parse_literal(text, idx, "null", JsonNode::Null()) {
			core.Result::Err(e) => { return core.Result::Err(move e); },
			core.Result::Ok(node) => { _set_leaf(ctx, sp, start, *idx); return core.Result::Ok(move node); }
		}
	}
	if b == cast<Byte>(116) {
		match _parse_literal(text, idx, "true", JsonNode::Bool(true)) {
			core.Result::Err(e) => { return core.Result::Err(move e); },
			core.Result::Ok(node) => { _set_leaf(ctx, sp, start, *idx); return core.Result::Ok(move node); }
		}
	}
	if b == cast<Byte>(102) {
		match _parse_literal(text, idx, "false", JsonNode::Bool(false)) {
			core.Result::Err(e) => { return core.Result::Err(move e); },
			core.Result::Ok(node) => { _set_leaf(ctx, sp, start, *idx); return core.Result::Ok(move node); }
		}
	}
	if b == cast<Byte>(34) {
		match _parse_string(text, idx, ctx) {
			core.Result::Err(e) => { return core.Result::Err(move e); },
			core.Result::Ok(v) => { _set_leaf(ctx, sp, start, *idx); return core.Result::Ok(JsonNode::String(move v)); }
		}
	}
	if b == cast<Byte>(91) {
		return _parse_array(text, idx, ctx, depth, sp);
	}
	if b == cast<Byte>(123) {
		return _parse_object(text, idx, ctx, depth, sp);
	}
	if b == cast<Byte>(45) or _is_digit(b) {
		match _parse_number(text, idx, ctx) {
			core.Result::Err(e) => { return core.Result::Err(move e); },
			core.Result::Ok(node) => { _set_leaf(ctx, sp, start, *idx); return core.Result::Ok(move node); }
		}
	}
	return core.Result::Err(_err_parse(text, "invalid-syntax", *idx));
}

fn _encode_string(s: String) nothrow -> String {
	var out = "\"";
	val n = s.byte_length();
	var i = 0;
	while i < n {
		val b = core.string_byte_at(&s, i);
		if b == cast<Byte>(34) {
			out = out + "\\\"";
		} else {
			if b == cast<Byte>(92) {
				out = out + "\\\\";
			} else {
				if b == cast<Byte>(8) {
					out = out + "\\b";
				} else {
					if b == cast<Byte>(12) {
						out = out + "\\f";
					} else {
						if b == cast<Byte>(10) {
							out = out + "\\n";
						} else {
							if b == cast<Byte>(13) {
								out = out + "\\r";
							} else {
								if b == cast<Byte>(9) {
									out = out + "\\t";
								} else {
									if b < cast<Byte>(32) {
										out = out + "\\u00" + _hex_byte(b);
									} else {
										out = out + _byte_to_string(b);
									}
								}
							}
						}
					}
				}
			}
		}
		i = i + 1;
	}
	return out + "\"";
}

fn _hex_nibble(n: Int) nothrow -> String {
	if n == 0 { return "0"; }
	if n == 1 { return "1"; }
	if n == 2 { return "2"; }
	if n == 3 { return "3"; }
	if n == 4 { return "4"; }
	if n == 5 { return "5"; }
	if n == 6 { return "6"; }
	if n == 7 { return "7"; }
	if n == 8 { return "8"; }
	if n == 9 { return "9"; }
	if n == 10 { return "a"; }
	if n == 11 { return "b"; }
	if n == 12 { return "c"; }
	if n == 13 { return "d"; }
	if n == 14 { return "e"; }
	if n == 15 { return "f"; }
	return "0";
}

fn _hex_byte(b: Byte) nothrow -> String {
	val v = cast<Int>(b);
	val hi = v / 16;
	val lo = v % 16;
	return _hex_nibble(hi) + _hex_nibble(lo);
}

fn _encode_array(values: &Array<JsonNode>, cfg: &JsonConfig) nothrow -> String {
	var out = "[";
	var i = 0;
	while i < values.len {
		if i > 0 {
			out = out + ",";
		}
		out = out + _encode_node(&values[i], cfg);
		i = i + 1;
	}
	return out + "]";
}

fn _bool_to_json(v: Bool) nothrow -> String {
	if v {
		return "true";
	}
	return "false";
}

fn _string_lex_cmp(a: &String, b: &String) nothrow -> Int {
	val na = a.byte_length();
	val nb = b.byte_length();
	var n = na;
	if nb < n {
		n = nb;
	}
	var i = 0;
	while i < n {
		val ba = core.string_byte_at(a, i);
		val bb = core.string_byte_at(b, i);
		if ba < bb {
			return -1;
		}
		if ba > bb {
			return 1;
		}
		i = i + 1;
	}
	if na < nb {
		return -1;
	}
	if na > nb {
		return 1;
	}
	return 0;
}

fn _sort_keys_lex(keys: &mut Array<String>) nothrow -> Void {
	var i = 1;
	while i < keys.len {
		var j = i;
		while j > 0 {
			if _string_lex_cmp(&keys[j - 1], &keys[j]) <= 0 {
				break;
			}
			keys.swap(j - 1, j);
			j = j - 1;
		}
		i = i + 1;
	}
}

fn _encode_object_unordered_throwing(fields: &containers.HashMap<String, std.json.JsonNode>, cfg: &JsonConfig) -> String {
	var out = "{";
	var first = true;
	var it = fields.iter();
	while true {
		match it.next() {
			Some(item) => {
				if not first {
					out = out + ",";
				}
				first = false;
				val k = item.key;
				out = out + _encode_string(*k) + ":" + _encode_node(item.value, cfg);
			},
			None => {
				break;
			}
		}
	}
	return out + "}";
}

fn _encode_object_ordered_throwing(fields: &containers.HashMap<String, std.json.JsonNode>, cfg: &JsonConfig) -> String {
	var out = "{";
	var total = fields.len();
	var emitted = 0;
	var has_prev = false;
	var prev = "";
	while emitted < total {
		var found = false;
		var best = "";
		var it = fields.iter();
		while true {
			match it.next() {
				Some(item) => {
					val k = item.key;
					if has_prev and _string_lex_cmp(k, &prev) <= 0 {
						continue;
					}
					if not found or _string_lex_cmp(k, &best) < 0 {
						best = *k;
						found = true;
					}
				},
				None => {
					break;
				}
			}
		}
		if not found {
			break;
		}
		if emitted > 0 {
			out = out + ",";
		}
		val key = &best;
		match fields.get(key) {
			Some(v) => {
				out = out + _encode_string(*key) + ":" + _encode_node(v, cfg);
			},
			None => {
			}
		}
		prev = best;
		has_prev = true;
		emitted = emitted + 1;
	}
	return out + "}";
}

fn _encode_object(fields: &containers.HashMap<String, std.json.JsonNode>, cfg: &JsonConfig) nothrow -> String {
	return try match cfg.key_order {
		JsonKeyOrder::OrderedLexUtf8() => { _encode_object_ordered_throwing(fields, cfg) },
		default => { _encode_object_unordered_throwing(fields, cfg) }
	} catch { "{}" };
}

fn _encode_node(node: &JsonNode, cfg: &JsonConfig) nothrow -> String {
	match node {
		Null => {
			return "null";
		},
		Bool(v) => {
			return _bool_to_json(*v);
		},
		Number(raw) => {
			return *raw;
		},
		String(v) => {
			return _encode_string(*v);
		},
		Array(values) => {
			return _encode_array(values, cfg);
		},
		Object(fields) => {
			return _encode_object(fields, cfg);
		},
		default => {
			return "null";
		}
	}
}

fn _encode_node(node: JsonNode, cfg: &JsonConfig) nothrow -> String {
	return _encode_node(&node, cfg);
}

// ── Slice-2 canonical encoding (result-propagating; signed-IR) ──────
//
// A SEPARATE encoder from `_encode_node` — it must NOT inherit the object
// path's failure-swallowing (`"{}"`) behavior.  Fixed canonical form: UTF-8,
// no insignificant whitespace, object keys recursively sorted by UTF-8 byte
// order, the frozen `_encode_string` escape table for keys and values, and the
// signed-IR integer grammar `0 | -?[1-9][0-9]*` on numbers (rejecting `-0`,
// leading zeros, fractions, exponents — never silently normalized).  Error
// selection is deterministic: array elements in index order, object members in
// UTF-8-sorted key order, first error returned.  Caller hashes the bytes.

/// Canonically encodes `node`.  `Err` (with a stable `canonical-*` tag, a JSON
/// Pointer `path`, and `offset = -1`) on a non-integer `Number` or an
/// unsupported node — never a fallback representation.
pub fn encode_canonical(node: &JsonNode) nothrow -> core.Result<String, JsonErrorData> {
	return _enc_canon(node, "");
}

fn _canon_err(tag: String, pointer: &String, raw: &String) nothrow -> JsonErrorData {
	return JsonErrorData(tag = tag, offset = -1, line = -1, col = -1, path = pointer.clone(), key = raw.clone());
}

fn _is_canonical_integer(raw: &String) nothrow -> Bool {
	val n = raw.byte_length();
	if n == 0 { return false; }
	var i = 0;
	if core.string_byte_at(raw, 0) == cast<Byte>(45) { i = 1; }
	if i >= n { return false; }
	while i < n {
		if not _is_digit(core.string_byte_at(raw, i)) { return false; }
		i = i + 1;
	}
	return true;
}

fn _canon_number(raw: &String, pointer: &String) nothrow -> Optional<JsonErrorData> {
	if _num_has_leading_zero(raw) { return Optional::Some(_canon_err("canonical-number-leading-zero", pointer, raw)); }
	if _num_is_negative_zero(raw) { return Optional::Some(_canon_err("canonical-number-negative-zero", pointer, raw)); }
	if _num_has_fraction(raw) { return Optional::Some(_canon_err("canonical-number-fraction", pointer, raw)); }
	if _num_has_exponent(raw) { return Optional::Some(_canon_err("canonical-number-exponent", pointer, raw)); }
	if not _is_canonical_integer(raw) { return Optional::Some(_canon_err("canonical-number-invalid", pointer, raw)); }
	return Optional<JsonErrorData>::None();
}

fn _enc_canon(node: &JsonNode, pointer: String) nothrow -> core.Result<String, JsonErrorData> {
	match node {
		Null => { return core.Result::Ok("null"); },
		Bool(v) => { return core.Result::Ok(_bool_to_json(*v)); },
		String(v) => { return core.Result::Ok(_encode_string(*v)); },
		Number(raw) => {
			match _canon_number(raw, &pointer) {
				Optional::Some(e) => { return core.Result::Err(move e); },
				Optional::None() => { return core.Result::Ok(*raw); }
			}
		},
		Array(values) => { return _enc_canon_array(values, pointer); },
		Object(fields) => { return _enc_canon_object(fields, pointer); },
		default => {
			return core.Result::Err(JsonErrorData(tag = "canonical-invalid-node", offset = -1, line = -1, col = -1, path = pointer.clone(), key = ""));
		}
	}
}

fn _enc_canon_array(values: &Array<JsonNode>, pointer: String) nothrow -> core.Result<String, JsonErrorData> {
	var out = "[";
	var i = 0;
	while i < values.len {
		if i > 0 {
			out = out + ",";
		}
		val child_ptr = pointer + "/" + _int_to_string(i);
		match _enc_canon(&values[i], child_ptr) {
			core.Result::Err(e) => { return core.Result::Err(move e); },
			core.Result::Ok(s) => { out = out + s; }
		}
		i = i + 1;
	}
	return core.Result::Ok(out + "]");
}

fn _enc_canon_object(fields: &containers.HashMap<String, std.json.JsonNode>, pointer: String) nothrow -> core.Result<String, JsonErrorData> {
	var out = "{";
	val total = fields.len();
	var emitted = 0;
	var has_prev = false;
	var prev = "";
	while emitted < total {
		var found = false;
		var best = "";
		var it = fields.iter();
		while true {
			match it.next() {
				Some(item) => {
					val k = item.key;
					if has_prev and _string_lex_cmp(k, &prev) <= 0 {
						continue;
					}
					if not found or _string_lex_cmp(k, &best) < 0 {
						best = *k;
						found = true;
					}
				},
				None => { break; }
			}
		}
		if not found {
			break;
		}
		if emitted > 0 {
			out = out + ",";
		}
		val child_ptr = pointer + "/" + _jp_escape(&best);
		match fields.get(&best) {
			Some(v) => {
				out = out + _encode_string(best) + ":";
				match _enc_canon(v, child_ptr) {
					core.Result::Err(e) => { return core.Result::Err(move e); },
					core.Result::Ok(s) => { out = out + s; }
				}
			},
			None => { }
		}
		prev = best;
		has_prev = true;
		emitted = emitted + 1;
	}
	return core.Result::Ok(out + "}");
}

// ── JsonHandle: shared, read-only, Arc-backed JSON tree ──────────────
//
// Wraps Arc<JsonNode>.  clone() is O(1) (refcount increment).
// share() is O(1) (single Arc allocation wrapping the whole tree).
// Read-only accessors delegate to the inner &JsonNode.

pub struct JsonHandle {
	data: concurrent.Arc<JsonNode>
}

pub fn share(node: JsonNode) nothrow -> JsonHandle {
	return JsonHandle(data = concurrent.arc<type JsonNode>(move node));
}

implement JsonHandle {
	pub fn clone(self: &JsonHandle) nothrow -> JsonHandle {
		return JsonHandle(data = self.data.clone());
	}

	pub fn node(self: &JsonHandle) nothrow -> &JsonNode {
		return self.data.get();
	}

	pub fn is_null(self: &JsonHandle) nothrow -> Bool {
		val n = self.data.get();
		return n.is_null();
	}

	pub fn get(self: &JsonHandle, key: &String) nothrow -> Optional<&JsonNode> {
		val n = self.data.get();
		return n.get(key);
	}

	pub fn as_string(self: &JsonHandle) nothrow -> Optional<String> {
		val n = self.data.get();
		return n.as_string();
	}

	pub fn as_int(self: &JsonHandle) nothrow -> Optional<Int> {
		val n = self.data.get();
		return n.as_int();
	}

	pub fn as_bool(self: &JsonHandle) nothrow -> Optional<Bool> {
		val n = self.data.get();
		return n.as_bool();
	}

	pub fn as_array(self: &JsonHandle) nothrow -> Optional<&Array<JsonNode>> {
		val n = self.data.get();
		return n.as_array();
	}

	pub fn as_object(self: &JsonHandle) nothrow -> Optional<&containers.HashMap<String, std.json.JsonNode>> {
		val n = self.data.get();
		return n.as_object();
	}

	pub fn encode_compact(self: &JsonHandle) nothrow -> String {
		val n = self.data.get();
		return _encode_node(n, &JsonConfig(key_order = JsonKeyOrder::Unordered()));
	}

	pub fn clone_deep(self: &JsonHandle) nothrow -> JsonNode {
		val n = self.data.get();
		return _clone_deep_impl(n);
	}
}

fn _clone_deep_impl(node: &JsonNode) nothrow -> JsonNode {
	match node {
		JsonNode::Null => { return JsonNode::Null(); },
		JsonNode::Bool(v) => { return JsonNode::Bool(*v); },
		JsonNode::Number(raw) => { return JsonNode::Number(*raw); },
		JsonNode::String(v) => { return JsonNode::String(*v); },
		JsonNode::Array(values) => {
			var out: Array<JsonNode> = [];
			var i = 0;
			while i < values.len {
				var c = _clone_deep_impl(&values[i]);
				out.push(move c);
				i = i + 1;
			}
			return JsonNode::Array(move out);
		},
		JsonNode::Object(fields) => {
			var out = containers.hash_map<type String, std.json.JsonNode>();
			var it = fields.iter();
			while true {
				match it.next() {
					Some(item) => {
						var k = *item.key;
						var v = _clone_deep_impl(item.value);
						out.insert(move k, move v);
					},
					None => { break; }
				}
			}
			return JsonNode::Object(move out);
		},
		default => { return JsonNode::Null(); }
	}
}

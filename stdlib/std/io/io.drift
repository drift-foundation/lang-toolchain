struct FileOpenOptions {
	pub read: Bool,
	pub write: Bool,
	pub create: Bool,
	pub truncate: Bool,
	pub append: Bool,
	pub mode: Int
}

@test_build_only
pub fn file_from_fd(fd: Int) nothrow -> File {
	return File(fd = fd, closed = core.cell(false));
}

@test_build_only
pub fn configured_input_from_file(self: &ConfiguredFile, max_line_bytes: Int) nothrow -> ConfiguredInputStream {
	return ConfiguredInputStream(fd = self.inner.fd, timeout = self.timeout, max_line_bytes = max_line_bytes);
}

pub fn stdin() nothrow -> InputStream {
	val _ = thread.io_set_nonblocking(STDIN_FD);
	return InputStream(fd = STDIN_FD);
}

pub fn stdout() nothrow -> OutputStream {
	val _ = thread.io_set_nonblocking(STDOUT_FD);
	return OutputStream(fd = STDOUT_FD);
}

pub fn stderr() nothrow -> OutputStream {
	val _ = thread.io_set_nonblocking(STDERR_FD);
	return OutputStream(fd = STDERR_FD);
}

pub fn stdin_builder() nothrow -> InputStreamBuilder {
	val _ = thread.io_set_nonblocking(STDIN_FD);
	return InputStreamBuilder(fd = STDIN_FD, timeout = conc.Duration(millis = STREAM_TIMEOUT_DEFAULT_MS), max_line_bytes = STREAM_MAX_LINE_BYTES_DEFAULT);
}

pub fn stdout_builder() nothrow -> OutputStreamBuilder {
	val _ = thread.io_set_nonblocking(STDOUT_FD);
	return OutputStreamBuilder(fd = STDOUT_FD, timeout = conc.Duration(millis = STREAM_TIMEOUT_DEFAULT_MS));
}

pub fn stderr_builder() nothrow -> OutputStreamBuilder {
	val _ = thread.io_set_nonblocking(STDERR_FD);
	return OutputStreamBuilder(fd = STDERR_FD, timeout = conc.Duration(millis = STREAM_TIMEOUT_DEFAULT_MS));
}

pub fn file_builder(path: String) nothrow -> FileBuilder {
	return FileBuilder(path = path, opt_read = true, opt_write = false, opt_create = false, opt_truncate = false, opt_append = false, opt_mode = FILE_MODE_DEFAULT, timeout = conc.Duration(millis = STREAM_TIMEOUT_DEFAULT_MS));
}

pub struct Buffer {
	buf: mem.RawBuffer<Byte>,
	cap: Int,
	len: Int
}

implement core.Destructible for Buffer {
	pub fn destroy(var self: Buffer) nothrow -> Void {
		val ptr = mem.rawbuffer_ptr<type Byte>(&self.buf);
		val cap = mem.rawbuffer_cap<type Byte>(&self.buf);
		var tmp = mem.rawbuffer_from_parts<type Byte>(ptr, cap);
		mem.dealloc<type Byte>(tmp);
	}
}

pub const FILE_READ_ONLY: Uint = 0;
pub const FILE_WRITE_ONLY: Uint = 1;
pub const FILE_READ_WRITE: Uint = 2;
pub const FILE_CREATE: Uint = 64;
pub const FILE_TRUNCATE: Uint = 512;
pub const FILE_APPEND: Uint = 1024;
pub const FILE_MODE_DEFAULT: Int = 420;
pub const IO_EINTR: Int = 4;
pub const IO_EAGAIN: Int = 11;
pub const IO_ERR_WOULD_BLOCK: Int = -4095;
pub const IO_ERR_EOF: Int = -4096;
pub const IO_ERR_LINE_TOO_LONG: Int = -4097;
pub const STDIN_FD: Int = 0;
pub const STDOUT_FD: Int = 1;
pub const STDERR_FD: Int = 2;
pub const STREAM_TIMEOUT_DEFAULT_MS: Int = 60000;
pub const STREAM_MAX_LINE_BYTES_DEFAULT: Int = 65536;

pub fn io_error_code(e: IoError) nothrow -> Int {
	return match e {
		Errno(code) => { code }
	};
}

pub fn io_is_would_block(code: Int) nothrow -> Bool {
	if code == IO_ERR_WOULD_BLOCK {
		return true;
	}
	return false;
}

pub fn io_is_eof(code: Int) nothrow -> Bool {
	if code == IO_ERR_EOF {
		return true;
	}
	return false;
}

pub fn is_would_block_error(e: IoError) nothrow -> Bool {
	return io_is_would_block(io_error_code(e));
}

pub fn is_eof_error(e: IoError) nothrow -> Bool {
	return io_is_eof(io_error_code(e));
}

pub fn is_line_too_long_error(e: IoError) nothrow -> Bool {
	return io_is_line_too_long(io_error_code(e));
}

pub fn io_is_line_too_long(code: Int) nothrow -> Bool {
	if code == IO_ERR_LINE_TOO_LONG {
		return true;
	}
	return false;
}

fn _deadline_from_timeout(timeout: conc.Duration) nothrow -> Int {
	if timeout.millis <= 0 {
		return 0;
	}
	return thread.now_ms() + timeout.millis;
}

fn _remaining_ms(deadline_ms: Int) nothrow -> Int {
	if deadline_ms <= 0 {
		return 0;
	}
	val now = thread.now_ms();
	if now >= deadline_ms {
		return 0;
	}
	return deadline_ms - now;
}

fn _block_on_io(fd: Int, interest: Int, deadline_ms: Int) nothrow -> Void {
	if deadline_ms <= 0 {
		return;
	}
	val vt = thread.vt_current();
	if vt == 0 {
		val remaining = _remaining_ms(deadline_ms);
		if remaining > 0 {
			thread.vt_park_until(remaining);
		}
		return;
	}
	thread.reactor_register_io(fd, interest, vt, deadline_ms);
	thread.vt_park_until(deadline_ms);
	return;
}

pub fn buffer(len: Int) nothrow -> Buffer {
	unsafe {
		var b = mem.alloc_uninit<type Byte>(len);
		return Buffer(buf = move b, cap = len, len = 0);
	}
}

pub fn buffer_capacity(self: &Buffer) nothrow -> Int {
	return self.cap;
}

pub fn buffer_capacity_mut(self: &mut Buffer) nothrow -> Int {
	return self.cap;
}

pub fn buffer_len(self: &Buffer) nothrow -> Int {
	return self.len;
}

pub fn buffer_len_mut(self: &mut Buffer) nothrow -> Int {
	return self.len;
}

pub fn buffer_set_len(self: &mut Buffer, len: Int) nothrow -> Void {
	self.len = len;
}

pub fn buffer_ptr(self: &Buffer) nothrow -> mem.Ptr<Byte> {
	return mem.rawbuffer_ptr<type Byte>(&self.buf);
}

pub fn buffer_ptr_mut(self: &mut Buffer) nothrow -> mem.Ptr<Byte> {
	return mem.rawbuffer_ptr<type Byte>(&self.buf);
}

pub fn buffer_write(self: &mut Buffer, i: Int, v: Byte) nothrow -> Void {
	mem.write<type Byte>(&mut self.buf, i, v);
	val new_len = i + 1;
	if new_len > self.len {
		self.len = new_len;
	}
}

pub fn buffer_read(self: &mut Buffer, i: Int) nothrow -> Byte {
	return mem.read<type Byte>(&mut self.buf, i);
}

fn _file_open(path: String, opts: &FileOpenOptions, timeout: conc.Duration) nothrow -> core.Result<File, IoError> {
	var flags = FILE_READ_ONLY;
	val deadline = _deadline_from_timeout(timeout);
	if opts.read and opts.write {
		flags = FILE_READ_WRITE;
	} else {
		if opts.write {
			flags = FILE_WRITE_ONLY;
		} else {
			flags = FILE_READ_ONLY;
		}
	}
	if opts.create {
		flags = flags + FILE_CREATE;
	}
	if opts.truncate {
		flags = flags + FILE_TRUNCATE;
	}
	if opts.append {
		flags = flags + FILE_APPEND;
	}
	while true {
		val fd = thread.io_open(path, cast<Int>(flags), opts.mode);
		if fd >= 0 {
			return core.Result::Ok(File(fd = fd, closed = core.cell(false)));
		}
		val err = thread.io_errno();
		if err == IO_EINTR {
			continue;
		}
		if err == IO_EAGAIN {
			if deadline <= 0 {
				return core.Result::Err(IoError::Errno(IO_ERR_WOULD_BLOCK));
			}
			val remaining = _remaining_ms(deadline);
			if remaining <= 0 {
				return core.Result::Err(IoError::Errno(IO_ERR_WOULD_BLOCK));
			}
			thread.vt_park_until(remaining);
			continue;
		}
		return core.Result::Err(IoError::Errno(err));
	}
	return core.Result::Err(IoError::Errno(-1));
}

fn _file_close(self: &File, timeout: conc.Duration) nothrow -> core.Result<Void, IoError> {
	if self.closed.get() {
		return core.Result::Ok(core.void_value());
	}
	val deadline = _deadline_from_timeout(timeout);
	while true {
		val r = thread.io_close(self.fd);
		if r >= 0 {
			self.closed.set(true);
			return core.Result::Ok(core.void_value());
		}
		val err = thread.io_errno();
		if err == IO_EINTR {
			continue;
		}
		if err == IO_EAGAIN {
			if deadline <= 0 {
				return core.Result::Err(IoError::Errno(IO_ERR_WOULD_BLOCK));
			}
			val remaining = _remaining_ms(deadline);
			if remaining <= 0 {
				return core.Result::Err(IoError::Errno(IO_ERR_WOULD_BLOCK));
			}
			thread.vt_park_until(remaining);
			continue;
		}
		return core.Result::Err(IoError::Errno(err));
	}
	return core.Result::Err(IoError::Errno(-1));
}

pub fn configure_file(self: &File, timeout: conc.Duration) nothrow -> ConfiguredFile {
	return ConfiguredFile(inner = File(fd = self.fd, closed = self.closed), timeout = timeout);
}

implement InputStreamBuilder {
	pub fn timeout(self: &InputStreamBuilder, timeout: conc.Duration) nothrow -> InputStreamBuilder {
		return InputStreamBuilder(fd = self.fd, timeout = timeout, max_line_bytes = self.max_line_bytes);
	}

	pub fn max_line_bytes(self: &InputStreamBuilder, max_line_bytes: Int) nothrow -> InputStreamBuilder {
		return InputStreamBuilder(fd = self.fd, timeout = self.timeout, max_line_bytes = max_line_bytes);
	}

	pub fn build(self: &InputStreamBuilder) nothrow -> ConfiguredInputStream {
		return ConfiguredInputStream(fd = self.fd, timeout = self.timeout, max_line_bytes = self.max_line_bytes);
	}
}

implement FileBuilder {
	pub fn read(self: &FileBuilder, read: Bool) nothrow -> FileBuilder {
		return FileBuilder(path = self.path, opt_read = read, opt_write = self.opt_write, opt_create = self.opt_create, opt_truncate = self.opt_truncate, opt_append = self.opt_append, opt_mode = self.opt_mode, timeout = self.timeout);
	}

	pub fn write(self: &FileBuilder, write: Bool) nothrow -> FileBuilder {
		return FileBuilder(path = self.path, opt_read = self.opt_read, opt_write = write, opt_create = self.opt_create, opt_truncate = self.opt_truncate, opt_append = self.opt_append, opt_mode = self.opt_mode, timeout = self.timeout);
	}

	pub fn create(self: &FileBuilder, create: Bool) nothrow -> FileBuilder {
		return FileBuilder(path = self.path, opt_read = self.opt_read, opt_write = self.opt_write, opt_create = create, opt_truncate = self.opt_truncate, opt_append = self.opt_append, opt_mode = self.opt_mode, timeout = self.timeout);
	}

	pub fn truncate(self: &FileBuilder, truncate: Bool) nothrow -> FileBuilder {
		return FileBuilder(path = self.path, opt_read = self.opt_read, opt_write = self.opt_write, opt_create = self.opt_create, opt_truncate = truncate, opt_append = self.opt_append, opt_mode = self.opt_mode, timeout = self.timeout);
	}

	pub fn append(self: &FileBuilder, append: Bool) nothrow -> FileBuilder {
		return FileBuilder(path = self.path, opt_read = self.opt_read, opt_write = self.opt_write, opt_create = self.opt_create, opt_truncate = self.opt_truncate, opt_append = append, opt_mode = self.opt_mode, timeout = self.timeout);
	}

	pub fn mode(self: &FileBuilder, mode: Int) nothrow -> FileBuilder {
		return FileBuilder(path = self.path, opt_read = self.opt_read, opt_write = self.opt_write, opt_create = self.opt_create, opt_truncate = self.opt_truncate, opt_append = self.opt_append, opt_mode = mode, timeout = self.timeout);
	}

	pub fn timeout(self: &FileBuilder, timeout: conc.Duration) nothrow -> FileBuilder {
		return FileBuilder(path = self.path, opt_read = self.opt_read, opt_write = self.opt_write, opt_create = self.opt_create, opt_truncate = self.opt_truncate, opt_append = self.opt_append, opt_mode = self.opt_mode, timeout = timeout);
	}

	pub fn build(self: &FileBuilder) nothrow -> core.Result<ConfiguredFile, IoError> {
		val opts = FileOpenOptions(read = self.opt_read, write = self.opt_write, create = self.opt_create, truncate = self.opt_truncate, append = self.opt_append, mode = self.opt_mode);
		val opened = _file_open(self.path, &opts, self.timeout);
		match opened {
			Ok(file) => {
				return core.Result::Ok(ConfiguredFile(inner = move file, timeout = self.timeout));
			},
			Err(e) => {
				return core.Result::Err(e);
			},
			default => {
				return core.Result::Err(IoError::Errno(-1));
			}
		}
	}
}

implement OutputStreamBuilder {
	pub fn timeout(self: &OutputStreamBuilder, timeout: conc.Duration) nothrow -> OutputStreamBuilder {
		return OutputStreamBuilder(fd = self.fd, timeout = timeout);
	}

	pub fn build(self: &OutputStreamBuilder) nothrow -> ConfiguredOutputStream {
		return ConfiguredOutputStream(fd = self.fd, timeout = self.timeout);
	}
}

pub fn input_read(self: &InputStream, buf: &mut Buffer, timeout: conc.Duration) nothrow -> core.Result<Int, IoError> {
	val ptr = mem.rawbuffer_ptr<type Byte>(&buf.buf);
	val len = buf.cap;
	val deadline = _deadline_from_timeout(timeout);
	while true {
		val n = thread.io_read(self.fd, ptr, len);
		if n >= 0 {
			buf.len = n;
			return core.Result::Ok(n);
		}
		val err = thread.io_errno();
		if err == IO_EINTR {
			continue;
		}
		if err == IO_EAGAIN {
			if deadline <= 0 {
				return core.Result::Err(IoError::Errno(IO_ERR_WOULD_BLOCK));
			}
			val remaining = _remaining_ms(deadline);
			if remaining <= 0 {
				return core.Result::Err(IoError::Errno(IO_ERR_WOULD_BLOCK));
			}
			val vt = thread.vt_current();
			if vt == 0 {
				thread.vt_park_until(remaining);
				continue;
			}
			_block_on_io(self.fd, 1, deadline);
			continue;
		}
		return core.Result::Err(IoError::Errno(err));
	}
	return core.Result::Err(IoError::Errno(-1));
}

pub fn output_write(self: &OutputStream, buf: &Buffer, timeout: conc.Duration) nothrow -> core.Result<Int, IoError> {
	val ptr = mem.rawbuffer_ptr<type Byte>(&buf.buf);
	val len = buf.len;
	val deadline = _deadline_from_timeout(timeout);
	while true {
		val n = thread.io_write(self.fd, ptr, len);
		if n >= 0 {
			return core.Result::Ok(n);
		}
		val err = thread.io_errno();
		if err == IO_EINTR {
			continue;
		}
		if err == IO_EAGAIN {
			if deadline <= 0 {
				return core.Result::Err(IoError::Errno(IO_ERR_WOULD_BLOCK));
			}
			val remaining = _remaining_ms(deadline);
			if remaining <= 0 {
				return core.Result::Err(IoError::Errno(IO_ERR_WOULD_BLOCK));
			}
			val vt = thread.vt_current();
			if vt == 0 {
				thread.vt_park_until(remaining);
				continue;
			}
			_block_on_io(self.fd, 4, deadline);
			continue;
		}
		return core.Result::Err(IoError::Errno(err));
	}
	return core.Result::Err(IoError::Errno(-1));
}

pub fn configured_input_read(self: &ConfiguredInputStream, buf: &mut Buffer) nothrow -> core.Result<Int, IoError> {
	val stream = InputStream(fd = self.fd);
	return input_read(&stream, buf, self.timeout);
}

pub fn configured_output_write(self: &ConfiguredOutputStream, buf: &Buffer) nothrow -> core.Result<Int, IoError> {
	val stream = OutputStream(fd = self.fd);
	return output_write(&stream, buf, self.timeout);
}


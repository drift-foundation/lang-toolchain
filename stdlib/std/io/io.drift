implement ConfiguredFile {
	pub fn read(self: &ConfiguredFile, buf: &mut Buffer) nothrow -> core.Result<Int, IoError> {
		return _file_read(&self.inner, buf, self.timeout);
	}

	pub fn write(self: &ConfiguredFile, buf: &Buffer) nothrow -> core.Result<Int, IoError> {
		return _file_write(&self.inner, buf, self.timeout);
	}

	pub fn close(self: &ConfiguredFile) nothrow -> core.Result<Void, IoError> {
		return _file_close(&self.inner, self.timeout);
	}
}

fn _file_read(self: &File, buf: &mut Buffer, timeout: conc.Duration) nothrow -> core.Result<Int, IoError> {
	val ptr = mem.rawbuffer_ptr<type Byte>(&buf.buf);
	val len = buf.cap;
	val deadline = _deadline_from_timeout(timeout);
	while true {
		val n = thread.io_read(self.fd, ptr, len);
		if n >= 0 {
			buf.len = n;
			return core.Result::Ok(n);
		}
		val err = thread.io_errno();
		if err == IO_EINTR {
			continue;
		}
		if err == IO_EAGAIN {
			if deadline <= 0 {
				return core.Result::Err(IoError::Errno(IO_ERR_WOULD_BLOCK));
			}
			val remaining = _remaining_ms(deadline);
			if remaining <= 0 {
				return core.Result::Err(IoError::Errno(IO_ERR_WOULD_BLOCK));
			}
			val vt = thread.vt_current();
			if vt == 0 {
				thread.vt_park_until(remaining);
				continue;
			}
			_block_on_io(self.fd, 1, deadline);
			continue;
		}
		return core.Result::Err(IoError::Errno(err));
	}
	return core.Result::Err(IoError::Errno(-1));
}

pub fn configured_input_read_line(self: &ConfiguredInputStream) nothrow -> core.Result<String, IoError> {
	if self.max_line_bytes <= 0 {
		return core.Result::Err(IoError::Errno(IO_ERR_LINE_TOO_LONG));
	}
	var line = buffer(self.max_line_bytes);
	var one = buffer(1);
	var used = 0;
	var got_any = false;
	while true {
		val r = configured_input_read(self, &mut one);
		match r {
			Ok(n) => {
				if n <= 0 {
					if got_any {
						val s = core.string_from_utf8_bytes(buffer_ptr(&line), used);
						return core.Result::Ok(s);
					}
					return core.Result::Err(IoError::Errno(IO_ERR_EOF));
				}
				got_any = true;
				val b = buffer_read(&mut one, 0);
				if b == cast<Byte>(10) {
					val s = core.string_from_utf8_bytes(buffer_ptr(&line), used);
					return core.Result::Ok(s);
				}
				if used >= self.max_line_bytes {
					return core.Result::Err(IoError::Errno(IO_ERR_LINE_TOO_LONG));
				}
				buffer_write(&mut line, used, b);
				used += 1;
				continue;
			},
			Err(e) => {
				return core.Result::Err(e);
			},
			default => {
				return core.Result::Err(IoError::Errno(-1));
			}
		}
	}
	return core.Result::Err(IoError::Errno(-1));
}

pub fn input_read_line(self: &InputStream, timeout: conc.Duration, max_line_bytes: Int) nothrow -> core.Result<String, IoError> {
	val configured = ConfiguredInputStream(fd = self.fd, timeout = timeout, max_line_bytes = max_line_bytes);
	return configured_input_read_line(&configured);
}

fn _file_write(self: &File, buf: &Buffer, timeout: conc.Duration) nothrow -> core.Result<Int, IoError> {
	val ptr = mem.rawbuffer_ptr<type Byte>(&buf.buf);
	val len = buf.len;
	val deadline = _deadline_from_timeout(timeout);
	while true {
		val n = thread.io_write(self.fd, ptr, len);
		if n >= 0 {
			return core.Result::Ok(n);
		}
		val err = thread.io_errno();
		if err == IO_EINTR {
			continue;
		}
		if err == IO_EAGAIN {
			if deadline <= 0 {
				return core.Result::Err(IoError::Errno(IO_ERR_WOULD_BLOCK));
			}
			val remaining = _remaining_ms(deadline);
			if remaining <= 0 {
				return core.Result::Err(IoError::Errno(IO_ERR_WOULD_BLOCK));
			}
			val vt = thread.vt_current();
			if vt == 0 {
				thread.vt_park_until(remaining);
				continue;
			}
			_block_on_io(self.fd, 4, deadline);
			continue;
		}
		return core.Result::Err(IoError::Errno(err));
	}
	return core.Result::Err(IoError::Errno(-1));
}

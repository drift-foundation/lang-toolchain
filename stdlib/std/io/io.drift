module std.io

import std.core as core;
import std.mem as mem;
import std.concurrent as conc;
import lang.thread as thread;

export {
	IoInterest,
	IoError,
	File,
	OpenOptions,
	Buffer,
	buffer,
	buffer_ptr,
	buffer_ptr_mut,
	buffer_capacity,
	buffer_capacity_mut,
	buffer_len,
	buffer_len_mut,
	buffer_set_len,
	buffer_write,
	buffer_read,
	file_from_fd,
	open,
	FILE_MODE_DEFAULT,
	close,
	read,
	write
};

pub variant IoInterest {
	Read,
	Write
}

pub variant IoError {
	Errno(code: Int),
	WouldBlock
}

implement core.Diagnostic for IoError {
	pub fn to_diag(self: &IoError) nothrow -> DiagnosticValue {
		return match self {
			Errno(code) => {
				DiagnosticValue::Int(*code)
			},
			WouldBlock => {
				DiagnosticValue::Int(-1)
			}
		};
	}
}

pub struct File {
	fd: Int,
	closed: core.Cell<Bool>
}

pub struct OpenOptions {
	pub read: Bool,
	pub write: Bool,
	pub create: Bool,
	pub truncate: Bool,
	pub append: Bool,
	pub mode: Int
}

@test_build_only
pub fn file_from_fd(fd: Int) nothrow -> File {
	return File(fd = fd, closed = core.cell(false));
}

pub struct Buffer {
	buf: mem.RawBuffer<Byte>,
	cap: Int,
	len: Int
}

pub const FILE_READ_ONLY: Uint = 0;
pub const FILE_WRITE_ONLY: Uint = 1;
pub const FILE_READ_WRITE: Uint = 2;
pub const FILE_CREATE: Uint = 64;
pub const FILE_TRUNCATE: Uint = 512;
pub const FILE_APPEND: Uint = 1024;
pub const FILE_MODE_DEFAULT: Int = 420;
pub const IO_EINTR: Int = 4;
pub const IO_EAGAIN: Int = 11;

fn _deadline_from_timeout(timeout: conc.Duration) nothrow -> Int {
	if timeout.millis <= 0 {
		return 0;
	}
	return thread.now_ms() + timeout.millis;
}

fn _remaining_ms(deadline_ms: Int) nothrow -> Int {
	if deadline_ms <= 0 {
		return 0;
	}
	val now = thread.now_ms();
	if now >= deadline_ms {
		return 0;
	}
	return deadline_ms - now;
}

fn _block_on_io(fd: Int, interest: Int, deadline_ms: Int) nothrow -> Void {
	if deadline_ms <= 0 {
		return;
	}
	val vt = thread.vt_current();
	if vt == 0 {
		val remaining = _remaining_ms(deadline_ms);
		if remaining > 0 {
			thread.vt_park_until(remaining);
		}
		return;
	}
	thread.reactor_register_io(fd, interest, vt, deadline_ms);
	thread.vt_park_until(deadline_ms);
	return;
}

pub fn buffer(len: Int) nothrow -> Buffer {
	unsafe {
		var b = mem.alloc_uninit<type Byte>(len);
		return Buffer(buf = move b, cap = len, len = 0);
	}
}

pub fn buffer_capacity(self: &Buffer) nothrow -> Int {
	return self.cap;
}

pub fn buffer_capacity_mut(self: &mut Buffer) nothrow -> Int {
	return self.cap;
}

pub fn buffer_len(self: &Buffer) nothrow -> Int {
	return self.len;
}

pub fn buffer_len_mut(self: &mut Buffer) nothrow -> Int {
	return self.len;
}

pub fn buffer_set_len(self: &mut Buffer, len: Int) nothrow -> Void {
	self.len = len;
}

pub fn buffer_ptr(self: &Buffer) nothrow -> mem.Ptr<Byte> {
	return mem.rawbuffer_ptr<type Byte>(&self.buf);
}

pub fn buffer_ptr_mut(self: &mut Buffer) nothrow -> mem.Ptr<Byte> {
	return mem.rawbuffer_ptr<type Byte>(&self.buf);
}

pub fn buffer_write(self: &mut Buffer, i: Int, v: Byte) nothrow -> Void {
	mem.write<type Byte>(&mut self.buf, i, v);
	val new_len = i + 1;
	if new_len > self.len {
		self.len = new_len;
	}
}

pub fn buffer_read(self: &mut Buffer, i: Int) nothrow -> Byte {
	return mem.read<type Byte>(&mut self.buf, i);
}

pub fn open(path: String, opts: &OpenOptions, timeout: conc.Duration) nothrow -> core.Result<File, IoError> {
	var flags = FILE_READ_ONLY;
	val deadline = _deadline_from_timeout(timeout);
	if opts.read and opts.write {
		flags = FILE_READ_WRITE;
	} else {
		if opts.write {
			flags = FILE_WRITE_ONLY;
		} else {
			flags = FILE_READ_ONLY;
		}
	}
	if opts.create {
		flags = flags + FILE_CREATE;
	}
	if opts.truncate {
		flags = flags + FILE_TRUNCATE;
	}
	if opts.append {
		flags = flags + FILE_APPEND;
	}
	while true {
		val fd = thread.io_open(path, cast<Int>(flags), opts.mode);
		if fd >= 0 {
			return core.Result::Ok(File(fd = fd, closed = core.cell(false)));
		}
		val err = thread.io_errno();
		if err == IO_EINTR {
			continue;
		}
		if err == IO_EAGAIN {
			if deadline <= 0 {
				return core.Result::Err(IoError::WouldBlock());
			}
			val remaining = _remaining_ms(deadline);
			if remaining <= 0 {
				return core.Result::Err(IoError::WouldBlock());
			}
			thread.vt_park_until(remaining);
			continue;
		}
		return core.Result::Err(IoError::Errno(err));
	}
	return core.Result::Err(IoError::Errno(-1));
}

pub fn close(self: &File, timeout: conc.Duration) nothrow -> core.Result<Void, IoError> {
	if self.closed.get() {
		return core.Result::Ok(core.void_value());
	}
	val deadline = _deadline_from_timeout(timeout);
	while true {
		val r = thread.io_close(self.fd);
		if r >= 0 {
			self.closed.set(true);
			return core.Result::Ok(core.void_value());
		}
		val err = thread.io_errno();
		if err == IO_EINTR {
			continue;
		}
		if err == IO_EAGAIN {
			if deadline <= 0 {
				return core.Result::Err(IoError::WouldBlock());
			}
			val remaining = _remaining_ms(deadline);
			if remaining <= 0 {
				return core.Result::Err(IoError::WouldBlock());
			}
			thread.vt_park_until(remaining);
			continue;
		}
		return core.Result::Err(IoError::Errno(err));
	}
	return core.Result::Err(IoError::Errno(-1));
}

implement File {
	pub fn close(self: &File, timeout: conc.Duration) nothrow -> core.Result<Void, IoError> {
		return close(self, timeout);
	}

	pub fn read(self: &File, buf: &mut Buffer, timeout: conc.Duration) nothrow -> core.Result<Int, IoError> {
		return read(self, buf, timeout);
	}

	pub fn write(self: &File, buf: &Buffer, timeout: conc.Duration) nothrow -> core.Result<Int, IoError> {
		return write(self, buf, timeout);
	}
}

pub fn read(self: &File, buf: &mut Buffer, timeout: conc.Duration) nothrow -> core.Result<Int, IoError> {
	val ptr = mem.rawbuffer_ptr<type Byte>(&buf.buf);
	val len = buf.cap;
	val deadline = _deadline_from_timeout(timeout);
	while true {
		val n = thread.io_read(self.fd, ptr, len);
		if n >= 0 {
			buf.len = n;
			return core.Result::Ok(n);
		}
		val err = thread.io_errno();
		if err == IO_EINTR {
			continue;
		}
		if err == IO_EAGAIN {
			if deadline <= 0 {
				return core.Result::Err(IoError::WouldBlock());
			}
			val remaining = _remaining_ms(deadline);
			if remaining <= 0 {
				return core.Result::Err(IoError::WouldBlock());
			}
			val vt = thread.vt_current();
			if vt == 0 {
				thread.vt_park_until(remaining);
				continue;
			}
			_block_on_io(self.fd, 1, deadline);
			continue;
		}
		return core.Result::Err(IoError::Errno(err));
	}
	return core.Result::Err(IoError::Errno(-1));
}

pub fn write(self: &File, buf: &Buffer, timeout: conc.Duration) nothrow -> core.Result<Int, IoError> {
	val ptr = mem.rawbuffer_ptr<type Byte>(&buf.buf);
	val len = buf.len;
	val deadline = _deadline_from_timeout(timeout);
	while true {
		val n = thread.io_write(self.fd, ptr, len);
		if n >= 0 {
			return core.Result::Ok(n);
		}
		val err = thread.io_errno();
		if err == IO_EINTR {
			continue;
		}
		if err == IO_EAGAIN {
			if deadline <= 0 {
				return core.Result::Err(IoError::WouldBlock());
			}
			val remaining = _remaining_ms(deadline);
			if remaining <= 0 {
				return core.Result::Err(IoError::WouldBlock());
			}
			val vt = thread.vt_current();
			if vt == 0 {
				thread.vt_park_until(remaining);
				continue;
			}
			_block_on_io(self.fd, 4, deadline);
			continue;
		}
		return core.Result::Err(IoError::Errno(err));
	}
	return core.Result::Err(IoError::Errno(-1));
}

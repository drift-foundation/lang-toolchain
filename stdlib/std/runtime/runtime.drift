module std.runtime

import std.core as core;
import std.mem as mem;
import lang.thread as thread;

export {
	GlobalRegistry,
	global_registry,
	contains,
	get,
	expect,
	RegistryError,
	TypeBox,
	TypeBoxError,
	type_box,
	downcast,
	expect_downcast
};

pub struct GlobalRegistry {
	_opaque: Int
}

pub exception RegistryError(tag: String);

pub fn global_registry() nothrow -> &GlobalRegistry {
	unsafe {
		val p = thread.runtime_global_registry_ptr();
		var raw = mem.rawbuffer_from_parts<type GlobalRegistry>(p, 1);
		return mem.ptr_at_ref<type GlobalRegistry>(&raw, 0);
	}
}

implement GlobalRegistry {
	pub fn set<T>(self: &GlobalRegistry, value: T) nothrow -> Bool {
		val _ = self;
		unsafe {
			var raw = mem.alloc_uninit<type T>(1);
			mem.write<type T>(&mut raw, 0, move value);
			val p = mem.rawbuffer_ptr<type T>(&raw);
			val dropper = core.callback1(_typebox_drop_impl<type T>);
			val rc = thread.runtime_registry_set(core.type_id<type T>(), p, move dropper);
			if rc != 1 {
				val v = mem.read<type T>(&mut raw, 0);
				core.drop_value<type T>(move v);
				mem.dealloc<type T>(move raw);
				return false;
			}
			return true;
		}
	}

	pub fn contains_type(self: &GlobalRegistry, type_tag: Uint64) nothrow -> Bool {
		val _ = self;
		return thread.runtime_registry_contains(type_tag) == 1;
	}

	pub fn get_ptr(self: &GlobalRegistry, type_tag: Uint64) nothrow -> mem.Ptr<Byte> {
		val _ = self;
		return thread.runtime_registry_get(type_tag);
	}
}

pub fn contains<T>(reg: &GlobalRegistry) nothrow -> Bool {
	return reg.contains_type(core.type_id<type T>());
}

pub fn get<T>(reg: &GlobalRegistry) nothrow -> Optional<&T> {
	unsafe {
		val p = reg.get_ptr(core.type_id<type T>());
		if mem.ptr_is_null<type Byte>(p) {
			return Optional<&T>::None();
		}
		var raw = mem.rawbuffer_from_parts<type T>(p, 1);
		return Optional<&T>::Some(mem.ptr_at_ref<type T>(&raw, 0));
	}
}

pub fn expect<T>(reg: &GlobalRegistry, tag: String) -> &T {
	match get<type T>(reg) {
		Some(v) => { return v; },
		None => {
			throw RegistryError(tag = tag);
		}
	}
}

pub exception TypeBoxError();

pub struct TypeBox {
	tag: Uint64,
	buf: mem.RawBuffer<Byte>,
	dropper: core.Callback1<mem.Ptr<Byte>, Void>
}

fn _typebox_drop_impl<T>(p: mem.Ptr<Byte>) nothrow -> Void {
	unsafe {
		var raw = mem.rawbuffer_from_parts<type T>(p, 1);
		val value = mem.read<type T>(&mut raw, 0);
		core.drop_value<type T>(move value);
		mem.dealloc<type T>(move raw);
	}
	return;
}

pub fn type_box<T>(value: T) nothrow -> TypeBox {
	unsafe {
		var raw = mem.alloc_uninit<type T>(1);
		mem.write<type T>(&mut raw, 0, move value);
		val p = mem.rawbuffer_ptr<type T>(&raw);
		val c = mem.rawbuffer_cap<type T>(&raw);
		val b = mem.rawbuffer_from_parts<type Byte>(p, c);
		val dropper = core.callback1(_typebox_drop_impl<type T>);
		return TypeBox(tag = core.type_id<type T>(), buf = move b, dropper = move dropper);
	}
}

pub fn downcast<T>(self: &TypeBox) nothrow -> Optional<&T> {
	if self.tag != core.type_id<type T>() {
		return Optional<&T>::None();
	}
	unsafe {
		val p = mem.rawbuffer_ptr<type Byte>(&self.buf);
		var raw = mem.rawbuffer_from_parts<type T>(p, 1);
		val v = mem.ptr_at_ref<type T>(&raw, 0);
		return Optional::Some(v);
	}
}

pub fn expect_downcast<T>(self: &TypeBox, tag: String) -> &T {
	match downcast<type T>(self) {
		Some(v) => { return v; },
		None => {
			core.drop_value(move tag);
			throw TypeBoxError();
		}
	}
}

implement TypeBox {
	pub fn type_id(self: &TypeBox) nothrow -> Uint64 {
		return self.tag;
	}
}

implement core.Destructible for TypeBox {
	pub fn destroy(self: TypeBox) nothrow -> Void {
		var is_null = false;
		unsafe {
			val p = mem.rawbuffer_ptr<type Byte>(&self.buf);
			is_null = mem.ptr_is_null<type Byte>(p);
		}
		if is_null {
			return;
		}
		val p = mem.rawbuffer_ptr<type Byte>(&self.buf);
		self.dropper.call(p);
		return;
	}
}

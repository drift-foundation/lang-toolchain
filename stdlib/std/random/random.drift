module std.random;

import std.core as core;
import std.mem as mem;
import lang.thread as thread;

export {
	RandomError,
	random_secure_bytes
};

/// Error returned by `random_secure_bytes` when the OS RNG fails.
///
/// `tag` is a stable machine-readable code (`"invalid-length"`,
/// `"os-random-failed"`).  `errno` is the platform errno (positive
/// integer) when the OS call returned an error code; `0` otherwise.
///
/// `RandomError` implements `core.Throw` and `core.Diagnostic`.
pub struct RandomError {
	pub tag: String,
	pub errno: Int
}

implement core.Diagnostic for RandomError {
	pub fn to_diag(self: &RandomError) nothrow -> DiagnosticValue {
		return DiagnosticValue::String(self.tag);
	}
}

implement core.Throw for RandomError {
	pub fn throw_self(self: RandomError) throws {
		throw std.err:ResultError(dv = DiagnosticValue::String(self.tag));
	}
}

/// Returns `n` cryptographically-secure random bytes.
///
/// Backed by the OS RNG (e.g. `getrandom(2)` on Linux).  Suitable
/// for cryptographic key material, nonces, session tokens.  Blocks
/// briefly if the OS pool is uninitialized (rare, only at very
/// early boot).
///
/// **Parameters:**
/// - `n` — number of bytes to generate.  Must be `>= 0`.
///
/// **Returns:** `Ok(Array<Byte>)` of length `n` on success.
/// `Err(RandomError(tag = "invalid-length"))` if `n < 0`.
/// `Err(RandomError(tag = "os-random-failed", errno = …))` if the
/// OS RNG call fails.
pub fn random_secure_bytes(n: Int) nothrow -> core.Result<Array<Byte>, RandomError> {
	if n < 0 {
		return core.Result::Err(RandomError(tag = "invalid-length", errno = 0));
	}
	if n == 0 {
		var empty: Array<Byte> = [];
		return core.Result::Ok(move empty);
	}
	var buf = unsafe { thread.array_byte_alloc_uninit(n) };
	val ptr = unsafe { thread.array_byte_as_mut_ptr(&mut buf) };
	val rc = unsafe { thread.random_fill(ptr, n) };
	if rc != 0 {
		return core.Result::Err(RandomError(tag = "os-random-failed", errno = 0 - rc));
	}
	unsafe { thread.array_byte_commit_init_len(&mut buf, n); }
	return core.Result::Ok(move buf);
}

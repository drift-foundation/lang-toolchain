module std.crypto

export {
	sha1,
	sha256,
	hmac_sha256,
	constant_time_eq
};

const U32_MOD: Uint = 4294967296;
const U32_MASK: Uint = 4294967295;
const H0_INIT: Uint = 1732584193;
const H1_INIT: Uint = 4023233417;
const H2_INIT: Uint = 2562383102;
const H3_INIT: Uint = 271733878;
const H4_INIT: Uint = 3285377520;

fn _u32(x: Uint) nothrow -> Uint {
	return x % U32_MOD;
}

fn _ror32(x: Uint, n: Int) nothrow -> Uint {
	val v: Uint = _u32(x);
	val r: Uint = v >> cast<Uint>(n);
	val l: Uint = _u32(v << cast<Uint>(32 - n));
	return _u32(r | l);
}

fn _rol32(x: Uint, n: Int) nothrow -> Uint {
	val v = _u32(x);
	val l = _u32(v << cast<Uint>(n));
	val r = v >> cast<Uint>(32 - n);
	return _u32(cast<Uint>(l) | cast<Uint>(r));
}

fn _u8(b: Byte) nothrow -> Uint {
	return cast<Uint>(b);
}

fn _append_u32_be(out: &mut Array<Byte>, x: Uint) nothrow -> Void {
	val v = _u32(x);
	out.push(cast<Byte>((v >> cast<Uint>(24)) % cast<Uint>(256)));
	out.push(cast<Byte>((v >> cast<Uint>(16)) % cast<Uint>(256)));
	out.push(cast<Byte>((v >> cast<Uint>(8)) % cast<Uint>(256)));
	out.push(cast<Byte>(v % cast<Uint>(256)));
}

pub fn constant_time_eq(a: &Array<Byte>, b: &Array<Byte>) nothrow -> Bool {
	if a.len != b.len {
		return false;
	}
	var diff: Uint = cast<Uint>(0);
	var i = 0;
	while i < a.len {
		diff = diff | (cast<Uint>(a[i]) ^ cast<Uint>(b[i]));
		i = i + 1;
	}
	return diff == cast<Uint>(0);
}

fn _sha256_k(i: Int) nothrow -> Uint {
	if i == 0 { return cast<Uint>(1116352408); }
	if i == 1 { return cast<Uint>(1899447441); }
	if i == 2 { return cast<Uint>(3049323471); }
	if i == 3 { return cast<Uint>(3921009573); }
	if i == 4 { return cast<Uint>(961987163); }
	if i == 5 { return cast<Uint>(1508970993); }
	if i == 6 { return cast<Uint>(2453635748); }
	if i == 7 { return cast<Uint>(2870763221); }
	if i == 8 { return cast<Uint>(3624381080); }
	if i == 9 { return cast<Uint>(310598401); }
	if i == 10 { return cast<Uint>(607225278); }
	if i == 11 { return cast<Uint>(1426881987); }
	if i == 12 { return cast<Uint>(1925078388); }
	if i == 13 { return cast<Uint>(2162078206); }
	if i == 14 { return cast<Uint>(2614888103); }
	if i == 15 { return cast<Uint>(3248222580); }
	if i == 16 { return cast<Uint>(3835390401); }
	if i == 17 { return cast<Uint>(4022224774); }
	if i == 18 { return cast<Uint>(264347078); }
	if i == 19 { return cast<Uint>(604807628); }
	if i == 20 { return cast<Uint>(770255983); }
	if i == 21 { return cast<Uint>(1249150122); }
	if i == 22 { return cast<Uint>(1555081692); }
	if i == 23 { return cast<Uint>(1996064986); }
	if i == 24 { return cast<Uint>(2554220882); }
	if i == 25 { return cast<Uint>(2821834349); }
	if i == 26 { return cast<Uint>(2952996808); }
	if i == 27 { return cast<Uint>(3210313671); }
	if i == 28 { return cast<Uint>(3336571891); }
	if i == 29 { return cast<Uint>(3584528711); }
	if i == 30 { return cast<Uint>(113926993); }
	if i == 31 { return cast<Uint>(338241895); }
	if i == 32 { return cast<Uint>(666307205); }
	if i == 33 { return cast<Uint>(773529912); }
	if i == 34 { return cast<Uint>(1294757372); }
	if i == 35 { return cast<Uint>(1396182291); }
	if i == 36 { return cast<Uint>(1695183700); }
	if i == 37 { return cast<Uint>(1986661051); }
	if i == 38 { return cast<Uint>(2177026350); }
	if i == 39 { return cast<Uint>(2456956037); }
	if i == 40 { return cast<Uint>(2730485921); }
	if i == 41 { return cast<Uint>(2820302411); }
	if i == 42 { return cast<Uint>(3259730800); }
	if i == 43 { return cast<Uint>(3345764771); }
	if i == 44 { return cast<Uint>(3516065817); }
	if i == 45 { return cast<Uint>(3600352804); }
	if i == 46 { return cast<Uint>(4094571909); }
	if i == 47 { return cast<Uint>(275423344); }
	if i == 48 { return cast<Uint>(430227734); }
	if i == 49 { return cast<Uint>(506948616); }
	if i == 50 { return cast<Uint>(659060556); }
	if i == 51 { return cast<Uint>(883997877); }
	if i == 52 { return cast<Uint>(958139571); }
	if i == 53 { return cast<Uint>(1322822218); }
	if i == 54 { return cast<Uint>(1537002063); }
	if i == 55 { return cast<Uint>(1747873779); }
	if i == 56 { return cast<Uint>(1955562222); }
	if i == 57 { return cast<Uint>(2024104815); }
	if i == 58 { return cast<Uint>(2227730452); }
	if i == 59 { return cast<Uint>(2361852424); }
	if i == 60 { return cast<Uint>(2428436474); }
	if i == 61 { return cast<Uint>(2756734187); }
	if i == 62 { return cast<Uint>(3204031479); }
	if i == 63 { return cast<Uint>(3329325298); }
	return cast<Uint>(0);
}

pub fn sha256(bytes: &Array<Byte>) nothrow -> Array<Byte> {
	var msg = Array<type Byte>::with_capacity(bytes.len + 72);
	var i = 0;
	while i < bytes.len {
		msg.push(bytes[i]);
		i = i + 1;
	}
	val mlen = msg.len;
	val bit_len = cast<Uint>(mlen) * cast<Uint>(8);
	msg.push(cast<Byte>(128));
	while msg.len % 64 != 56 {
		msg.push(cast<Byte>(0));
	}
	val hi = bit_len / U32_MOD;
	val lo = bit_len % U32_MOD;
	_append_u32_be(&mut msg, hi);
	_append_u32_be(&mut msg, lo);

	var h0: Uint = cast<Uint>(1779033703);
	var h1: Uint = cast<Uint>(3144134277);
	var h2: Uint = cast<Uint>(1013904242);
	var h3: Uint = cast<Uint>(2773480762);
	var h4: Uint = cast<Uint>(1359893119);
	var h5: Uint = cast<Uint>(2600822924);
	var h6: Uint = cast<Uint>(528734635);
	var h7: Uint = cast<Uint>(1541459225);

	var chunk = 0;
	while chunk < msg.len {
		var w = Array<type Uint>::with_capacity(64);
		var t = 0;
		while t < 64 {
			w.push(cast<Uint>(0));
			t = t + 1;
		}
		t = 0;
		while t < 16 {
			val base = chunk + t * 4;
			val b0 = _u8(msg[base]);
			val b1 = _u8(msg[base + 1]);
			val b2 = _u8(msg[base + 2]);
			val b3 = _u8(msg[base + 3]);
			w[t] = _u32((b0 << cast<Uint>(24)) | (b1 << cast<Uint>(16)) | (b2 << cast<Uint>(8)) | b3);
			t = t + 1;
		}
		t = 16;
		while t < 64 {
			val s0 = _ror32(w[t - 15], 7) ^ _ror32(w[t - 15], 18) ^ (w[t - 15] >> cast<Uint>(3));
			val s1 = _ror32(w[t - 2], 17) ^ _ror32(w[t - 2], 19) ^ (w[t - 2] >> cast<Uint>(10));
			w[t] = _u32(w[t - 16] + s0 + w[t - 7] + s1);
			t = t + 1;
		}

		var a = h0;
		var b = h1;
		var c = h2;
		var d = h3;
		var e = h4;
		var f = h5;
		var g = h6;
		var hh = h7;

		t = 0;
		while t < 64 {
			val sig1 = _ror32(e, 6) ^ _ror32(e, 11) ^ _ror32(e, 25);
			val ch = (e & f) ^ ((e ^ U32_MASK) & g);
			val temp1 = _u32(hh + sig1 + ch + _sha256_k(t) + w[t]);
			val sig0 = _ror32(a, 2) ^ _ror32(a, 13) ^ _ror32(a, 22);
			val maj = (a & b) ^ (a & c) ^ (b & c);
			val temp2 = _u32(sig0 + maj);
			hh = g;
			g = f;
			f = e;
			e = _u32(d + temp1);
			d = c;
			c = b;
			b = a;
			a = _u32(temp1 + temp2);
			t = t + 1;
		}

		h0 = _u32(h0 + a);
		h1 = _u32(h1 + b);
		h2 = _u32(h2 + c);
		h3 = _u32(h3 + d);
		h4 = _u32(h4 + e);
		h5 = _u32(h5 + f);
		h6 = _u32(h6 + g);
		h7 = _u32(h7 + hh);
		chunk = chunk + 64;
	}

	var out = Array<type Byte>::with_capacity(32);
	_append_u32_be(&mut out, h0);
	_append_u32_be(&mut out, h1);
	_append_u32_be(&mut out, h2);
	_append_u32_be(&mut out, h3);
	_append_u32_be(&mut out, h4);
	_append_u32_be(&mut out, h5);
	_append_u32_be(&mut out, h6);
	_append_u32_be(&mut out, h7);
	return move out;
}

pub fn hmac_sha256(key: &Array<Byte>, msg: &Array<Byte>) nothrow -> Array<Byte> {
	var effective_key: Array<Byte> = [];
	if key.len > 64 {
		effective_key = sha256(key);
	} else {
		var ki = 0;
		while ki < key.len {
			effective_key.push(key[ki]);
			ki = ki + 1;
		}
	}
	while effective_key.len < 64 {
		effective_key.push(cast<Byte>(0));
	}
	var ipad_msg = Array<type Byte>::with_capacity(64 + msg.len);
	var opad_prefix = Array<type Byte>::with_capacity(64 + 32);
	var pi = 0;
	while pi < 64 {
		ipad_msg.push(cast<Byte>(cast<Uint>(effective_key[pi]) ^ cast<Uint>(54)));
		opad_prefix.push(cast<Byte>(cast<Uint>(effective_key[pi]) ^ cast<Uint>(92)));
		pi = pi + 1;
	}
	var mi = 0;
	while mi < msg.len {
		ipad_msg.push(msg[mi]);
		mi = mi + 1;
	}
	val inner_hash = sha256(&ipad_msg);
	var hi = 0;
	while hi < inner_hash.len {
		opad_prefix.push(inner_hash[hi]);
		hi = hi + 1;
	}
	return sha256(&opad_prefix);
}

pub fn sha1(bytes: &Array<Byte>) nothrow -> Array<Byte> {
	var msg = Array<type Byte>::with_capacity(bytes.len + 72);
	var i = 0;
	while i < bytes.len {
		msg.push(bytes[i]);
		i = i + 1;
	}
	val mlen = msg.len;
	val bit_len = cast<Uint>(mlen) * cast<Uint>(8);
	msg.push(cast<Byte>(128));
	while msg.len % 64 != 56 {
		msg.push(cast<Byte>(0));
	}
	val hi = bit_len / U32_MOD;
	val lo = bit_len % U32_MOD;
	_append_u32_be(&mut msg, hi);
	_append_u32_be(&mut msg, lo);

	var h0 = H0_INIT;
	var h1 = H1_INIT;
	var h2 = H2_INIT;
	var h3 = H3_INIT;
	var h4 = H4_INIT;

	var chunk = 0;
	while chunk < msg.len {
		var w = Array<type Uint>::with_capacity(80);
		var t = 0;
		while t < 80 {
			w.push(cast<Uint>(0));
			t = t + 1;
		}
		t = 0;
		while t < 16 {
			val base = chunk + t * 4;
			val b0 = _u8(msg[base]);
			val b1 = _u8(msg[base + 1]);
			val b2 = _u8(msg[base + 2]);
			val b3 = _u8(msg[base + 3]);
			w[t] = _u32((b0 << cast<Uint>(24)) | (b1 << cast<Uint>(16)) | (b2 << cast<Uint>(8)) | b3);
			t = t + 1;
		}
		t = 16;
		while t < 80 {
			w[t] = _rol32(w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16], 1);
			t = t + 1;
		}

		var a = h0;
		var b = h1;
		var c = h2;
		var d = h3;
		var e = h4;

		t = 0;
		while t < 80 {
			var f: Uint = cast<Uint>(0);
			var k: Uint = cast<Uint>(0);
			if t < 20 {
				f = (cast<Uint>(b) & cast<Uint>(c)) | ((cast<Uint>(b) ^ U32_MASK) & cast<Uint>(d));
				k = cast<Uint>(1518500249);
			} else {
				if t < 40 {
					f = cast<Uint>(b) ^ cast<Uint>(c) ^ cast<Uint>(d);
					k = cast<Uint>(1859775393);
				} else {
					if t < 60 {
						f = (cast<Uint>(b) & cast<Uint>(c)) | (cast<Uint>(b) & cast<Uint>(d)) | (cast<Uint>(c) & cast<Uint>(d));
						k = cast<Uint>(2400959708);
					} else {
						f = cast<Uint>(b) ^ cast<Uint>(c) ^ cast<Uint>(d);
						k = cast<Uint>(3395469782);
					}
				}
			}
			val temp = _u32(_rol32(a, 5) + f + e + k + w[t]);
			e = d;
			d = c;
			c = _rol32(b, 30);
			b = a;
			a = temp;
			t = t + 1;
		}

		h0 = _u32(h0 + a);
		h1 = _u32(h1 + b);
		h2 = _u32(h2 + c);
		h3 = _u32(h3 + d);
		h4 = _u32(h4 + e);
		chunk = chunk + 64;
	}

	var out = Array<type Byte>::with_capacity(20);
	_append_u32_be(&mut out, h0);
	_append_u32_be(&mut out, h1);
	_append_u32_be(&mut out, h2);
	_append_u32_be(&mut out, h3);
	_append_u32_be(&mut out, h4);
	return move out;
}

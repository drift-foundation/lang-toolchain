module std.fs;

import std.core as core;
import std.io as io;
import std.text as text;
import std.concurrent as conc;
import lang.thread as thread;

export {
	FileKind,
	DirEntry,
	read_dir,
	read_to_bytes,
	read_to_string
};

/// The type of a directory entry, reflecting the **entry itself** and
/// never a symlink's target.
///
/// `read_dir` classifies every entry with
/// `fstatat(dirfd, name, AT_SYMLINK_NOFOLLOW)`, so a symlink is always
/// reported as `Symlink` (never resolved).  `Unknown` means the type
/// could not be determined (the per-entry `fstatat` failed) — it does
/// **not** mean the entry is absent, and such an entry does not fail the
/// listing.
///
/// **Platform:** POSIX.
pub variant FileKind {
	File,
	Dir,
	Symlink,
	Other,
	Unknown,
}

/// A single directory entry: its `name` (owned, valid UTF-8) and its
/// `kind`.  `.` and `..` are never present.  `name` is a `String`, which
/// self-releases — `DirEntry` needs no explicit `Destructible`.
pub struct DirEntry {
	pub name: String,
	pub kind: FileKind,
}

// FileKind codes returned by `thread.fs_result_kind` — must match the
// DRIFT_FK_* constants in lang/language_runtime/posix/fs_runtime.c.
const FK_FILE: Int = 0;
const FK_DIR: Int = 1;
const FK_SYMLINK: Int = 2;
const FK_OTHER: Int = 3;

// Result status codes from `thread.fs_result_status` (C-side, with close-error
// precedence already resolved): 0 ok / 1 errno / 2 invalid-utf8.
const STATUS_ERRNO: Int = 1;
const STATUS_UTF8: Int = 2;

// Negative sentinels from `thread.fs_read_dir` (no result handle).
const RC_ENOMEM: Int = -1;
const RC_SATURATED: Int = -2;
const RC_TIMEDOUT: Int = -4;
const RC_CANCELLED: Int = -5;

// Linux errno labels carried in the IoError.code for interop.
const ERRNO_ENOMEM: Int = 12;
const ERRNO_EAGAIN: Int = 11;
const ERRNO_ETIMEDOUT: Int = 110;
const ERRNO_ECANCELED: Int = 125;
const ERRNO_EINVAL: Int = 22;
const ERRNO_EFBIG: Int = 27;
const ERRNO_EILSEQ: Int = 84;

// Whole-file read chunk size (bytes). One pooled blocking read per chunk.
const READ_CHUNK_BYTES: Int = 65536;

fn _kind_of(code: Int) nothrow -> FileKind {
	if code == FK_FILE {
		return FileKind::File();
	}
	if code == FK_DIR {
		return FileKind::Dir();
	}
	if code == FK_SYMLINK {
		return FileKind::Symlink();
	}
	if code == FK_OTHER {
		return FileKind::Other();
	}
	return FileKind::Unknown();
}

// Deterministic, locale-independent sort by name using Drift's built-in String
// ordering (unsigned-byte lexicographic via StringCmp).  Insertion sort:
// directory listings are small (config/plugin dirs) and entry names are unique,
// so a simple in-place pass is sufficient.
fn _sort_by_name(entries: &mut Array<DirEntry>) nothrow -> Void {
	val n = entries.len;
	var i = 1;
	while i < n {
		var j = i;
		while j > 0 {
			if entries[j].name < entries[j - 1].name {
				entries.swap(j - 1, j);
				j = j - 1;
			} else {
				j = 0; // ordered prefix reached — stop the inner pass
			}
		}
		i = i + 1;
	}
}

/// Lists `path` within `timeout`, returning an owned, name-sorted snapshot.
///
/// **Explicit deadline (required by the stdlib IO contract).** `timeout` bounds
/// the wait; on expiry the call returns a `timeout` error promptly without
/// waiting for the underlying syscall to finish. A non-positive `timeout`
/// (`Duration(millis = 0)`) is an explicit "no deadline" — the VT parks until
/// the walk completes.
///
/// **VT-safe:** the entire directory walk (`open`, enumerate, UTF-8 validate,
/// `fstatat`, `close`) runs on **one** job on the runtime's shared
/// blocking-syscall pool while the calling virtual thread is **parked**, so a
/// stalling NFS/FUSE/autofs directory never blocks a carrier thread. The
/// snapshot is decoded and sorted in-memory after wakeup (no further syscalls).
///
/// **Determinism:** entries are sorted by name with the built-in `String`
/// ordering (deterministic unsigned-byte lexicographic, locale-independent).
/// `.` and `..` are excluded.
///
/// **Symlinks:** `DirEntry.kind` reflects the entry itself; a symlink is
/// `FileKind::Symlink`, never its target.
///
/// **Distinct error modes (`IoError.kind`):**
///   - `"errno"` — `opendir`/`readdir`/`closedir` failure (`code` = errno).
///   - `"invalid-utf8"` — an entry name was not valid UTF-8 (`code` = EILSEQ).
///   - `"timeout"` — the deadline expired before completion (`code` = ETIMEDOUT).
///   - `"cancelled"` — the calling VT was cancelled (`code` = ECANCELED).
///   - `"saturated"` — the blocking pool was full; runtime backpressure, retry
///     later (`code` = EAGAIN).
/// No partial listing is ever returned. A per-entry `fstatat` failure is **not**
/// a whole-call failure — it degrades that entry to `FileKind::Unknown`.
///
/// **Platform:** POSIX.
pub fn read_dir(path: String, timeout: conc.Duration) nothrow -> core.Result<Array<DirEntry>, io.IoError> {
	// Absolute monotonic-ms deadline (0 = no deadline).
	var deadline = 0;
	if timeout.millis > 0 {
		deadline = thread.now_ms() + timeout.millis;
	}
	val h = thread.fs_read_dir(path, deadline);

	// Negative sentinels carry no result handle — each a distinct failure mode.
	if h == RC_ENOMEM {
		return core.Result::Err(io.IoError(kind = io.IO_ERROR_KIND_ERRNO, code = ERRNO_ENOMEM));
	}
	if h == RC_SATURATED {
		return core.Result::Err(io.IoError(kind = io.IO_ERROR_KIND_SATURATED, code = ERRNO_EAGAIN));
	}
	if h == RC_TIMEDOUT {
		return core.Result::Err(io.IoError(kind = io.IO_ERROR_KIND_TIMEOUT, code = ERRNO_ETIMEDOUT));
	}
	if h == RC_CANCELLED {
		return core.Result::Err(io.IoError(kind = io.IO_ERROR_KIND_CANCELLED, code = ERRNO_ECANCELED));
	}

	// h >= 1: a result object (snapshot or resolved error). Always free it.
	val status = thread.fs_result_status(h);
	if status == STATUS_ERRNO {
		val e = thread.fs_result_errno(h);
		val _ = thread.fs_result_free(h);
		return core.Result::Err(io.IoError(kind = io.IO_ERROR_KIND_ERRNO, code = e));
	}
	if status == STATUS_UTF8 {
		val e = thread.fs_result_errno(h);
		val _ = thread.fs_result_free(h);
		return core.Result::Err(io.IoError(kind = io.IO_ERROR_KIND_INVALID_UTF8, code = e));
	}

	// status ok: decode the snapshot (pure in-memory accessor reads).
	var entries: Array<DirEntry> = [];
	val n = thread.fs_result_count(h);
	var i = 0;
	while i < n {
		val name = thread.fs_result_name(h, i);
		val kind = _kind_of(thread.fs_result_kind(h, i));
		entries.push(DirEntry(name = move name, kind = move kind));
		i = i + 1;
	}
	val _ = thread.fs_result_free(h);

	_sort_by_name(&mut entries);
	return core.Result::Ok(move entries);
}

// Read the whole file into an owned `Array<Byte>`, never exceeding `max_bytes`.
// One pooled blocking read per chunk; the running total is checked against the
// cap BEFORE each chunk is appended, so a file that grows past `max_bytes`
// during the read fails with a distinct `too-large` error rather than being
// silently truncated or over-allocating.  Does NOT close the file — the caller
// owns close-error precedence.  `max_bytes` is assumed already validated (>= 0).
fn _read_all_capped(f: &io.ConfiguredFile, max_bytes: Int) nothrow -> io.Result<Array<Byte>> {
	var acc: Array<Byte> = [];
	var total = 0;
	var buf = io.buffer(READ_CHUNK_BYTES);
	var more = true;
	while more {
		io.buffer_set_len(&mut buf, 0);
		val rr = f.read(&mut buf);
		match rr {
			core.Result::Ok(n) => {
				if n <= 0 {
					more = false;
				} else {
					// Cap check BEFORE appending (and before growing `acc`): a
					// breach — including a file that grew past the cap mid-read —
					// is a distinct `too-large`, never a truncated success.
					// Written in the non-overflowing form `n > max_bytes - total`
					// (NOT `total + n > max_bytes`, which could overflow on a
					// pathological stream): `max_bytes >= 0` and `total` only
					// advanced past previous successful cap checks, so
					// `max_bytes - total >= 0` and the subtraction never wraps.
					if n > max_bytes - total {
						return core.Result::Err(io.IoError(kind = io.IO_ERROR_KIND_TOO_LARGE, code = ERRNO_EFBIG));
					}
					var k = 0;
					while k < n {
						acc.push(io.buffer_read(&mut buf, k));
						k = k + 1;
					}
					total = total + n;
				}
			},
			core.Result::Err(e) => {
				return core.Result::Err(move e);
			}
		}
	}
	return core.Result::Ok(move acc);
}

/// Reads the entire file at `path` into an owned `Array<Byte>`, bounded by
/// `max_bytes` and `timeout`.
///
/// **Cap (`max_bytes`, mandatory, in bytes).**
///   - `max_bytes < 0` → `Err(IoError(kind = "invalid-argument"))` (`EINVAL`);
///     no file is opened.
///   - `max_bytes == 0` accepts ONLY an empty file; any content yields
///     `Err(kind = "too-large")`.
///   - If the file's content exceeds `max_bytes` — including a file that GROWS
///     past the cap while being read — the call fails with
///     `Err(kind = "too-large")` (`EFBIG`) instead of truncating.  (A
///     stat-based "fail before opening" fast path is not available without a new
///     runtime boundary; the cap is enforced per chunk during the read, so the
///     accumulator never exceeds `max_bytes`.)
///
/// **Deadline (`timeout`, required by the stdlib IO contract).** Bounds the
/// wait; there is no implicit unbounded wait.  Timeout / cancellation / pool
/// saturation surface as the underlying `io` read's `IoError` (`timeout` /
/// `cancelled` / `saturated` where the runtime distinguishes them, otherwise the
/// translated `errno`), consistent with `read_dir`.
///
/// **Error precedence.** A read or too-large failure WINS over a close failure
/// (the close result is discarded in that case).  If the read completes but the
/// final `close` fails, the close `IoError` is returned.
///
/// **VT-safe:** each chunk read parks the calling virtual thread on the shared
/// blocking pool.  Must be called from a virtual thread.
///
/// **Path-based whole-file helper;** opened-handle / streaming reads remain in
/// `std.io` (`file_builder`, `ConfiguredFile.read`).
///
/// **Platform:** POSIX.
pub fn read_to_bytes(path: String, max_bytes: Int, timeout: conc.Duration) nothrow -> io.Result<Array<Byte>> {
	if max_bytes < 0 {
		return core.Result::Err(io.IoError(kind = io.IO_ERROR_KIND_INVALID_ARGUMENT, code = ERRNO_EINVAL));
	}
	val br = io.file_builder(path).read(true).write(false).timeout(timeout).build();
	return match br {
		core.Result::Ok(f) => {
			val rr = _read_all_capped(&f, max_bytes);
			val cr = f.close();
			match rr {
				core.Result::Ok(bytes) => {
					// Read OK: a close failure now wins (nothing higher-priority).
					match cr {
						core.Result::Ok(_v) => { core.Result::Ok(move bytes) },
						core.Result::Err(ce) => { core.Result::Err(move ce) }
					}
				},
				// Read / too-large failure wins over any close error.
				core.Result::Err(re) => { core.Result::Err(move re) }
			}
		},
		core.Result::Err(e) => { core.Result::Err(move e) }
	};
}

/// Reads the entire file at `path` into an owned, UTF-8-validated `String`,
/// bounded by `max_bytes` (in bytes) and `timeout`.
///
/// Same cap, deadline, and VT-safety semantics as `read_to_bytes`.  After the
/// bytes are read, they are validated as UTF-8: invalid UTF-8 yields
/// `Err(IoError(kind = "invalid-utf8"))` (`EILSEQ`).  The returned `String` is
/// owned (self-releasing); it does not alias any IO buffer.
///
/// **Error precedence.** Read, too-large, and UTF-8 **decode** failures all win
/// over a close failure.  A close failure is returned only when the read AND
/// decode both succeeded.
///
/// **Platform:** POSIX.
pub fn read_to_string(path: String, max_bytes: Int, timeout: conc.Duration) nothrow -> io.Result<String> {
	if max_bytes < 0 {
		return core.Result::Err(io.IoError(kind = io.IO_ERROR_KIND_INVALID_ARGUMENT, code = ERRNO_EINVAL));
	}
	val br = io.file_builder(path).read(true).write(false).timeout(timeout).build();
	return match br {
		core.Result::Ok(f) => {
			val rr = _read_all_capped(&f, max_bytes);
			match rr {
				core.Result::Err(re) => {
					// Read / too-large failure wins; close result discarded.
					val _c1 = f.close();
					core.Result::Err(move re)
				},
				core.Result::Ok(bytes) => {
					match text.utf8_from_bytes(&bytes) {
						core.Result::Ok(s) => {
							// Read + decode OK: a close failure now wins.
							match f.close() {
								core.Result::Ok(_v) => { core.Result::Ok(move s) },
								core.Result::Err(ce) => { core.Result::Err(move ce) }
							}
						},
						// Decode failure wins over any close error.
						core.Result::Err(_ue) => {
							val _c2 = f.close();
							core.Result::Err(io.IoError(kind = io.IO_ERROR_KIND_INVALID_UTF8, code = ERRNO_EILSEQ))
						}
					}
				}
			}
		},
		core.Result::Err(e) => { core.Result::Err(move e) }
	};
}

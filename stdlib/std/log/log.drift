module std.log;

import std.core as core;
import std.containers as containers;
import std.concurrent as conc;
import std.format as format;
import std.io as io;
import std.iter as iter;
import std.mem as mem;
import std.meta as meta;
import std.runtime as runtime;
import std.sync as sync;
import std.time as time;
import lang.thread as thread;

use trait iter.SinglePassIterator;

export {
	Level,
	BackpressurePolicy,
	Sink,
	StdErrSink,
	stderr_sink,
	FormatterKind,
	Debuggable,
	Formatter,
	LogRecord,
	LogContext,
	LoggerConfig,
	LoggerConfigBuilder,
	Logger,
	LoggerBuilder,
	config_builder,
	log_context,
	create_logger,
	macro_debug,
	macro_info,
	macro_error
};

pub variant Level {
	Debug,
	Info,
	Error
}

pub variant BackpressurePolicy {
	BlockWithTimeout,
	DropOldest,
	DropNewest
}

pub interface Sink {
	fn write(self: &Self, rec: &LogRecord) nothrow -> Bool;
	fn flush(self: &Self, timeout_ms: Int) nothrow -> Bool;
}

pub struct StdErrSink {
}

pub variant FormatterKind {
	JsonIso8601,
	Custom(name: String),
	@tombstone Tombstone
}

pub trait Debuggable {
	fn to_debug(self: &Self) nothrow -> DiagnosticValue;
}

implement Debuggable for Int {
	pub fn to_debug(self: &Int) nothrow -> DiagnosticValue {
		return DiagnosticValue::Int(*self);
	}
}

implement Debuggable for Uint {
	pub fn to_debug(self: &Uint) nothrow -> DiagnosticValue {
		return DiagnosticValue::Int(*self);
	}
}

implement Debuggable for Bool {
	pub fn to_debug(self: &Bool) nothrow -> DiagnosticValue {
		return DiagnosticValue::Bool(*self);
	}
}

implement Debuggable for Float {
	pub fn to_debug(self: &Float) nothrow -> DiagnosticValue {
		return DiagnosticValue::Float(*self);
	}
}

implement Debuggable for String {
	pub fn to_debug(self: &String) nothrow -> DiagnosticValue {
		return DiagnosticValue::String(*self);
	}
}

implement Debuggable for DiagnosticValue {
	pub fn to_debug(self: &DiagnosticValue) nothrow -> DiagnosticValue {
		return *self;
	}
}

pub trait Formatter {
	fn format(self: &Self, rec: &LogRecord) nothrow -> String;
}

pub struct LogRecord {
	pub tm: String,
	pub ev: String,
	pub level: Level,
	pub logger: String,
	pub tid: Int,
	pub attrs_count: Int
}

pub struct LogContext {
	attrs: containers.HashMap<String, DiagnosticValue>
}

pub struct LoggerConfig {
	pub sink: Sink,
	pub min_level: Level,
	pub queue_capacity: Int,
	pub write_timeout: conc.Duration,
	pub enqueue_timeout: conc.Duration,
	pub backpressure_policy: BackpressurePolicy,
	pub formatter: FormatterKind
}

pub struct LoggerConfigBuilder {
	sink: Sink,
	min_level: Level,
	queue_capacity: Int,
	write_timeout: conc.Duration,
	enqueue_timeout: conc.Duration,
	backpressure_policy: BackpressurePolicy,
	formatter: FormatterKind
}

pub struct Logger {
	name: String,
	min_level: Level,
	state: sync.Handle<Byte>
}

struct LoggerRuntimeState {
	min_level: Level,
	queue_capacity: Int,
	write_timeout_ms: Int,
	enqueue_timeout_ms: Int,
	backpressure_policy: BackpressurePolicy,
	stderr_cap: Optional<io.ProcessStderrCapability>,
	queue: sync.MpscQueue<Byte>,
	drain_lock: sync.AtomicBool
}

struct LogEnvelope {
	level_rank: Int,
	logger_min_rank: Int,
	enqueue_timeout_ms: Int,
	payload_json: String
}

pub struct LoggerBuilder {
	parent_state: sync.Handle<Byte>,
	parent_min_level: Level,
	name: String,
	min_level: Optional<Level>
}

implement core.Copy for Level {
}

implement core.Copy for BackpressurePolicy {
}

implement core.Copy for FormatterKind {
}

implement core.Copy for LoggerConfig {
}

implement core.Copy for StdErrSink {
}

implement Sink for StdErrSink {
	pub fn write(self: &StdErrSink, rec: &LogRecord) nothrow -> Bool {
		val _ = self;
		val _ = rec;
		return true;
	}

	pub fn flush(self: &StdErrSink, timeout_ms: Int) nothrow -> Bool {
		val _ = self;
		val _ = timeout_ms;
		return true;
	}
}

pub fn stderr_sink() nothrow -> StdErrSink {
	return StdErrSink();
}

pub fn config_builder() nothrow -> LoggerConfigBuilder {
	return LoggerConfigBuilder(
		sink = stderr_sink(),
		min_level = Level::Info(),
		queue_capacity = 1024,
		write_timeout = conc.Duration(millis = 1000),
		enqueue_timeout = conc.Duration(millis = 1000),
		backpressure_policy = BackpressurePolicy::BlockWithTimeout(),
		formatter = FormatterKind::JsonIso8601()
	);
}

pub fn log_context() nothrow -> LogContext {
	var attrs: containers.HashMap<String, DiagnosticValue> = {:};
	return LogContext(attrs = move attrs);
}

implement LogContext {
	pub fn put<V>(self: &mut LogContext, key: String, value: V) nothrow -> Void require V is Debuggable {
		val dv = Debuggable::to_debug(&value);
		match self.attrs.insert(move key, dv) {
			Some(old) => {
				core.drop_value(move old);
			},
			None => {
			}
		}
		core.drop_value(move value);
		return;
	}

	pub fn get(self: &LogContext, key: &String) nothrow -> Optional<&DiagnosticValue> {
		return self.attrs.get(key);
	}

	pub fn clear(self: &mut LogContext) nothrow -> Void {
		self.attrs.clear();
	}
}

implement LoggerConfigBuilder {
	pub fn sink(self: &mut LoggerConfigBuilder, sink: Sink) nothrow -> &mut LoggerConfigBuilder {
		self.sink = move sink;
		return self;
	}

	pub fn min_level(self: &mut LoggerConfigBuilder, var v: Level) nothrow -> &mut LoggerConfigBuilder {
		self.min_level = move v;
		return self;
	}

	pub fn queue_capacity(self: &mut LoggerConfigBuilder, v: Int) nothrow -> &mut LoggerConfigBuilder {
		self.queue_capacity = v;
		return self;
	}

	pub fn write_timeout(self: &mut LoggerConfigBuilder, v: conc.Duration) nothrow -> &mut LoggerConfigBuilder {
		self.write_timeout = v;
		return self;
	}

	pub fn enqueue_timeout(self: &mut LoggerConfigBuilder, v: conc.Duration) nothrow -> &mut LoggerConfigBuilder {
		self.enqueue_timeout = v;
		return self;
	}

	pub fn backpressure_policy(self: &mut LoggerConfigBuilder, var v: BackpressurePolicy) nothrow -> &mut LoggerConfigBuilder {
		self.backpressure_policy = move v;
		return self;
	}

	pub fn formatter(self: &mut LoggerConfigBuilder, var v: FormatterKind) nothrow -> &mut LoggerConfigBuilder {
		self.formatter = move v;
		return self;
	}

	pub fn build(self: &LoggerConfigBuilder) nothrow -> LoggerConfig {
		return LoggerConfig(
			sink = self.sink,
			min_level = self.min_level,
			queue_capacity = self.queue_capacity,
			write_timeout = self.write_timeout,
			enqueue_timeout = self.enqueue_timeout,
			backpressure_policy = self.backpressure_policy,
			formatter = self.formatter
		);
	}
}

pub fn create_logger(name: String, config: LoggerConfig) nothrow -> Logger {
	val reg = runtime.global_registry();
	val _ = io.install_process_stdio(reg);
	val st = _runtime_state_from_cfg(&config, _resolve_stderr_cap(reg));
	val h = _alloc_runtime_state(st);
	return Logger(name = name, min_level = config.min_level, state = h);
}

fn _level_rank(level: Level) nothrow -> Int {
	return match level {
		Debug => {
			0
		},
		Info => {
			1
		},
		Error => {
			2
		}
	};
}

fn _level_from_rank(rank: Int) nothrow -> Level {
	if rank <= 0 {
		return Level::Debug();
	}
	if rank == 1 {
		return Level::Info();
	}
	return Level::Error();
}

fn _backpressure_code(var policy: BackpressurePolicy) nothrow -> Int {
	return match policy {
		BlockWithTimeout => {
			0
		},
		DropOldest => {
			1
		},
		DropNewest => {
			2
		}
	};
}

fn _resolve_stderr_cap(reg: &runtime.GlobalRegistry) nothrow -> Optional<io.ProcessStderrCapability> {
	match runtime.get<type io.ProcessStderrCapability>(reg) {
		Some(cap) => {
			return Optional<io.ProcessStderrCapability>::Some(*cap);
		},
		None => {
			return Optional<io.ProcessStderrCapability>::None();
		}
	}
}

fn _runtime_state_from_cfg(cfg: &LoggerConfig, stderr_cap: Optional<io.ProcessStderrCapability>) nothrow -> LoggerRuntimeState {
	return LoggerRuntimeState(
		min_level = cfg.min_level,
		queue_capacity = cfg.queue_capacity,
		write_timeout_ms = cfg.write_timeout.millis,
		enqueue_timeout_ms = cfg.enqueue_timeout.millis,
		backpressure_policy = cfg.backpressure_policy,
		stderr_cap = stderr_cap,
		queue = sync.mpsc_queue<type Byte>(cfg.queue_capacity),
		drain_lock = sync.atomic_bool(false)
	);
}

fn _clone_runtime_state(st: &LoggerRuntimeState, min_level: Level) nothrow -> LoggerRuntimeState {
	return LoggerRuntimeState(
		min_level = min_level,
		queue_capacity = st.queue_capacity,
		write_timeout_ms = st.write_timeout_ms,
		enqueue_timeout_ms = st.enqueue_timeout_ms,
		backpressure_policy = st.backpressure_policy,
		stderr_cap = st.stderr_cap,
		queue = sync.mpsc_queue<type Byte>(st.queue_capacity),
		drain_lock = sync.atomic_bool(false)
	);
}

fn _alloc_runtime_state(st: LoggerRuntimeState) nothrow -> sync.Handle<Byte> {
	unsafe {
		var raw = mem.alloc_uninit<type LoggerRuntimeState>(1);
		mem.write<type LoggerRuntimeState>(&mut raw, 0, move st);
		val p = mem.rawbuffer_ptr<type LoggerRuntimeState>(&raw);
		return sync.handle<type Byte>(cast<Uint>(p));
	}
}

fn _runtime_state_from_handle(h: sync.Handle<Byte>) nothrow -> Optional<&LoggerRuntimeState> {
	if h.is_null() {
		return Optional<&LoggerRuntimeState>::None();
	}
	unsafe {
		val p = cast<mem.Ptr<LoggerRuntimeState> >(h.to_uint());
		return Optional<&LoggerRuntimeState>::Some(p);
	}
}

fn _enabled(min_level: Level, event_level: Level) nothrow -> Bool {
	if _level_rank(event_level) >= _level_rank(min_level) {
		return true;
	}
	return false;
}

fn _alloc_envelope(level_rank: Int, logger_min_rank: Int, enqueue_timeout_ms: Int, payload_json: String) -> sync.Handle<Byte> {
	unsafe {
		var raw = mem.alloc_uninit<type LogEnvelope>(1);
		val env = LogEnvelope(level_rank = level_rank, logger_min_rank = logger_min_rank, enqueue_timeout_ms = enqueue_timeout_ms, payload_json = payload_json);
		mem.write<type LogEnvelope>(&mut raw, 0, move env);
		val p = mem.rawbuffer_ptr<type LogEnvelope>(&raw);
		val u = cast<Uint>(p);
		return sync.handle<type Byte>(u);
	}
}

fn _drop_envelope_handle(h: sync.Handle<Byte>) nothrow -> Void {
	if h.is_null() {
		return;
	}
	unsafe {
		val p = cast<mem.Ptr<Byte> >(h.to_uint());
		var raw = mem.rawbuffer_from_parts<type LogEnvelope>(p, 1);
		val env = mem.read<type LogEnvelope>(&mut raw, 0);
		core.drop_value(move env);
		mem.dealloc<type LogEnvelope>(raw);
	}
	return;
}

fn _emit_envelope_handle(st: &LoggerRuntimeState, h: sync.Handle<Byte>) nothrow -> Bool {
	if h.is_null() {
		return false;
	}
	unsafe {
		val p = cast<mem.Ptr<Byte> >(h.to_uint());
		var raw = mem.rawbuffer_from_parts<type LogEnvelope>(p, 1);
		val env = mem.read<type LogEnvelope>(&mut raw, 0);
		val tm = time.format_iso8601_utc(&time.now_utc());
		val tid = thread.vt_current();
		val line = "{\"tm\":\"" + _json_escape(tm) + "\",\"level\":\"" + _level_text_from_rank(env.level_rank) + "\"," + env.payload_json + ",\"tid\":" + format.format_int(tid) + "}";
		val _ = _sink_write_line(st, line);
		core.drop_value(move env);
		mem.dealloc<type LogEnvelope>(raw);
		return true;
	}
}

fn _sink_write_line(st: &LoggerRuntimeState, line: String) nothrow -> Bool {
	match st.stderr_cap {
		Some(cap) => {
			return cap.write_line(line);
		},
		None => {
			val _ = st;
			val _ = line;
			return false;
		}
	}
}

fn _drain_locked(st: &LoggerRuntimeState) nothrow -> Void {
	while true {
		match st.queue.pop() {
			Some(h) => {
				val _ = _emit_envelope_handle(st, h);
			},
			None => {
				break;
			}
		}
	}
	return;
}

fn _try_drain_once_owner(st: &LoggerRuntimeState) nothrow -> Void {
	if st.drain_lock.compare_exchange(false, true, sync.MemoryOrder::AcqRel(), sync.MemoryOrder::Acquire()) {
		_drain_locked(st);
		st.drain_lock.store(false, sync.MemoryOrder::Release());
	}
	return;
}

fn _flush_state(st: &LoggerRuntimeState, timeout_ms: Int) nothrow -> Void {
	val deadline = thread.now_ms() + timeout_ms;
	var acquired = false;
	while thread.now_ms() <= deadline {
		if st.drain_lock.compare_exchange(false, true, sync.MemoryOrder::AcqRel(), sync.MemoryOrder::Acquire()) {
			acquired = true;
			break;
		}
	}
	if acquired {
		_drain_locked(st);
		st.drain_lock.store(false, sync.MemoryOrder::Release());
	}
	return;
}

fn _enqueue_with_policy(st: &LoggerRuntimeState, h: sync.Handle<Byte>) nothrow -> Bool {
	if st.queue.push(h) {
		return true;
	}
	match st.backpressure_policy {
		DropNewest => {
			_drop_envelope_handle(h);
			return false;
		},
		DropOldest => {
			match st.queue.pop() {
				Some(old) => {
					_drop_envelope_handle(old);
				},
				None => {
				}
			}
			if st.queue.push(h) {
				return true;
			}
			_drop_envelope_handle(h);
			return false;
		},
		BlockWithTimeout => {
			if st.enqueue_timeout_ms <= 0 {
				_drop_envelope_handle(h);
				return false;
			}
			val deadline = thread.now_ms() + st.enqueue_timeout_ms;
			var pushed = false;
			while thread.now_ms() <= deadline {
				if st.queue.push(h) {
					pushed = true;
					break;
				}
				_try_drain_once_owner(st);
			}
			if not pushed {
				_drop_envelope_handle(h);
			}
			return pushed;
		}
	}
	return false;
}

fn _emit<V>(logger: &Logger, var level: Level, ev: String, attrs: containers.HashMap<String, V>) nothrow -> Bool require V is Debuggable {
	if not _enabled(logger.min_level, level) {
		core.drop_value(move attrs);
		return false;
	}
	val ok = try _emit_throwing<type V>(logger, level, ev, &attrs) catch { false };
	core.drop_value(move attrs);
	return ok;
}

fn _emit_ctx(logger: &Logger, var level: Level, ev: String, ctx: &LogContext) nothrow -> Bool {
	if not _enabled(logger.min_level, level) {
		return false;
	}
	return try _emit_ctx_throwing(logger, level, ev, ctx) catch { false };
}

fn _emit_no_attrs(logger: &Logger, var level: Level, ev: String) nothrow -> Bool {
	if not _enabled(logger.min_level, level) {
		return false;
	}
	return try _emit_no_attrs_throwing(logger, level, ev) catch { false };
}

fn _emit_ctx_attrs(logger: &Logger, var level: Level, ev: String, ctx: &LogContext, attrs: containers.HashMap<String, DiagnosticValue>) nothrow -> Bool {
	if not _enabled(logger.min_level, level) {
		core.drop_value(move attrs);
		return false;
	}
	val ok = try _emit_ctx_attrs_throwing(logger, level, ev, ctx, &attrs) catch { false };
	core.drop_value(move attrs);
	return ok;
}

fn _emit_throwing<V>(logger: &Logger, var level: Level, ev: String, attrs: &containers.HashMap<String, V>) -> Bool require V is Debuggable {
	val payload = _payload_json<type V>(logger, ev, attrs);
	return _emit_payload_throwing(logger, level, payload);
}

fn _emit_ctx_throwing(logger: &Logger, var level: Level, ev: String, ctx: &LogContext) -> Bool {
	val payload = _payload_json_ctx(logger, ev, ctx);
	return _emit_payload_throwing(logger, level, payload);
}

fn _emit_no_attrs_throwing(logger: &Logger, var level: Level, ev: String) -> Bool {
	val payload = _payload_json_no_attrs(logger, ev);
	return _emit_payload_throwing(logger, level, payload);
}

fn _emit_ctx_attrs_throwing(logger: &Logger, var level: Level, ev: String, ctx: &LogContext, attrs: &containers.HashMap<String, DiagnosticValue>) -> Bool {
	val payload = _payload_json_ctx_attrs(logger, ev, ctx, attrs);
	return _emit_payload_throwing(logger, level, payload);
}

fn _emit_payload_throwing(logger: &Logger, var level: Level, payload: String) -> Bool {
	match _runtime_state_from_handle(logger.state) {
		Some(st) => {
			val h = _alloc_envelope(_level_rank(level), _level_rank(logger.min_level), st.enqueue_timeout_ms, payload);
			if not _enqueue_with_policy(st, h) {
				return false;
			}
			_try_drain_once_owner(st);
			return true;
		},
		None => {
			val _ = level;
			val _ = payload;
			return false;
		}
	}
}

fn _attrs_json<V>(attrs: &containers.HashMap<String, V>) -> String require V is Debuggable {
	var out = "{";
	var first = true;
	var it = attrs.iter();
	while true {
		val next = it.next();
		match next {
			Some(item) => {
				if not first {
					out = out + ",";
				}
				first = false;
				val key = _json_escape(*item.key);
				val dv = Debuggable::to_debug(item.value);
				val value_json = _dv_json(&dv);
				out = out + "\"" + key + "\":" + value_json;
			},
			None => {
				break;
			}
		}
	}
	return out + "}";
}

fn _payload_json<V>(logger: &Logger, ev: String, attrs: &containers.HashMap<String, V>) -> String require V is Debuggable {
	val ev_json = _json_escape(ev);
	val logger_json = _json_escape(logger.name);
	val attrs_json = _attrs_json<type V>(attrs);
	return "\"ev\":\"" + ev_json + "\",\"logger\":\"" + logger_json + "\",\"attrs\":" + attrs_json;
}

fn _ctx_attrs_json(ctx: &LogContext) -> String {
	var out = "{";
	var first = true;
	var it = ctx.attrs.iter();
	while true {
		val next = it.next();
		match next {
			Some(item) => {
				if not first {
					out = out + ",";
				}
				first = false;
				val key = _json_escape(*item.key);
				val value_json = _dv_json(item.value);
				out = out + "\"" + key + "\":" + value_json;
			},
			None => {
				break;
			}
		}
	}
	return out + "}";
}

fn _ctx_attrs_json_merged(ctx: &LogContext, attrs: &containers.HashMap<String, DiagnosticValue>) -> String {
	var out = "{";
	var first = true;
	var it_ctx = ctx.attrs.iter();
	while true {
		val next = it_ctx.next();
		match next {
			Some(item) => {
				if attrs.contains_key(item.key) {
					continue;
				}
				if not first {
					out = out + ",";
				}
				first = false;
				val key = _json_escape(*item.key);
				val value_json = _dv_json(item.value);
				out = out + "\"" + key + "\":" + value_json;
			},
			None => {
				break;
			}
		}
	}
	var it_attrs = attrs.iter();
	while true {
		val next = it_attrs.next();
		match next {
			Some(item) => {
				if not first {
					out = out + ",";
				}
				first = false;
				val key = _json_escape(*item.key);
				val value_json = _dv_json(item.value);
				out = out + "\"" + key + "\":" + value_json;
			},
			None => {
				break;
			}
		}
	}
	return out + "}";
}

fn _payload_json_no_attrs(logger: &Logger, ev: String) -> String {
	val ev_json = _json_escape(ev);
	val logger_json = _json_escape(logger.name);
	return "\"ev\":\"" + ev_json + "\",\"logger\":\"" + logger_json + "\",\"attrs\":{}";
}

fn _payload_json_ctx(logger: &Logger, ev: String, ctx: &LogContext) -> String {
	val ev_json = _json_escape(ev);
	val logger_json = _json_escape(logger.name);
	val attrs_json = _ctx_attrs_json(ctx);
	return "\"ev\":\"" + ev_json + "\",\"logger\":\"" + logger_json + "\",\"attrs\":" + attrs_json;
}

fn _payload_json_ctx_attrs(logger: &Logger, ev: String, ctx: &LogContext, attrs: &containers.HashMap<String, DiagnosticValue>) -> String {
	val ev_json = _json_escape(ev);
	val logger_json = _json_escape(logger.name);
	val attrs_json = _ctx_attrs_json_merged(ctx, attrs);
	return "\"ev\":\"" + ev_json + "\",\"logger\":\"" + logger_json + "\",\"attrs\":" + attrs_json;
}

implement Logger {
	pub fn name(self: &Logger) nothrow -> String {
		return self.name;
	}

	pub fn min_level(self: &Logger) nothrow -> Level {
		return self.min_level;
	}

	pub fn with_min_level(self: &Logger, var level: Level) nothrow -> Logger {
		match _runtime_state_from_handle(self.state) {
			Some(st) => {
				val next = _clone_runtime_state(st, level);
				val h = _alloc_runtime_state(next);
				return Logger(name = self.name, min_level = level, state = h);
			},
			None => {
				return Logger(name = self.name, min_level = level, state = sync.null_handle<type Byte>());
			}
		}
	}

	pub fn derive(self: &Logger, name: String) nothrow -> LoggerBuilder {
		return LoggerBuilder(parent_state = self.state, parent_min_level = self.min_level, name = name, min_level = Optional<Level>::None());
	}

	pub fn flush(self: &Logger, timeout: conc.Duration) nothrow -> Bool {
		match _runtime_state_from_handle(self.state) {
			Some(st) => {
				_flush_state(st, timeout.millis);
			},
			None => {
			}
		}
		return true;
	}

	pub fn debug<V>(self: &Logger, ev: String, attrs: containers.HashMap<String, V>) nothrow -> Bool require V is Debuggable {
		return _emit(self, Level::Debug(), ev, move attrs);
	}

	pub fn debug(self: &Logger, ev: String) nothrow -> Bool {
		return _emit_no_attrs(self, Level::Debug(), ev);
	}

	pub fn debug_ctx(self: &Logger, ev: String, ctx: &LogContext) nothrow -> Bool {
		return _emit_ctx(self, Level::Debug(), ev, ctx);
	}

	pub fn debug_ctx_attrs(self: &Logger, ev: String, ctx: &LogContext, attrs: containers.HashMap<String, DiagnosticValue>) nothrow -> Bool {
		return _emit_ctx_attrs(self, Level::Debug(), ev, ctx, move attrs);
	}

	pub fn info<V>(self: &Logger, ev: String, attrs: containers.HashMap<String, V>) nothrow -> Bool require V is Debuggable {
		return _emit(self, Level::Info(), ev, move attrs);
	}

	pub fn info(self: &Logger, ev: String) nothrow -> Bool {
		return _emit_no_attrs(self, Level::Info(), ev);
	}

	pub fn info_ctx(self: &Logger, ev: String, ctx: &LogContext) nothrow -> Bool {
		return _emit_ctx(self, Level::Info(), ev, ctx);
	}

	pub fn info_ctx_attrs(self: &Logger, ev: String, ctx: &LogContext, attrs: containers.HashMap<String, DiagnosticValue>) nothrow -> Bool {
		return _emit_ctx_attrs(self, Level::Info(), ev, ctx, move attrs);
	}

	pub fn error<V>(self: &Logger, ev: String, attrs: containers.HashMap<String, V>) nothrow -> Bool require V is Debuggable {
		return _emit(self, Level::Error(), ev, move attrs);
	}

	pub fn error(self: &Logger, ev: String) nothrow -> Bool {
		return _emit_no_attrs(self, Level::Error(), ev);
	}

	pub fn error_ctx(self: &Logger, ev: String, ctx: &LogContext) nothrow -> Bool {
		return _emit_ctx(self, Level::Error(), ev, ctx);
	}

	pub fn error_ctx_attrs(self: &Logger, ev: String, ctx: &LogContext, attrs: containers.HashMap<String, DiagnosticValue>) nothrow -> Bool {
		return _emit_ctx_attrs(self, Level::Error(), ev, ctx, move attrs);
	}
}

implement LoggerBuilder {
	pub fn name(self: &mut LoggerBuilder, name: String) nothrow -> &mut LoggerBuilder {
		self.name = name;
		return self;
	}

	pub fn min_level(self: &mut LoggerBuilder, var level: Level) nothrow -> &mut LoggerBuilder {
		self.min_level = Optional::Some(move level);
		return self;
	}

	pub fn build(self: &LoggerBuilder) nothrow -> Logger {
		val min = match self.min_level {
			Some(level) => {
				level
			},
			None => {
				self.parent_min_level
			}
		};
		match _runtime_state_from_handle(self.parent_state) {
			Some(st) => {
				val next = _clone_runtime_state(st, min);
				val h = _alloc_runtime_state(next);
				return Logger(name = self.name, min_level = min, state = h);
			},
			None => {
				return Logger(name = self.name, min_level = min, state = sync.null_handle<type Byte>());
			}
		}
	}
}

implement core.Destructible for Logger {
	pub fn destroy(var self: Logger) nothrow -> Void {
		if self.state.is_null() {
			return;
		}
		unsafe {
			val p = cast<mem.Ptr<Byte> >(self.state.to_uint());
			var raw = mem.rawbuffer_from_parts<type LoggerRuntimeState>(p, 1);
			val st = mem.read<type LoggerRuntimeState>(&mut raw, 0);
			core.drop_value(move st);
			mem.dealloc<type LoggerRuntimeState>(raw);
		}
		return;
	}
}

fn _level_text(level: Level) nothrow -> String {
	return match level {
		Debug => { "debug" },
		Info => { "info" },
		Error => { "error" }
	};
}

fn _level_text_from_rank(rank: Int) nothrow -> String {
	return _level_text(_level_from_rank(rank));
}

fn _hex_digit(v: Int) nothrow -> String {
	if v <= 9 {
		return format.format_int(v);
	}
	if v == 10 { return "A"; }
	if v == 11 { return "B"; }
	if v == 12 { return "C"; }
	if v == 13 { return "D"; }
	if v == 14 { return "E"; }
	return "F";
}

fn _byte_hex2(b: Byte) nothrow -> String {
	val v = cast<Int>(b);
	val hi = v / 16;
	val lo = v % 16;
	return _hex_digit(hi) + _hex_digit(lo);
}

fn _byte_to_string(b: Byte) nothrow -> String {
	unsafe {
		var raw = mem.alloc_uninit<type Byte>(1);
		mem.write<type Byte>(&mut raw, 0, b);
		val out = core.string_from_utf8_bytes(mem.rawbuffer_ptr<type Byte>(&raw), 1);
		mem.dealloc<type Byte>(raw);
		return out;
	}
}

fn _json_escape(s: String) nothrow -> String {
	var out = "";
	var i = 0;
	val n = s.byte_length();
	while i < n {
		val b = core.string_byte_at(&s, i);
		if b == cast<Byte>(34) {
			out = out + "\\\"";
		} else {
			if b == cast<Byte>(92) {
				out = out + "\\\\";
			} else {
				if b == cast<Byte>(10) {
					out = out + "\\n";
				} else {
					if b == cast<Byte>(13) {
						out = out + "\\r";
					} else {
						if b == cast<Byte>(9) {
							out = out + "\\t";
						} else {
							if b < cast<Byte>(32) {
								out = out + "\\u00" + _byte_hex2(b);
							} else {
								out = out + _byte_to_string(b);
							}
						}
					}
				}
			}
		}
		i = i + 1;
	}
	return out;
}

fn _dv_json(dv: &DiagnosticValue) nothrow -> String {
	match dv.as_bool() {
		Some(v) => {
			if v {
				return "true";
			}
			return "false";
		},
		None => {
		}
	}
	match dv.as_int() {
		Some(v) => {
			return format.format_int(v);
		},
		None => {
		}
	}
	match dv.as_float() {
		Some(v) => {
			return format.format_float(v);
		},
		None => {
		}
	}
	match dv.as_string() {
		Some(v) => {
			return "\"" + _json_escape(v) + "\"";
		},
		None => {
		}
	}
	match dv.as_object() {
		Some(_) => {
			return "{}";
		},
		None => {
		}
	}
	return "null";
}

pub fn macro_debug(logger: &Logger, ev: String, src: meta.Caller) nothrow -> Bool {
	val _ = move src;
	return logger.debug(ev);
}

pub fn macro_debug(logger: &Logger, ev: String, ctx: &LogContext, src: meta.Caller) nothrow -> Bool {
	val _ = move src;
	return logger.debug_ctx(ev, ctx);
}

pub fn macro_debug(logger: &Logger, ev: String, ctx: &LogContext, attrs: containers.HashMap<String, DiagnosticValue>, src: meta.Caller) nothrow -> Bool {
	val _ = move src;
	return logger.debug_ctx_attrs(ev, ctx, move attrs);
}

pub fn macro_debug<V>(logger: &Logger, ev: String, attrs: containers.HashMap<String, V>, src: meta.Caller) nothrow -> Bool require V is Debuggable {
	val _ = move src;
	return logger.debug(ev, move attrs);
}


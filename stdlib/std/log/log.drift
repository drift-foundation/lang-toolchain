module std.log;

import std.core as core;
import std.containers as containers;
import std.concurrent as conc;
import std.format as format;
import std.io as io;
import std.iter as iter;
import std.mem as mem;
import std.meta as meta;
import std.runtime as runtime;
import std.sync as sync;
import std.time as time;
import lang.thread as thread;

use trait iter.SinglePassIterator;

export {
	Level,
	BackpressurePolicy,
	Sink,
	StdErrSink,
	stderr_sink,
	FormatterKind,
	Debuggable,
	Formatter,
	LogRecord,
	LogContext,
	ContextResolver,
	NoContextResolver,
	LoggerConfig,
	LoggerConfigBuilder,
	Logger,
	LoggerBuilder,
	config_builder,
	log_context,
	create_logger,
	macro_debug,
	macro_info,
	macro_error
};

/// Severity level of a log event.
///
/// Total order: `Debug < Info < Error`.  A logger with `min_level =
/// Info` accepts `Info` and `Error` events and silently drops `Debug`
/// events at the call site.
///
/// **See also:** `LoggerConfigBuilder.min_level`, `Logger.min_level`.
pub variant Level {
	Debug,
	Info,
	Error
}

/// Policy controlling what the logger does when its in-memory queue
/// is full.
///
/// `BlockWithTimeout` — submitter blocks up to `enqueue_timeout`
/// before dropping the event silently.  `DropOldest` — evict the
/// oldest queued event to make room.  `DropNewest` — discard the
/// incoming event.  Note: under the current logging contract, the
/// drop is not observable at the call site (logging methods return
/// `Void`).
///
/// **See also:** `LoggerConfigBuilder.backpressure_policy`,
/// `LoggerConfigBuilder.enqueue_timeout`.
pub variant BackpressurePolicy {
	BlockWithTimeout,
	DropOldest,
	DropNewest
}

/// Interface implemented by log destinations.
///
/// Implementations receive formatted records from the logger's drain
/// thread.  The default `StdErrSink` writes to the process's
/// standard-error fd through the runtime registry.  Custom sinks can
/// route records elsewhere (file, network, ring buffer, etc.).
///
/// **See also:** `StdErrSink`, `Formatter`,
/// `LoggerConfigBuilder.sink`.
pub interface Sink {
	fn write(self: &Self, rec: &LogRecord) nothrow -> Bool;
	fn flush(self: &Self, timeout_ms: Int) nothrow -> Bool;
}

/// Default `Sink` implementation that writes to standard error.
///
/// Constructed via `stderr_sink()`.  Routes log lines through the
/// process-wide `ProcessStderrCapability` installed by
/// `io.install_process_stdio` (or auto-installed by `create_logger`).
///
/// **See also:** `stderr_sink`, `Sink`.
pub struct StdErrSink {
}

/// Formatter selection for the logger's output encoding.
///
/// `JsonIso8601` — line-delimited JSON with ISO-8601 timestamps; the
/// default and the only fully-supported format today.  `Custom(name)`
/// — reserved for future pluggable formatters; `name` identifies the
/// implementation by tag.
///
/// **See also:** `LoggerConfigBuilder.formatter`, `Formatter`.
pub variant FormatterKind {
	JsonIso8601,
	Custom(name: String),
	@tombstone Tombstone
}

/// Trait implemented by types that can appear as log-attribute
/// values.
///
/// `to_debug_json_text` projects the value into its canonical JSON
/// text form (a single JSON value: number, string, bool, or `null`).
/// `Int`, `Uint`, `Bool`, `Float`, and `String` ship with default
/// impls that delegate to the corresponding `core.diagnostic_json_*`
/// helpers.  Implement for user types to log them as attribute values
/// in the typed `info` / `debug` / `error` overloads.
///
/// **See also:** `Logger.info`, `Logger.debug`, `Logger.error`,
/// `LogContext.put`.
pub trait Debuggable {
	fn to_debug_json_text(self: &Self) nothrow -> String;
}

implement Debuggable for Int {
	pub fn to_debug_json_text(self: &Int) nothrow -> String {
		return core.diagnostic_json_int(*self);
	}
}

implement Debuggable for Uint {
	pub fn to_debug_json_text(self: &Uint) nothrow -> String {
		return core.diagnostic_json_uint(*self);
	}
}

implement Debuggable for Bool {
	pub fn to_debug_json_text(self: &Bool) nothrow -> String {
		return core.diagnostic_json_bool(*self);
	}
}

implement Debuggable for Float {
	pub fn to_debug_json_text(self: &Float) nothrow -> String {
		return core.diagnostic_json_float(*self);
	}
}

implement Debuggable for String {
	pub fn to_debug_json_text(self: &String) nothrow -> String {
		return core.diagnostic_json_string(self);
	}
}

/// Interface for custom log-record formatters.
///
/// Implementations turn a `LogRecord` into the bytes that the sink
/// will emit.  Used together with `FormatterKind::Custom(name)` to
/// register pluggable formatters.  Reserved for future use; the
/// default `JsonIso8601` formatter is currently selected directly by
/// the runtime.
///
/// **See also:** `FormatterKind`, `LogRecord`.
pub trait Formatter {
	fn format(self: &Self, rec: &LogRecord) nothrow -> String;
}

/// Single log record handed to a `Sink` (and optionally a
/// `Formatter`).
///
/// `tm` is the ISO-8601 timestamp; `ev` is the event name; `level`
/// is the severity; `logger` is the logger's name; `vtid` and `ptid`
/// are virtual-thread and OS-thread identifiers; `attrs_count`
/// reports the number of attribute key/value pairs in the record's
/// payload.
///
/// Field naming matches the JSON wire format produced by the default
/// formatter (`tm`, `ev`, `level`, `logger`, `vtid`, `ptid`,
/// `attrs`).
///
/// **See also:** `Sink.write`, `Formatter.format`.
pub struct LogRecord {
	pub tm: String,
	pub ev: String,
	pub level: Level,
	pub logger: String,
	pub vtid: Int,
	pub ptid: Int,
	pub attrs_count: Int
}

/// Mutable bag of attribute key/value pairs that can be attached to
/// log calls.
///
/// Construct via `log_context()`.  Use `.put(key, value)` to
/// accumulate attributes (any type implementing `Debuggable`) and
/// pass `&ctx` to `Logger.info(ev, ctx)` (or the `debug` / `error`
/// counterparts).  Passing an explicit `&LogContext` suppresses the
/// configured context resolver for that call; pass
/// `&log.log_context()` (an empty context) to force "no context" on
/// a single call.
///
/// When combined with attribute overrides via the three-arg
/// `Logger.info(ev, ctx, attrs)` form, the override values take
/// precedence over those carried by the context.
///
/// Typically pushed onto a `runtime.ScopedStack<LogContext>` so a
/// scope can establish ambient attributes that nested calls inherit.
///
/// **See also:** `log_context`, `LogContext.put`,
/// `Logger.info(ev, ctx)`, `LoggerConfigBuilder.context_resolver`.
pub struct LogContext {
	attrs: containers.HashMap<String, String>
}

/// Application-supplied service consulted by the logger to resolve
/// ambient context at emit time.
///
/// `ContextResolver` is an interface with a single `nothrow` method
/// `resolve(&self) -> Optional<&LogContext>`.  When installed via
/// `LoggerConfigBuilder.context_resolver`, calls to `Logger.info(ev)`
/// / `Logger.info(ev, attrs)` (and the `debug` / `error`
/// counterparts) dispatch through this interface per emit; if
/// `resolve` returns `Some(ctx)`, `ctx`'s attributes are merged into
/// the record.  Calls that pass an explicit `&LogContext` skip the
/// resolver.
///
/// The return is borrowed.  The logger reads the borrowed context
/// synchronously during record formatting, serializes its attrs into
/// the owned `payload_json` string stored in the queued `LogEnvelope`,
/// and does not retain the borrow after enqueue or after the emit
/// call returns.  The queue never holds a `&LogContext`; by the time
/// the drain worker consumes the envelope, the borrow's backing
/// storage may be anywhere.  Resolvers hold the backing `LogContext`
/// somewhere addressable from `&self` or from process/thread-global
/// state (registry, scoped stack) and return a borrow into that
/// storage.  No per-emit allocation is required; `LogContext.clone`
/// is not needed for the resolver path.
///
/// `std.log` deliberately knows nothing about how a resolver
/// discovers context — VT-local registry, request state,
/// thread-local — that is all app policy inside the implementation.
///
/// The resolver is held inside an `conc.Arc` and the emit path
/// borrows through the stored Arc on every call.  No retain/release
/// happens per log event; the only Arc clones are at logger
/// construction (`build`, `with_min_level`, `derive`) where one
/// extra refcount is paid to share the resolver across the new
/// runtime state.
///
/// **See also:** `LoggerConfigBuilder.context_resolver`,
/// `LogContext`, `Logger.info(ev)`.
pub interface ContextResolver {
	fn resolve(self: &Self) nothrow -> Optional<&LogContext>;
}

/// Default no-op resolver installed on every `LoggerConfig` until the
/// caller swaps in their own via
/// `LoggerConfigBuilder.context_resolver`.  Returns
/// `Optional<&LogContext>::None()` so bare `Logger.info(ev)` calls
/// emit no contextual attributes.
///
/// Keeping a present-by-default resolver (rather than
/// `Optional<Arc<ContextResolver>>`) avoids match-on-borrowed-Arc
/// gymnastics in the emit hot path: the LLVM CallIface lowering
/// always loads the fat pointer through the borrowed Arc and
/// dispatches, regardless of whether a custom resolver was
/// installed.  When this default is in effect the dispatch is one
/// indirect call into a function that immediately returns `None` —
/// negligible vs. the JSON-serialise + sink-write cost of a real log
/// emit.
pub struct NoContextResolver {
}

implement ContextResolver for NoContextResolver {
	pub fn resolve(self: &NoContextResolver) nothrow -> Optional<&LogContext> {
		val _ = self;
		return Optional<&LogContext>::None();
	}
}

/// Frozen logger configuration produced by `LoggerConfigBuilder.build`.
///
/// Move-only — pass directly into `create_logger` from the builder
/// (`create_logger("name", b.build())`).  The `resolver` field is
/// always set: a fresh `LoggerConfigBuilder` seeds it with
/// `NoContextResolver` (returns `None` on every `resolve()`); call
/// `LoggerConfigBuilder.context_resolver` to swap in your own
/// implementation.
///
/// **See also:** `LoggerConfigBuilder`, `create_logger`,
/// `ContextResolver`.
pub struct LoggerConfig {
	pub sink: Sink,
	pub min_level: Level,
	pub queue_capacity: Int,
	pub write_timeout: conc.Duration,
	pub enqueue_timeout: conc.Duration,
	pub backpressure_policy: BackpressurePolicy,
	pub formatter: FormatterKind,
	pub resolver: conc.Arc<ContextResolver>
}

/// Mutable builder for `LoggerConfig`.
///
/// Constructed via `config_builder()` with conservative defaults
/// (stderr sink, info min level, 1024-deep queue, 1-second
/// timeouts, block-with-timeout backpressure, JSON ISO-8601
/// formatter).  Configurator methods mutate in place and return
/// `&mut Self` for chaining.  Call `.build()` to freeze into a
/// `LoggerConfig`.
///
/// **See also:** `config_builder`, `LoggerConfigBuilder.build`,
/// `create_logger`.
pub struct LoggerConfigBuilder {
	sink: Sink,
	min_level: Level,
	queue_capacity: Int,
	write_timeout: conc.Duration,
	enqueue_timeout: conc.Duration,
	backpressure_policy: BackpressurePolicy,
	formatter: FormatterKind,
	resolver: conc.Arc<ContextResolver>
}

/// Live logger handle.
///
/// Constructed via `create_logger(name, config)` (root logger) or
/// `Logger.derive(name).build()` (sub-logger inheriting parent's
/// runtime state).  Logging methods (`info` / `debug` / `error` and
/// their `(ev, &ctx)` and `(ev, &ctx, attrs)` overloads) are
/// best-effort and return `Void` — see "Logging is best-effort" in
/// `docs/effective-drift.md` for the design rationale.
///
/// `Logger` implements `core.Destructible`; the destructor releases
/// the underlying runtime-state allocation when the last clone goes
/// out of scope.
///
/// **See also:** `create_logger`, `Logger.info`, `Logger.derive`,
/// `Logger.with_min_level`, `Logger.flush`.
pub struct Logger {
	name: String,
	min_level: Level,
	state: sync.Handle<Byte>
}

struct LoggerRuntimeState {
	min_level: Level,
	queue_capacity: Int,
	write_timeout_ms: Int,
	enqueue_timeout_ms: Int,
	backpressure_policy: BackpressurePolicy,
	stderr_cap: Optional<io.ProcessStderrCapability>,
	queue: sync.MpscQueue<Byte>,
	drain_lock: sync.AtomicBool,
	resolver: conc.Arc<ContextResolver>
}

struct LogEnvelope {
	level_rank: Int,
	logger_min_rank: Int,
	enqueue_timeout_ms: Int,
	// Caller's virtual-thread and POSIX thread IDs captured
	// synchronously at emit time, before the record is handed to the
	// async drain path.  `_emit_envelope_handle` must format these
	// stored values rather than calling `thread.vt_id()` /
	// `thread.posix_thread_id()` itself — the drain worker is an
	// implementation detail and its IDs are never the right answer
	// for "which thread emitted this event".
	vtid: Int,
	ptid: Int,
	payload_json: String
}

/// Mutable builder for sub-`Logger`s derived from a parent.
///
/// Constructed via `Logger.derive(name)`.  A sub-logger inherits its
/// parent's runtime state (sink, queue, formatter) but may override
/// the minimum log level via `.min_level(level)` before the terminal
/// `.build()`.  When no override is set, the sub-logger inherits the
/// parent's level.
///
/// **See also:** `Logger.derive`, `LoggerBuilder.min_level`,
/// `LoggerBuilder.build`.
pub struct LoggerBuilder {
	parent_state: sync.Handle<Byte>,
	parent_min_level: Level,
	name: String,
	min_level: Optional<Level>
}

implement core.Copy for Level {
}

implement core.Copy for BackpressurePolicy {
}

implement core.Copy for FormatterKind {
}

implement core.Copy for StdErrSink {
}

implement Sink for StdErrSink {
	pub fn write(self: &StdErrSink, rec: &LogRecord) nothrow -> Bool {
		val _ = self;
		val _ = rec;
		return true;
	}

	pub fn flush(self: &StdErrSink, timeout_ms: Int) nothrow -> Bool {
		val _ = self;
		val _ = timeout_ms;
		return true;
	}
}

/// Constructs a `StdErrSink` — the default sink that routes log
/// records to the process's standard-error fd.
///
/// **See also:** `StdErrSink`, `LoggerConfigBuilder.sink`.
pub fn stderr_sink() nothrow -> StdErrSink {
	return StdErrSink();
}

/// Returns a fresh `LoggerConfigBuilder` with conservative defaults:
/// stderr sink, `Info` minimum level, 1024-deep queue, 1-second
/// write/enqueue timeouts, block-with-timeout backpressure, JSON
/// ISO-8601 formatter.
///
/// Configure further before calling `.build()` to obtain a
/// `LoggerConfig` for `create_logger`.
///
/// **See also:** `LoggerConfigBuilder`, `create_logger`.
///
/// **Example:** `examples/logging/basic_events.drift`.
pub fn config_builder() nothrow -> LoggerConfigBuilder {
	return LoggerConfigBuilder(
		sink = stderr_sink(),
		min_level = Level::Info(),
		queue_capacity = 1024,
		write_timeout = conc.Duration(millis = 1000),
		enqueue_timeout = conc.Duration(millis = 1000),
		backpressure_policy = BackpressurePolicy::BlockWithTimeout(),
		formatter = FormatterKind::JsonIso8601(),
		resolver = conc.arc(NoContextResolver()).as_interface<type ContextResolver>()
	);
}

/// Constructs an empty `LogContext` for collecting attribute pairs.
///
/// Populate with `.put(key, value)`, then pass `&ctx` to
/// `Logger.info(ev, &ctx)` (or the `debug` / `error` siblings).
/// Passing `&log.log_context()` directly is the per-call opt-out
/// from a configured ambient context resolver.
///
/// **See also:** `LogContext`, `LogContext.put`,
/// `Logger.info(ev, ctx)`, `LoggerConfigBuilder.context_resolver`.
pub fn log_context() nothrow -> LogContext {
	var attrs: containers.HashMap<String, String> = {:};
	return LogContext(attrs = move attrs);
}

implement LogContext {
	/// Inserts (or replaces) an attribute pair.
	///
	/// `value` is projected to its canonical JSON text via the
	/// `Debuggable` impl on `V`.  If `key` was already present, the
	/// old value is dropped silently.
	///
	/// **Parameters:**
	/// - `key` — attribute name (consumed by move).
	/// - `value` — attribute value implementing `Debuggable`
	///   (consumed by move).
	///
	/// **See also:** `Debuggable`, `LogContext.get`.
	pub fn put<V>(self: &mut LogContext, key: String, value: V) nothrow -> Void require V is Debuggable {
		val json = Debuggable::to_debug_json_text(&value);
		match self.attrs.insert(move key, json) {
			Some(old) => {
				core.drop_value(move old);
			},
			None => {
			}
		}
		core.drop_value(move value);
		return;
	}

	/// Looks up the canonical-JSON-text value stored under `key`, or
	/// `None` if absent.
	pub fn get(self: &LogContext, key: &String) nothrow -> Optional<&String> {
		return self.attrs.get(key);
	}

	/// Removes every attribute from the context, keeping the
	/// allocated storage on the underlying map.
	pub fn clear(self: &mut LogContext) nothrow -> Void {
		self.attrs.clear();
	}
}

implement LoggerConfigBuilder {
	/// Sets the destination sink (e.g. `stderr_sink()` or a custom
	/// `Sink` implementation).
	pub fn sink(self: &mut LoggerConfigBuilder, sink: Sink) nothrow -> &mut LoggerConfigBuilder {
		self.sink = move sink;
		return self;
	}

	/// Sets the minimum log level.  Events below this level are
	/// dropped at the call site (no sink call, no record allocation).
	pub fn min_level(self: &mut LoggerConfigBuilder, var v: Level) nothrow -> &mut LoggerConfigBuilder {
		self.min_level = move v;
		return self;
	}

	/// Sets the in-memory queue capacity (number of pending records
	/// the producer side can buffer before backpressure kicks in).
	///
	/// **See also:** `LoggerConfigBuilder.backpressure_policy`,
	/// `LoggerConfigBuilder.enqueue_timeout`.
	pub fn queue_capacity(self: &mut LoggerConfigBuilder, v: Int) nothrow -> &mut LoggerConfigBuilder {
		self.queue_capacity = v;
		return self;
	}

	/// Sets the per-write timeout used by the drain side when
	/// flushing records to the sink.
	pub fn write_timeout(self: &mut LoggerConfigBuilder, v: conc.Duration) nothrow -> &mut LoggerConfigBuilder {
		self.write_timeout = v;
		return self;
	}

	/// Sets the per-enqueue timeout used when the queue is full and
	/// the backpressure policy is `BlockWithTimeout`.
	pub fn enqueue_timeout(self: &mut LoggerConfigBuilder, v: conc.Duration) nothrow -> &mut LoggerConfigBuilder {
		self.enqueue_timeout = v;
		return self;
	}

	/// Sets the backpressure policy — what to do when the queue is
	/// full.
	///
	/// **See also:** `BackpressurePolicy`.
	pub fn backpressure_policy(self: &mut LoggerConfigBuilder, var v: BackpressurePolicy) nothrow -> &mut LoggerConfigBuilder {
		self.backpressure_policy = move v;
		return self;
	}

	/// Sets the output formatter.  Defaults to
	/// `FormatterKind::JsonIso8601()`.
	pub fn formatter(self: &mut LoggerConfigBuilder, var v: FormatterKind) nothrow -> &mut LoggerConfigBuilder {
		self.formatter = move v;
		return self;
	}

	/// Installs an ambient context resolver consulted at emit time
	/// when a logging call passes no explicit `&LogContext`.
	///
	/// The caller supplies the resolver already wrapped in a fat
	/// `conc.Arc<ContextResolver>`, constructed via
	/// `conc.arc(concrete).as_interface<type ContextResolver>()`.
	/// When set, `Logger.info(ev)` / `Logger.info(ev, attrs)` (and
	/// the `debug` / `error` counterparts) call
	/// `resolver.get().resolve()` per emit; if it returns
	/// `Some(ctx)`, the returned context's attributes are merged
	/// into the record.  Calls that pass an explicit `&LogContext`
	/// suppress the resolver — see `Logger.info(ev, ctx)`.
	///
	/// `std.log` deliberately knows nothing about how the resolver
	/// discovers context: VT-local registry, request state,
	/// thread-local — it is all app policy inside the implementation.
	///
	/// **Parameters:**
	/// - `r` — a `conc.Arc<ContextResolver>` fat handle.  Sub-loggers
	///   and re-builds clone the Arc (one atomic refcount each); the
	///   per-emit hot path borrows through the stored Arc and
	///   dispatches `resolve()` without touching the refcount.
	pub fn context_resolver(self: &mut LoggerConfigBuilder, var r: conc.Arc<ContextResolver>) nothrow -> &mut LoggerConfigBuilder {
		self.resolver = move r;
		return self;
	}

	/// Materializes the builder into a `LoggerConfig` value
	/// suitable for `create_logger`.
	pub fn build(self: &LoggerConfigBuilder) nothrow -> LoggerConfig {
		return LoggerConfig(
			sink = self.sink,
			min_level = self.min_level,
			queue_capacity = self.queue_capacity,
			write_timeout = self.write_timeout,
			enqueue_timeout = self.enqueue_timeout,
			backpressure_policy = self.backpressure_policy,
			formatter = self.formatter,
			resolver = self.resolver.clone()
		);
	}
}

/// Constructs a root `Logger` with `name` and the supplied
/// configuration.
///
/// As a side effect, ensures `io.install_process_stdio` has run on
/// the global registry so the default stderr sink can resolve the
/// `ProcessStderrCapability`.
///
/// **Parameters:**
/// - `name` — logger name, surfaced as the `logger` field on every
///   emitted record.
/// - `config` — frozen `LoggerConfig` from
///   `LoggerConfigBuilder.build`.
///
/// **Returns:** a `Logger` ready to receive log calls.
///
/// **See also:** `config_builder`, `Logger`, `Logger.derive`.
///
/// **Example:** `examples/logging/basic_events.drift`.
pub fn create_logger(name: String, config: LoggerConfig) nothrow -> Logger {
	val reg = runtime.global_registry();
	val _ = io.install_process_stdio(reg);
	val st = _runtime_state_from_cfg(&config, _resolve_stderr_cap(reg));
	val h = _alloc_runtime_state(st);
	return Logger(name = name, min_level = config.min_level, state = h);
}

fn _level_rank(level: Level) nothrow -> Int {
	return match level {
		Debug => {
			0
		},
		Info => {
			1
		},
		Error => {
			2
		}
	};
}

fn _level_from_rank(rank: Int) nothrow -> Level {
	if rank <= 0 {
		return Level::Debug();
	}
	if rank == 1 {
		return Level::Info();
	}
	return Level::Error();
}

fn _backpressure_code(var policy: BackpressurePolicy) nothrow -> Int {
	return match policy {
		BlockWithTimeout => {
			0
		},
		DropOldest => {
			1
		},
		DropNewest => {
			2
		}
	};
}

fn _resolve_stderr_cap(reg: &runtime.GlobalRegistry) nothrow -> Optional<io.ProcessStderrCapability> {
	match runtime.get<type io.ProcessStderrCapability>(reg) {
		Some(cap) => {
			return Optional<io.ProcessStderrCapability>::Some(*cap);
		},
		None => {
			return Optional<io.ProcessStderrCapability>::None();
		}
	}
}

fn _runtime_state_from_cfg(cfg: &LoggerConfig, stderr_cap: Optional<io.ProcessStderrCapability>) nothrow -> LoggerRuntimeState {
	return LoggerRuntimeState(
		min_level = cfg.min_level,
		queue_capacity = cfg.queue_capacity,
		write_timeout_ms = cfg.write_timeout.millis,
		enqueue_timeout_ms = cfg.enqueue_timeout.millis,
		backpressure_policy = cfg.backpressure_policy,
		stderr_cap = stderr_cap,
		queue = sync.mpsc_queue<type Byte>(cfg.queue_capacity),
		drain_lock = sync.atomic_bool(false),
		resolver = cfg.resolver.clone()
	);
}

fn _clone_runtime_state(st: &LoggerRuntimeState, min_level: Level) nothrow -> LoggerRuntimeState {
	return LoggerRuntimeState(
		min_level = min_level,
		queue_capacity = st.queue_capacity,
		write_timeout_ms = st.write_timeout_ms,
		enqueue_timeout_ms = st.enqueue_timeout_ms,
		backpressure_policy = st.backpressure_policy,
		stderr_cap = st.stderr_cap,
		queue = sync.mpsc_queue<type Byte>(st.queue_capacity),
		drain_lock = sync.atomic_bool(false),
		resolver = st.resolver.clone()
	);
}

fn _alloc_runtime_state(st: LoggerRuntimeState) nothrow -> sync.Handle<Byte> {
	unsafe {
		var raw = mem.alloc_uninit<type LoggerRuntimeState>(1);
		mem.write<type LoggerRuntimeState>(&mut raw, 0, move st);
		val p = mem.rawbuffer_ptr<type LoggerRuntimeState>(&raw);
		return sync.handle<type Byte>(cast<Uint>(p));
	}
}

fn _runtime_state_from_handle(h: sync.Handle<Byte>) nothrow -> Optional<&LoggerRuntimeState> {
	if h.is_null() {
		return Optional<&LoggerRuntimeState>::None();
	}
	unsafe {
		val p = cast<mem.Ptr<LoggerRuntimeState> >(h.to_uint());
		return Optional<&LoggerRuntimeState>::Some(p);
	}
}

fn _enabled(min_level: Level, event_level: Level) nothrow -> Bool {
	if _level_rank(event_level) >= _level_rank(min_level) {
		return true;
	}
	return false;
}

fn _alloc_envelope(level_rank: Int, logger_min_rank: Int, enqueue_timeout_ms: Int, vtid: Int, ptid: Int, payload_json: String) -> sync.Handle<Byte> {
	unsafe {
		var raw = mem.alloc_uninit<type LogEnvelope>(1);
		val env = LogEnvelope(level_rank = level_rank, logger_min_rank = logger_min_rank, enqueue_timeout_ms = enqueue_timeout_ms, vtid = vtid, ptid = ptid, payload_json = payload_json);
		mem.write<type LogEnvelope>(&mut raw, 0, move env);
		val p = mem.rawbuffer_ptr<type LogEnvelope>(&raw);
		val u = cast<Uint>(p);
		return sync.handle<type Byte>(u);
	}
}

fn _drop_envelope_handle(h: sync.Handle<Byte>) nothrow -> Void {
	if h.is_null() {
		return;
	}
	unsafe {
		val p = cast<mem.Ptr<Byte> >(h.to_uint());
		var raw = mem.rawbuffer_from_parts<type LogEnvelope>(p, 1);
		val env = mem.read<type LogEnvelope>(&mut raw, 0);
		core.drop_value(move env);
		mem.dealloc<type LogEnvelope>(raw);
	}
	return;
}

fn _emit_envelope_handle(st: &LoggerRuntimeState, h: sync.Handle<Byte>) nothrow -> Bool {
	if h.is_null() {
		return false;
	}
	unsafe {
		val p = cast<mem.Ptr<Byte> >(h.to_uint());
		var raw = mem.rawbuffer_from_parts<type LogEnvelope>(p, 1);
		val env = mem.read<type LogEnvelope>(&mut raw, 0);
		val tm = time.format_iso8601_utc(&time.now_utc());
		// vtid/ptid were captured synchronously at emit time on the
		// caller's thread — use the stored snapshot, never probe
		// here (the drain path may be running on a completely
		// different VT/OS thread than the emitter).
		val line = "{\"tm\":\"" + _json_escape(tm) + "\",\"level\":\"" + _level_text_from_rank(env.level_rank) + "\"," + env.payload_json + ",\"vtid\":" + format.format_int(env.vtid) + ",\"ptid\":" + format.format_int(env.ptid) + "}";
		val _ = _sink_write_line(st, line);
		core.drop_value(move env);
		mem.dealloc<type LogEnvelope>(raw);
		return true;
	}
}

fn _sink_write_line(st: &LoggerRuntimeState, line: String) nothrow -> Bool {
	match st.stderr_cap {
		Some(cap) => {
			return cap.write_line(line);
		},
		None => {
			val _ = st;
			val _ = line;
			return false;
		}
	}
}

fn _drain_locked(st: &LoggerRuntimeState) nothrow -> Void {
	while true {
		match st.queue.pop() {
			Some(h) => {
				val _ = _emit_envelope_handle(st, h);
			},
			None => {
				break;
			}
		}
	}
	return;
}

fn _try_drain_once_owner(st: &LoggerRuntimeState) nothrow -> Void {
	if st.drain_lock.compare_exchange(false, true, sync.MemoryOrder::AcqRel(), sync.MemoryOrder::Acquire()) {
		_drain_locked(st);
		st.drain_lock.store(false, sync.MemoryOrder::Release());
	}
	return;
}

fn _flush_state(st: &LoggerRuntimeState, timeout_ms: Int) nothrow -> Void {
	val deadline = thread.now_ms() + timeout_ms;
	var acquired = false;
	while thread.now_ms() <= deadline {
		if st.drain_lock.compare_exchange(false, true, sync.MemoryOrder::AcqRel(), sync.MemoryOrder::Acquire()) {
			acquired = true;
			break;
		}
	}
	if acquired {
		_drain_locked(st);
		st.drain_lock.store(false, sync.MemoryOrder::Release());
	}
	return;
}

fn _enqueue_with_policy(st: &LoggerRuntimeState, h: sync.Handle<Byte>) nothrow -> Bool {
	if st.queue.push(h) {
		return true;
	}
	match st.backpressure_policy {
		DropNewest => {
			_drop_envelope_handle(h);
			return false;
		},
		DropOldest => {
			match st.queue.pop() {
				Some(old) => {
					_drop_envelope_handle(old);
				},
				None => {
				}
			}
			if st.queue.push(h) {
				return true;
			}
			_drop_envelope_handle(h);
			return false;
		},
		BlockWithTimeout => {
			if st.enqueue_timeout_ms <= 0 {
				_drop_envelope_handle(h);
				return false;
			}
			val deadline = thread.now_ms() + st.enqueue_timeout_ms;
			var pushed = false;
			while thread.now_ms() <= deadline {
				if st.queue.push(h) {
					pushed = true;
					break;
				}
				_try_drain_once_owner(st);
			}
			if not pushed {
				_drop_envelope_handle(h);
			}
			return pushed;
		}
	}
	return false;
}

fn _resolve_ctx_from_state(st: &LoggerRuntimeState) nothrow -> Optional<&LogContext> {
	return st.resolver.get().resolve();
}

fn _emit<V>(logger: &Logger, var level: Level, ev: String, attrs: containers.HashMap<String, V>) nothrow -> Bool require V is Debuggable {
	if not _enabled(logger.min_level, level) {
		core.drop_value(move attrs);
		return false;
	}
	match _runtime_state_from_handle(logger.state) {
		Some(st) => {
			match _resolve_ctx_from_state(st) {
				Some(ctx) => {
					val ok = try _emit_ctx_attrs_throwing_typed<type V>(logger, level, ev, ctx, &attrs) catch { false };
					core.drop_value(move attrs);
					return ok;
				},
				None => {
					val ok = try _emit_throwing<type V>(logger, level, ev, &attrs) catch { false };
					core.drop_value(move attrs);
					return ok;
				}
			}
		},
		None => {
			core.drop_value(move attrs);
			return false;
		}
	}
}

fn _emit_explicit_ctx(logger: &Logger, var level: Level, ev: String, ctx: &LogContext) nothrow -> Bool {
	if not _enabled(logger.min_level, level) {
		return false;
	}
	return try _emit_ctx_throwing(logger, level, ev, ctx) catch { false };
}

fn _emit_no_attrs(logger: &Logger, var level: Level, ev: String) nothrow -> Bool {
	if not _enabled(logger.min_level, level) {
		return false;
	}
	match _runtime_state_from_handle(logger.state) {
		Some(st) => {
			match _resolve_ctx_from_state(st) {
				Some(ctx) => {
					return try _emit_ctx_throwing(logger, level, ev, ctx) catch { false };
				},
				None => {
					return try _emit_no_attrs_throwing(logger, level, ev) catch { false };
				}
			}
		},
		None => {
			return false;
		}
	}
}

fn _emit_explicit_ctx_attrs(logger: &Logger, var level: Level, ev: String, ctx: &LogContext, attrs: containers.HashMap<String, String>) nothrow -> Bool {
	if not _enabled(logger.min_level, level) {
		core.drop_value(move attrs);
		return false;
	}
	val ok = try _emit_ctx_attrs_throwing(logger, level, ev, ctx, &attrs) catch { false };
	core.drop_value(move attrs);
	return ok;
}

fn _emit_explicit_ctx_attrs_typed<V>(logger: &Logger, var level: Level, ev: String, ctx: &LogContext, attrs: containers.HashMap<String, V>) nothrow -> Bool require V is Debuggable {
	if not _enabled(logger.min_level, level) {
		core.drop_value(move attrs);
		return false;
	}
	val ok = try _emit_ctx_attrs_throwing_typed<type V>(logger, level, ev, ctx, &attrs) catch { false };
	core.drop_value(move attrs);
	return ok;
}

fn _emit_throwing<V>(logger: &Logger, var level: Level, ev: String, attrs: &containers.HashMap<String, V>) -> Bool require V is Debuggable {
	val payload = _payload_json<type V>(logger, ev, attrs);
	return _emit_payload_throwing(logger, level, payload);
}

fn _emit_ctx_throwing(logger: &Logger, var level: Level, ev: String, ctx: &LogContext) -> Bool {
	val payload = _payload_json_ctx(logger, ev, ctx);
	return _emit_payload_throwing(logger, level, payload);
}

fn _emit_no_attrs_throwing(logger: &Logger, var level: Level, ev: String) -> Bool {
	val payload = _payload_json_no_attrs(logger, ev);
	return _emit_payload_throwing(logger, level, payload);
}

fn _emit_ctx_attrs_throwing(logger: &Logger, var level: Level, ev: String, ctx: &LogContext, attrs: &containers.HashMap<String, String>) -> Bool {
	val payload = _payload_json_ctx_attrs(logger, ev, ctx, attrs);
	return _emit_payload_throwing(logger, level, payload);
}

fn _emit_ctx_attrs_throwing_typed<V>(logger: &Logger, var level: Level, ev: String, ctx: &LogContext, attrs: &containers.HashMap<String, V>) -> Bool require V is Debuggable {
	val payload = _payload_json_ctx_attrs_typed<type V>(logger, ev, ctx, attrs);
	return _emit_payload_throwing(logger, level, payload);
}

fn _emit_payload_throwing(logger: &Logger, var level: Level, payload: String) -> Bool {
	match _runtime_state_from_handle(logger.state) {
		Some(st) => {
			// Snapshot the caller's thread identity BEFORE enqueue —
			// the record must describe the event origin, not the
			// drain worker that happens to dequeue it later.
			val vtid = thread.vt_id();
			val ptid = thread.posix_thread_id();
			val h = _alloc_envelope(_level_rank(level), _level_rank(logger.min_level), st.enqueue_timeout_ms, vtid, ptid, payload);
			if not _enqueue_with_policy(st, h) {
				return false;
			}
			_try_drain_once_owner(st);
			return true;
		},
		None => {
			val _ = level;
			val _ = payload;
			return false;
		}
	}
}

fn _attrs_json<V>(attrs: &containers.HashMap<String, V>) -> String require V is Debuggable {
	var out = "{";
	var first = true;
	var it = attrs.iter();
	while true {
		val next = it.next();
		match next {
			Some(item) => {
				if not first {
					out = out + ",";
				}
				first = false;
				val key = _json_escape(*item.key);
				val value_json = Debuggable::to_debug_json_text(item.value);
				out = out + "\"" + key + "\":" + value_json;
			},
			None => {
				break;
			}
		}
	}
	return out + "}";
}

fn _payload_json<V>(logger: &Logger, ev: String, attrs: &containers.HashMap<String, V>) -> String require V is Debuggable {
	val ev_json = _json_escape(ev);
	val logger_json = _json_escape(logger.name);
	val attrs_json = _attrs_json<type V>(attrs);
	return "\"ev\":\"" + ev_json + "\",\"logger\":\"" + logger_json + "\",\"attrs\":" + attrs_json;
}

fn _ctx_attrs_json(ctx: &LogContext) -> String {
	var out = "{";
	var first = true;
	var it = ctx.attrs.iter();
	while true {
		val next = it.next();
		match next {
			Some(item) => {
				if not first {
					out = out + ",";
				}
				first = false;
				val key = _json_escape(*item.key);
				out = out + "\"" + key + "\":" + *item.value;
			},
			None => {
				break;
			}
		}
	}
	return out + "}";
}

fn _ctx_attrs_json_merged(ctx: &LogContext, attrs: &containers.HashMap<String, String>) -> String {
	var out = "{";
	var first = true;
	var it_ctx = ctx.attrs.iter();
	while true {
		val next = it_ctx.next();
		match next {
			Some(item) => {
				if attrs.contains_key(item.key) {
					continue;
				}
				if not first {
					out = out + ",";
				}
				first = false;
				val key = _json_escape(*item.key);
				out = out + "\"" + key + "\":" + *item.value;
			},
			None => {
				break;
			}
		}
	}
	var it_attrs = attrs.iter();
	while true {
		val next = it_attrs.next();
		match next {
			Some(item) => {
				if not first {
					out = out + ",";
				}
				first = false;
				val key = _json_escape(*item.key);
				out = out + "\"" + key + "\":" + *item.value;
			},
			None => {
				break;
			}
		}
	}
	return out + "}";
}

fn _payload_json_no_attrs(logger: &Logger, ev: String) -> String {
	val ev_json = _json_escape(ev);
	val logger_json = _json_escape(logger.name);
	return "\"ev\":\"" + ev_json + "\",\"logger\":\"" + logger_json + "\",\"attrs\":{}";
}

fn _payload_json_ctx(logger: &Logger, ev: String, ctx: &LogContext) -> String {
	val ev_json = _json_escape(ev);
	val logger_json = _json_escape(logger.name);
	val attrs_json = _ctx_attrs_json(ctx);
	return "\"ev\":\"" + ev_json + "\",\"logger\":\"" + logger_json + "\",\"attrs\":" + attrs_json;
}

fn _payload_json_ctx_attrs(logger: &Logger, ev: String, ctx: &LogContext, attrs: &containers.HashMap<String, String>) -> String {
	val ev_json = _json_escape(ev);
	val logger_json = _json_escape(logger.name);
	val attrs_json = _ctx_attrs_json_merged(ctx, attrs);
	return "\"ev\":\"" + ev_json + "\",\"logger\":\"" + logger_json + "\",\"attrs\":" + attrs_json;
}

fn _payload_json_ctx_attrs_typed<V>(logger: &Logger, ev: String, ctx: &LogContext, attrs: &containers.HashMap<String, V>) -> String require V is Debuggable {
	val ev_json = _json_escape(ev);
	val logger_json = _json_escape(logger.name);
	val attrs_json = _ctx_attrs_json_merged_typed<type V>(ctx, attrs);
	return "\"ev\":\"" + ev_json + "\",\"logger\":\"" + logger_json + "\",\"attrs\":" + attrs_json;
}

fn _ctx_attrs_json_merged_typed<V>(ctx: &LogContext, attrs: &containers.HashMap<String, V>) -> String require V is Debuggable {
	var out = "{";
	var first = true;
	var it_ctx = ctx.attrs.iter();
	while true {
		val next = it_ctx.next();
		match next {
			Some(item) => {
				if attrs.contains_key(item.key) {
					continue;
				}
				if not first {
					out = out + ",";
				}
				first = false;
				val key = _json_escape(*item.key);
				out = out + "\"" + key + "\":" + *item.value;
			},
			None => {
				break;
			}
		}
	}
	var it_attrs = attrs.iter();
	while true {
		val next = it_attrs.next();
		match next {
			Some(item) => {
				if not first {
					out = out + ",";
				}
				first = false;
				val key = _json_escape(*item.key);
				val value_json = Debuggable::to_debug_json_text(item.value);
				out = out + "\"" + key + "\":" + value_json;
			},
			None => {
				break;
			}
		}
	}
	return out + "}";
}

implement Logger {
	/// Returns the logger's name.
	pub fn name(self: &Logger) nothrow -> String {
		return self.name;
	}

	/// Returns the logger's current minimum log level.
	pub fn min_level(self: &Logger) nothrow -> Level {
		return self.min_level;
	}

	/// Returns a new `Logger` sharing this logger's runtime state but
	/// with `level` as its minimum log level.
	///
	/// Useful for temporarily lowering the level inside a scope (e.g.
	/// turn on debug logging for a single request).  The original
	/// logger is unchanged.
	///
	/// **Parameters:**
	/// - `level` — minimum level for the returned logger.
	///
	/// **See also:** `Logger.derive`, `Logger.min_level`.
	pub fn with_min_level(self: &Logger, var level: Level) nothrow -> Logger {
		match _runtime_state_from_handle(self.state) {
			Some(st) => {
				val next = _clone_runtime_state(st, level);
				val h = _alloc_runtime_state(next);
				return Logger(name = self.name, min_level = level, state = h);
			},
			None => {
				return Logger(name = self.name, min_level = level, state = sync.null_handle<type Byte>());
			}
		}
	}

	/// Returns a `LoggerBuilder` for constructing a sub-logger that
	/// inherits this logger's runtime state.
	///
	/// The sub-logger gets a fresh name (the supplied `name`); call
	/// `.min_level(level)` on the builder to override the inherited
	/// minimum log level, then `.build()` to materialize.
	///
	/// **See also:** `LoggerBuilder`, `Logger.with_min_level`.
	pub fn derive(self: &Logger, name: String) nothrow -> LoggerBuilder {
		return LoggerBuilder(parent_state = self.state, parent_min_level = self.min_level, name = name, min_level = Optional<Level>::None());
	}

	/// Drains the logger's queue to its sink and waits up to
	/// `timeout` for the drain to complete.
	///
	/// Unlike the `info` / `debug` / `error` methods, `flush` returns
	/// a `Bool` because the wait-for-drain semantic genuinely needs
	/// to surface success vs. timeout to the caller.
	///
	/// **Parameters:**
	/// - `timeout` — maximum time to wait for the drain to finish.
	///
	/// **Returns:** `true` if the drain completed within `timeout`,
	/// `false` otherwise.
	pub fn flush(self: &Logger, timeout: conc.Duration) nothrow -> Bool {
		match _runtime_state_from_handle(self.state) {
			Some(st) => {
				_flush_state(st, timeout.millis);
			},
			None => {
			}
		}
		return true;
	}

	/// Emits an `info`-level event with a typed attribute map.
	///
	/// Best-effort, fire-and-continue: returns `Void` regardless of
	/// queue acceptance.  Filtered out at the call site if the
	/// logger's `min_level` is above `Info`.  See "Logging is
	/// best-effort" in `docs/effective-drift.md` for the contract
	/// rationale.
	///
	/// If the logger is configured with a context resolver
	/// (`LoggerConfigBuilder.context_resolver`) and no explicit
	/// `&LogContext` is passed, the resolver is consulted at emit
	/// time and any returned context's attributes are merged with
	/// `attrs` (resolver attributes lose to caller-supplied keys on
	/// collision).
	///
	/// **Parameters:**
	/// - `ev` — event name (machine-readable, stable identifier).
	/// - `attrs` — map of attribute key/value pairs; values may be
	///   any type implementing `Debuggable`.
	///
	/// **See also:** `Logger.info(ev, ctx)`,
	/// `LoggerConfigBuilder.context_resolver`, `Debuggable`.
	///
	/// **Example:** `examples/logging/basic_events.drift`.
	pub fn info<V>(self: &Logger, ev: String, attrs: containers.HashMap<String, V>) nothrow -> Void require V is Debuggable {
		val _ = _emit(self, Level::Info(), ev, move attrs);
	}

	/// No-attrs overload of `Logger.info`.  Emits an event whose
	/// attributes come solely from the configured context resolver
	/// (or none, if no resolver is set).
	pub fn info(self: &Logger, ev: String) nothrow -> Void {
		val _ = _emit_no_attrs(self, Level::Info(), ev);
	}

	/// Explicit-context overload of `Logger.info`.  Attaches every
	/// attribute carried by `ctx` to the emitted event and **does
	/// not** consult the configured context resolver.
	///
	/// To force "no context" on a single call when an ambient
	/// resolver is configured, pass `&log.log_context()` (an empty
	/// context).
	///
	/// **Parameters:**
	/// - `ev` — event name.
	/// - `ctx` — borrowed `LogContext` whose attributes are merged
	///   into the record.
	///
	/// **See also:** `LogContext`, `Logger.info(ev, ctx, attrs)`.
	pub fn info(self: &Logger, ev: String, ctx: &LogContext) nothrow -> Void {
		val _ = _emit_explicit_ctx(self, Level::Info(), ev, ctx);
	}

	/// Explicit-context-plus-typed-overrides overload of `Logger.info`.
	/// Merges `ctx`'s attributes with `attrs`; the latter wins on
	/// key collisions.  Suppresses the configured context resolver.
	///
	/// Values may be any type implementing `Debuggable` — use this
	/// form for the common single-type override case
	/// (`{"size": 42}`).  When overrides carry mixed types, fall
	/// back to the pre-projected JSON-text form: project each value
	/// via `core.diagnostic_json_*` and pass a
	/// `HashMap<String, String>`.
	///
	/// **See also:** `Logger.info(ev, ctx)`, `LogContext`,
	/// `Debuggable`.
	pub fn info<V>(self: &Logger, ev: String, ctx: &LogContext, attrs: containers.HashMap<String, V>) nothrow -> Void require V is Debuggable {
		val _ = _emit_explicit_ctx_attrs_typed<type V>(self, Level::Info(), ev, ctx, move attrs);
	}

	/// Explicit-context-plus-pre-projected-overrides overload of
	/// `Logger.info`.  Same as the typed form but takes a
	/// `HashMap<String, String>` whose values are already canonical
	/// JSON text (e.g. produced by `core.diagnostic_json_*`), so the
	/// overrides can carry mixed-type values.
	pub fn info(self: &Logger, ev: String, ctx: &LogContext, attrs: containers.HashMap<String, String>) nothrow -> Void {
		val _ = _emit_explicit_ctx_attrs(self, Level::Info(), ev, ctx, move attrs);
	}

	/// Emits a `debug`-level event with a typed attribute map.
	///
	/// Same shape and contract as `Logger.info`, but at `Debug`
	/// severity — typically filtered out by default since `Info` is
	/// the default minimum level.
	///
	/// **See also:** `Logger.info`, `Logger.debug(ev, ctx)`.
	pub fn debug<V>(self: &Logger, ev: String, attrs: containers.HashMap<String, V>) nothrow -> Void require V is Debuggable {
		val _ = _emit(self, Level::Debug(), ev, move attrs);
	}

	/// No-attrs overload of `Logger.debug`.  See `Logger.debug` for
	/// full semantics.
	pub fn debug(self: &Logger, ev: String) nothrow -> Void {
		val _ = _emit_no_attrs(self, Level::Debug(), ev);
	}

	/// Explicit-context overload of `Logger.debug`.  See
	/// `Logger.info(ev, ctx)` for the resolver-suppression semantics.
	pub fn debug(self: &Logger, ev: String, ctx: &LogContext) nothrow -> Void {
		val _ = _emit_explicit_ctx(self, Level::Debug(), ev, ctx);
	}

	/// Explicit-context-plus-typed-overrides overload of
	/// `Logger.debug`.  See `Logger.info(ev, ctx, attrs)` for the
	/// override semantics.
	pub fn debug<V>(self: &Logger, ev: String, ctx: &LogContext, attrs: containers.HashMap<String, V>) nothrow -> Void require V is Debuggable {
		val _ = _emit_explicit_ctx_attrs_typed<type V>(self, Level::Debug(), ev, ctx, move attrs);
	}

	/// Explicit-context-plus-pre-projected-overrides overload of
	/// `Logger.debug`.  See the typed `Logger.debug(ev, ctx, attrs)`
	/// overload above for the common case.  Values must be canonical
	/// JSON text (e.g. produced by `core.diagnostic_json_*`).
	pub fn debug(self: &Logger, ev: String, ctx: &LogContext, attrs: containers.HashMap<String, String>) nothrow -> Void {
		val _ = _emit_explicit_ctx_attrs(self, Level::Debug(), ev, ctx, move attrs);
	}

	/// Emits an `error`-level event with a typed attribute map.
	///
	/// Same shape and contract as `Logger.info`, but at `Error`
	/// severity — passes through every default-configured logger.
	///
	/// **See also:** `Logger.info`, `Logger.error(ev, ctx)`.
	pub fn error<V>(self: &Logger, ev: String, attrs: containers.HashMap<String, V>) nothrow -> Void require V is Debuggable {
		val _ = _emit(self, Level::Error(), ev, move attrs);
	}

	/// No-attrs overload of `Logger.error`.  See `Logger.error` for
	/// full semantics.
	pub fn error(self: &Logger, ev: String) nothrow -> Void {
		val _ = _emit_no_attrs(self, Level::Error(), ev);
	}

	/// Explicit-context overload of `Logger.error`.  See
	/// `Logger.info(ev, ctx)` for the resolver-suppression semantics.
	pub fn error(self: &Logger, ev: String, ctx: &LogContext) nothrow -> Void {
		val _ = _emit_explicit_ctx(self, Level::Error(), ev, ctx);
	}

	/// Explicit-context-plus-typed-overrides overload of
	/// `Logger.error`.  See `Logger.info(ev, ctx, attrs)` for the
	/// override semantics.
	pub fn error<V>(self: &Logger, ev: String, ctx: &LogContext, attrs: containers.HashMap<String, V>) nothrow -> Void require V is Debuggable {
		val _ = _emit_explicit_ctx_attrs_typed<type V>(self, Level::Error(), ev, ctx, move attrs);
	}

	/// Explicit-context-plus-pre-projected-overrides overload of
	/// `Logger.error`.  See the typed `Logger.error(ev, ctx, attrs)`
	/// overload above for the common case.  Values must be canonical
	/// JSON text (e.g. produced by `core.diagnostic_json_*`).
	pub fn error(self: &Logger, ev: String, ctx: &LogContext, attrs: containers.HashMap<String, String>) nothrow -> Void {
		val _ = _emit_explicit_ctx_attrs(self, Level::Error(), ev, ctx, move attrs);
	}
}

implement LoggerBuilder {
	/// Overrides the sub-logger name initially set by `Logger.derive`.
	pub fn name(self: &mut LoggerBuilder, name: String) nothrow -> &mut LoggerBuilder {
		self.name = name;
		return self;
	}

	/// Overrides the inherited minimum log level.
	///
	/// Without this call, the resulting sub-logger inherits its
	/// parent's `min_level`.
	pub fn min_level(self: &mut LoggerBuilder, var level: Level) nothrow -> &mut LoggerBuilder {
		self.min_level = Optional::Some(move level);
		return self;
	}

	/// Materializes the builder into a sub-`Logger` sharing the
	/// parent's runtime state (sink, queue, formatter).
	///
	/// **Returns:** a `Logger` with the configured name and
	/// effective minimum level.
	pub fn build(self: &LoggerBuilder) nothrow -> Logger {
		val min = match self.min_level {
			Some(level) => {
				level
			},
			None => {
				self.parent_min_level
			}
		};
		match _runtime_state_from_handle(self.parent_state) {
			Some(st) => {
				val next = _clone_runtime_state(st, min);
				val h = _alloc_runtime_state(next);
				return Logger(name = self.name, min_level = min, state = h);
			},
			None => {
				return Logger(name = self.name, min_level = min, state = sync.null_handle<type Byte>());
			}
		}
	}
}

implement core.Destructible for Logger {
	pub fn destroy(var self: Logger) nothrow -> Void {
		if self.state.is_null() {
			return;
		}
		unsafe {
			val p = cast<mem.Ptr<Byte> >(self.state.to_uint());
			var raw = mem.rawbuffer_from_parts<type LoggerRuntimeState>(p, 1);
			val st = mem.read<type LoggerRuntimeState>(&mut raw, 0);
			core.drop_value(move st);
			mem.dealloc<type LoggerRuntimeState>(raw);
		}
		return;
	}
}

fn _level_text(level: Level) nothrow -> String {
	return match level {
		Debug => { "debug" },
		Info => { "info" },
		Error => { "error" }
	};
}

fn _level_text_from_rank(rank: Int) nothrow -> String {
	return _level_text(_level_from_rank(rank));
}

fn _hex_digit(v: Int) nothrow -> String {
	if v <= 9 {
		return format.format_int(v);
	}
	if v == 10 { return "A"; }
	if v == 11 { return "B"; }
	if v == 12 { return "C"; }
	if v == 13 { return "D"; }
	if v == 14 { return "E"; }
	return "F";
}

fn _byte_hex2(b: Byte) nothrow -> String {
	val v = cast<Int>(b);
	val hi = v / 16;
	val lo = v % 16;
	return _hex_digit(hi) + _hex_digit(lo);
}

fn _byte_to_string(b: Byte) nothrow -> String {
	unsafe {
		var raw = mem.alloc_uninit<type Byte>(1);
		mem.write<type Byte>(&mut raw, 0, b);
		val out = core.string_from_utf8_bytes(mem.rawbuffer_ptr<type Byte>(&raw), 1);
		mem.dealloc<type Byte>(raw);
		return out;
	}
}

fn _json_escape(s: String) nothrow -> String {
	var out = "";
	var i = 0;
	val n = s.byte_length();
	while i < n {
		val b = core.string_byte_at(&s, i);
		if b == cast<Byte>(34) {
			out = out + "\\\"";
		} else {
			if b == cast<Byte>(92) {
				out = out + "\\\\";
			} else {
				if b == cast<Byte>(10) {
					out = out + "\\n";
				} else {
					if b == cast<Byte>(13) {
						out = out + "\\r";
					} else {
						if b == cast<Byte>(9) {
							out = out + "\\t";
						} else {
							if b < cast<Byte>(32) {
								out = out + "\\u00" + _byte_hex2(b);
							} else {
								out = out + _byte_to_string(b);
							}
						}
					}
				}
			}
		}
		i = i + 1;
	}
	return out;
}

/// Macro-target for `log.debug!(logger, ev)`.
///
/// Generated by the macro expander from `log.debug!(...)` syntax;
/// captures the caller's source location via `src`.  Direct callers
/// should prefer `Logger.debug` — the `macro_*` family exists so the
/// expander can pass the implicit `src` argument.  See
/// `lang/driftc/stage1/macro_expander.py` for the expansion rules.
///
/// **See also:** `Logger.debug`, `macro_info`, `macro_error`.
pub fn macro_debug(logger: &Logger, ev: String, src: meta.Caller) nothrow -> Void {
	val _ = move src;
	logger.debug(ev);
}

/// Macro-target for `log.debug!(logger, ev, ctx)`.  See `macro_debug`
/// (no-ctx) for the macro-target convention.
pub fn macro_debug(logger: &Logger, ev: String, ctx: &LogContext, src: meta.Caller) nothrow -> Void {
	val _ = move src;
	logger.debug(ev, ctx);
}

/// Macro-target for `log.debug!(logger, ev, ctx, attrs)` with a
/// typed `attrs` map.  See `macro_debug` (no-ctx) for the
/// macro-target convention.
pub fn macro_debug<V>(logger: &Logger, ev: String, ctx: &LogContext, attrs: containers.HashMap<String, V>, src: meta.Caller) nothrow -> Void require V is Debuggable {
	val _ = move src;
	logger.debug<type V>(ev, ctx, move attrs);
}

/// Macro-target for `log.debug!(logger, ev, ctx, attrs)` with a
/// pre-projected JSON-text map.  See the typed overload above for
/// the common case.
pub fn macro_debug(logger: &Logger, ev: String, ctx: &LogContext, attrs: containers.HashMap<String, String>, src: meta.Caller) nothrow -> Void {
	val _ = move src;
	logger.debug(ev, ctx, move attrs);
}

